// Universal QR Scanner — Meta Quest 3 / 3S (Horizon Store)
//
// HoloScript-native composition. The native compile target `quest` (surface: immersive_mr) compiles
// THIS file through the REAL HoloCompositionParser + trait dispatch — no regex scraper, no
// hand-written Kotlin. Every capability below is a REAL registered trait
// (packages/core/src/traits/{PassthroughCamera,QrDecode,SpatialPanel,Onboarding,Tutorial}Trait.ts);
// the QuestCompiler walks composition.objects[].traits[] and emits the native Meta Spatial SDK app.
// Edit HERE, recompile — the Kotlin under android-mr/ is @generated output.

composition "UniversalQrScanner" {
  environment {
    surface: "immersive_mr"          // Meta Spatial SDK passthrough mixed reality
    runtime: "meta_spatial_sdk"
    passthrough: true
    reference_space: "local_floor"
    target_devices: ["quest3", "quest3s"]
    min_horizon_os: 76
    package: "net.holoscript.qrscanner"
  }

  // Passthrough camera frame source — trait: PassthroughCameraTrait.
  object "camera_sensor" {
    @passthrough_camera {
      permission: "horizonos.permission.HEADSET_CAMERA"
      camera_source: 0
      camera_position: 0
      capture: "max"
      frame_width: 1280
      frame_height: 960
      format: "YUV_420_888"
      plane: "luminance"
      preview_downscale: 4
    }
  }

  // QR decode — trait: QrDecodeTrait.
  object "qr_engine" {
    @qr_decode {
      library: "zxing-core"
      formats: ["QR_CODE"]
      try_harder: true
      also_inverted: true
      center_crop: { width: 640, height: 480 }
      decode_interval_ms: 200
      dedupe_window_ms: 2500

      // Scan feedback — a short confirmation beep on every decode (non-visual cue). Compiles to a
      // ToneGenerator call in StarterSampleActivity. (Haptics aren't reliable from a headset app, so
      // the cue is audible; the visual success card already animates on a hit.)
      feedback: { sound: true }

      // Universal content classification — the DATA the compiler turns into the on-device
      // classifyContent() Kotlin (StarterSampleActivity.kt). Each row: a content kind, the primary
      // action (open = launch in the Quest browser; copy = copy to clipboard), the result-card label,
      // and the case-insensitive prefixes that identify it. First match wins; world links are matched
      // earlier by @world_portal and take precedence. Add a row here → recompile → the app handles a
      // new QR type. (Native authoring F.126: behavior is data the compiler consumes, not hand-Kotlin.)
      content_types: [
        { kind: "url",     action: "open", label: "Link",           prefixes: ["http://", "https://"] },
        { kind: "wifi",    action: "copy", label: "Wi-Fi network",  prefixes: ["WIFI:"] },
        { kind: "contact", action: "copy", label: "Contact card",   prefixes: ["BEGIN:VCARD", "MECARD:"] },
        { kind: "email",   action: "copy", label: "Email",          prefixes: ["mailto:", "MATMSG:"] },
        { kind: "phone",   action: "copy", label: "Phone number",   prefixes: ["tel:"] },
        { kind: "sms",     action: "copy", label: "Message",        prefixes: ["sms:", "smsto:"] },
        { kind: "geo",     action: "copy", label: "Location",       prefixes: ["geo:"] },
        { kind: "event",   action: "copy", label: "Calendar event", prefixes: ["BEGIN:VEVENT"] }
      ]
      fallback_type: { kind: "text", action: "copy", label: "Text" }   // no prefix matched
    }
  }

  // Spatial panel (Compose, placed in 3D) — trait: SpatialPanelTrait.
  object "scanner_panel" {
    @spatial_panel {
      place: { x: 0.0, y: 1.3, z: 1.5 }   // initial placement; head-lock overrides it at runtime
      size: { width: 1.2, height: 1.2 }
      follow_head: true                    // HUD follows the head (not world-fixed) — moves with your gaze
      follow_distance: 1.2                 // meters in front of the head
      title: "Universal QR Scanner"
      ambient: true                        // nothing shown while scanning; a result card pops only on a hit
    }
  }

  // Scan a QR → enter a HoloScript world — trait: WorldPortalTrait.
  object "portal" {
    @world_portal {
      link_patterns: ["holoscript://world/", "https://holoscript.studio/w/", "https://hololand.holoscript.studio/"]
      auto_immerse: true                   // a world QR immerses you automatically (no extra tap)
      keep_scanning: true                  // the camera keeps reading inside the world — scan/hop worlds
      entering_label: "Entered"
      leave_action: "Leave world"
      demo_world_url: "holoscript://world/hololand"
    }
  }

  // Welcome / how-to-use screen — trait: OnboardingTrait.
  object "welcome" {
    @onboarding {
      title: "Universal QR Scanner"
      tagline: "Read any QR code — right in mixed reality"
      how_to_use: [
        { context: "At your computer", icon: "monitor", text: "Look at a QR on your screen — the scanner reads it straight through passthrough." },
        { context: "On the go", icon: "world", text: "Out in the world? Just look at any QR — posters, products, signs, menus." },
        { context: "From a phone", icon: "phone", text: "Show a QR on another phone or screen and look at it." },
        { context: "Into a world", icon: "portal", text: "Scan a HoloScript world QR to step inside it — then keep scanning to hop worlds." }
      ]
      aim_tip: "Center the QR in your view, about an arm's length away, and hold steady for a moment."
      start_action: "Start scanning"
      tutorial_action: "See how it works"
    }
  }

  // Guided tutorial with an on-device mock QR — trait: TutorialTrait.
  object "how_it_works" {
    @tutorial {
      heading: "How it works"
      mock_qr: { demo_url: "https://holoscript.studio", caption: "A QR code looks like this", display_dp: 180 }
      steps: [
        "Look at any QR code in your space — no buttons, it reads automatically.",
        "When it reads, a card appears with the link.",
        "Tap Open to launch it in the Quest browser.",
        "Scan a HoloScript world QR to step inside it — your room fades and you're in the world, still scanning."
      ]
      result_preview: { label: "QR found", sample: "https://holoscript.studio", open_action: "Open in browser" }
      start_action: "Start scanning"
    }
  }
}
