# Copy to keystore.properties (gitignored) for LOCAL signed builds, OR set the matching
# env vars (KEYSTORE_FILE / KEYSTORE_PASSWORD / KEY_ALIAS / KEY_PASSWORD) in CI.
#
# Generate a keystore once (keep it safe — it is your app identity on the store):
#   keytool -genkeypair -v -keystore release.keystore -alias quest_qr \
#           -keyalg RSA -keysize 2048 -validity 10000
#
# NEVER commit the real keystore.properties or the .keystore file (see .gitignore).
storeFile=release.keystore
storePassword=CHANGE_ME
keyAlias=quest_qr
keyPassword=CHANGE_ME
