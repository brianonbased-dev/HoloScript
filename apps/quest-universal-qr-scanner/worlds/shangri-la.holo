// Shangri-La — a HoloScript world with REAL sovereign-generated geometry AND a living grove.
//
// The hero structures (temple, gate, cliffs, lotus, holo_spire) and ALL vegetation (pines,
// broadleaf trees, grass-patch beds, rock clusters, bushes) are watertight triangle meshes generated
// by the sovereign SDF/CSG marching-cubes path (Simulation.marchingCubes, no API key, $0), exported to
// GLB by GLTFPipeline.addSurfaceMesh, and bundled under android-mr/.../assets/models/. They load
// through the `model:` slot (Mesh(apk:///models/<name>.glb)) — Meta Spatial SDK loads glb directly.
//
// DENSITY is baked into each GLB, not spawned per-object: one grass_patch.glb is ~80 blades in a
// single mesh = one draw call (SDF `repeat` domain op). On Quest there is no instancing yet, so we
// lean on a few dense baked GLBs to get apparent quantity while staying well under the ~200 draw-call /
// 500 mesh-instance budget. Object count here is ~60, each a single Mesh — comfortably inside budget.
//
// Regenerate the meshes with `npx tsx gen-world-meshes.mts`. The glowing accents (lanterns, spirit
// orbs, guardian, Brittney) stay primitives with motion traits so the scene is alive; trees `sway`.
// Authored natively; compiled to Meta by the quest target. Walk it with thumbstick locomotion.

composition "ShangriLa" {
  environment {
    backgroundColor: "#0c2a33"   // serene twilight-teal sky
    ambient_light: 0.6
  }

  // ── Ground ───────────────────────────────────────────────────────────────
  object "GroundBase" { geometry: "plane" position: [0, 0, 0] scale: [70, 70, 1] color: "#12313a" }
  object "Terrace"    { geometry: "box"   position: [0, 0.2, 12] scale: [20, 0.4, 20] color: "#163b40" }

  // ── Hero sculpted geometry (sovereign SDF -> GLB) ────────────────────────
  object "Temple"   { model: "temple.glb" position: [0, 0.4, 13] }
  object "GateMain" { model: "gate.glb"   position: [0, 0, 5] }
  object "CliffL"   { model: "cliff.glb"  position: [-7.5, 0, 13] }
  object "CliffR"   { model: "cliff.glb"  position: [7.5, 0, 15] }
  object "CliffBack"{ model: "cliff.glb"  position: [-2.5, 0, 20] }
  object "LotusA"   { model: "lotus.glb"  position: [-3.4, 0.45, 8] motion: "bob" speed: 0.9 amplitude: 0.07 }
  object "LotusB"   { model: "lotus.glb"  position: [3.4, 0.45, 9.5] motion: "bob" speed: 0.7 amplitude: 0.09 }

  // ── Model-generated landmark (the LLM authored the SDFNode) ───────────────
  // holo_spire.glb: text prompt "a torus joined with a cone" -> holo-sdf:v0 on the Jetson ->
  // SDFNode -> marchingCubes -> GLB. First geometry in a world authored by the sovereign model, not
  // by hand. Regenerate: npx tsx gen-landmark-from-holosdf.mts.
  object "HoloSpire" { model: "holo_spire.glb" position: [0, 0.9, 7] motion: "bob" speed: 0.5 amplitude: 0.08 }

  // ── Pine grove — conifers framing the temple & climbing toward the cliffs ──
  // Three pine variants (pine ~4m, pine2 ~3m fir, pine3 ~2m sapling) clustered for natural variety.
  // Tall pines sway gently. base sits on y=0.4 (the terrace lift).
  object "PineL1"  { model: "pine.glb"   position: [-9.5, 0.4, 9]  motion: "sway" speed: 0.5 amplitude: 0.04 }
  object "PineL2"  { model: "pine2.glb"  position: [-11, 0.4, 13]  motion: "sway" speed: 0.6 amplitude: 0.05 }
  object "PineL3"  { model: "pine.glb"   position: [-10, 0.4, 17]  motion: "sway" speed: 0.45 amplitude: 0.04 }
  object "PineL4"  { model: "pine3.glb"  position: [-8, 0.4, 11] }
  object "PineL5"  { model: "pine3.glb"  position: [-12, 0.4, 16] }
  object "PineR1"  { model: "pine.glb"   position: [9.5, 0.4, 10]  motion: "sway" speed: 0.55 amplitude: 0.04 }
  object "PineR2"  { model: "pine2.glb"  position: [11, 0.4, 14]   motion: "sway" speed: 0.5 amplitude: 0.05 }
  object "PineR3"  { model: "pine.glb"   position: [10.5, 0.4, 18] motion: "sway" speed: 0.48 amplitude: 0.04 }
  object "PineR4"  { model: "pine3.glb"  position: [8.5, 0.4, 12] }
  object "PineR5"  { model: "pine3.glb"  position: [12, 0.4, 17] }
  object "PineB1"  { model: "pine2.glb"  position: [-4.5, 0.4, 22] motion: "sway" speed: 0.5 amplitude: 0.05 }
  object "PineB2"  { model: "pine.glb"   position: [2, 0.4, 23]    motion: "sway" speed: 0.46 amplitude: 0.04 }
  object "PineB3"  { model: "pine3.glb"  position: [5, 0.4, 21] }

  // ── Broadleaf shade trees — rounded canopies anchoring the entry & corners ──
  object "OakL1"   { model: "broadleaf.glb"  position: [-6, 0.4, 6]  motion: "sway" speed: 0.4 amplitude: 0.05 }
  object "OakL2"   { model: "broadleaf2.glb" position: [-13, 0.4, 10] motion: "sway" speed: 0.35 amplitude: 0.06 }
  object "OakR1"   { model: "broadleaf.glb"  position: [6, 0.4, 6.5] motion: "sway" speed: 0.42 amplitude: 0.05 }
  object "OakR2"   { model: "broadleaf2.glb" position: [13, 0.4, 11] motion: "sway" speed: 0.36 amplitude: 0.06 }
  object "OakFront"{ model: "broadleaf.glb"  position: [-3.5, 0.4, 2] motion: "sway" speed: 0.4 amplitude: 0.05 }
  object "OakBack" { model: "broadleaf2.glb" position: [-1, 0.4, 24]  motion: "sway" speed: 0.33 amplitude: 0.06 }

  // ── Grass beds — dense baked tufts carpeting the walkable terrace & approach ──
  // Each grass_patch.glb is ~80 blades in ONE mesh; ~10 patches cover the ~20x20m terrace + the
  // path up to the gate. grass_patch2 = taller wild grass for texture variation.
  object "GrassA" { model: "grass_patch.glb"  position: [-4, 0.4, 5] }
  object "GrassB" { model: "grass_patch.glb"  position: [-1, 0.4, 7] }
  object "GrassC" { model: "grass_patch2.glb" position: [2.5, 0.4, 6] }
  object "GrassD" { model: "grass_patch.glb"  position: [4.5, 0.4, 9] }
  object "GrassE" { model: "grass_patch2.glb" position: [-4.5, 0.4, 11] }
  object "GrassF" { model: "grass_patch.glb"  position: [0, 0.4, 11] }
  object "GrassG" { model: "grass_patch.glb"  position: [4, 0.4, 13] }
  object "GrassH" { model: "grass_patch2.glb" position: [-3, 0.4, 16] }
  object "GrassI" { model: "grass_patch.glb"  position: [2.5, 0.4, 17] }
  object "GrassJ" { model: "grass_patch.glb"  position: [-1, 0.4, 3] }
  object "GrassK" { model: "grass_patch2.glb" position: [6, 0.4, 4] }
  object "GrassL" { model: "grass_patch.glb"  position: [-6.5, 0.4, 4] }

  // ── Rock clusters & bushes — ground detail scattered through the grove ─────
  object "RockA"  { model: "rock_cluster.glb" position: [-5.5, 0.4, 9] }
  object "RockB"  { model: "rock_cluster.glb" position: [5.5, 0.4, 11] }
  object "RockC"  { model: "rock_cluster.glb" position: [-8.5, 0.4, 15] }
  object "RockD"  { model: "rock_cluster.glb" position: [7, 0.4, 7] }
  object "RockE"  { model: "rock_cluster.glb" position: [1.5, 0.4, 20] }
  object "BushA"  { model: "bush.glb" position: [-2.5, 0.4, 4] }
  object "BushB"  { model: "bush.glb" position: [3, 0.4, 4.5] }
  object "BushC"  { model: "bush.glb" position: [-6, 0.4, 12] }
  object "BushD"  { model: "bush.glb" position: [6.5, 0.4, 14] }
  object "BushE"  { model: "bush.glb" position: [-3.5, 0.4, 19] }
  object "BushF"  { model: "bush.glb" position: [4, 0.4, 19.5] }

  // ── Agent embodiment (the mind carries from the compute node) ─────────────
  // Brittney runs on the Jetson (wallet-keyed identity + memory). The `agent:` key marks this object
  // her body in the world — the same agent, embodied in the headset. The memory-carry slice binds her
  // private:<wallet> memory to this presence so she arrives with her mind, not just a body.
  object "Brittney" { agent: "brittney" geometry: "sphere" position: [-1.8, 1.4, 6] scale: [0.5, 0.5, 0.5] color: "#ffd39a" glow: true motion: "float" speed: 1.0 amplitude: 0.25 }

  // ── Orbiting guardian (character action) ─────────────────────────────────
  object "Guardian" { geometry: "sphere" position: [6, 3.4, 13] scale: [0.7, 0.7, 0.7] color: "#7fe7ff" glow: true motion: "orbit" orbit_center: [0, 3.4, 13] radius: 6.5 speed: 0.45 }

  // ── Floating lanterns (bob + glow) ───────────────────────────────────────
  object "LanternA" { geometry: "box" position: [-2.4, 2.6, 6] scale: [0.4, 0.5, 0.4] color: "#ff9d5c" glow: true motion: "bob" speed: 1.6 amplitude: 0.22 }
  object "LanternB" { geometry: "box" position: [2.4, 3.0, 6.5] scale: [0.4, 0.5, 0.4] color: "#ffb06b" glow: true motion: "bob" speed: 1.3 amplitude: 0.28 }
  object "LanternC" { geometry: "box" position: [-1.4, 3.4, 9.5] scale: [0.35, 0.45, 0.35] color: "#ffc27d" glow: true motion: "bob" speed: 1.9 amplitude: 0.2 }

  // ── Drifting spirit orbs (float + glow) ──────────────────────────────────
  object "SpiritA" { geometry: "sphere" position: [-5, 2.4, 9] scale: [0.4, 0.4, 0.4] color: "#9affd0" glow: true motion: "float" speed: 1.2 amplitude: 0.35 }
  object "SpiritB" { geometry: "sphere" position: [5, 2.8, 10] scale: [0.4, 0.4, 0.4] color: "#7fe7ff" glow: true motion: "float" speed: 1.0 amplitude: 0.4 }
  object "SpiritC" { geometry: "sphere" position: [0, 3.0, 4] scale: [0.45, 0.45, 0.45] color: "#c9b3ff" glow: true motion: "float" speed: 0.9 amplitude: 0.3 }
}
