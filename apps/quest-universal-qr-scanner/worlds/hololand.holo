// HoloLand — a HoloScript world, authored natively in HoloScript's own scene vocabulary.
//
// This is NOT a bundled glb or a procedural hash: it is a real `.holo` composition (the same object/
// geometry/position/color grammar every HoloScript 3D target consumes — see BabylonCompiler), and the
// `quest` compile target walks it into Meta Spatial SDK entities (geometry → mesh://*, color →
// Material(Color4), position/rotation/scale → Transform). Scan the world's QR (holoscript://world/hololand)
// in the Universal QR Scanner and you step inside THIS composition, compiled to Meta.

composition "HoloLand" {
  environment {
    backgroundColor: "#0a1730"   // themed skybox surround
    ambient_light: 0.6
  }

  // Floor.
  object "Ground" {
    geometry: "plane"
    position: [0, 0, 0]
    scale: [44, 44, 1]
    color: "#0e2442"
  }

  // Central monument: a lit pillar crowned with a glowing orb, dead ahead.
  object "Monument" {
    geometry: "box"
    position: [0, 1.7, 6]
    scale: [1.3, 3.4, 1.3]
    color: "#1d4ed8"
  }
  object "MonumentOrb" {
    geometry: "sphere"
    position: [0, 3.9, 6]
    scale: [1.3, 1.3, 1.3]
    color: "#38bdf8"
  }

  // A ring of pillars around the visitor.
  object "PillarNW" {
    geometry: "box"
    position: [-5, 1.1, -5]
    scale: [0.7, 2.2, 0.7]
    color: "#2563eb"
  }
  object "PillarNE" {
    geometry: "box"
    position: [5, 1.1, -5]
    scale: [0.7, 2.2, 0.7]
    color: "#2563eb"
  }
  object "PillarW" {
    geometry: "box"
    position: [-6.5, 1.4, 1.5]
    scale: [0.7, 2.8, 0.7]
    color: "#3b82f6"
  }
  object "PillarE" {
    geometry: "box"
    position: [6.5, 1.4, 1.5]
    scale: [0.7, 2.8, 0.7]
    color: "#3b82f6"
  }

  // Floating accent orbs for color + parallax.
  object "OrbTeal" {
    geometry: "sphere"
    position: [-3.4, 1.6, 3.2]
    scale: [0.8, 0.8, 0.8]
    color: "#34d399"
  }
  object "OrbPink" {
    geometry: "sphere"
    position: [3.4, 1.9, 3.2]
    scale: [0.7, 0.7, 0.7]
    color: "#f472b6"
  }
  object "OrbAmber" {
    geometry: "sphere"
    position: [0, 2.4, -4.5]
    scale: [0.9, 0.9, 0.9]
    color: "#fbbf24"
  }
}
