{
  "schema": "holoscript.package-consumption-matrix/v1",
  "_comment": "Packages consumed by the owned laptop, Jetson, and Vast fleet lanes. The check script validates packaging metadata, platform compatibility, npm pack contents, and PyPI build artifacts. The published consumption bar also requires live registry cold-start probes for core, cli, and mcp-server; metadata-only is not a pass.",
  "consumers": [
    {
      "id": "laptop-windows",
      "label": "Founder laptop / HoloShell",
      "os": "win32",
      "cpu": "x64",
      "node": ">=20.0.0",
      "python": ">=3.10"
    },
    {
      "id": "jetson-orin",
      "label": "Jetson owned-metal lane",
      "os": "linux",
      "cpu": "arm64",
      "node": ">=20.0.0",
      "python": ">=3.10"
    },
    {
      "id": "vast-linux-gpu",
      "label": "Vast.ai Linux GPU fleet",
      "os": "linux",
      "cpu": "x64",
      "node": ">=20.0.0",
      "python": ">=3.10"
    }
  ],
  "npmPackages": [
    {
      "name": "@holoscript/core",
      "packageDir": "packages/core",
      "requiredBy": ["laptop-windows", "jetson-orin", "vast-linux-gpu"],
      "requireFiles": ["dist/index.js", "dist/index.cjs", "dist/index.d.ts"],
      "forbidInternalPeerDependencies": true,
      "forbidBundledNativeAddons": true
    },
    {
      "name": "@holoscript/cli",
      "packageDir": "packages/cli",
      "requiredBy": ["laptop-windows", "jetson-orin", "vast-linux-gpu"],
      "requireBins": ["holo", "holoscript", "hs"],
      "requireFiles": ["bin/holoscript.cjs", "dist/index.js"],
      "forbidBundledNativeAddons": true
    },
    {
      "name": "@holoscript/formatter",
      "packageDir": "packages/formatter",
      "requiredBy": ["laptop-windows", "jetson-orin", "vast-linux-gpu"],
      "requireBins": ["holoscript-format"],
      "requireFiles": [
        "bin/holoscript-format.cjs",
        "dist/index.js",
        "dist/cli.js",
        "dist/index.d.ts"
      ],
      "forbidBundledNativeAddons": true
    },
    {
      "name": "@holoscript/mcp-server",
      "packageDir": "packages/mcp-server",
      "requiredBy": ["laptop-windows", "jetson-orin", "vast-linux-gpu"],
      "requireBins": ["holoscript-mcp", "holoscript-mcp-http", "holoscript-mcp-cli"],
      "requireFiles": [
        "bin/holoscript-mcp-http.cjs",
        "dist/http-server.js",
        "dist/index.js",
        "dist/index.d.ts",
        "dist/server-sizing.js",
        "dist/server-sizing.mjs",
        "dist/server-sizing.d.ts"
      ],
      "forbidBundledNativeAddons": true
    },
    {
      "name": "@holoscript/memory",
      "packageDir": "packages/memory",
      "requiredBy": ["laptop-windows", "jetson-orin", "vast-linux-gpu"],
      "requireBins": ["holoscript-memory"],
      "requireFiles": [
        "dist/index.js",
        "dist/index.cjs",
        "dist/index.d.ts",
        "dist/cli.js"
      ],
      "forbidBundledNativeAddons": true
    },
    {
      "name": "@holoscript/agent-runtime",
      "packageDir": "packages/agent-runtime",
      "requiredBy": ["laptop-windows", "jetson-orin", "vast-linux-gpu"],
      "requireFiles": [
        "src/index.mjs",
        "src/second-brain-runtime.mjs",
        "README.md"
      ],
      "forbidBundledNativeAddons": true
    },
    {
      "name": "@holoscript/holollama",
      "packageDir": "packages/holollama",
      "requiredBy": ["laptop-windows", "jetson-orin", "vast-linux-gpu"],
      "requireBins": ["holollama"],
      "requireFiles": [
        "bin/holollama.cjs",
        "dist/index.js",
        "dist/index.cjs",
        "dist/index.d.ts",
        "dist/brain.js",
        "dist/brain.cjs",
        "dist/brain.d.ts",
        "dist/cli.js",
        "templates/ai-ecosystem-basic/AGENTS.md",
        "templates/ai-ecosystem-basic/.env.example",
        "templates/ai-ecosystem-basic/holollama.harness.json"
      ],
      "forbidBundledNativeAddons": true,
      "fleetLifecycle": {
        "receiptScope": "Fresh HoloLlama registry harness proof plus live-service lifecycle receipts for owned Jetson and configured Vast endpoints; static plan/preflight receipts alone do not prove a serving node.",
        "staleTelemetryPolicy": "Every live-service receipt must come from the current run or a freshly installed @holoscript/holollama package; do not close fleet-serving work from historical model logs.",
        "checks": [
          {
            "id": "published-harness-cold-start",
            "description": "Install @holoscript/holollama@latest into a repo-less consumer and run the public .ai-ecosystem harness installer.",
            "evidence": "check-registry-cold-start --probe holollama-harness passes and verifies harness files, receipt files, and no founder path or key leakage.",
            "command": "node scripts/holo-ci/check-registry-cold-start.mjs --package @holoscript/holollama@latest --probe holollama-harness --json",
            "consumerLanes": ["laptop-windows", "jetson-orin", "vast-linux-gpu"]
          },
          {
            "id": "jetson-live-lifecycle",
            "description": "Probe the owned Jetson HoloLlama endpoint and promote the live HoloLlama lifecycle receipt into the fleet lifecycle report.",
            "evidence": "check-holollama-live-fleet writes jetson-orin/live-lifecycle.json and jetson-orin/fleet-lifecycle.json with live-lifecycle ok.",
            "command": "node scripts/holo-ci/check-holollama-live-fleet.mjs --profiles jetson-orin --require-profile jetson-orin --out .scratch/holollama-live-fleet --json",
            "consumerLanes": ["jetson-orin"]
          },
          {
            "id": "vast-live-lifecycle",
            "description": "Probe the configured Vast HoloLlama endpoint and promote the live HoloLlama lifecycle receipt into the fleet lifecycle report.",
            "evidence": "Set HOLOLLAMA_VAST_ENDPOINT or VAST_HOLOLLAMA_ENDPOINT, then require vast-linux-gpu in check-holollama-live-fleet and verify live-lifecycle ok.",
            "command": "node scripts/holo-ci/check-holollama-live-fleet.mjs --profiles vast-linux-gpu --require-profile vast-linux-gpu --out .scratch/holollama-live-fleet --json",
            "consumerLanes": ["vast-linux-gpu"]
          }
        ]
      }
    },
    {
      "name": "@holoscript/uaal",
      "packageDir": "packages/uaal",
      "requiredBy": ["laptop-windows", "jetson-orin", "vast-linux-gpu"],
      "requireFiles": [
        "dist/index.js",
        "dist/index.cjs",
        "dist/index.d.ts",
        "dist/gate.js",
        "dist/gate.cjs",
        "dist/gate.d.ts",
        "dist/semantic.js",
        "dist/semantic.cjs",
        "dist/semantic.d.ts"
      ],
      "forbidBundledNativeAddons": true
    },
    {
      "name": "@holoscript/holoscript-agent",
      "packageDir": "packages/holoscript-agent",
      "requiredBy": ["laptop-windows", "jetson-orin", "vast-linux-gpu"],
      "requireBins": ["holoscript-agent"],
      "requireFiles": ["bin/holoscript-agent.cjs", "dist/index.js", "dist/index.d.ts"],
      "forbidBundledNativeAddons": true
    },
    {
      "name": "@holoscript/xr-embodiment",
      "packageDir": "packages/xr-embodiment",
      "requiredBy": ["laptop-windows", "jetson-orin", "vast-linux-gpu"],
      "requireFiles": ["dist/index.js", "dist/index.cjs", "dist/index.d.ts"],
      "forbidBundledNativeAddons": true
    },
    {
      "name": "@holoscript/engine",
      "packageDir": "packages/engine",
      "requiredBy": ["laptop-windows", "jetson-orin", "vast-linux-gpu"],
      "requireFiles": [
        "dist/index.js",
        "dist/index.cjs",
        "dist/index.d.ts",
        "dist/runtime/index.js",
        "dist/physics/index.js"
      ],
      "forbidBundledNativeAddons": true
    },
    {
      "name": "@holoscript/framework",
      "packageDir": "packages/framework",
      "requiredBy": ["laptop-windows", "jetson-orin", "vast-linux-gpu"],
      "requireFiles": [
        "dist/index.js",
        "dist/index.cjs",
        "dist/index.d.ts",
        "dist/board/index.js",
        "dist/agents/index.js"
      ],
      "forbidBundledNativeAddons": true
    },
    {
      "name": "@holoscript/absorb-service",
      "packageDir": "packages/absorb-service",
      "requiredBy": ["laptop-windows", "vast-linux-gpu"],
      "forbidDependencies": ["peerDependencies:@holoscript/core"],
      "requireFiles": [
        "dist/index.js",
        "dist/index.cjs",
        "dist/index.d.ts",
        "dist/engine/index.js",
        "dist/schema.js"
      ],
      "forbidBundledNativeAddons": true
    },
    {
      "name": "@holoscript/platform",
      "packageDir": "packages/platform",
      "requiredBy": ["laptop-windows", "jetson-orin", "vast-linux-gpu"],
      "requireFiles": ["dist/index.js", "dist/index.cjs", "dist/index.d.ts"],
      "forbidDependencies": ["@holoscript/core"],
      "forbidInternalPeerDependencies": true,
      "forbidBundledNativeAddons": true
    }
  ],
  "candidateNpmPackages": [
    {
      "name": "@holoscript/domain-plugin-template",
      "packageDir": "packages/plugins/domain-plugin-template",
      "requiredBy": ["laptop-windows", "jetson-orin", "vast-linux-gpu"],
      "requireFiles": ["dist/index.js", "dist/index.mjs", "dist/index.d.ts"],
      "forbidBundledNativeAddons": true
    },
    {
      "name": "@holoscript/agent-protocol",
      "packageDir": "packages/agent-protocol",
      "requiredBy": ["laptop-windows", "jetson-orin", "vast-linux-gpu"],
      "requireFiles": ["dist/index.js", "dist/index.cjs", "dist/index.d.ts"],
      "forbidBundledNativeAddons": true
    },
    {
      "name": "@holoscript/llm-provider",
      "packageDir": "packages/llm-provider",
      "requiredBy": ["laptop-windows", "jetson-orin", "vast-linux-gpu"],
      "requireFiles": [
        "dist/index.js",
        "dist/index.cjs",
        "dist/index.d.ts",
        "dist/adapters/openai.js",
        "dist/adapters/anthropic.js"
      ],
      "forbidBundledNativeAddons": true
    },
    {
      "name": "@holoscript/snn-webgpu",
      "packageDir": "packages/snn-webgpu",
      "requiredBy": ["laptop-windows", "jetson-orin", "vast-linux-gpu"],
      "requireFiles": ["dist/index.js", "dist/index.cjs", "dist/index.d.ts"],
      "forbidBundledNativeAddons": true
    },
    {
      "name": "@holoscript/holoembed",
      "packageDir": "packages/holoembed",
      "requiredBy": ["laptop-windows", "jetson-orin", "vast-linux-gpu"],
      "requireFiles": ["dist/index.js", "dist/index.cjs", "dist/index.d.ts"],
      "forbidBundledNativeAddons": true
    }
  ],
  "pypiPackages": [
    {
      "name": "holoscript",
      "packageDir": "packages/python-bindings",
      "requiredBy": ["laptop-windows", "jetson-orin", "vast-linux-gpu"],
      "imports": ["holoscript"],
      "extrasByConsumer": {
        "laptop-windows": ["scientific"],
        "jetson-orin": ["robotics", "scientific"],
        "vast-linux-gpu": ["scientific"]
      },
      "fleetLifecycle": {
        "receiptScope": "Fresh Python build artifacts, fresh virtualenv install smokes, live PyPI metadata, and pip resolver reports; no hardware utilization is claimed from historical logs.",
        "staleTelemetryPolicy": "Every PyPI lifecycle receipt must come from the current run or a live registry response; do not close fleet package work from cached install logs.",
        "checks": [
          {
            "id": "wheel-sdist-build",
            "description": "Build wheel and sdist artifacts from packages/python-bindings.",
            "evidence": "python -m build output names the wheel and sdist.",
            "requiredFlags": ["build-python"],
            "consumerLanes": ["laptop-windows", "jetson-orin", "vast-linux-gpu"]
          },
          {
            "id": "artifact-shape-inspection",
            "description": "Inspect wheel and sdist metadata, imports, and declared extras.",
            "evidence": "artifact inspection verifies METADATA/WHEEL, pyproject, README, imports, and Provides-Extra fields.",
            "requiredFlags": ["inspect-python-artifacts"],
            "consumerLanes": ["laptop-windows", "jetson-orin", "vast-linux-gpu"]
          },
          {
            "id": "fresh-venv-artifact-smoke",
            "description": "Install the built wheel into a fresh venv and import holoscript.",
            "evidence": "fresh virtualenv import smoke passes for the built wheel.",
            "requiredFlags": ["smoke-python-artifacts"],
            "consumerLanes": ["laptop-windows", "jetson-orin", "vast-linux-gpu"]
          },
          {
            "id": "live-pypi-version-audit",
            "description": "Compare local version and extras against live PyPI metadata.",
            "evidence": "PyPI JSON audit reports current or publish-update status and verifies provides_extra.",
            "requiredFlags": ["audit-pypi"],
            "consumerLanes": ["laptop-windows", "jetson-orin", "vast-linux-gpu"]
          },
          {
            "id": "lane-extra-resolution",
            "description": "Resolve lane extras for Windows laptop, Jetson aarch64, and Vast Linux GPU without installing.",
            "evidence": "pip dry-run reports resolve scientific and robotics extras for declared fleet lanes.",
            "requiredFlags": ["resolve-pypi-extras"],
            "consumerLanes": ["laptop-windows", "jetson-orin", "vast-linux-gpu"]
          },
          {
            "id": "published-wheel-smoke",
            "description": "Install the published PyPI wheel into a fresh venv and import holoscript.",
            "evidence": "fresh virtualenv install smoke passes from PyPI using only published wheels.",
            "requiredFlags": ["smoke-pypi-install"],
            "consumerLanes": ["laptop-windows", "jetson-orin", "vast-linux-gpu"]
          }
        ]
      }
    },
    {
      "name": "holoscript-trait-inference",
      "packageDir": "packages/trait-inference",
      "requiredBy": ["laptop-windows", "vast-linux-gpu"],
      "imports": ["trait_inference"],
      "consoleScripts": ["trait-inference"],
      "extrasByConsumer": {
        "vast-linux-gpu": ["model"]
      },
      "fleetLifecycle": {
        "receiptScope": "Fresh Python build artifacts, fresh virtualenv install smokes, live PyPI metadata, and pip resolver reports; GPU/model capability is scoped to Vast via the optional model extra.",
        "staleTelemetryPolicy": "Every trait-inference lifecycle receipt must come from the current run or a live registry response; stale model or install logs do not prove package consumption.",
        "checks": [
          {
            "id": "wheel-sdist-build",
            "description": "Build wheel and sdist artifacts from packages/trait-inference.",
            "evidence": "python -m build output names the wheel and sdist.",
            "requiredFlags": ["build-python"],
            "consumerLanes": ["laptop-windows", "vast-linux-gpu"]
          },
          {
            "id": "artifact-shape-inspection",
            "description": "Inspect wheel and sdist metadata, imports, console script, and declared extras.",
            "evidence": "artifact inspection verifies METADATA/WHEEL, pyproject, README, trait_inference import, console script, and Provides-Extra fields.",
            "requiredFlags": ["inspect-python-artifacts"],
            "consumerLanes": ["laptop-windows", "vast-linux-gpu"]
          },
          {
            "id": "fresh-venv-artifact-smoke",
            "description": "Install the built wheel into a fresh venv, import trait_inference, and run trait-inference --help.",
            "evidence": "fresh virtualenv import and console script smoke pass for the built wheel.",
            "requiredFlags": ["smoke-python-artifacts"],
            "consumerLanes": ["laptop-windows", "vast-linux-gpu"]
          },
          {
            "id": "live-pypi-version-audit",
            "description": "Compare local version and extras against live PyPI metadata.",
            "evidence": "PyPI JSON audit reports current or publish-update status and verifies provides_extra.",
            "requiredFlags": ["audit-pypi"],
            "consumerLanes": ["laptop-windows", "vast-linux-gpu"]
          },
          {
            "id": "vast-model-extra-resolution",
            "description": "Resolve the Vast GPU model extra without installing heavyweight dependencies.",
            "evidence": "pip dry-run report resolves holoscript-trait-inference[model] for the Vast Linux GPU lane.",
            "requiredFlags": ["resolve-pypi-extras"],
            "consumerLanes": ["vast-linux-gpu"]
          },
          {
            "id": "published-wheel-smoke",
            "description": "Install the published PyPI wheel into a fresh venv, import trait_inference, and run trait-inference --help.",
            "evidence": "fresh virtualenv install smoke passes from PyPI using only published wheels.",
            "requiredFlags": ["smoke-pypi-install"],
            "consumerLanes": ["laptop-windows", "vast-linux-gpu"]
          }
        ]
      }
    }
  ]
}
