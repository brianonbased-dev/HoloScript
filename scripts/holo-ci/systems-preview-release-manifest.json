  "installContract": {
    "availability": "published",
    "primaryCommand": "npm install --global @holoscript/systems@0.1.0",
    "expectedBins": ["holoscript", "hs", "holoscriptc"],
    "coldConsumerRequirements": [
      "No HoloScript repository clone.",
      "No founder-local path, GOLD vault, private .env file, or HoloScript service credential.",
      "Node.js 20 or later and a supported win32-x64 host for the first native binary.",
      "Network access only for installation; local parse, validate, and compile remain offline-capable after installation."
    ]
