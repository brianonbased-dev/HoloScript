  "compatibilityPolicy": {
    "semverStage": "0.x-preview",
    "minorReleaseRule": "A 0.x minor release may make breaking language, CLI, manifest, or ABI changes only with migration notes and an explicit changed-boundary list.",
    "patchReleaseRule": "A patch release must not intentionally break a documented supported surface.",
    "deprecationRule": "When safety permits, retain deprecated behavior for at least one preview minor release; unsafe behavior may be removed immediately with a security migration note.",
    "machineContractRule": "An hs-machine-vN successor never changes the public distribution version by itself.",
    "componentPinRule": "Changing any required component pin or artifact content requires a new distribution version and fresh parity receipts."
  },
  "supportContract": {
    "ownerId": "holoscript-language-toolchain",
    "supportChannel": "https://github.com/brianonbased-dev/HoloScript/issues",
    "serviceLevel": "best-effort preview; no uptime or response-time SLA",
    "supported": [
      "Reproducing documented install, parse, validate, and compile failures on the declared host and pinned artifacts.",
      "Security reports, deterministic artifact mismatches, and fail-closed compiler regressions."
    ],
    "unsupported": [
      "Undeclared host targets, private plugins, founder-local services, and compatibility with unpinned component versions.",
      "Stable-API, production-readiness, or drop-in replacement guarantees."
    ]
  },
  "rollbackContract": {
    "npm": "Never overwrite or reuse a published version. Move the preview dist-tag to the last verified release; if 0.1.0 is the first and is defective, remove the preview tag and publish the correction as 0.1.1 or later.",
    "nativeArtifacts": "Retain immutable checksums, mark a defective artifact withdrawn, and restore the last verified artifact link. If no prior preview exists, withhold the install link until a corrected version is available.",
    "services": "Rollback hosted companions independently to their prior deployment. Service loss cannot invalidate the offline compiler artifact or require a distribution-version rewrite.",
    "source": "Revert the faulty source commit through a normal commit, preserve the failed receipt, and publish migration or recovery notes with the corrected candidate."
  },
  "securityContract": {
    "credentialBoundary": "Local install, parse, validate, and compile require no HoloScript credential. Hosted companion credentials are caller-owned and never bundled.",
    "requiredArtifactChecks": [
      "Inspect npm pack contents and native archive contents against explicit allowlists.",
      "Scan packed artifacts for secrets, wallet material, private paths, auth caches, and source maps not intended for consumers.",
      "Run HS010 lexical-firewall and fail-closed native diagnostics on the exact candidate artifacts.",
      "Record SHA-256 digests for every immutable distribution artifact."
    ]
  },
