      "coldProbe": "Import the bundled WASM parser/type-checker and run the declared conformance corpus."
    },
    {
      "id": "hosted-mcp",
      "rail": "railway",
      "class": "optional-companion",
      "required": false,
      "identity": "https://mcp.holoscript.net",
      "componentIdentity": "@holoscript/mcp-server",
      "baselineObservedVersion": "8.0.14",
      "versionMode": "independent-compatible-component",
      "requiredForLocalCompile": false,
      "compatibilityProbe": "GET https://mcp.holoscript.net/health and compile the release example through the declared public tool surface."
    },
    {
      "id": "hosted-absorb",
      "rail": "railway",
      "class": "optional-companion",
      "required": false,
