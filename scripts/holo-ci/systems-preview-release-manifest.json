      "baselineObservedVersion": "6.1.1",
      "versionMode": "independent-compatible-component",
      "requiredForLocalCompile": false,
      "compatibilityProbe": "GET https://absorb.holoscript.net/health and run a bounded sourceFiles Absorb probe."
    },
