      "requiredContents": ["holoscriptc.exe", "conformance/*.hs", "release-manifest.json", "SHA256SUMS", "LICENSE"],
      "coldProbe": "holoscriptc examples/native/conditional-borrow-summary-exit-five.hs -o proof.exe; proof.exe exits 5"
    },
    {
      "id": "wasm-portable-runtime",
      "rail": "npm-bundled-artifact",
      "class": "distribution",
      "required": true,
