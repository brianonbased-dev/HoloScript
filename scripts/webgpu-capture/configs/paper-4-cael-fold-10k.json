{
  "paper": "paper-4-sandbox-usenix",
  "section": "7.8 (WebGPU determinism replay — cael-trace-fold-v1 over 10000 trace rows; production-scale CAEL chain)",
  "harness": "scripts/webgpu-capture/capture-bench.mjs",
  "kernel": {
    "wgsl_path": "scripts/webgpu-capture/cael-trace-fold-v1.wgsl",
    "entry_point": "main",
    "workgroup_size": [64, 1, 1],
    "dispatch_size": [157, 1, 1]
  },
  "buffers": [
    { "group": 0, "binding": 0, "name": "traceRows",  "size_bytes": 160000, "init": { "kind": "trace-rows-u32x4" }, "usage": ["storage", "copy_dst"] },
    { "group": 0, "binding": 1, "name": "finalState", "size_bytes": 32,     "init": "zeros",                       "usage": ["storage", "copy_dst", "copy_src"] },
    { "group": 0, "binding": 2, "name": "params",     "size_bytes": 16,     "init": { "kind": "uniform-u32-tuple", "values": [10000, 305419896, 0, 0] }, "usage": ["uniform", "copy_dst"] }
  ],
  "trials": 200,
  "warmup": 20
}
