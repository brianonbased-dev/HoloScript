    { "group": 2, "binding": 0, "name": "args",    "size_bytes": 16,    "init": { "kind": "uniform-u32-args", "num_rows": 10000, "vector_width": 1, "n": 10000, "alpha": 1.0 }, "usage": ["uniform", "copy_dst"] }
  ],
  "trials": 200,
  "warmup": 20
}
