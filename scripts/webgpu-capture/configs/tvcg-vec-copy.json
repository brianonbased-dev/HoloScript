{
  "paper": "trust-by-construction-paper",
  "section": "5.1 (vec_copy — dst = src on 10K-element vector)",
  "harness": "scripts/webgpu-capture/capture-bench.mjs",
  "kernel": {
    "wgsl_path": "packages/engine/src/gpu/shaders/cg_kernels.wgsl",
