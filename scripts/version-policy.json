{
  "defaultBehavior": "report-unmanaged",
  "rootVersionFile": "package.json",
  "lanes": [
    {
      "name": "platform-v8",
      "description": "Core platform packages on the 8.x release line (diverged from root 6.x line during architecture expansion)",
      "enforce": "major",
      "targetMajor": 8,
      "sync": true,
      "packages": [
        "@holoscript/agent-protocol",
        "@holoscript/cli",
        "@holoscript/core",
        "@holoscript/holo-vm",
        "@holoscript/mcp-server",
        "@holoscript/snn-webgpu",
        "@holoscript/uaal"
      ]
    },
    {
      "name": "platform-v6",
      "description": "Platform/runtime packages on the current 6.x release line",
      "enforce": "major",
      "targetMajor": 6,
      "sync": true,
      "packages": [
        "@holoscript/absorb-service",
        "@holoscript/absorb-service-host",
        "@holoscript/auth",
        "@holoscript/config",
        "@holoscript/core-types",
        "@holoscript/engine",
        "@holoscript/framework",
        "@holoscript/hololand-platform",
        "@holoscript/holoembed",
        "@holoscript/mesh",
        "@holoscript/platform",
        "@holoscript/r3f-renderer",
        "@holoscript/runtime",
        "@holoscript/sdk",
        "@holoscript/secrets-broker",
        "@holoscript/studio",
        "@holoscript/xr-embodiment"
      ]
    },
    {
      "name": "tooling-v7",
      "description": "Tooling packages that advanced to major 7 ahead of the 6.x root line",
      "enforce": "major",
      "targetMajor": 7,
      "packages": [
        "@holoscript/std"
      ]
    },
    {
      "name": "tooling-v6",
      "description": "Tooling and developer-facing support packages aligned with the current 6.x release line",
      "enforce": "major",
      "targetMajor": 6,
      "packages": [
        "@holoscript/benchmark",
        "@holoscript/formatter",
        "@holoscript/linter",
        "@holoscript/lsp",
        "@holoscript/partner-sdk",
        "@holoscript/registry",
        "@holoscript/visual",
        "@holoscript/wasm"
      ]
    },
    {
      "name": "services-v1",
      "description": "Service, connector, and app-surface packages on major 1",
      "enforce": "major",
      "targetMajor": 1,
      "packages": [
        "@holoscript/adapter-postgres",
        "@holoscript/ai-validator",
        "@holoscript/animation-presets",
        "@holoscript/cdn",
        "@holoscript/comparative-benchmarks",
        "@holoscript/connector-appstore",
        "@holoscript/connector-core",
        "@holoscript/connector-github",
        "@holoscript/connector-moltbook",
        "@holoscript/connector-railway",
        "@holoscript/connector-upstash",
        "@holoscript/connector-vscode",
        "@holoscript/crdt",
        "@holoscript/crdt-spatial",
        "@holoscript/export-api",
        "@holoscript/holomap",
        "@holoscript/holomesh-web",
        "@holoscript/llm-provider",
        "@holoscript/marketplace-agentkit",
        "@holoscript/marketplace-api",
        "@holoscript/marketplace-web",
        "@holoscript/mvc-schema",
        "@holoscript/net-service",
        "@holoscript/security-sandbox",
        "@holoscript/spatial-index",
        "@holoscript/studio-api",
        "@holoscript/studio-bridge",
        "@holoscript/studio-plugin-sdk",
        "brittney-service",
        "create-holoscript"
      ]
    },
    {
      "name": "infra-v4",
      "description": "Platform-adjacent packages on major 4",
      "enforce": "major",
      "targetMajor": 4,
      "packages": [
        "@holoscript/render-service",
        "holoscript-vscode"
      ]
    },
    {
      "name": "experimental-v0",
      "description": "Experimental and early-stage packages that remain pre-1.0",
      "enforce": "major",
      "targetMajor": 0,
      "packages": [
        "@hololand/react-agent-sdk",
        "@holoscript/agent-runtime",
        "@holoscript/aibrittney",
        "@holoscript/graphql-api",
        "@holoscript/hologram-worker",
        "@holoscript/holo-runtime",
        "@holoscript/holollama",
        "@holoscript/memory",
        "@holoscript/mcp-server-adversarial",
        "@holoscript/net-v2",
        "@holoscript/preview-component",
        "@holoscript/studio-ui-graph",
        "@holoscript/tauri-app",
        "@holoscript/ui",
        "@holoscript/video-tutorials"
      ]
    },
    {
      "name": "external-managed",
      "description": "Externally managed packages with explicit major guardrails",
      "enforce": "major",
      "targetMajor": 3,
      "packages": [
        "visualizer-client"
      ]
    },
    {
      "name": "language-bindings",
      "description": "Language integration packages with independent majors",
      "enforce": "major",
      "targetMajor": 2,
      "packages": [
        "tree-sitter-holoscript"
      ]
    },
    {
      "name": "agent-v2",
      "description": "Agent runtime packages on independent major 2",
      "enforce": "major",
      "targetMajor": 2,
      "packages": [
        "@holoscript/holoscript-agent"
      ]
    }
  ],
  "releaseLineMajor": 6,
  "releaseLineVersion": "6.1.0"
}
