{
  "name": "holoscript",
  "version": "6.1.3",
  "private": true,
  "description": "HoloScript - The open platform for spatial worlds",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "packages/plugins/*",
    "services/*",
    "benchmarks/*"
  ],
  "scripts": {
    "build": "node scripts/check-pnpm-install-needed.mjs && pnpm --filter @holoscript/core run build && pnpm -r --workspace-concurrency=1 --filter=!@holoscript/core --filter=!@holoscript/tauri-app run --if-present build",
    "build:parallel": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "test": "node scripts/run-root-tests.mjs",
    "test:coverage": "pnpm -r --filter=!holoscript test:coverage",
    "coverage:summary": "node scripts/scan-coverage-summaries.mjs",
    "coverage:summary:write": "node scripts/scan-coverage-summaries.mjs --write-central",
    "test:core": "pnpm --filter @holoscript/core test",
    "test:holomap": "pnpm --filter @holoscript/holomap test && pnpm --filter @holoscript/core exec vitest run src/reconstruction/__tests__",
    "provision:motion-model": "node scripts/provision-motion-model.mjs",
    "provision:motion-model:verify": "node scripts/provision-motion-model.mjs --verify",
    "holomap:status": "node scripts/check-ingest-path-status.mjs",
    "holomap:android-arcore-device-probe": "node scripts/android-arcore-depth-device-probe.mjs",
    "holomap:android-arcore-device-probe-test": "node scripts/__tests__/android-arcore-depth-device-probe.test.mjs",
    "holomap:android-arcore-depth-apk": "node scripts/android-arcore-depth-apk-runner.mjs",
    "holomap:android-arcore-depth-apk-test": "node scripts/__tests__/android-arcore-depth-apk-runner.test.mjs",
    "preflight": "node scripts/preflight.mjs",
    "preflight:full": "node scripts/preflight.mjs --full",
    "preflight:fix": "node scripts/preflight.mjs --fix",
    "validate:dockerfile": "node scripts/validate-dockerfile-build.mjs",
    "lint": "eslint packages/*/src/**/*.ts --max-warnings 2420",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bench": "pnpm --filter @holoscript/benchmark bench",
    "bench:ci": "pnpm --filter @holoscript/benchmark bench:ci",
    "bench:paper-rigorous": "node scripts/bench-paper-rigorous.mjs",
    "bench:perf-regression": "node scripts/perf-regression-check.mjs",
    "bench:perf-regression-update": "node scripts/perf-regression-check.mjs --update-baseline",
    "bench:perf-regression-test": "node scripts/__tests__/perf-regression-check.test.mjs",
    "holo-ci:docker-core-entries-test": "node scripts/__tests__/docker-core-entries-gate.test.mjs",
    "bench:paper26:section7": "node scripts/run-paper26-section7-harness.mjs",
    "bench:paper26:section7-test": "node scripts/__tests__/paper26-section7-harness.test.mjs",
    "holoshell:format-gauntlet": "node scripts/holoshell-format-gauntlet.mjs",
    "holoshell:format-gauntlet-test": "node scripts/__tests__/holoshell-format-gauntlet.test.mjs",
    "holoshell:local-reality-node": "node scripts/holoshell-local-reality-node.mjs",
    "holoshell:local-reality-node-test": "node scripts/__tests__/holoshell-local-reality-node.test.mjs",
    "holoshell:camera-scan": "node scripts/holoshell-camera-scan-adapter.mjs capture",
    "holoshell:camera-scan-test": "node scripts/__tests__/holoshell-camera-scan-adapter.test.mjs",
    "holoshell:image-preprocess-test": "node scripts/__tests__/holoshell-image-preprocess.test.mjs",
    "holoshell:geometric-control-target": "node scripts/holoshell-geometric-control-target.mjs",
    "holoshell:geometric-control-target-test": "node scripts/__tests__/holoshell-geometric-control-target.test.mjs",
    "holoshell:worktree-reap": "node scripts/holoshell-worktree-reap-adapter.mjs scan",
    "holoshell:worktree-reap-commit": "node scripts/holoshell-worktree-reap-adapter.mjs reap --commit --reap-orphans",
    "holoshell:worktree-reap-test": "node scripts/holoshell-worktree-reap-adapter.mjs --self-test",
    "holoshell:fiducial-board": "node scripts/holoshell-fiducial-board.mjs",
    "holoshell:fiducial-board-test": "node scripts/__tests__/holoshell-fiducial-board.test.mjs",
    "holoshell:target-in-frame": "node scripts/holoshell-target-in-frame-analyzer.mjs",
    "holoshell:target-in-frame-test": "node scripts/__tests__/holoshell-target-in-frame-analyzer.test.mjs",
    "holoshell:fiducial-pose-seed": "node scripts/holoshell-fiducial-pose-seed.mjs",
    "holoshell:fiducial-pose-seed-test": "node scripts/__tests__/holoshell-fiducial-pose-seed.test.mjs",
    "holoshell:fiducial-calibration": "node scripts/holoshell-fiducial-calibration.mjs",
    "holoshell:fiducial-calibration-test": "node scripts/__tests__/holoshell-fiducial-calibration.test.mjs",
    "holoshell:low-camera-fixture": "node scripts/holoshell-camera-scan-adapter.mjs fixture --require-capture",
    "holoshell:preprocess-sweep": "node scripts/holoshell-camera-scan-adapter.mjs sweep --require-capture",
    "holoshell:low-camera-workflow": "node scripts/holoshell-low-camera-workflow.mjs --require-capture",
    "holoshell:low-camera-workflow-test": "node scripts/__tests__/holoshell-low-camera-workflow.test.mjs",
    "holoshell:hologram-bridge-render": "node scripts/holoshell-hologram-bridge-renderer.mjs",
    "holoshell:hologram-bridge-render-test": "node scripts/__tests__/holoshell-hologram-bridge-renderer.test.mjs",
    "bench:p043:sku-matrix": "node scripts/p043-sku-matrix.mjs",
    "bench:p043:sku-matrix-test": "node scripts/__tests__/p043-sku-matrix.test.mjs",
    "eval:brain-intent": "node scripts/evaluate-brain-intent-loop.mjs",
    "eval:brain-intent:self-test": "node scripts/evaluate-brain-intent-loop.mjs --self-test",
    "eval:brain-intent:holoshell": "node scripts/evaluate-brain-intent-loop.mjs --case research/brain-intent-eval/cases/holoshell-room-marathon.case.json --runtime-gate --strict",
    "eval:brain-intent:trait": "node scripts/evaluate-brain-intent-loop.mjs --case research/brain-intent-eval/cases/trait-inference-gate-refusal.case.json --brain compositions/trait-inference-brain.hsplus --strict",
    "eval:brain-intent:fleet": "node scripts/evaluate-brain-intent-loop.mjs --case research/brain-intent-eval/cases/fleet-trust-auditor-gate.case.json --brain compositions/fleet-trust-auditor-brain.hsplus --runtime-gate --strict",
    "eval:brain-intent:test": "node scripts/__tests__/evaluate-brain-intent-loop.test.mjs",
    "benchmark": "tsx benchmarks/tools/benchmark-runner.ts",
    "ops:dashboard": "tsx docs/ops/admin-cli.ts",
    "webgpu:determinism": "node scripts/run-webgpu-determinism.mjs --production-evidence",
    "webgpu:determinism:mock": "node scripts/run-webgpu-determinism.mjs --mock",
    "webgpu:probe": "node scripts/probe-webgpu.mjs",
    "smoke:physics": "pnpm exec holoscript smoke examples/physics --target threejs -o .bench-logs/physics-smoke-receipt.json",
    "clean": "pnpm -r exec rm -rf dist",
    "build:auto": "bash scripts/auto-build-manager.sh",
    "build:archive": "bash scripts/archive-build-artifacts.sh",
    "build:restore": "bash scripts/restore-build-archive.sh",
    "build:monitor": "bash scripts/monitor-disk-usage.sh",
    "build:prune": "bash scripts/prune-old-archives.sh",
    "build:wasm": "bash scripts/build/wasm-build.sh --sizes",
    "build:wasm:debug": "bash scripts/build/wasm-build.sh --debug --sizes",
    "build:wasm:parallel": "bash scripts/build/wasm-build.sh --parallel --sizes",
    "build:wasm:check": "bash scripts/build/wasm-build.sh --check",
    "build:wasm:clean": "bash scripts/build/wasm-build.sh --clean",
    "build:wasm:win": "powershell -File scripts/build/wasm-build.ps1 -Sizes",
    "types:generate": "bash scripts/generate-types.sh",
    "types:generate:win": "powershell -File scripts/generate-types.ps1",
    "hooks:install": "node scripts/install-hooks.js",
    "health:repo": "node scripts/repo-health.js",
    "health:repo:quick": "node scripts/repo-health.js --skip-tests",
    "health:deps": "node scripts/bounded-pnpm-audit.mjs --audit-level=moderate --timeout-ms=25000",
    "architecture:check": "node scripts/check-architecture-coupling.js",
    "check:boundary": "node scripts/boundary-ratchet.mjs",
    "check:boundary:update": "node scripts/boundary-ratchet.mjs --update",
    "check:studio-typecheck": "node scripts/holo-ci/studio-typecheck.mjs",
    "check:publish-surface": "node scripts/holo-ci/check-publish-surface.mjs",
    "check:publish-surface:update": "node scripts/holo-ci/check-publish-surface.mjs --update",
    "check:solver-smoke": "node scripts/holo-ci/solver-smoke-check.mjs",
    "check:codex-mcp": "node scripts/holo-ci/check-codex-mcp.mjs",
    "check:cross-platform-paths": "node scripts/holo-ci/check-cross-platform-paths.mjs",
    "check:docker-core-entries": "node scripts/holo-ci/check-docker-core-entries.mjs",
    "holo:translate-cloud": "node scripts/holo-ci/translate-cloud-sessions.mjs",
    "verify:core-engine-imports": "node scripts/verify-core-engine-import-allowlist.mjs",
    "verify:claude-plugin-skills": "node scripts/verify-claude-plugin-skills.mjs",
    "verify:marketplace-skill": "node scripts/verify-marketplace-skill.mjs",
    "capabilities:cartographer": "node scripts/capability-cartographer.mjs",
    "verify:doctrine": "node scripts/check-doctrine-slots.mjs",
    "verify:package-src-no-emit": "node scripts/verify-no-js-in-package-src.mjs",
    "verify:holoshell-mcp": "node scripts/verify-holoshell-mcp-registration.mjs",
    "tests:hotspots": "node scripts/check-hotspot-test-coverage.js",
    "smoke:prod": "node scripts/smoke-prod.mjs",
    "connect": "node scripts/connect.mjs",
    "connect:test": "node --test scripts/__tests__/connect.test.mjs",
    "version:check": "node scripts/check-version-policy.js",
    "version:check:strict": "node scripts/check-version-policy.js --strict",
    "version:patch": "node scripts/sync-versions.js patch",
    "version:minor": "node scripts/sync-versions.js minor",
    "version:major": "node scripts/sync-versions.js major",
    "version:prerelease": "node scripts/sync-versions.js prerelease",
    "release:guard": "node scripts/release-guard.js",
    "release:version": "changeset version",
    "release:publish": "node scripts/release-guard.js && node scripts/cold-repro-onramp.mjs --local packages/core && changeset publish && node scripts/audit-published-install-tree.mjs @holoscript/cli@latest && node scripts/cold-repro-onramp.mjs --published",
    "audit:install-tree": "node scripts/audit-published-install-tree.mjs",
    "audit:onramp": "node scripts/cold-repro-onramp.mjs --published",
    "audit:onramp:local": "node scripts/cold-repro-onramp.mjs --local",
    "publish": "echo 'Use pnpm release:publish instead. Raw publish is blocked.' && exit 1",
    "docs:api": "typedoc",
    "docs:api:watch": "typedoc --watch",
    "docs:api:json": "typedoc --json docs/api/api.json",
    "audit:red-flags": "node scripts/check-red-flags.mjs",
    "audit:domain-plugin-receipts": "node scripts/audit-domain-plugin-receipts.mjs",
    "docs:roadmap:drift": "node scripts/check-roadmap-drift.mjs",
    "docs:counts:drift": "node scripts/check-doc-count-drift.mjs",
    "check:tropical-mentions": "node scripts/check-tropical-mentions.mjs",
    "check:security-audit": "node scripts/security-audit-io-network.mjs",
    "check:security-audit:strict": "node scripts/security-audit-io-network.mjs --strict",
    "check:security-audit:verbose": "node scripts/security-audit-io-network.mjs --verbose",
    "test:mutate": "npx stryker run",
    "audit:security": "node scripts/bounded-pnpm-audit.mjs --audit-level=moderate --timeout-ms=25000",
    "analyze:bundle": "pnpm --filter @holoscript/core build && npx rollup-plugin-visualizer dist/stats.html",
    "self-improve": "tsx scripts/self-improve.ts --verbose",
    "self-improve:daemon": "tsx scripts/self-improve.ts --daemon --verbose",
    "self-improve:commit": "tsx scripts/self-improve.ts --daemon --commit --verbose",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "syncpack:check": "syncpack lint",
    "agents:status": "tsx scripts/build/deploy-multi-agents.ts --status",
    "agents:deploy": "tsx scripts/build/deploy-multi-agents.ts",
    "render:competitor-gap-matrix": "node scripts/render-competitor-gap-matrix.mjs",
    "conjecture:runner": "tsx scripts/conjecture-runner.ts",
    "conjecture:cost-cell": "tsx scripts/conjecture-cost-cell.ts",
    "check:export-targets-sync": "node scripts/holo-ci/check-export-targets-sync.mjs",
    "check:trait-test-tautologies": "node scripts/holo-ci/check-trait-test-tautologies.mjs",
    "check:trait-parity": "node scripts/holo-ci/check-trait-parity.mjs",
    "check:trait-parity:verbose": "node scripts/holo-ci/check-trait-parity.mjs --verbose"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.88.0",
    "@changesets/cli": "^2.29.4",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vitest/coverage-v8": "^4.1.5",
    "audit-ci": "^7.1.0",
    "depcheck": "^1.4.7",
    "eslint": "^9.39.1",
    "eslint-config-next": "^15.5.14",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "gpt-tokenizer": "^3.4.0",
    "jscpd": "^4.0.8",
    "madge": "^8.0.0",
    "prettier": "^3.8.1",
    "syncpack": "^14.0.0",
    "tsup": "^8.0.1",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.2.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "@neondatabase/serverless"
      ]
    },
    "overrides": {
      "hono": ">=4.12.14",
      "@hono/node-server": ">=1.19.13",
      "axios": ">=1.16.0",
      "follow-redirects": ">=1.16.0",
      "dompurify": ">=3.4.0",
      "glob": "^13.0.6",
      "minimatch": ">=9.0.7",
      "qs": ">=6.15.0",
      "markdown-it": ">=14.1.1",
      "@x402/svm": ">=2.9.0",
      "brace-expansion": ">=5.0.5",
      "picomatch": ">=4.0.4",
      "monaco-editor": "0.55.1",
      "yaml": ">=2.8.3",
      "terser-webpack-plugin": ">=5.4.0",
      "lodash-es": ">=4.18.1",
      "lodash": ">=4.18.1",
      "defu": ">=6.1.6",
      "undici": ">=7.24.0",
      "flatted": ">=3.4.2",
      "rollup": ">=4.59.0",
      "serialize-javascript": ">=7.0.3",
      "parse-duration": ">=2.1.3",
      "underscore": ">=1.13.8",
      "h3": ">=1.15.6",
      "socket.io-parser": ">=4.2.6",
      "@modelcontextprotocol/sdk": "^1.27.1",
      "tree-sitter": "^0.22.4",
      "path-to-regexp@<1": "0.1.13",
      "esbuild": "^0.27.3",
      "nanoid": ">=5.0.9",
      "bn.js": ">=4.12.3",
      "next": ">=16.2.7",
      "@apollo/server": ">=5.5.0",
      "elliptic": ">=6.6.1",
      "bigint-buffer": ">=1.1.5",
      "three": "^0.182.0",
      "@react-three/fiber": "^9.5.0",
      "@types/react": "19.2.14",
      "protobufjs": ">=8.0.2",
      "vite": ">=7.3.2",
      "drizzle-orm": ">=0.45.2",
      "basic-ftp": ">=5.3.1",
      "fast-uri": ">=3.1.2",
      "fast-xml-builder": ">=1.1.7",
      "tmp": ">=0.2.6",
      "zod": ">=4.4.3"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-3gc7-fjrx-p6mg"
      ]
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "author": "Brian X Base Team",
  "repository": {
    "type": "git",
    "url": "https://github.com/brianonbased-dev/HoloScript.git"
  },
  "dependencies": {
    "@holoscript/cli": "workspace:*",
    "tree-sitter": "^0.22.4",
    "tree-sitter-go": "^0.23.4",
    "tree-sitter-javascript": "^0.23.1",
    "tree-sitter-python": "^0.23.6",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-typescript": "^0.23.2",
    "ts-morph": "^27.0.2"
  }
}
