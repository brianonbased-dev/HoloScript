# holoscript.net v2 — the .holo-dogfooded front door, Next 16 standalone on Railway.
#
# Build from the workspace ROOT:
#   docker build -f services/holoscript-net-v2/Dockerfile -t holoscript-net-v2 .
#
# src/app/page.tsx is committed (generated by `pnpm holo:build` via HoloScript's
# NextJSCompiler). This image builds that artifact with `next build` and never
# needs @holoscript/core — core is a build-time-only devDependency used by the
# compile script in dev/CI, not by the Next runtime. That keeps the image lean
# and sidesteps the broken Vite/rolldown toolchain in the old services/holoscript-net.
ARG PNPM_VERSION=9.15.9

FROM node:20-alpine AS base
RUN apk add --no-cache libc6-compat dumb-init
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate

# ─── Collect every workspace package.json so --frozen-lockfile can resolve the graph ───
FROM base AS manifests
WORKDIR /app
COPY . .
RUN mkdir -p /manifests && \
    find packages services benchmarks -type f -name "package.json" 2>/dev/null \
    | grep -v node_modules \
    | while read -r f; do mkdir -p "/manifests/$(dirname "$f")" && cp "$f" "/manifests/$f"; done

# ─── Install (workspace-aware, frozen) then build net-v2 ───
FROM base AS builder
WORKDIR /app
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml .npmrc ./
COPY --from=manifests /manifests/ ./

# Install only net-v2's dependency closure. The whole-workspace lockfile is
# validated against the copied manifests, but only @holoscript/net-v2's deps are
# materialized into node_modules.
RUN pnpm install --frozen-lockfile --filter @holoscript/net-v2 --ignore-scripts

COPY services/holoscript-net-v2/ services/holoscript-net-v2/

WORKDIR /app/services/holoscript-net-v2
ENV NEXT_TELEMETRY_DISABLED=1
# Build the committed page.tsx directly. Bypass the `prebuild` holo:build hook
# (which needs @holoscript/core) by invoking next directly — the page is already
# compiled. `--webpack` applies the same config path the local build uses.
RUN pnpm exec next build --webpack

# ─── Production runner — Next standalone output ───
FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3300
ENV HOSTNAME=0.0.0.0

RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs

COPY --from=builder --chown=nextjs:nodejs /app/services/holoscript-net-v2/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/services/holoscript-net-v2/.next/static ./services/holoscript-net-v2/.next/static
COPY --from=builder --chown=nextjs:nodejs /app/services/holoscript-net-v2/public ./services/holoscript-net-v2/public

USER nextjs
EXPOSE 3300
CMD ["dumb-init", "node", "services/holoscript-net-v2/server.js"]
