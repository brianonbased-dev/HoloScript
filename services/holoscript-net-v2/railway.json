{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "services/holoscript-net-v2/Dockerfile",
    "watchPatterns": ["services/holoscript-net-v2/**"]
  },
  "deploy": {
    "numReplicas": 1,
    "sleep": false,
    "restartPolicyType": "ON_FAILURE",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 30
  }
}
