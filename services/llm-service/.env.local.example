# HoloScript LLM Service Configuration

# Ollama API URL (local inference)
OLLAMA_URL=http://localhost:11434

# Optional Vast serverless fleet provider
# Set BRITTNEY_PROVIDER=fleet to prefer it when a worker is already ready.
# A cold pool records demand and falls back for the current request while it wakes.
FLEET_PROVIDER_ENDPOINT=holoscript-qwen-coder
VAST_API_KEY=
VAST_SERVERLESS_COST=100
VAST_SERVERLESS_MAX_WAIT_S=540

# Model to use (must be pulled in Ollama)
# Available: mistral, llama2, neural-chat, etc.
OLLAMA_MODEL=mistral

# Server port
PORT=8000

# Session timeout (ms)
SESSION_TIMEOUT=86400000
