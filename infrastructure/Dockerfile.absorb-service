# Absorb Service - Node.js only (skip Rust workspace)
#
# Builds from the pnpm workspace root to resolve workspace dependencies
# Dependency chain: absorb-service → core + engine + framework + absorb-service(pkg)

ARG PNPM_VERSION=9.15.9

FROM node:20-alpine AS base
ARG PNPM_VERSION
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate

# Collect all package.json for lockfile resolution
FROM base AS manifests
WORKDIR /app
COPY . .
RUN find packages services benchmarks -name "package.json" -not -path "*/node_modules/*" -exec sh -c 'mkdir -p /manifests/$(dirname {}) && cp {} /manifests/{}' \; 2>/dev/null; true

FROM base AS builder
WORKDIR /app

# Copy workspace config + all package.json manifests
# .npmrc carries `shamefully-hoist=true` — REQUIRED so undeclared-but-hoisted
# type deps resolve during core's public-subpath declaration emit (e.g.
# onnxruntime-node, declared only by hologram-worker, imported by core's
# onnx-adapter). Missing .npmrc = isolated pnpm layout = TS2307 in
# build-core-stack generate-types (broke every absorb-service deploy once the
# earlier mesh esbuild blocker was cleared, 2026-07-10). Mirrors
# packages/studio/Dockerfile + infrastructure/Dockerfile.mcp-server.
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml tsconfig.base.json tsconfig.json .npmrc ./
COPY --from=manifests /manifests/ ./
COPY scripts/docker/build-engine-no-dts.sh scripts/docker/build-engine-no-dts.sh
COPY scripts/docker/build-core-stack-no-dts.sh scripts/docker/build-core-stack-no-dts.sh
COPY scripts/docker/tsup.core.docker.cjs scripts/docker/tsup.core.docker.cjs

# Install dependencies
RUN pnpm install --frozen-lockfile --ignore-scripts

# Copy source code
# core-types must come first — build-core-stack-no-dts.sh builds it before
# crdt/agent-protocol/etc. (commit f3751ef55). Dockerfile copy block had drifted
# from the script for 9+ days, manifesting as "tsup: No input files" because the
# manifests stage created packages/core-types/package.json but src/ was absent.
COPY packages/core-types/ packages/core-types/
COPY packages/crdt/ packages/crdt/
COPY packages/agent-protocol/ packages/agent-protocol/
COPY packages/config/ packages/config/
COPY packages/core/ packages/core/
COPY packages/engine/ packages/engine/
COPY packages/framework/ packages/framework/
COPY packages/llm-provider/ packages/llm-provider/
# secrets-broker: zero-dep HoloKey vault primitive imported by services/absorb-service/src/boot-secrets.ts.
# Must be COPYed + built (WITH dts) so the host's `pnpm exec tsc` resolves its types and runtime resolves its js.
# Omitting it is the W.731 curated-build-list drift (cf. the core-types/marketplace-api notes above).
COPY packages/secrets-broker/ packages/secrets-broker/
COPY packages/absorb-service/ packages/absorb-service/
# packages/platform/src/marketplace/{MarketplaceRegistry,MarketplaceSubmission}.ts
# do `export * from '../../../marketplace-api/src/core-marketplace/...js'`. The
# source comments at those files explicitly document this Dockerfile requirement.
# Same drift class as the core-types miss above.
COPY packages/marketplace-api/ packages/marketplace-api/
COPY packages/platform/ packages/platform/
COPY packages/mesh/ packages/mesh/
COPY services/absorb-service/ services/absorb-service/

# Build in dependency order (skip DTS for runtime)
RUN chmod +x scripts/docker/build-engine-no-dts.sh scripts/docker/build-core-stack-no-dts.sh && ./scripts/docker/build-core-stack-no-dts.sh
# secrets-broker WITH dts (zero-dep) MUST precede config: config's dts emit needs it
# (packages/config/src/auth.ts dynamically imports '@holoscript/secrets-broker' — the
# literal 'secrets-broker-before-config' TS2307 class the docker-drift gate documents).
# The host's tsc also needs its dist/index.d.ts to resolve the import.
RUN cd packages/secrets-broker && pnpm exec tsup
# config WITH dts (tsup.config.ts has dts:true): the host's tsc imports
# '@holoscript/config' — with --no-dts here the host compiled against untyped JS
# (silently `any` under noImplicitAny:false). Emitting dts closes the blessed
# docker-drift order gap and types server.ts's config import for real.
RUN cd packages/config && pnpm exec tsup
RUN cd packages/llm-provider && pnpm exec tsup --no-dts
RUN cd packages/platform && pnpm exec tsup --no-dts
RUN cd packages/mesh && pnpm exec tsup --no-dts
RUN cd packages/absorb-service && pnpm exec tsup --no-dts
RUN cd services/absorb-service && pnpm exec tsc

# --- Production stage ---
FROM node:20-alpine

ARG PNPM_VERSION

RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate

WORKDIR /app

# Create non-root user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nodejs

# Copy workspace config + all manifests for lockfile resolution
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml .npmrc ./
COPY --from=manifests /manifests/ ./

# Install production dependencies
RUN pnpm install --frozen-lockfile --ignore-scripts

# Copy built artifacts and source core for CodebaseScanner
COPY --from=builder --chown=nodejs:nodejs /app/packages packages
COPY --from=builder --chown=nodejs:nodejs /app/services services
COPY --chown=nodejs:nodejs tsconfig.json tsconfig.base.json ./

# Copy entrypoint
COPY --chown=nodejs:nodejs services/absorb-service/scripts/docker-entrypoint.sh /app/services/absorb-service/scripts/docker-entrypoint.sh

# Keep /app writable for runtime caches without recursively rewriting node_modules.
RUN chown nodejs:nodejs /app

# Ensure entrypoint is executable
RUN chmod +x /app/services/absorb-service/scripts/docker-entrypoint.sh

USER nodejs

# Environment
ENV NODE_ENV=production

EXPOSE 3005

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD node -e "require('http').get('http://localhost:${PORT:-3005}/health',(r)=>process.exit(r.statusCode===200?0:1))"

CMD ["/app/services/absorb-service/scripts/docker-entrypoint.sh"]
