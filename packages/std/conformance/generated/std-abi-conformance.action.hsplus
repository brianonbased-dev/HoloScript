composition "std-math-conformance" {
  state {
    touched: 0
  }

  logic {
    action lerp(a, b, t) {
      return { value: a + (b - a) * t }
    }

    action clamp(value, min, max) {
      return { value: value < min ? min : (value > max ? max : value) }
    }

    action smoothstep(edge0, edge1, x) {
      t = (x - edge0) / (edge1 - edge0)
      if (t < 0) { t = 0 }
      if (t > 1) { t = 1 }
      return { value: t * t * (3 - 2 * t) }
    }

    action remap(value, in_min, in_max, out_min, out_max) {
      return { value: out_min + (out_max - out_min) * ((value - in_min) / (in_max - in_min)) }
    }

    action deg_to_rad(degrees) {
      return { value: degrees * 0.017453292519943295 }
    }

    action rad_to_deg(radians) {
      return { value: radians * 57.29577951308232 }
    }

    action vec3_dot(a, b) {
      return { value: a.x * b.x + a.y * b.y + a.z * b.z }
    }

    action vec3_cross(a, b) {
      return { x: a.y * b.z - a.z * b.y, y: a.z * b.x - a.x * b.z, z: a.x * b.y - a.y * b.x }
    }

    action vec3_lerp(a, b, t) {
      return { x: a.x + (b.x - a.x) * t, y: a.y + (b.y - a.y) * t, z: a.z + (b.z - a.z) * t }
    }

    action vec3_length(v) {
      return { value: sqrt(v.x * v.x + v.y * v.y + v.z * v.z) }
    }

    action vec3_normalize(v) {
      len = sqrt(v.x * v.x + v.y * v.y + v.z * v.z)
      if (len < 0.000001) { return { x: 0.0, y: 0.0, z: 0.0 } }
      return { x: v.x / len, y: v.y / len, z: v.z / len }
    }

    action vec3_distance(a, b) {
      return { value: sqrt((a.x - b.x) * (a.x - b.x) + (a.y - b.y) * (a.y - b.y) + (a.z - b.z) * (a.z - b.z)) }
    }

    action quat_from_axis_angle(axis, angle_rad) {
      return { x: axis.x * sin(angle_rad * 0.5), y: axis.y * sin(angle_rad * 0.5), z: axis.z * sin(angle_rad * 0.5), w: cos(angle_rad * 0.5) }
    }

    action quat_slerp(a, b, t) {
      dot = a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w
      bx = b.x
      by = b.y
      bz = b.z
      bw = b.w
      if (dot < 0) {
        bx = 0.0 - b.x
        by = 0.0 - b.y
        bz = 0.0 - b.z
        bw = 0.0 - b.w
        dot = 0.0 - dot
      }
      if (dot > 0.9995) {
        lx = a.x + (bx - a.x) * t
        ly = a.y + (by - a.y) * t
        lz = a.z + (bz - a.z) * t
        lw = a.w + (bw - a.w) * t
        len = sqrt(lx * lx + ly * ly + lz * lz + lw * lw)
        return { x: lx / len, y: ly / len, z: lz / len, w: lw / len }
      }
      theta0 = acos(dot)
      theta = theta0 * t
      sinTheta = sin(theta)
      sinTheta0 = sin(theta0)
      s0 = cos(theta) - dot * sinTheta / sinTheta0
      s1 = sinTheta / sinTheta0
      return { x: a.x * s0 + bx * s1, y: a.y * s0 + by * s1, z: a.z * s0 + bz * s1, w: a.w * s0 + bw * s1 }
    }

    action quat_identity() {
      return { x: 0.0, y: 0.0, z: 0.0, w: 1.0 }
    }

    action quat_multiply(a, b) {
      return { x: a.w * b.x + a.x * b.w + a.y * b.z - a.z * b.y, y: a.w * b.y - a.x * b.z + a.y * b.w + a.z * b.x, z: a.w * b.z + a.x * b.y - a.y * b.x + a.z * b.w, w: a.w * b.w - a.x * b.x - a.y * b.y - a.z * b.z }
    }

    action host_clamp(value, min, max) {
      return { value: math.clamp(value, min, max) }
    }

    action host_lerp(a, b, t) {
      return { value: math.lerp(a, b, t) }
    }

    action host_quat_slerp(a, b, t) {
      return { value: math.quat_slerp(a, b, t) }
    }

    action host_list_range(start, end, step) {
      return { value: list_lib.list_range(start, end, step) }
    }

    action host_list_repeat(value, count) {
      return { value: list_lib.list_repeat(value, count) }
    }

    action host_list_reverse(lst) {
      return { value: list_lib.list_reverse(lst) }
    }

    action host_list_flatten(lst) {
      return { value: list_lib.list_flatten(lst) }
    }

    action host_list_unique(lst) {
      return { value: list_lib.list_unique(lst) }
    }

    action host_list_get(lst, index) {
      return { value: list_lib.list_get(lst, index) }
    }

    action host_list_contains(lst, item) {
      return { value: list_lib.list_contains(lst, item) }
    }

    action host_list_index_of(lst, item) {
      return { value: list_lib.list_index_of(lst, item) }
    }

    action host_list_join(lst, sep) {
      return { value: list_lib.list_join(lst, sep) }
    }

    action host_list_zip(a, b) {
      return { value: list_lib.list_zip(a, b) }
    }

    action host_list_chunk(lst, size) {
      return { value: list_lib.list_chunk(lst, size) }
    }

    action host_map_set(m, key, value) {
      return { value: map_lib.map_set(m, key, value) }
    }

    action host_map_get(m, key) {
      return { value: map_lib.map_get(m, key) }
    }

    action host_map_keys(m) {
      return { value: map_lib.map_keys(m) }
    }

    action host_map_merge(a, b) {
      return { value: map_lib.map_merge(a, b) }
    }

    action host_map_size(m) {
      return { value: map_lib.map_size(m) }
    }

    action host_set_add(s, item) {
      return { value: set_lib.set_add(s, item) }
    }

    action host_set_has(s, item) {
      return { value: set_lib.set_has(s, item) }
    }

    action host_set_union(a, b) {
      return { value: set_lib.set_union(a, b) }
    }

    action host_set_intersection(a, b) {
      return { value: set_lib.set_intersection(a, b) }
    }

    action host_set_difference(a, b) {
      return { value: set_lib.set_difference(a, b) }
    }
  }
}
