{
  "schema": "holoscript.std-abi-packaged-execution.v0",
  "extensionsFile": "packages/std/conformance/std-abi-packaged-extensions.v0.json",
  "sources": {
    "std_math": "packages/std/src/math.hsplus",
    "std_list": "packages/std/src/collections.hsplus",
    "std_map": "packages/std/src/collections.hsplus",
    "std_set": "packages/std/src/collections.hsplus"
  },
  "targets": [
    "node",
    "browser-wasm",
    "owned-metal"
  ],
  "engineSubsetId": "holoscript-engine-hsplus-deterministic-action-subset-v7-packaged-traits",
  "wasmSubsetId": "holoscript-engine-hsplus-deterministic-action-subset-v6-null-coalescing",
  "claim": "These vectors execute every non-lifecycle SHIPPED packaged handler body from hash-bound source bytes. The engine v7 adapter consumes the canonical HoloScriptPlusParser @trait AST and reparses each preserved authored body through the structured deterministic evaluator; the wasm lane uses its cumulative v6 evaluator. Both statically lift whitelisted factory aliases from @on_spawn, do not execute on_spawn side effects, preserve strict short-circuiting ?? defaults, and carry iterable/callback parameters as the explicit holoscript.std-iterable.v0 and bounded holoscript.std-callable.v0 strict-JSON contracts.",
  "excludedHandlers": [
    {
      "handler": "on_spawn",
      "trait": "*",
      "reason": "lifecycle side effects; factory aliases statically lifted instead"
    }
  ],
  "handlers": [
