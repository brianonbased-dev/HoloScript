{
  "schema": "holoscript.std-abi-packaged-extensions.v0",
  "description": "Literal-oracle vectors for every non-lifecycle packaged std handler omitted by the base v0 corpus. Callback parameters use bounded holoscript.std-callable.v0 descriptors and on_from uses the explicit holoscript.std-iterable.v0 data boundary.",
  "handlers": [
    {
      "trait": "std_list",
      "handler": "on_of",
      "params": ["items"],
      "expectRef": { "literal": true },
      "vectors": [
        {
          "id": "packaged-list-of",
          "args": { "items": [1, "x", true] },
          "expected": [1, "x", true]
        }
      ]
    },
    {
      "trait": "std_list",
      "handler": "on_from",
      "params": ["iterable"],
      "expectRef": { "literal": true },
      "vectors": [
        {
          "id": "packaged-list-from-map",
          "args": {
            "iterable": {
              "schema": "holoscript.std-iterable.v0",
              "kind": "map",
              "value": { "b": 2, "a": 1 }
            }
          },
          "expected": [["a", 1], ["b", 2]]
        },
        {
          "id": "packaged-list-from-string",
          "args": { "iterable": "A😀" },
          "expected": ["A", "😀"]
        }
      ]
    },
    {
      "trait": "std_list",
      "handler": "on_repeat",
      "params": ["value", "count"],
      "expectRef": { "literal": true },
      "vectors": [
        {
          "id": "packaged-list-repeat",
          "args": { "value": "x", "count": 3 },
          "expected": ["x", "x", "x"]
        }
      ]
    },
    {
      "trait": "std_list",
      "handler": "on_map",
      "params": ["lst", "fn"],
      "expectRef": { "literal": true },
      "vectors": [
        {
          "id": "packaged-list-map-callable",
          "args": {
            "lst": [2, 3],
            "fn": {
              "schema": "holoscript.std-callable.v0",
              "arity": 2,
              "body": {
                "op": "add",
                "args": [
                  { "op": "mul", "args": [{ "arg": 0 }, { "const": 10 }] },
                  { "arg": 1 }
                ]
              }
            }
          },
          "expected": [20, 31]
        }
      ]
    },
    {
      "trait": "std_list",
      "handler": "on_flat_map",
      "params": ["lst", "fn"],
      "expectRef": { "literal": true },
      "vectors": [
        {
          "id": "packaged-list-flat-map-callable",
          "args": {
            "lst": [1, 2],
            "fn": {
              "schema": "holoscript.std-callable.v0",
              "arity": 2,
              "body": {
                "array": [
                  { "arg": 0 },
                  { "op": "mul", "args": [{ "arg": 0 }, { "const": 10 }] }
                ]
              }
            }
          },
          "expected": [1, 10, 2, 20]
        }
      ]
    },
    {
      "trait": "std_list",
      "handler": "on_filter",
      "params": ["lst", "predicate"],
      "expectRef": { "literal": true },
      "vectors": [
        {
          "id": "packaged-list-filter-callable",
          "args": {
            "lst": [1, 2, 3, 4],
            "predicate": {
              "schema": "holoscript.std-callable.v0",
              "arity": 2,
              "body": {
                "op": "eq",
                "args": [
                  { "op": "mod", "args": [{ "arg": 0 }, { "const": 2 }] },
                  { "const": 0 }
                ]
              }
            }
          },
          "expected": [2, 4]
        }
      ]
    },
    {
      "trait": "std_list",
      "handler": "on_reduce",
      "params": ["lst", "fn", "initial_value"],
      "expectRef": { "literal": true },
      "vectors": [
        {
          "id": "packaged-list-reduce-callable",
          "args": {
            "lst": [1, 2, 3],
            "fn": {
              "schema": "holoscript.std-callable.v0",
              "arity": 3,
              "body": {
                "op": "add",
                "args": [
                  { "op": "add", "args": [{ "arg": 0 }, { "arg": 1 }] },
                  { "arg": 2 }
                ]
              }
            },
            "initial_value": 0
          },
          "expected": 9
        }
      ]
    },
    {
      "trait": "std_list",
      "handler": "on_sort",
      "params": ["lst", "comparator"],
      "expectRef": { "literal": true },
      "vectors": [
        {
          "id": "packaged-list-sort-callable",
          "args": {
            "lst": [3, 1, 2, 1],
            "comparator": {
              "schema": "holoscript.std-callable.v0",
              "arity": 2,
              "body": { "op": "sub", "args": [{ "arg": 0 }, { "arg": 1 }] }
            }
          },
          "expected": [1, 1, 2, 3]
        }
      ]
    },
    {
      "trait": "std_list",
      "handler": "on_to_array",
      "params": ["lst"],
      "expectRef": { "literal": true },
      "vectors": [
        {
          "id": "packaged-list-to-array",
          "args": { "lst": [1, { "x": true }] },
          "expected": [1, { "x": true }]
        }
      ]
    },
    {
      "trait": "std_list",
      "handler": "on_to_set",
      "params": ["lst"],
      "expectRef": { "literal": true },
      "vectors": [
        {
          "id": "packaged-list-to-set",
          "args": { "lst": [3, 1, 3, 2] },
          "expected": [1, 2, 3]
        }
      ]
    },
    {
      "trait": "std_map",
      "handler": "on_get",
      "params": ["m", "key"],
      "expectRef": { "literal": true },
      "vectors": [
        {
          "id": "packaged-map-get",
          "args": { "m": { "a": 1 }, "key": "a" },
          "expected": 1
        }
      ]
    },
    {
      "trait": "std_map",
      "handler": "on_has",
      "params": ["m", "key"],
      "expectRef": { "literal": true },
      "vectors": [
        {
          "id": "packaged-map-has",
          "args": { "m": { "a": 1 }, "key": "a" },
          "expected": true
        }
      ]
    },
    {
      "trait": "std_map",
      "handler": "on_delete",
      "params": ["m", "key"],
      "expectRef": { "literal": true },
      "vectors": [
        {
          "id": "packaged-map-delete",
          "args": { "m": { "a": 1, "b": 2 }, "key": "a" },
          "expected": { "b": 2 }
        }
      ]
    },
    {
      "trait": "std_map",
      "handler": "on_values",
      "params": ["m"],
      "expectRef": { "literal": true },
      "vectors": [
        {
          "id": "packaged-map-values",
          "args": { "m": { "b": 2, "a": 1 } },
          "expected": [1, 2]
        }
      ]
    },
    {
      "trait": "std_map",
      "handler": "on_entries",
      "params": ["m"],
      "expectRef": { "literal": true },
      "vectors": [
        {
          "id": "packaged-map-entries",
          "args": { "m": { "b": 2, "a": 1 } },
          "expected": [["a", 1], ["b", 2]]
        }
      ]
    },
    {
      "trait": "std_map",
      "handler": "on_map_values",
      "params": ["m", "fn"],
      "expectRef": { "literal": true },
      "vectors": [
        {
          "id": "packaged-map-values-callable",
          "args": {
            "m": { "b": 2, "a": 1 },
            "fn": {
              "schema": "holoscript.std-callable.v0",
              "arity": 2,
              "body": {
                "object": {
                  "key": { "arg": 1 },
                  "value": { "arg": 0 }
                }
              }
            }
          },
          "expected": {
            "a": { "key": "a", "value": 1 },
            "b": { "key": "b", "value": 2 }
          }
        }
      ]
    },
    {
      "trait": "std_map",
      "handler": "on_filter_entries",
      "params": ["m", "predicate"],
      "expectRef": { "literal": true },
      "vectors": [
        {
          "id": "packaged-map-filter-callable",
          "args": {
            "m": { "b": 2, "a": 1 },
            "predicate": {
              "schema": "holoscript.std-callable.v0",
              "arity": 2,
              "body": { "op": "ne", "args": [{ "arg": 1 }, { "const": "b" }] }
            }
          },
          "expected": { "a": 1 }
        }
      ]
    },
    {
      "trait": "std_set",
      "handler": "on_has",
      "params": ["s", "item"],
      "expectRef": { "literal": true },
      "vectors": [
        {
          "id": "packaged-set-has",
          "args": { "s": [3, 1, 2], "item": 2 },
          "expected": true
        }
      ]
    },
    {
      "trait": "std_set",
      "handler": "on_delete",
      "params": ["s", "item"],
      "expectRef": { "literal": true },
      "vectors": [
        {
          "id": "packaged-set-delete",
          "args": { "s": [3, 1, 2], "item": 2 },
          "expected": [1, 3]
        }
      ]
    },
    {
      "trait": "std_set",
      "handler": "on_to_array",
      "params": ["s"],
      "expectRef": { "literal": true },
      "vectors": [
        {
          "id": "packaged-set-to-array",
          "args": { "s": [3, 1, 3, 2] },
          "expected": [1, 2, 3]
        }
      ]
    },
    {
      "trait": "std_set",
      "handler": "on_size",
      "params": ["s"],
      "expectRef": { "literal": true },
      "vectors": [
        {
          "id": "packaged-set-size",
          "args": { "s": [3, 1, 3, 2] },
          "expected": 3
        }
      ]
    }
  ]
}
