{
  "name": "@holoscript/std",
  "version": "7.0.8",
  "description": "HoloScript Standard Library - Core types and utilities",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist",
    "src/math.hsplus",
    "src/collections.hsplus",
    "src/abi/scalar-v1.hs",
    "src/abi/scalar-f32-v1.hs",
    "src/abi/scalar-f64-v1.hs",
    "src/abi/vector-v1.hs",
    "src/abi/collections-list3-v1.hs",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./math": {
      "types": "./dist/math.d.ts",
      "import": "./dist/math.js",
      "require": "./dist/math.cjs"
    },
    "./uaal-abi": {
      "types": "./dist/uaal-abi.d.ts",
      "import": "./dist/uaal-abi.js",
      "require": "./dist/uaal-abi.cjs"
    },
    "./collections": {
      "types": "./dist/collections.d.ts",
      "import": "./dist/collections.js",
      "require": "./dist/collections.cjs"
    },
    "./native/math.hsplus": "./src/math.hsplus",
    "./native/collections.hsplus": "./src/collections.hsplus",
    "./native/abi/scalar-v1.hs": "./src/abi/scalar-v1.hs",
    "./native/abi/scalar-f32-v1.hs": "./src/abi/scalar-f32-v1.hs",
    "./native/abi/scalar-f64-v1.hs": "./src/abi/scalar-f64-v1.hs",
    "./native/abi/vector-v1.hs": "./src/abi/vector-v1.hs",
    "./native/abi/collections-list3-v1.hs": "./src/abi/collections-list3-v1.hs",
    "./string": {
      "types": "./dist/string.d.ts",
      "import": "./dist/string.js",
      "require": "./dist/string.cjs"
    },
    "./time": {
      "types": "./dist/time.d.ts",
      "import": "./dist/time.js",
      "require": "./dist/time.cjs"
    },
    "./economic": {
      "types": "./dist/traits/EconomicPrimitives.d.ts",
      "import": "./dist/traits/EconomicPrimitives.js",
      "require": "./dist/traits/EconomicPrimitives.cjs"
    },
    "./economic-traits": {
      "types": "./dist/traits/EconomicTraits.d.ts",
      "import": "./dist/traits/EconomicTraits.js",
      "require": "./dist/traits/EconomicTraits.cjs"
    },
    "./fs": {
      "types": "./dist/fs/index.d.ts",
      "import": "./dist/fs/index.js",
      "require": "./dist/fs/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --declarationDir dist --skipLibCheck",
    "watch": "tsc -w",
    "clean": "rm -rf dist",
    "test": "vitest run --passWithNoTests",
    "test:abi": "pnpm --dir ../.. --filter @holoscript/meaning run build && pnpm --dir ../.. --filter @holoscript/uaal run build && pnpm run build && node scripts/abi-conformance.mjs",
    "test:coverage": "vitest run --coverage --passWithNoTests"
  },
  "keywords": [
    "holoscript",
    "std",
    "standard-library",
    "3d",
    "spatial",
    "economic",
    "bonding-curve",
    "pid-controller"
  ],
  "holoscript": {
    "artifact": "library",
    "entrypoint": "./src/math.hsplus",
    "exports": {
      "./math": "./src/math.hsplus",
      "./collections": "./src/collections.hsplus",
      "./abi/scalar-v1": "./src/abi/scalar-v1.hs",
      "./abi/scalar-f32-v1": "./src/abi/scalar-f32-v1.hs",
      "./abi/scalar-f64-v1": "./src/abi/scalar-f64-v1.hs",
      "./abi/vector-v1": "./src/abi/vector-v1.hs",
      "./abi/collections-list3-v1": "./src/abi/collections-list3-v1.hs"
    },
    "supportTier": "preview",
    "compatibility": {
      "holoscript": ">=8.0.0",
      "targets": [
        "node",
        "browser-wasm",
        "owned-metal"
      ]
    },
    "capabilities": [
      "std_math",
      "std_math_scalar_i32_v1",
      "std_math_scalar_f32_v1",
      "std_math_scalar_f64_v1",
      "std_math_finite_fail_closed_v1",
      "std_math_vector_i32_v1",
      "std_math_vector_aggregate_i32_v1",
      "std_math_aabb3_aggregate_i32_v1",
      "std_collections_list3_i32_v1",
      "std_uaal_exec_host_adapter",
      "std_uaal_owned_buffer_host_adapter",
      "std_uaal_aggregate_reference_host_adapter",
      "std_collections"
    ],
    "abi": {
      "id": "hs.std.scalar.i32.v1",
      "entrypoint": "./src/abi/scalar-v1.hs",
      "functions": [
        "std_math_clamp_i32",
        "std_math_sign_i32",
        "std_math_step_i32"
      ],
      "provenTargets": [
        "node",
        "browser-wasm-uaal",
        "owned-metal"
      ]
    },
    "abis": [
      {
        "id": "hs.std.scalar.i32.v1",
        "entrypoint": "./src/abi/scalar-v1.hs",
        "functions": [
          "std_math_clamp_i32",
          "std_math_sign_i32",
          "std_math_step_i32"
        ],
        "provenTargets": [
          "node",
          "browser-wasm-uaal",
          "owned-metal"
        ]
      },
      {
        "id": "hs.std.vector.i32.v1",
        "entrypoint": "./src/abi/vector-v1.hs",
        "functions": [
          "std_math_vec3_dot_i32",
          "std_math_vec3_cross_x_i32",
          "std_math_vec3_cross_y_i32",
          "std_math_vec3_cross_z_i32",
          "std_math_vec3_length_sq_i32"
        ],
        "provenTargets": [
          "node",
          "browser-wasm-uaal",
          "owned-metal"
        ]
      },
      {
        "id": "hs.std.vector.aggregate.i32.v1",
        "entrypoint": "./src/abi/vector-v1.hs",
        "functions": [
          "std_math_vec3_make_i32",
          "std_math_vec3_dot_value_i32",
          "std_math_vec3_cross_value_i32",
          "std_math_vec3_length_sq_value_i32"
        ],
        "valueAbi": "hs.aggregate.value.v1",
        "layout": "StdVec3I32{x:i32,y:i32,z:i32}",
        "provenTargets": [
          "node",
          "browser-wasm-uaal",
          "owned-metal"
        ]
      },
      {
        "id": "hs.std.aabb3.aggregate.i32.v1",
        "entrypoint": "./src/abi/vector-v1.hs",
        "functions": [
          "std_math_aabb3_make_i32",
          "std_math_aabb3_size_value_i32",
          "std_math_aabb3_volume_value_i32"
        ],
        "valueAbi": "hs.aggregate.value.v2",
        "layout": "StdAabb3I32{min:StdVec3I32{x:i32,y:i32,z:i32},max:StdVec3I32{x:i32,y:i32,z:i32}}",
        "provenTargets": [
          "node",
          "browser-wasm-uaal",
          "owned-metal"
        ]
      },
      {
        "id": "hs.std.collections.list3.i32.v1",
        "entrypoint": "./src/abi/collections-list3-v1.hs",
        "functions": [
          "std_collections_list3_make_i32",
          "std_collections_list3_sum_i32",
          "std_collections_list3_replace_second_i32",
          "std_collections_list3_reverse_i32",
          "std_collections_list3_weighted_digest_i32"
        ],
        "valueAbi": "hs.aggregate.value.v1",
        "layout": "StdList3I32{first:i32,second:i32,third:i32}",
        "provenTargets": [
          "node",
          "browser-wasm-uaal",
          "owned-metal"
        ]
      },
      {
        "id": "hs.buffer.owned.v1",
        "valueAbi": "hs.buffer.owned.v1",
        "opcodes": [
          "OP_HS_BUFFER_ALLOC",
          "OP_HS_BUFFER_MOVE",
          "OP_HS_BUFFER_LOAD",
          "OP_HS_BUFFER_STORE",
          "OP_HS_BUFFER_DROP",
          "OP_HS_BUFFER_LENGTH"
        ],
        "provenCompilerSubset": [
          "local allocation",
          "whole-owner move",
          "explicit drop",
          "automatic return cleanup"
        ],
        "provenTargets": [
          "browser-wasm-uaal",
          "owned-metal"
        ]
      },
      {
        "id": "hs.aggregate.ref.v1",
        "valueAbi": "hs.aggregate.ref.v1",
        "opcodes": [
          "OP_HS_AGGREGATE_BORROW",
          "OP_HS_AGGREGATE_LOAD",
          "OP_HS_AGGREGATE_STORE"
        ],
        "provenCompilerSubset": [
          "call-scoped shared aggregate parameters",
          "call-scoped mutable aggregate parameters",
          "layout-checked scalar field load",
          "immutable-rebuild scalar field store",
          "borrow release",
          "same-call alias rejection"
        ],
        "provenTargets": [
          "browser-wasm-uaal",
          "owned-metal"
        ]
      },
      {
        "id": "hs.std.scalar.f32.v1",
        "entrypoint": "./src/abi/scalar-f32-v1.hs",
        "functions": [
          "std_math_clamp_f32",
          "std_math_lerp_f32",
          "std_math_inverse_lerp_f32",
          "std_math_remap_f32"
        ],
        "failureContract": "finite-input-and-result-or-fail-closed",
        "provenFailures": [
          "non-finite input",
          "division by zero",
          "overflow result"
        ],
        "nodeReferenceFunctions": [
          "clampFiniteF32",
          "lerpFiniteF32",
          "inverseLerpFiniteF32",
          "remapFiniteF32"
        ],
        "provenTargets": [
          "node",
          "browser-wasm-uaal",
          "owned-metal"
        ]
      },
      {
        "id": "hs.std.scalar.f64.v1",
        "entrypoint": "./src/abi/scalar-f64-v1.hs",
        "functions": [
          "std_math_clamp_f64",
          "std_math_lerp_f64",
          "std_math_inverse_lerp_f64",
          "std_math_remap_f64"
        ],
        "failureContract": "finite-input-and-result-or-fail-closed",
        "provenFailures": [
          "non-finite input",
          "division by zero",
          "overflow result"
        ],
        "nodeReferenceFunctions": [
          "clampFiniteF64",
          "lerpFiniteF64",
          "inverseLerpFiniteF64",
          "remapFiniteF64"
        ],
        "provenTargets": [
          "node",
          "browser-wasm-uaal",
          "owned-metal"
        ]
      }
    ],
    "runtimeBoundary": "Executable ABI parity is proven for scalar i32 clamp/sign/step, affine aggregate-valued i32 Vec3 construction/dot/cross/length-squared, recursively nested immutable-POD i32 AABB construction/size/volume, an immutable fixed-size List3<i32> projection with construction/sum/persistent replacement/reversal/digest, local owned-buffer allocation/whole-owner move/explicit drop/automatic return cleanup, call-scoped shared and mutable aggregate parameters with scalar field load/store, finite scalar f32 clamp/lerp/inverse-lerp/remap with operation-by-operation binary32 rounding, and finite scalar f64 clamp/lerp/inverse-lerp/remap across the explicitly named targets. The f32/f64 contract is finite-input-and-result-or-fail-closed: checked Node references, browser-WASM/UAAL, and owned-metal execution reject non-finite inputs, division by zero, and overflow results; signed-zero preservation remains unproven. The packaged UAAL host adapter executes numeric, hs.aggregate.value.v1 flat-record, hs.aggregate.value.v2 recursive-record, hs.buffer.owned.v1 token/cell, and hs.aggregate.ref.v1 call-scoped lease instructions. Mutable aggregate stores rebuild frozen value envelopes and atomically replace one addressable state root; static and runtime checks reject same-call aliases, mutability escalation, conflicting leases, stale tokens, layout mismatch, and invalid scalar stores. The existing 11-op math conformance projection remains receipt-proven (50 vectors, cross-target exact value equality). Owned-buffer parameters, returns, aggregate fields, borrowed buffer element access, borrowed aggregate returns, stored reference locals, escaping leases, signed-zero preservation, quaternion, noise, sqrt/trig ops, dynamic indexing, variable-length allocation, iteration, and general List, Map, and Set parity remain preview."
  },
  "author": "Brian X Base Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/brianonbased-dev/HoloScript.git",
    "directory": "packages/std"
  },
  "dependencies": {
    "chokidar": "^3.5.3",
    "glob": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.5"
  },
  "homepage": "https://github.com/brianonbased-dev/HoloScript#readme",
  "bugs": {
    "url": "https://github.com/brianonbased-dev/HoloScript/issues"
  }
}
