{
  "extends": "./tsconfig.json",
  "include": ["src/policy/**/*.ts"],
  "exclude": ["src/policy/**/__tests__/**", "src/policy/**/*.test.ts"],
  "compilerOptions": {
    "types": ["@webgpu/types", "node"],
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": "./src"
  }
}
