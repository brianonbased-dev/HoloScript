// @holoscript_plus_parser — parses .hsplus semantic behavior and systems components to AST.
//
// Native .hsplus surface for core/src/HoloScriptPlusParser.ts.
// F.120: .hsplus = typed semantic components/behavior; brains are one vertical.
// Two-parser model: TypeScript authority here, Rust+WASM authority for .hs.

@trait holoscript_plus_parser {
  capability_tags: ["holoscript_plus_parser", "hsplus_semantic_components", "traits", "state", "pipelines", "services", "interfaces", "brains", "trait_ast", "parser", "core"]

  @on_spawn => {
    emit("holoscript_plus_parser_ready", {})
  }

  @on_parse(hsplus_source) => {
    trait_ast = parse_holoscript_plus(hsplus_source)
    return trait_ast
  }

  @receipt holoscript_plus_parser_config {
    type: "HoloScriptPlusParserReceipt"
    doc: "F.120 three-surface model: .holo=whole-system composition, .hsplus=typed semantic components/behavior, .hs=deterministic logic/policy"
    timestamp: now()
  }
}
