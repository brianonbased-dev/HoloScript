@trait barrel_trait_stdlib_interop {
  capability_tags: ["barrel", "trait_stdlib_interop", "re_export", "core"]

  @on_spawn => { emit("barrel_trait_stdlib_interop_ready", {}) }

  @receipt barrel_trait_stdlib_interop_config {
