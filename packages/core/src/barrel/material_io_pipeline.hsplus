// @barrel_material_io_pipeline — Barrel: re-exports material I/O pipeline surface.
//
// Native .hsplus surface for core/src/barrel/material-io-pipeline.ts.

@trait barrel_material_io_pipeline {
  capability_tags: ["barrel", "material_io_pipeline", "re_export", "core"]

  @on_spawn => { emit("barrel_material_io_pipeline_ready", {}) }

  @receipt barrel_material_io_pipeline_config {
    type: "BarrelMaterialIoPipelineReceipt"
    timestamp: now()
  }
}
