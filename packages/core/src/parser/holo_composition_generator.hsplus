// @holo_composition_generator — Generates .holo composition text from HoloComposition AST.
//
// Native .hsplus surface for core/parser/HoloCompositionGenerator.ts.
//
// generate(composition) → string — pretty-printed .holo source
// Inverse of HoloCompositionParser; used by code generation and refactor tools

@trait holo_composition_generator {
  capability_tags: ["holo_composition_generator", "ast_to_holo", "code_generation", "pretty_print", "core"]

  @on_spawn => {
    emit("holo_composition_generator_ready", {})
  }

  @on_generate(composition) => {
    source = generate_holo_composition(composition)
    return source
  }

  @receipt holo_composition_generator_config {
    type: "HoloCompositionGeneratorReceipt"
    output: "pretty-printed .holo source"
    timestamp: now()
  }
}
