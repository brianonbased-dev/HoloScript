// @holo_script_plus_parser — HoloScript+ (.hsplus) parser: traits, @on_*, @receipt, capability_tags.
//
// Native .hsplus surface for core/parser/HoloScriptPlusParser.ts.
//
// parse(source) → HSPlusAST / parseFile(path) → HSPlusAST
// Entry for all .hsplus source; produces typed AST consumed by compiler targets

@trait holo_script_plus_parser {
  capability_tags: ["holo_script_plus_parser", "hsplus_parser", "trait_ast", "on_event_receipt", "core"]

  @on_spawn => {
    emit("holo_script_plus_parser_ready", {})
  }

  @on_parse(source) => {
    ast = parse_holo_script_plus(source)
    return ast
  }

  @receipt holo_script_plus_parser_config {
    type: "HoloScriptPlusParserReceipt"
    format: ".hsplus"
    timestamp: now()
  }
}
