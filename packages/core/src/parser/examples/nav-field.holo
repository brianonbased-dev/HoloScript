// HoloScript `nav_field` — a typed crowd-steering field.
//
// The sovereign answer to Unreal's AI/nav + crowd framework (CG-325): agents are
// steered by a stack of typed field-based behaviors, each authored as
// `<id> { type: "<behavior>", ...params }`, all lowering to a real WGSL compute
// shader that accumulates a per-agent steering force and integrates velocity
// clamped to max_speed. The behavior stack is typed data the compiler solves —
// not a per-engine behavior-tree binary.
//
// Supported behaviors (first increment): seek, flee, flow, arrive.
composition "NavFieldDemo" {
  nav_field "market_crowd" {
    agents: 500
    max_speed: 3.0

    goal { type: "arrive", target_x: 12.0, target_z: 4.0, slow_radius: 3.0, weight: 1.0 }
    lane { type: "flow", dir_x: 1.0, dir_z: 0.0, weight: 0.4 }
    shy  { type: "flee", target_x: 0.0, target_z: 0.0, weight: 0.6 }
  }
}
