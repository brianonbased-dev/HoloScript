@trait {
  name: "@segment",
  category: "analytics",
  description: "Segment analytics. method is the HTTP method for tracking events. mode: on-demand (default), interval, always. interval_ms is the tracking interval in ms (default: 1,000ms). image_source_prop is the node property name holding the image source (default: imageSource). Port of SegmentTrait.ts (handler name: @segment).",
  props: {
    mode: enum("on-demand" | "interval" | "always") = "on-demand",
    interval_ms: number = 1000,
    image_source_prop: string = "imageSource"
  },
  events: {
    on_tracked: "segment:tracked",
    track: "segment.track",
    identify: "segment.identify"
  },
  behaviors: ["@analytics", "@telemetry", "@service_observability"]
}
