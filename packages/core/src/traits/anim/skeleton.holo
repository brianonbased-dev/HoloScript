@trait {
  name: "@skeleton",
  category: "anim",
  description: "Bone skeleton definition for rigged mesh animation. Stores the bind pose, bone hierarchy, and inverse bind matrices used by skinning and IK. Authored from SkeletonTrait.ts.",
  props: {
    rig_url: string = "",
    bone_count: number = 0,
    root_bone: string = "Hips",
    scale: number = 1.0,
    up_axis: enum("Y" | "Z" | "-Y") = "Y",
    retarget_mode: enum("none" | "heuristic" | "humanoid" | "custom") = "humanoid",
    skin_normals: boolean = true
  },
  events: {
    attached: "skeleton_attached",
    detached: "skeleton_detached",
    on_loaded: "skeleton_loaded",
    on_retarget: "skeleton_retarget",
    on_pose_reset: "skeleton_pose_reset",
    set_pose: "skeleton_set_pose",
    reset: "skeleton_reset"
  },
  behaviors: ["@animation", "@ik", "@avatar_embodiment"]
}
