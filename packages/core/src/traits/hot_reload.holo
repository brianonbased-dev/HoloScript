@trait {
  name: "@hot_reload",
  category: "development",
  description: "Hot-reload watcher — detects source changes and re-attaches traits without a full scene restart. Config is environment-dependent and passed through to HotReloadWatcher. Port of HotReloadTrait.ts (handler name: hot_reload).",
  props: {},
  events: {
    on_reloaded: "hot_reload:reloaded",
    on_error: "hot_reload:error",
    reload: "hot_reload.reload"
  },
  behaviors: ["@fixture", "@chaos_test"]
}
