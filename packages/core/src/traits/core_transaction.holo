@trait {
  name: "@core_transaction",
  category: "finance",
  description: "Core transaction ledger handler — wallet-keyed economic transaction state machine with CAEL receipt integration. defaultConfig is empty; transaction parameters (amount, token, from, to) are supplied via transaction.submit events. State machine: idle → pending → confirming → confirmed | failed | cancelled. Emits CAEL receipts on confirmed/failed. __tx_ledger integrates with the HoloMesh x402 ledger. NOTE: this is the core ledger handler; banking-finance-plugin @transaction handles domain-specific banking transfer objects. Port of core/traits/TransactionTrait.ts (handler name: transaction). Named @core_transaction (matching this file's own filename, and the cross-reference already made from ../zk_private.holo's behaviors list in the same original commit, 34accff12) to disambiguate from atomic_transaction.holo's @atomic_transaction and economics/transaction.holo's @transaction — all three previously declared the identical bare name '@transaction' (task_1784182188049_7xzd, 2026-07-16). This file is the closest native description of the actually-shipped packages/core/src/traits/TransactionTrait.ts handler (transactionHandler, barrel-exported), which is why it keeps 'transaction' in its own filename/identity even though the bare @transaction name now belongs to economics/transaction.holo.",
  props: {},
  events: {
    on_submitted: "transaction_submitted",
    on_confirmed: "transaction_confirmed",
    on_failed: "transaction_failed",
    on_cancelled: "transaction_cancelled",
    submit: "transaction.submit",
    cancel: "transaction.cancel"
  },
  behaviors: ["@zk_private", "@provenance"]
}
