@trait {
  name: "@faceted_search",
  category: "retrieval",
  description: "Faceted search index — builds categorical facets from entity properties and supports filtered queries. max_facets is the maximum tracked facets (default: 20). Port of FacetedSearchTrait.ts (handler name: faceted_search).",
  props: {
    max_facets: number = 20
  },
  events: {
    on_indexed: "faceted_search:indexed",
    on_results: "faceted_search:results",
    index: "faceted_search.index",
    search: "faceted_search.search",
    clear: "faceted_search.clear"
  },
  behaviors: ["@embedding_search", "@cache"]
}
