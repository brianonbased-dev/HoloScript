@trait {
  name: "@proximity_chat",
  category: "social",
  description: "Spatial proximity voice and text chat channel. Mixes audio volume by distance from the listener and filters text messages to entities within a configurable radius, enabling realistic conversation clusters in open-world scenes. Authored from ProximityChatTrait.ts.",
  props: {
    radius_m: number = 10,
    falloff: enum("linear" | "inverse_square" | "none") = "linear",
    voice_enabled: boolean = true,
    text_enabled: boolean = true,
    channel_id: string = "",
    mute_outside: boolean = true
  },
  events: {
    attached: "proximity_chat_attached",
    detached: "proximity_chat_detached",
    on_join: "proximity_chat_join",
    on_leave: "proximity_chat_leave",
    on_message: "proximity_chat_message"
  },
  behaviors: ["@chat", "@spatial_audio", "@proximity_zone"]
}
