@trait {
  name: "@sensor",
  category: "system",
  description: "Physical and virtual sensor binding for IoT, robotics, and mixed-reality pipelines. type identifies the sensor modality: imu (inertial measurement unit — accelerometer + gyroscope), gps (global positioning, lat/lon/alt), lidar (depth point-cloud), camera (RGB or depth-RGB), mic (microphone audio stream), baro (barometric pressure), temp (thermometer), or custom (application-defined protocol). sample_rate_hz is the requested sample frequency in Hz; the runtime negotiates with the hardware and delivers the closest achievable rate. calibration_offset is a 3-component [x, y, z] vector added to each raw reading before delivery — use it to zero-out mounting offsets for imu, gps bias, or LiDAR extrinsics. noise_sigma is the standard deviation of additive Gaussian noise injected in simulation mode; set to 0.0 to disable noise injection. on_sample fires on each delivered reading, carrying timestamp_ms (monotonic), raw_value (type-specific payload), and calibrated_value (raw_value with calibration_offset applied). on_error fires when the sensor is unreachable, the stream drops, or a reading is out-of-range, carrying code and message. units is a human-readable SI or sensor-native unit string for display and pipeline validation (e.g. 'm/s²', 'deg', 'Pa', '°C'). low_pass_cutoff_hz applies a first-order IIR low-pass filter to numeric sensor readings at the specified cutoff frequency; 0.0 disables the filter. Pairs with @agent_memory to persist sensor history and @telemetry for metric pipeline integration. Research: SensorTrait.ts v2.0, SensorSamplingTrait.ts.",
  props: {
    type: enum("imu" | "gps" | "lidar" | "camera" | "mic" | "baro" | "temp" | "custom") = "imu",
    sample_rate_hz: number = 100,
    calibration_offset: list<number> = [0.0, 0.0, 0.0],
    noise_sigma: number = 0.0,
    units: string = "",
    low_pass_cutoff_hz: number = 0.0
  },
  events: {
    attached: "sensor:attached",
    detached: "sensor:detached",
    on_sample: "sensor:sample",
    on_error: "sensor:error",
    stream_started: "sensor:stream_started",
    stream_stopped: "sensor:stream_stopped",
    on_start: "sensor:cmd_start",
    on_stop: "sensor:cmd_stop",
    on_set_rate: "sensor:cmd_set_rate"
  },
  behaviors: ["@agent_memory", "@telemetry"]
}
