@trait {
  name: "@session",
  category: "system",
  description: "Lifecycle-managed user or agent session with configurable persistence, encryption, and backend storage. session_id is the stable external identifier used to resume or share the session across restarts — if empty the runtime generates a UUID on on_start. max_duration_ms is the hard wall-clock limit in milliseconds after which the session expires regardless of activity; 0 means unlimited. idle_timeout_ms is the inactivity window — the session expires if no on_resume or activity event arrives within this interval; 0 disables idle expiry. persistent, when true, serialises the session state to the configured backend so it survives process restarts; false keeps state in-memory only (ephemeral). encrypt, when true, wraps the serialised session payload with the entity's key via @encryption before writing to the backend; requires @encryption to be composed on the same entity. backend selects the session store: local uses the in-process volatile store (fastest, no persistence across restarts even when persistent is true unless the host runtime provides a durable local adapter), redis connects to the Redis URL in the environment's HOLOSCRIPT_REDIS_URL secret for distributed session sharing across nodes, holoscript uses the HoloScript mesh session store backed by the MCP orchestrator (sovereign, supports agent wallet auth). on_start fires when a fresh session is created, carrying session_id and created_at. on_resume fires when an existing persistent session is rehydrated, carrying session_id and resumed_at. on_pause fires when the entity suspends the session (e.g. backgrounding), carrying session_id. on_expire fires when the session hits max_duration_ms or idle_timeout_ms, carrying session_id and reason ('idle' | 'max_duration'). on_end fires when the session is explicitly terminated via on_terminate, carrying session_id and ended_at. Research: SessionTrait.ts v5.1.",
  props: {
    session_id: string = "",
    max_duration_ms: number = 0,
    idle_timeout_ms: number = 1800000,
    persistent: boolean = false,
    encrypt: boolean = false,
    backend: enum("local" | "redis" | "holoscript") = "local"
  },
  events: {
    attached: "session:attached",
    detached: "session:detached",
    on_start: "session:started",
    on_resume: "session:resumed",
    on_pause: "session:paused",
    on_expire: "session:expired",
    on_end: "session:ended",
    on_create: "session:cmd_create",
    on_terminate: "session:cmd_terminate",
    on_validate: "session:cmd_validate"
  },
  behaviors: ["@encryption"]
}
