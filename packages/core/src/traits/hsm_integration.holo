@trait {
  name: "@hsm_integration",
  category: "security",
  description: "Hardware Security Module integration for secure key storage and cryptographic operations. hsm_provider is the HSM provider type. key_type is the cryptographic key type. enable_key_rotation enables automatic key rotation (default: false). audit_logging enables HSM operation audit logging (default: false). Port of HSMIntegrationTrait.ts (handler name: hsm_integration).",
  props: {
    hsm_provider: string = "software",
    key_type: string = "rsa-2048",
    enable_key_rotation: boolean = false,
    rotation_period_days: number = 365,
    audit_logging: boolean = false
  },
  events: {
    on_key_created: "hsm_integration:key_created",
    on_key_rotated: "hsm_integration:key_rotated",
    on_signed: "hsm_integration:signed",
    on_error: "hsm_integration:error",
    sign: "hsm_integration.sign",
    verify: "hsm_integration.verify"
  },
  behaviors: ["@encryption", "@audit_log"]
}
