@trait {
  name: "@voice_output",
  category: "audio",
  description: "Text-to-speech voice output. Config is device-dependent and set at class construction. Port of VoiceOutputTrait.ts (handler name: voice_output).",
  props: {},
  events: {
    on_speaking: "voice_output:speaking",
    on_done: "voice_output:done",
    speak: "voice_output.speak",
    stop: "voice_output.stop"
  },
  behaviors: ["@voice_input", "@spatial_voice", "@neural_link"]
}
