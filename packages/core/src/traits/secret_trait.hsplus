// @secret_trait — Secret resolution: resolves named secrets from HoloKey vault at runtime.
//
// Native .hsplus surface for core/traits/SecretTrait.ts.
// Secrets NEVER authored as literals — always resolved via vault at runtime (W.749).

@trait secret_trait {
  capability_tags: ["secret_trait", "holokey_vault", "runtime_resolve", "secret_access", "core"]

  @on_spawn(secret_name) => {
    init_secret(secret_name)
    emit("secret_ready", {})
  }

  @on_resolve => {
    value = resolve_secret_from_vault()
    return value
  }

  @receipt secret_trait_config {
    type: "SecretTraitReceipt"
    doc: "W.749 HoloKey vault cutover — NEVER author a literal secret in .hsplus"
    timestamp: now()
  }
}
