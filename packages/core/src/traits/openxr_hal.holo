@trait {
  name: "@openxr_hal",
  category: "xr",
  description: "OpenXR hardware abstraction layer — connects to the HMD runtime (Quest 3, Quest Pro, etc.). preferred_refresh_rate in Hz (0 = device default). enable_passthrough enables camera passthrough (default: false). enable_hand_tracking enables skeletal hand tracking (default: true). enable_eye_tracking enables eye tracking (default: false). performance_mode: balanced (default), low_power, high_performance. fallback_mode: simulate (default), desktop. Port of OpenXRHALTrait.ts (handler name: openxr_hal).",
  props: {
    preferred_refresh_rate: number = 0,
    enable_passthrough: boolean = false,
    enable_hand_tracking: boolean = true,
    enable_eye_tracking: boolean = false,
    performance_mode: enum("balanced" | "low_power" | "high_performance") = "balanced",
    fallback_mode: enum("simulate" | "desktop") = "simulate"
  },
  events: {
    on_session_started: "openxr_hal:session_started",
    on_session_ended: "openxr_hal:session_ended",
    on_reference_space_changed: "openxr_hal:reference_space_changed"
  },
  behaviors: ["@hand_tracking", "@eye_tracked", "@passthrough_camera"]
}
