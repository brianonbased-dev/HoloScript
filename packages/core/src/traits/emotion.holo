@trait {
  name: "@emotion",
  category: "expression",
  description: "Continuous emotion model (PAD or OCC). model: pad (Pleasure-Arousal-Dominance; default), occ. default_mood is the initial emotion state (default: neutral). reactivity is how quickly emotion responds to stimuli [0,1] (default: 0.5). decay_rate is the rate of return to neutral [0,1] (default: 0.1). Port of EmotionTrait.ts (handler name: emotion).",
  props: {
    model: enum("pad" | "occ") = "pad",
    default_mood: string = "neutral",
    reactivity: number = 0.5,
    decay_rate: number = 0.1
  },
  events: {
    on_changed: "emotion:changed",
    on_peak: "emotion:peak",
    on_neutral: "emotion:neutral",
    trigger: "emotion.trigger"
  },
  behaviors: ["@emotion_directive", "@neural_expression", "@ai_companion"]
}
