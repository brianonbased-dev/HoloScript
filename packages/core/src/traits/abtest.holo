@trait {
  name: "@abtest",
  category: "analytics",
  description: "A/B test experiment runner. enabled activates the experiment (default: true). default_strategy: equal (default), weighted, multi_armed_bandit. alpha is the statistical significance threshold (default: 0.05). min_sample_size is the minimum samples per variant (default: 30). Port of ABTestTrait.ts (handler name: abtest).",
  props: {
    enabled: boolean = true,
    default_strategy: enum("equal" | "weighted" | "multi_armed_bandit") = "equal",
    alpha: number = 0.05,
    min_sample_size: number = 30
  },
  events: {
    on_assigned: "abtest:assigned",
    on_converted: "abtest:converted",
    on_result: "abtest:result"
  },
  behaviors: ["@analytics", "@rollout", "@feedback_loop"]
}
