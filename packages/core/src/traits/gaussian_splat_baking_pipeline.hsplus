// @gaussian_splat_baking_pipeline — End-to-end Gaussian splat bake: capture → train → export → pack.
//
// Native .hsplus surface for core/traits/GaussianSplatBakingPipeline.ts.

@trait gaussian_splat_baking_pipeline {
  capability_tags: ["gaussian_splat_baking", "capture_train_export", "splat_pipeline", "3dgs_bake", "core"]

  @on_spawn(config) => {
    init_splat_bake_pipeline(config)
    emit("gaussian_splat_baking_ready", {})
  }

  @on_run(image_set) => {
    result = run_splat_baking_pipeline(image_set)
    emit("splat_baked", { path: result.output_path })
    return result
  }

  @receipt gaussian_splat_baking_pipeline_config {
    type: "GaussianSplatBakingPipelineReceipt"
    stages: ["capture", "train", "export", "pack"]
    timestamp: now()
  }
}
