@trait {
  name: "@form_builder",
  category: "interaction",
  description: "Declarative dynamic form schema: declares a list of typed field descriptors, a submission endpoint, autosave behaviour, and lifecycle event hooks. Each entry in fields carries name (the data-key), type (the input modality: text, email, number, password, textarea, select, checkbox, date, file), label (the human-visible caption), required (whether the field blocks submission if empty), and validators (a list of constraint strings such as 'minLength:3', 'maxEmail', 'regex:[A-Z]+'). submit_url is the HTTP endpoint the runtime POSTs the serialised form payload to when on_submit fires. on_submit fires when the user confirms the form; on_validate fires after each field edit to run the field validators and collect errors; on_error fires when validation finds a blocking constraint; on_reset restores all fields to their initial empty state. autosave enables automatic draft persistence on each successful field change; autosave_interval_ms controls how frequently the runtime flushes the draft to the autosave backend (0 = on every change). Pairs with @text_input for inline field rendering, @autocomplete for field-level suggestions, @notification for confirmation banners, and @scrollable for long multi-field layouts. Research: FormBuilderTrait.ts (field schema, state machine), AutocompleteTrait.ts (suggestion source).",
  props: {
    fields: array<{ name: string, type: enum("text" | "email" | "number" | "password" | "textarea" | "select" | "checkbox" | "date" | "file"), label: string, required: boolean, validators: array<string> }> = [],
    submit_url: string = "",
    on_submit: string = "form:submit",
    on_validate: string = "form:validate",
    on_error: string = "form:error",
    on_reset: string = "form:reset",
    autosave: boolean = false,
    autosave_interval_ms: number = 3000
  },
  events: {
    attached: "form:attached",
    detached: "form:detached",
    submitted: "form:submitted",
    validated: "form:validated",
    validation_error: "form:validation_error",
    reset: "form:reset_done",
    draft_saved: "form:draft_saved",
    field_changed: "form:field_changed",
    on_submit: "form:submit",
    on_validate: "form:validate",
    on_error: "form:error",
    on_reset: "form:reset",
    on_set_field: "form:set_field",
    on_clear_draft: "form:clear_draft"
  },
  behaviors: ["@accessible", "@keyboard_nav", "@text_input"]
}
