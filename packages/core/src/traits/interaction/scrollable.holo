@trait {
  name: "@scrollable",
  category: "interaction",
  description: "Inertial scroll container for spatial and 2D list or panel entities. axis restricts scroll movement to the horizontal (x), vertical (y), or both axes simultaneously. elastic enables rubber-band overshoot at the scroll boundary — the content springs back when released past the edge. velocity_decay is the per-frame friction coefficient applied to scroll inertia after the user releases (0 = instant stop, values approaching 1 = long glide; typical range 0.85–0.98). snap_to_grid snaps the final resting position to the nearest item_size grid cell once the velocity falls below the rest threshold. item_size defines the width and height of each logical grid cell in metres for snap alignment; ignored when snap_to_grid is false. on_scroll fires every frame the scroll offset changes. on_snap fires once when the content settles on a grid cell (only when snap_to_grid is true). on_start fires at the first touch or pointer-down that begins a scroll gesture. on_end fires when the gesture is released and inertia has settled. Pairs with @trigger for scroll-zone hit testing and @transform for viewport placement. Research: ScrollableTrait.ts v1.0.0 inertia + spring bounce.",
  props: {
    axis: enum("x" | "y" | "both") = "y",
    elastic: boolean = true,
    velocity_decay: number = 0.92,
    snap_to_grid: boolean = false,
    item_size: { x: number, y: number } = { x: 0.1, y: 0.1 }
  },
  events: {
    attached: "scrollable:attached",
    detached: "scrollable:detached",
    on_scroll: "scrollable:scroll",
    on_snap: "scrollable:snap",
    on_start: "scrollable:start",
    on_end: "scrollable:end",
    on_set_axis: "scrollable:set_axis",
    on_set_velocity_decay: "scrollable:set_velocity_decay",
    on_scroll_to: "scrollable:scroll_to",
    on_reset: "scrollable:reset"
  },
  behaviors: ["@transform"]
}
