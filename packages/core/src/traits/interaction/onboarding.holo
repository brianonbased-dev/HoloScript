@trait {
  name: "@onboarding",
  category: "interaction",
  description: "User onboarding flow coordinator. Steps new users through a sequence of contextual tooltips, interactive tutorials, and completion milestones, persisting progress and adapting to skipped steps. Authored from OnboardingTrait.ts.",
  props: {
    steps: list<{ id: string, title: string, target_entity: string, skippable: boolean }> = [],
    current_step: number = 0,
    completed: boolean = false,
    skip_all: boolean = false,
    persist_progress: boolean = true,
    show_progress_bar: boolean = true,
    completion_reward: string = ""
  },
  events: {
    attached: "onboarding_attached",
    detached: "onboarding_detached",
    on_step: "onboarding_step",
    on_complete: "onboarding_complete",
    on_skip: "onboarding_skip",
    next_step: "onboarding_next",
    skip_all: "onboarding_skip_all"
  },
  behaviors: ["@tutorial", "@quest_system", "@analytics"]
}
