@trait {
  name: "@spatial_navigation",
  category: "xr",
  description: "Spatial turn-by-turn navigation. navigation_mode: walking (default), driving, cycling. path_visualization: arrow (default), line, dotted, none. show_distance displays distance to next waypoint (default: true). show_eta displays estimated arrival (default: true). Port of SpatialNavigationTrait.ts (handler name: spatial_navigation).",
  props: {
    navigation_mode: enum("walking" | "driving" | "cycling") = "walking",
    path_visualization: enum("arrow" | "line" | "dotted" | "none") = "arrow",
    show_distance: boolean = true,
    show_eta: boolean = true
  },
  events: {
    on_waypoint_reached: "spatial_navigation:waypoint_reached",
    on_arrived: "spatial_navigation:arrived",
    on_rerouted: "spatial_navigation:rerouted",
    navigate: "spatial_navigation.navigate",
    stop: "spatial_navigation.stop"
  },
  behaviors: ["@navmesh_solver", "@geospatial_anchor", "@poi"]
}
