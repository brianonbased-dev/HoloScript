@trait {
  name: "@nft",
  category: "nft",
  description: "Blockchain NFT ownership binding for HoloScript entities. Verifies on-chain ownership, loads ERC-721/ERC-1155/SPL metadata, and gates display or transfer actions on proof. contract_address is the token contract on the chosen chain. token_id is the on-chain token identifier (uint256 for EVM, mint address for Solana). chain selects the L1/L2 network: ethereum, polygon, base, holoscript (HoloMesh sovereign chain), and arbitrum/optimism are supported. metadata_url is the off-chain JSON metadata URI; when empty the trait fetches it from the contract tokenURI. display_mode controls how ownership state is surfaced: 2d renders a flat badge overlay, 3d injects a visual proof marker into the scene, vr shows an immersive ownership indicator in headset context. royalty_bps records the creator royalty in basis points (e.g. 500 = 5%) — informational at the trait layer; enforcement is provenance-anchored at listing time via @economy_primitives. transferable enables the on_transfer event pathway; when false, transfer attempts emit on_error. Pairs with @economy_primitives for price-oracle and listing-mode coordination. Research: NFTTrait.ts — NFTConfig, BlockchainNetwork, verifyOwnership / loadMetadata flows, transfer events.",
  props: {
    contract_address: string = "",
    token_id: string = "",
    chain: enum("ethereum" | "polygon" | "base" | "holoscript" | "arbitrum" | "optimism") = "ethereum",
    metadata_url: string = "",
    display_mode: enum("2d" | "3d" | "vr") = "2d",
    royalty_bps: number = 500,
    transferable: boolean = false
  },
  events: {
    attached: "nft:attached",
    detached: "nft:detached",
    on_verified: "nft:verified",
    on_metadata_loaded: "nft:metadata_loaded",
    on_transferred: "nft:transferred",
    on_error: "nft:error",
    on_verify: "nft:verify",
    on_refresh_metadata: "nft:refresh_metadata",
    on_transfer: "nft:transfer",
    on_check_owner: "nft:check_owner",
    on_query: "nft:query"
  },
  behaviors: ["@economy_primitives", "@transform"]
}
