@trait {
  name: "@query",
  category: "data",
  description: "Generic query adapter. default_limit is the default result page size (default: 50). max_limit is the maximum allowed limit (default: 1000). Port of QueryTrait.ts (handler name: query).",
  props: {
    default_limit: number = 50,
    max_limit: number = 1000
  },
  events: {
    on_result: "query:result",
    on_error: "query:error",
    query: "query.query"
  },
  behaviors: ["@vector_search", "@sql_query", "@rag_knowledge"]
}
