@trait {
  name: "@embedding",
  category: "embedding",
  description: "Vector embedding generation for text and structured data. Attaches a configurable embedding model (default text-embedding-3-small, 1536-dim), exposes generate/result events for in-scene semantic search, RAG pipelines, and similarity queries. Backend enum gates OpenAI, local ONNX, or HoloScript-native inference. auto_index wires the output into the attached @vector_search index automatically.",
  props: {
    model: string = "text-embedding-3-small",
    dimension: number = 1536,
    backend: enum("openai" | "onnx" | "holoscript" | "mock") = "openai",
    auto_index: boolean = false,
    index_namespace: string = "",
    batch_size: number = 8,
    normalize: boolean = true
  },
  events: {
    generated: "embedding_generated",
    indexed: "embedding_indexed",
    error: "embedding_error",
    on_generate: "embedding_generate",
    on_batch_generate: "embedding_batch_generate",
    on_query: "embedding_query",
    on_reset: "embedding_reset"
  },
  behaviors: ["@vector_search"]
}
