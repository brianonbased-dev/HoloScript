@trait {
  name: "@twin_actuator",
  category: "spatial",
  description: "Digital-twin actuation bridge that relays commands from a HoloScript scene node to a physical device via a protocol adapter. device_id is the unique identifier of the target hardware actuator — matched against the physical-twin registry at runtime. protocol selects the wire protocol: ros2 (ROS 2 DDS topic), modbus (Modbus TCP/RTU coil/register write), opcua (OPC-UA node write), or holoscript (HoloMesh sovereign actuation channel). command_schema is a dict declaring the expected command payload structure (field names → type tags) consumed by the compile target to generate schema-validated message serialisers. feedback_schema is a dict declaring the inbound feedback payload structure emitted by the device and surfaced to the scene. safety_envelope is the identifier of a registered TwinEarth safety envelope that must be substrate-enforced before any actuation command is dispatched — empty string means no envelope is configured and actuation commands will be blocked (D.044 structural civilian-harm impossibility). Emits on_command when a validated command is dispatched to the physical layer, on_feedback when the device returns a state update, and on_error when a command is rejected (safety-envelope block, schema violation, device unreachable, or limit exceeded). Research: TwinActuatorTrait.ts — TwinActuatorConfig, SafetyEnvelope, validateSafetyEnvelope, twin_command event flow.",
  props: {
    device_id: string = "",
    protocol: enum("ros2" | "modbus" | "opcua" | "holoscript") = "ros2",
    command_schema: dict<string, string> = {},
    feedback_schema: dict<string, string> = {},
    safety_envelope: string = ""
  },
  events: {
    attached: "twin_actuator:attached",
    detached: "twin_actuator:detached",
    on_command: "twin_actuator:command",
    on_feedback: "twin_actuator:feedback",
    on_error: "twin_actuator:error",
    on_actuate: "twin_actuator:actuate",
    on_halt: "twin_actuator:halt",
    on_query_state: "twin_actuator:query_state"
  },
  behaviors: ["@transform"]
}
