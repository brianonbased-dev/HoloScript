@trait {
  name: "@scene_graph",
  category: "spatial",
  description: "Hierarchical scene graph manager for HoloScript spatial compositions. Maintains a parent-child node tree rooted at the entity, with configurable depth and node budgets for performance governance. max_depth caps the number of parent-child levels permitted beneath the root; attempts to add nodes beyond max_depth fire on_node_added with an error payload and are rejected. node_count is a read-only gauge of current active nodes; when it reaches max_nodes the graph stops accepting new nodes until existing ones are removed. dirty_tracking, when true, marks only nodes whose transform or state changed since the last frame, enabling partial update pipelines that skip clean subtrees (significant GPU bandwidth saving in large scenes). instancing, when true, enables draw-call batching for nodes that share the same mesh and material — the graph maintains an instance pool and collapses eligible siblings into a single GPU instanced draw call. cull_frustum, when true, activates view-frustum culling: nodes whose bounding volumes fall entirely outside the current camera frustum are skipped in the render traversal and have their on_node_removed event suppressed (they remain in the graph, only the draw is skipped). on_node_added fires when a node is successfully attached to the graph with the node_id, parent_id, and transform. on_node_removed fires when a node is detached, providing node_id and reason. on_node_moved fires when a node's transform changes with node_id, old_transform, and new_transform. on_node_reparented fires when a node's parent changes with node_id, old_parent_id, and new_parent_id. Research: SceneGraphTrait.ts, usd_stage.holo, spatial/transform.holo.",
  props: {
    max_depth: number = 32,
    max_nodes: number = 10000,
    dirty_tracking: boolean = true,
    instancing: boolean = false,
    cull_frustum: boolean = true
  },
  events: {
    attached: "scene_graph:attached",
    detached: "scene_graph:detached",
    ready: "scene_graph:ready",
    on_node_added: "scene_graph:node_added",
    on_node_removed: "scene_graph:node_removed",
    on_node_moved: "scene_graph:node_moved",
    on_node_reparented: "scene_graph:node_reparented",
    on_add_node: "scene_graph:cmd_add_node",
    on_remove_node: "scene_graph:cmd_remove_node",
    on_move_node: "scene_graph:cmd_move_node",
    on_reparent_node: "scene_graph:cmd_reparent_node",
    on_clear: "scene_graph:cmd_clear",
    on_traverse: "scene_graph:cmd_traverse"
  },
  behaviors: ["@transform"]
}
