@trait {
  name: "@lotus_gardener",
  category: "lotus",
  description: "Lotus gardener — coordinates watering pulses that nourish the Lotus bloom lifecycle. bloom_state_source is the prop path for bloom state. base_pulse_interval_s is the base pulse cadence in seconds (default: 5.0). base_pulse_intensity is the base pulse brightness (default: 0.7). base_droplet_count is the droplets per pulse (default: 8). Port of LotusGardenerTrait.ts (handler name: lotus_gardener).",
  props: {
    bloom_state_source: string = "lotus.api.bloom_state",
    base_pulse_interval_s: number = 5.0,
    base_pulse_intensity: number = 0.7,
    base_droplet_count: number = 8
  },
  events: {
    on_pulse: "lotus_gardener:pulse",
    on_watered: "lotus_gardener:watered"
  },
  behaviors: ["@lotus_center", "@cron"]
}
