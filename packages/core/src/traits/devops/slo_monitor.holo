@trait {
  name: "@slo_monitor",
  category: "devops",
  description: "Service level objective monitor. Tracks error budget burn rate, availability SLOs, and latency targets. Pages oncall when burn rate exceeds threshold. Authored from SLOMonitorTrait.ts.",
  props: {
    slo_pct: number = 99.9,
    window_days: number = 30,
    latency_p99_ms: number = 500,
    error_budget_alert_pct: number = 50.0,
    fast_burn_window_h: number = 1.0,
    slow_burn_window_h: number = 6.0,
    oncall_webhook_secret: string = ""
  },
  events: {
    attached: "slo_monitor_attached",
    detached: "slo_monitor_detached",
    on_breach: "slo_monitor_breach",
    on_recovery: "slo_monitor_recovery",
    on_fast_burn: "slo_monitor_fast_burn",
    on_budget_exhausted: "slo_monitor_budget_exhausted",
    on_sample: "slo_monitor_sample"
  },
  behaviors: ["@alert", "@telemetry", "@circuit_breaker"]
}
