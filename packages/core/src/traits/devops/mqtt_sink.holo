@trait {
  name: "@mqtt_sink",
  category: "devops",
  description: "MQTT publish sink for node state. Publishes node state to a configured broker/topic on every state change (or tick if onChangeOnly=false). Topic supports {nodeId} placeholders. QoS 0/1/2. JSON serialization optional. Change detection via state hash. Throttle limits publish rate (ms). Port of MQTTSinkTrait.ts (handler name: mqtt_sink).",
  props: {
    broker: string = "mqtt://localhost:1883",
    topic: string = "holoscript/{nodeId}/state",
    retain: boolean = false,
    qos: number = 0,
    on_change_only: boolean = true,
    auto_connect: boolean = true,
    serialize_json: boolean = true,
    include_timestamp: boolean = false
  },
  events: {
    attached: "mqtt_sink_ready",
    on_connected: "mqtt_sink_connected",
    on_published: "mqtt_sink_published",
    on_error: "mqtt_sink_error",
    connect: "mqtt_sink_connect",
    disconnect: "mqtt_sink_disconnect",
    publish: "mqtt_sink_publish"
  },
  behaviors: ["@mqtt_source", "@websocket"]
}
