@trait {
  name: "@log_aggregator",
  category: "devops",
  description: "Structured log aggregation and forwarding. Collects logs from entity handlers, enriches them with trace IDs and session context, and ships them to Loki, Datadog, or a custom ingest endpoint. Authored from LogAggregatorTrait.ts.",
  props: {
    backend: enum("loki" | "datadog" | "cloudwatch" | "stdout" | "holoscript") = "holoscript",
    endpoint_url: string = "",
    api_key_secret: string = "",
    min_level: enum("debug" | "info" | "warn" | "error") = "info",
    batch_size: number = 100,
    flush_interval_ms: number = 5000,
    include_trace_id: boolean = true,
    labels: dict<string, string> = {}
  },
  events: {
    attached: "log_aggregator_attached",
    detached: "log_aggregator_detached",
    on_flush: "log_aggregator_flush",
    on_error: "log_aggregator_error",
    log: "log_aggregator_log",
    flush: "log_aggregator_trigger_flush"
  },
  behaviors: ["@audit_log", "@telemetry", "@alert"]
}
