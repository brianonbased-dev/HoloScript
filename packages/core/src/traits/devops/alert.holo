@trait {
  name: "@alert",
  category: "devops",
  description: "Operational alerting trait that routes threshold-triggered or condition-triggered notifications to one or more external channels with built-in throttling, deduplication, and escalation. level sets the severity classification of alerts emitted by this entity: info represents informational signals that do not require action; warn indicates a degraded state the on-call engineer should review; error signals a service failure needing prompt intervention; critical indicates a high-impact outage requiring immediate response; fatal signals an unrecoverable condition that will halt the system. channel selects the notification destination: email delivers to the configured address list; slack posts to the configured webhook; pagerduty creates an incident in the PagerDuty service; holoscript routes through the HoloScript mesh notification bus for in-ecosystem delivery. throttle_ms is the minimum quiet period in milliseconds between successive alert deliveries; alerts that arrive inside the throttle window are dropped and not queued. dedup_window_ms is the deduplication look-back window: an alert with the same level and trigger source that already fired within this window is silently absorbed to prevent alert storms. escalation_delay_ms is the delay after the initial alert before the runtime automatically re-sends at the next higher severity level if the alert has not been acknowledged; set to 0 to disable escalation. on_trigger fires when a new alert is dispatched, carrying level, channel, message, and alert_id. on_acknowledge fires when an operator or automation marks an alert resolved before escalation, carrying alert_id and acknowledged_by. on_resolve fires when the triggering condition clears and the alert lifecycle closes, carrying alert_id and duration_ms. Research: AlertTrait.ts v2.0 — severity map, cooldown gate, dedup cache, escalation timer, SlackAlertTrait.ts, PagerdutyTrait.ts.",
  props: {
    level: enum("info" | "warn" | "error" | "critical" | "fatal") = "warn",
    channel: enum("email" | "slack" | "pagerduty" | "holoscript") = "holoscript",
    throttle_ms: number = 60000,
    dedup_window_ms: number = 300000,
    escalation_delay_ms: number = 0
  },
  events: {
    attached: "alert:attached",
    detached: "alert:detached",
    on_trigger: "alert:trigger",
    on_acknowledge: "alert:acknowledge",
    on_resolve: "alert:resolve",
    escalated: "alert:escalated",
    throttled: "alert:throttled",
    deduplicated: "alert:deduplicated",
    error: "alert:error",
    on_set_level: "alert:set_level",
    on_set_channel: "alert:set_channel"
  },
  behaviors: ["@telemetry"]
}
