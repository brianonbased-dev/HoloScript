@trait {
  name: "@deploy",
  category: "devops",
  description: "Service deployment trigger and lifecycle manager. Initiates builds, pushes container images, and coordinates Railway/Docker/Jetson deploy targets. Authored from DeployTrait.ts.",
  props: {
    target: enum("railway" | "docker" | "jetson" | "k8s" | "holoscript") = "holoscript",
    service_id: string = "",
    image_url: string = "",
    env_vars: dict<string, string> = {},
    health_check_url: string = "",
    auto_rollback: boolean = true,
    timeout_s: number = 300
  },
  events: {
    attached: "deploy_attached",
    detached: "deploy_detached",
    on_start: "deploy_start",
    on_success: "deploy_success",
    on_fail: "deploy_fail",
    on_rollback: "deploy_rollback",
    on_health: "deploy_health",
    deploy: "deploy_trigger",
    rollback: "deploy_trigger_rollback"
  },
  behaviors: ["@rollout", "@health_check", "@canary"]
}
