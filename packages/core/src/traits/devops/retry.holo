@trait {
  name: "@retry",
  category: "devops",
  description: "Configurable retry policy for fallible operations. Applies exponential backoff, jitter, and deadline enforcement to any handler event, emitting success, exhausted, or aborted signals. Authored from RetryTrait.ts.",
  props: {
    max_attempts: number = 3,
    initial_delay_ms: number = 500,
    backoff_factor: number = 2.0,
    max_delay_ms: number = 30000,
    jitter: boolean = true,
    deadline_ms: number = 0,
    on_exhaust: enum("throw" | "return_last_error" | "return_default") = "throw",
    retry_on: list<string> = []
  },
  events: {
    attached: "retry_attached",
    detached: "retry_detached",
    on_attempt: "retry_attempt",
    on_success: "retry_success",
    on_exhaust: "retry_exhaust",
    on_abort: "retry_abort"
  },
  behaviors: ["@circuit_breaker", "@audit_log"]
}
