@trait {
  name: "@circuit_breaker",
  category: "devops",
  description: "Fault-isolation gate that tracks upstream failure rates and transitions through closed, open, and half_open states to prevent cascading failure. failure_threshold is the count of failures within the sliding window required to open the circuit. success_threshold is the count of consecutive successes in half_open state required to close the circuit and resume normal traffic. timeout_ms is the duration the circuit stays open before transitioning to half_open to test recovery. state reflects the current circuit position: closed allows all requests through, open blocks all requests and emits on_open immediately, half_open allows a single probe request and re-opens on failure or closes on success_threshold successes. fallback_value is an optional serialised default returned to callers when the circuit is open, so upstream consumers receive a safe degraded value instead of an error. on_open fires when the circuit trips open with the failure_count and window at the time of opening; on_close fires with the recovery duration and success_count when the circuit closes; on_half_open fires when the timeout elapses and the circuit enters probe mode. Research: CircuitBreakerTrait.ts — closed/open/half-open state machine with sliding-window failure log, failure-count and failure-rate thresholds, auto half-open transition.",
  props: {
    failure_threshold: number = 5,
    success_threshold: number = 2,
    timeout_ms: number = 30000,
    state: enum("closed" | "open" | "half_open") = "closed",
    fallback_value: string = ""
  },
  events: {
    attached: "circuit_breaker:attached",
    detached: "circuit_breaker:detached",
    on_open: "circuit_breaker:opened",
    on_close: "circuit_breaker:closed",
    on_half_open: "circuit_breaker:half_opened",
    rejected: "circuit_breaker:rejected",
    success: "circuit_breaker:success",
    failure: "circuit_breaker:failure",
    on_execute: "circuit_breaker:execute",
    on_result: "circuit_breaker:result",
    on_reset: "circuit_breaker:reset",
    on_status: "circuit_breaker:get_status"
  },
  behaviors: ["@telemetry"]
}
