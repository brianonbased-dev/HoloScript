@trait {
  name: "@control_loop",
  category: "devops",
  description: "Closed-loop PID/bang-bang controller for real-time setpoint tracking. Drives actuators in digital twins, HVAC, robotics, and adaptive systems. Authored from ControlLoopTrait.ts.",
  props: {
    mode: enum("pid" | "bang_bang" | "fuzzy" | "model_predictive") = "pid",
    kp: number = 1.0,
    ki: number = 0.0,
    kd: number = 0.0,
    setpoint: number = 0.0,
    output_min: number = -1.0,
    output_max: number = 1.0,
    update_rate_hz: number = 10,
    windup_limit: number = 100.0
  },
  events: {
    attached: "control_loop_attached",
    detached: "control_loop_detached",
    on_tick: "control_loop_tick",
    on_setpoint_reached: "control_loop_setpoint",
    on_saturate: "control_loop_saturate",
    set_setpoint: "control_loop_set",
    reset: "control_loop_reset"
  },
  behaviors: ["@sensor", "@twin_actuator", "@thermal_zone"]
}
