@trait {
  name: "@schema_migrate",
  category: "devops",
  description: "Versioned schema migration controller for HoloScript entities, persistent stores, and wire formats. from_version and to_version declare the migration contract: the runtime refuses to apply the trait to a document whose current version is not from_version. strategy selects the execution policy: forward_only applies the migration once and does not support rollback — caller must take a snapshot before migrating if recovery is needed; reversible registers both an up and a down migration handler so the runtime can roll back to from_version on error; snapshot_swap atomically swaps the entire document with a pre-migrated snapshot, providing O(1) rollback at the cost of double storage during the swap window. dry_run runs all validation and transformation logic without committing any changes to the store — on_complete fires with a dry_run flag in the payload so observers can inspect the result before committing. batch_size splits large document collections into chunks for incremental migration; set to 0 to migrate the entire collection atomically. on_start fires when the migration runner begins with from_version and to_version in the payload. on_complete fires after all documents have been migrated and validated; payload includes migrated_count and skipped_count. on_error fires if a batch fails; payload includes failed_index, error, and the partially migrated batch for forensics. on_rollback fires after a successful automatic rollback triggered by an on_error with strategy=reversible or snapshot_swap. Pairs with @version for schema-evolution-aware entity loading and @validation for post-migration integrity checks. Research: SchemaMigrateTrait.ts, MigrateTrait.ts, VersionedStateTrait.ts.",
  props: {
    from_version: string = "",
    to_version: string = "",
    strategy: enum("forward_only" | "reversible" | "snapshot_swap") = "forward_only",
    dry_run: boolean = false,
    batch_size: number = 0,
    auto_rollback: boolean = true
  },
  events: {
    attached: "schema_migrate:attached",
    detached: "schema_migrate:detached",
    on_start: "schema_migrate:start",
    on_complete: "schema_migrate:complete",
    on_error: "schema_migrate:error",
    on_rollback: "schema_migrate:rollback",
    on_progress: "schema_migrate:progress",
    on_migrate_up: "schema_migrate:up",
    on_migrate_down: "schema_migrate:down",
    on_validate: "schema_migrate:validate",
    on_status: "schema_migrate:status"
  },
  behaviors: ["@version", "@validation"]
}
