@trait {
  name: "@cache",
  category: "devops",
  description: "In-process and distributed caching layer with pluggable backends, TTL expiry, configurable eviction, and namespace isolation. backend selects the storage tier: memory uses a bounded in-process store, redis delegates to a Redis-compatible server, cdn routes cache-control headers to an edge CDN, holoscript uses the HoloScript distributed state store. ttl_s is the default time-to-live in seconds for every entry; 0 disables expiry. max_size_mb caps the total footprint of the in-process tier; entries are evicted when the limit is reached using the eviction policy. eviction controls the replacement algorithm: lru evicts the least-recently-used entry, lfu evicts the least-frequently-used entry, arc adapts between recency and frequency automatically, ttl evicts the soonest-expiring entry first regardless of access pattern. namespace scopes all cache keys to prevent cross-feature collisions — two traits with different namespaces can coexist on the same backend without key interference. on_hit fires with the key and cached value on a successful read; on_miss fires with the key when no valid entry exists; on_evict fires with the key and reason when an entry is displaced; on_clear fires after the namespace is flushed. Research: CacheTrait.ts — in-process LRU/FIFO handler with TTL expiry, cache:set/get/invalidate/clear/stats events.",
  props: {
    backend: enum("memory" | "redis" | "cdn" | "holoscript") = "memory",
    ttl_s: number = 60,
    max_size_mb: number = 64,
    eviction: enum("lru" | "lfu" | "arc" | "ttl") = "lru",
    namespace: string = "default"
  },
  events: {
    attached: "cache:attached",
    detached: "cache:detached",
    on_hit: "cache:hit",
    on_miss: "cache:miss",
    on_evict: "cache:evict",
    on_clear: "cache:clear",
    set: "cache:set",
    get: "cache:get",
    invalidate: "cache:invalidate",
    stats: "cache:stats",
    on_set: "cache:cmd_set",
    on_get: "cache:cmd_get",
    on_invalidate: "cache:cmd_invalidate",
    on_flush: "cache:cmd_flush"
  },
  behaviors: ["@feature_flag"]
}
