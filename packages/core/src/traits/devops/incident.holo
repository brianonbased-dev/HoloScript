@trait {
  name: "@incident",
  category: "devops",
  description: "Incident lifecycle manager. Fires when SLO breaches, escalation policies, or manual triggers create an incident, tracks severity changes, assigns on-call, and writes a post-mortem template. Authored from IncidentTrait.ts.",
  props: {
    severity: enum("p0" | "p1" | "p2" | "p3") = "p2",
    auto_create_on_alert: boolean = true,
    pagerduty_service_key_secret: string = "",
    slack_channel: string = "",
    escalation_timeout_s: number = 900,
    auto_resolve: boolean = false,
    postmortem_template_url: string = ""
  },
  events: {
    attached: "incident_attached",
    detached: "incident_detached",
    on_open: "incident_open",
    on_escalate: "incident_escalate",
    on_resolve: "incident_resolve",
    on_postmortem: "incident_postmortem",
    open: "incident_trigger_open",
    resolve: "incident_trigger_resolve"
  },
  behaviors: ["@alert", "@slo_monitor", "@audit_log"]
}
