@trait {
  name: "@script_test",
  category: "devops",
  description: "Headless unit-test runner for .hs and .hsplus logic. runner selects the test framework adapter: jest and vitest target Node-side JavaScript runtimes, deno targets the Deno runtime, holoscript targets the native HoloScript headless evaluator (default and recommended — the only runner that can verify .hs/.hsplus semantics without a JS transpile step). timeout_ms caps the wall-clock duration of the full test suite before an on_timeout event fires and the run is marked failed. parallel enables concurrent test execution when the runner supports it; holoscript and deno both honour this flag; jest/vitest delegate to their native worker pools. coverage emits per-file line/branch coverage payloads as on_complete payload.coverage when true; requires a coverage-instrumented build. watch re-runs the suite on any source-file change detected by the runtime file watcher. on_pass fires after each individual test case that passes, carrying the test name and duration_ms. on_fail fires after each failure with name, error, and assertion context. on_skip fires when a test block is decorated @skip or excluded by the runner filter. on_complete fires once the full run finishes with a summary: total, passed, failed, skipped, duration_ms, and optional coverage map. Pairs with @validation for schema-gated test fixtures and @feature_flag for staged test-gate roll-outs. Research: ScriptTestTrait.ts, TestTrait.ts, SnapshotTestTrait.ts, ChaosTestTrait.ts.",
  props: {
    runner: enum("jest" | "vitest" | "deno" | "holoscript") = "holoscript",
    timeout_ms: number = 5000,
    parallel: boolean = false,
    coverage: boolean = false,
    watch: boolean = false
  },
  events: {
    attached: "script_test:attached",
    detached: "script_test:detached",
    on_pass: "script_test:pass",
    on_fail: "script_test:fail",
    on_skip: "script_test:skip",
    on_complete: "script_test:complete",
    on_timeout: "script_test:timeout",
    on_run: "script_test:cmd_run",
    on_stop: "script_test:cmd_stop",
    on_set_filter: "script_test:cmd_set_filter"
  },
  behaviors: ["@validation", "@feature_flag"]
}
