@trait {
  name: "@approval",
  category: "devops",
  description: "Human-in-the-loop approval gate. Pauses execution until one or more designated approvers accept or reject the proposed action. Times out with configurable fallback. Authored from ApprovalTrait.ts.",
  props: {
    approvers: list<string> = [],
    quorum: number = 1,
    timeout_s: number = 3600,
    on_timeout: enum("reject" | "approve" | "escalate") = "reject",
    notification_channel: string = "",
    reason_required: boolean = true,
    auto_approve_roles: list<string> = []
  },
  events: {
    attached: "approval_attached",
    detached: "approval_detached",
    on_request: "approval_request",
    on_approve: "approval_approve",
    on_reject: "approval_reject",
    on_timeout: "approval_timeout",
    on_escalate: "approval_escalate",
    request: "approval_trigger_request"
  },
  behaviors: ["@hitl", "@audit_log", "@rbac"]
}
