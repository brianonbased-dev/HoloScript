@trait {
  name: "@mqtt_source",
  category: "devops",
  description: "MQTT subscription source for node state injection. Subscribes to a broker topic pattern (supports + single-level and # multi-level wildcards). JSON auto-parse optional. Received payload stored in configurable stateField (default: 'value'). Debounce suppresses rapid message bursts. Port of MQTTSourceTrait.ts (handler name: mqtt_source).",
  props: {
    broker: string = "mqtt://localhost:1883",
    topic: string = "#",
    qos: number = 0,
    parse_json: boolean = true,
    state_field: string = "value",
    auto_connect: boolean = true,
    debounce: number = 0
  },
  events: {
    attached: "mqtt_source_ready",
    on_connected: "mqtt_source_connected",
    on_message: "mqtt_source_message",
    on_error: "mqtt_source_error",
    connect: "mqtt_source_connect",
    disconnect: "mqtt_source_disconnect"
  },
  behaviors: ["@mqtt_sink", "@websocket"]
}
