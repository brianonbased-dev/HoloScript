@trait {
  name: "@load_test",
  category: "devops",
  description: "HTTP/WebSocket load test executor. Sends configurable virtual-user traffic against endpoints, records latency percentiles and error rates, and fails fast when thresholds are breached. Authored from LoadTestTrait.ts.",
  props: {
    target_url: string = "",
    protocol: enum("http" | "websocket" | "grpc") = "http",
    virtual_users: number = 100,
    ramp_up_s: number = 30,
    duration_s: number = 60,
    think_time_ms: number = 1000,
    p99_threshold_ms: number = 2000,
    error_rate_threshold_pct: number = 1.0
  },
  events: {
    attached: "load_test_attached",
    detached: "load_test_detached",
    on_start: "load_test_start",
    on_result: "load_test_result",
    on_threshold_breach: "load_test_breach",
    on_complete: "load_test_complete",
    run: "load_test_trigger_run",
    stop: "load_test_stop"
  },
  behaviors: ["@healthcheck", "@slo_monitor", "@chaos_test"]
}
