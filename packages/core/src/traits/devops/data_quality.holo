@trait {
  name: "@data_quality",
  category: "devops",
  description: "Data quality rule engine. Validates incoming data against completeness, uniqueness, freshness, and schema rules; quarantines or rejects bad records. Authored from DataQualityTrait.ts.",
  props: {
    rules: list<{ field: string, rule: enum("not_null" | "unique" | "range" | "regex" | "freshness" | "schema"), params: string }> = [],
    on_fail: enum("reject" | "quarantine" | "warn" | "tag") = "warn",
    quarantine_key: string = "",
    sample_rate: number = 1.0,
    alert_threshold_pct: number = 5.0
  },
  events: {
    attached: "data_quality_attached",
    detached: "data_quality_detached",
    on_pass: "data_quality_pass",
    on_fail: "data_quality_fail",
    on_quarantine: "data_quality_quarantine",
    on_alert: "data_quality_alert",
    validate: "data_quality_validate"
  },
  behaviors: ["@validation", "@audit_log", "@alert"]
}
