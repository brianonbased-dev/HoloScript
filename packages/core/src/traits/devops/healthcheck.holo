@trait {
  name: "@healthcheck",
  category: "devops",
  description: "Service health probe. Polls a URL or TCP socket on a schedule, tracks success rate, fires alerts on consecutive failures, and exposes status for orchestrators and load balancers. Authored from HealthcheckTrait.ts.",
  props: {
    target_url: string = "",
    method: enum("get" | "head" | "tcp") = "get",
    interval_s: number = 30,
    timeout_ms: number = 5000,
    healthy_threshold: number = 2,
    unhealthy_threshold: number = 3,
    expected_status: number = 200,
    expected_body: string = ""
  },
  events: {
    attached: "healthcheck_attached",
    detached: "healthcheck_detached",
    on_healthy: "healthcheck_healthy",
    on_unhealthy: "healthcheck_unhealthy",
    on_timeout: "healthcheck_timeout",
    on_error: "healthcheck_error",
    check: "healthcheck_trigger"
  },
  behaviors: ["@alert", "@slo_monitor"]
}
