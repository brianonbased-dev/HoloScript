@trait {
  name: "@abtest",
  category: "devops",
  description: "A/B testing framework for spatial computing scenes. Deterministic hash-based variant assignment (djb2 — no PII required), multiple concurrent experiments, chi-squared and z-test significance, conversion tracking, multi-armed bandit adaptive allocation (epsilon-greedy), and anonymous/pseudonymous privacy modes. Port of ABTestTrait.ts (handler name: abtest).",
  props: {
    enabled: boolean = true,
    default_strategy: enum("equal" | "weighted" | "bandit") = "equal",
    alpha: number = 0.05,
    min_sample_size: number = 30,
    min_detectable_effect: number = 0.1,
    statistical_power: number = 0.8,
    auto_complete: boolean = false,
    max_duration: number = 0,
    privacy_mode: enum("anonymous" | "pseudonymous") = "anonymous",
    enable_bandit: boolean = false,
    bandit_epsilon: number = 0.1,
    custom_tags: dict<string,string> = {}
  },
  events: {
    on_assigned: "abtest:assigned",
    on_converted: "abtest:converted",
    on_significant: "abtest:significant",
    on_completed: "abtest:completed",
    on_error: "abtest:error",
    assign: "abtest:assign",
    track: "abtest:track",
    get_variant: "abtest:get_variant",
    get_stats: "abtest:get_stats"
  },
  behaviors: ["@consent_management", "@analytics"]
}
