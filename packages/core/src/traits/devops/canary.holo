@trait {
  name: "@canary",
  category: "devops",
  description: "Canary deployment sensor that monitors a small traffic slice for error rate, latency, and crash signals before promoting a new version to full rollout. Authored from CanaryTrait.ts.",
  props: {
    traffic_pct: number = 5.0,
    error_rate_threshold: number = 2.0,
    latency_p99_threshold_ms: number = 1000,
    window_min: number = 30,
    auto_rollback: boolean = true,
    metrics_source: enum("prometheus" | "datadog" | "holoscript") = "holoscript"
  },
  events: {
    attached: "canary_attached",
    detached: "canary_detached",
    on_healthy: "canary_healthy",
    on_unhealthy: "canary_unhealthy",
    on_rollback: "canary_rollback",
    on_promote: "canary_promote",
    promote: "canary_trigger_promote",
    rollback: "canary_trigger_rollback"
  },
  behaviors: ["@rollout", "@slo_monitor", "@alert"]
}
