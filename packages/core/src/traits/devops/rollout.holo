@trait {
  name: "@rollout",
  category: "devops",
  description: "Canary and blue/green deployment rollout controller. Gradually shifts traffic to a new version, monitors error rates, and auto-rolls back on threshold breach. Authored from RolloutTrait.ts.",
  props: {
    strategy: enum("canary" | "blue_green" | "rolling" | "immediate") = "canary",
    target_version: string = "",
    canary_pct: number = 5.0,
    step_pct: number = 10.0,
    step_interval_s: number = 300,
    error_threshold_pct: number = 5.0,
    auto_promote: boolean = false,
    auto_rollback: boolean = true
  },
  events: {
    attached: "rollout_attached",
    detached: "rollout_detached",
    on_step: "rollout_step",
    on_promote: "rollout_promote",
    on_rollback: "rollout_rollback",
    on_complete: "rollout_complete",
    on_error_threshold: "rollout_error_threshold",
    promote: "rollout_trigger_promote",
    rollback: "rollout_trigger_rollback"
  },
  behaviors: ["@feature_flag", "@alert", "@circuit_breaker"]
}
