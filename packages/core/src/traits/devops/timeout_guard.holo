@trait {
  name: "@timeout_guard",
  category: "devops",
  description: "Configurable operation timeout wrapper that bounds the wall-clock duration of any watched action. timeout_ms is the total budget in milliseconds from the moment the guard is armed (on_watch) to when the result must arrive via on_result; exceeding it triggers the action specified by action and emits on_timeout. grace_period_ms is an additional window after timeout_ms expires during which an in-flight result is still accepted before the action is taken; 0 = no grace period. action selects the post-timeout response: cancel emits on_timeout and drops the pending result if it arrives late, retry re-arms the guard and re-emits the original watch event up to max_retries times, notify emits on_timeout as a non-fatal informational event and continues waiting, escalate emits on_escalate which the parent composition handles (circuit-breaker, alert, etc.). max_retries caps automatic retries when action is retry; after exhaustion the guard transitions to escalate behaviour. watch_event is the event name the guard listens on to arm itself; when an event matching watch_event arrives the guard starts its clock for that operation. on_timeout fires when the budget elapses and action is cancel, notify, or escalate — carries guard_id, elapsed_ms, and action; on_retry fires before each retry attempt carrying guard_id and attempt number; on_escalate fires when action is escalate or retry exhaustion occurs. Research: TimeoutGuardTrait.ts v5.1.",
  props: {
    timeout_ms: number = 30000,
    grace_period_ms: number = 0,
    action: enum("cancel" | "retry" | "notify" | "escalate") = "cancel",
    max_retries: number = 3,
    watch_event: string = ""
  },
  events: {
    attached: "timeout_guard:attached",
    detached: "timeout_guard:detached",
    started: "timeout_guard:started",
    completed: "timeout_guard:completed",
    on_timeout: "timeout_guard:timed_out",
    on_retry: "timeout_guard:retry",
    on_escalate: "timeout_guard:escalate",
    on_watch: "timeout_guard:cmd_watch",
    on_result: "timeout_guard:cmd_result",
    on_cancel: "timeout_guard:cmd_cancel",
    on_get_status: "timeout_guard:cmd_get_status"
  },
  behaviors: ["@feature_flag"]
}
