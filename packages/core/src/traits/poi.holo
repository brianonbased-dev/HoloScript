@trait {
  name: "@poi",
  category: "spatial",
  description: "Point of interest — a labelled geospatial anchor with radius-based triggers. name is the POI label. description is the hover text. category groups POIs. icon is the marker icon URL. trigger_radius is the proximity trigger distance in meters (default: 10m). visible_radius is the maximum visibility distance in meters (default: 100m). Port of POITrait.ts (handler name: poi).",
  props: {
    name: string = "",
    description: string = "",
    category: string = "",
    icon: string = "",
    trigger_radius: number = 10,
    visible_radius: number = 100
  },
  events: {
    on_entered: "poi:entered",
    on_exited: "poi:exited",
    on_tapped: "poi:tapped"
  },
  behaviors: ["@geospatial_anchor", "@holomap_anchor_context"]
}
