@trait {
  name: "@lip_sync",
  category: "animation",
  description: "Audio-driven lip sync via frequency band viseme mapping. Config is frequency-band-dependent and passed through to LipSyncTrait instance. Default frequency bands target ARKit/Oculus visemes. Port of LipSyncTrait.ts (handler name: lip_sync).",
  props: {},
  events: {
    on_viseme: "lip_sync:viseme",
    on_silence: "lip_sync:silence",
    start: "lip_sync.start",
    stop: "lip_sync.stop"
  },
  behaviors: ["@emotional_voice", "@face_tracking", "@avatar_embodiment"]
}
