@trait {
  name: "@voice_mesh",
  category: "audio",
  description: "Spatial voice mesh for multi-user voice. auto_connect establishes voice on attach (default: true). mute starts muted (default: false). spatial enables positional audio (default: true). volume is the initial gain (default: 1.0). Port of VoiceMeshTrait.ts (handler name: voice_mesh).",
  props: {
    auto_connect: boolean = true,
    mute: boolean = false,
    spatial: boolean = true,
    volume: number = 1.0
  },
  events: {
    on_connected: "voice_mesh:connected",
    on_disconnected: "voice_mesh:disconnected",
    on_muted: "voice_mesh:muted",
    toggle_mute: "voice_mesh.toggle_mute"
  },
  behaviors: ["@spatial_voice", "@shareplay", "@shared_world"]
}
