@trait {
  name: "@recall_trigger",
  category: "agent",
  description: "Agent memory recall trigger. Fires a recall query into the agent's private memory store when a condition is met. Config is trigger-condition-dependent. Port of RecallTriggerTrait.ts (handler name: recall_trigger).",
  props: {},
  events: {
    on_recalled: "recall_trigger:recalled",
    on_miss: "recall_trigger:miss",
    trigger: "recall_trigger.trigger"
  },
  behaviors: ["@memory_crystal", "@rag_knowledge", "@neural_link"]
}
