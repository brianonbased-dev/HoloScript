@trait {
  name: "@native_call",
  category: "interop",
  description: "Sandboxed native function bridge. sandbox enables call sandboxing with syscall filtering (default: true). Port of NativeCallTrait.ts (handler name: native_call).",
  props: {
    sandbox: boolean = true
  },
  events: {
    on_called: "native_call:called",
    on_error: "native_call:error",
    call: "native_call.call"
  },
  behaviors: ["@ffi", "@compute"]
}
