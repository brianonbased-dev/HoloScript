@trait {
  name: "@multiview_gaussian_renderer",
  category: "render",
  description: "Multiview Gaussian splat renderer — renders a 3DGS scene from multiple simultaneous viewpoints. Config is view-count-dependent and passed through to MultiviewGaussianRendererTrait instance. Port of MultiviewGaussianRendererTrait.ts (handler name: multiview_gaussian_renderer).",
  props: {},
  events: {
    on_rendered: "multiview_gaussian_renderer:rendered",
    render: "multiview_gaussian_renderer.render"
  },
  behaviors: ["@gaussian_splat", "@gpu_particle"]
}
