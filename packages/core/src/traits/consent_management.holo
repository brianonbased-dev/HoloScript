@trait {
  name: "@consent_management",
  category: "compliance",
  description: "Multi-tenant consent management store. required_consents is the list of consent categories to track (default: [analytics, marketing]). Port of ConsentManagementTrait.ts (handler name: consent_management).",
  props: {},
  events: {
    on_granted: "consent_management:granted",
    on_withdrawn: "consent_management:withdrawn",
    grant: "consent_management.grant",
    withdraw: "consent_management.withdraw",
    check: "consent_management.check"
  },
  behaviors: ["@consent_gate", "@audit_log"]
}
