@trait {
  name: "@pose_estimation",
  category: "vision",
  description: "Human and object 6-DoF pose estimator. Infers body keypoints, joint angles, or rigid-body rotation from RGB or depth input using MediaPipe, ViTPose, or a custom ONNX model. Authored from PoseEstimationTrait.ts.",
  props: {
    model: enum("mediapipe" | "vitpose" | "openpose" | "holoscript") = "mediapipe",
    mode: enum("2d_keypoints" | "3d_keypoints" | "6dof_object") = "3d_keypoints",
    target: enum("body" | "face" | "hands" | "full") = "body",
    min_confidence: number = 0.5,
    smooth: boolean = true,
    target_fps: number = 30
  },
  events: {
    attached: "pose_estimation_attached",
    detached: "pose_estimation_detached",
    on_pose: "pose_estimation_pose",
    on_lost: "pose_estimation_lost",
    on_error: "pose_estimation_error"
  },
  behaviors: ["@vision", "@skeleton", "@hand_tracking"]
}
