@trait {
  name: "@multi_target_tracking",
  category: "vision",
  description: "Multi-object tracker using SORT, DeepSORT, or ByteTrack algorithms. Assigns persistent IDs to detected bounding boxes across frames and provides velocity and trajectory estimates. Authored from MultiTargetTrackingTrait.ts.",
  props: {
    algorithm: enum("sort" | "deepsort" | "bytetrack" | "holoscript") = "bytetrack",
    max_age: number = 30,
    min_hits: number = 3,
    iou_threshold: number = 0.3,
    max_targets: number = 100,
    reid_model_url: string = "",
    predict_when_lost: boolean = true
  },
  events: {
    attached: "multi_target_tracking_attached",
    detached: "multi_target_tracking_detached",
    on_track_new: "multi_target_tracking_new",
    on_track_update: "multi_target_tracking_update",
    on_track_lost: "multi_target_tracking_lost",
    on_frame: "multi_target_tracking_frame"
  },
  behaviors: ["@vision", "@reid_embedding", "@segment"]
}
