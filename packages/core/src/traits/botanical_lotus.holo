@trait {
  name: "@botanical_lotus",
  category: "visual",
  description: "Provenance-tracked botanical lotus entity. schema is the versioned schema identifier ('holoscript.trait.botanical_lotus.v0'). status tracks the authoring lifecycle: visual_seed (reference images ingested) → mesh_draft → mesh_final → anchored. source.kind describes the provenance origin (e.g., conversation_reference_images). Render profile includes petal layers (inner/mid/outer), PBR material params, and filament-style emission. Integrates with the CAEL anchor pipeline for provenance receipts. Port of BotanicalLotusTrait.ts (handler name: botanical_lotus).",
  props: {
    schema: string = "holoscript.trait.botanical_lotus.v0",
    status: enum("visual_seed" | "mesh_draft" | "mesh_final" | "anchored") = "visual_seed"
  },
  events: {
    on_attached: "botanical_lotus_attached",
    on_status_changed: "botanical_lotus_status_changed",
    on_anchored: "botanical_lotus_anchored",
    advance_status: "botanical_lotus_advance_status"
  },
  behaviors: ["@provenance"]
}
