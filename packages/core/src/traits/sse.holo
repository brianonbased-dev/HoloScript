@trait {
  name: "@sse",
  category: "integration",
  description: "Server-Sent Events endpoint. max_clients is the connection limit (default: 1,000). keepalive_ms is the keep-alive ping interval in ms (default: 30,000ms). Port of SseTrait.ts (handler name: sse).",
  props: {
    max_clients: number = 1000,
    keepalive_ms: number = 30000
  },
  events: {
    on_connected: "sse:connected",
    on_disconnected: "sse:disconnected",
    emit: "sse.emit"
  },
  behaviors: ["@stream", "@rest_endpoint", "@webhook"]
}
