@trait {
  name: "@speech_aware_encounter",
  category: "gamedev",
  description: "Speech-aware NPC encounter. voice_enabled enables voice input for the encounter (default: true). reid_confidence_threshold is the speaker re-identification threshold (default: 0.75). fallback_to_text falls back to text input when voice unavailable (default: true). max_turns is the maximum dialogue turns (default: 100). Port of SpeechAwareEncounterTrait.ts (handler name: speech_aware_encounter).",
  props: {
    voice_enabled: boolean = true,
    reid_confidence_threshold: number = 0.75,
    fallback_to_text: boolean = true,
    max_turns: number = 100
  },
  events: {
    on_turn: "speech_aware_encounter:turn",
    on_ended: "speech_aware_encounter:ended"
  },
  behaviors: ["@encounter", "@voice_input", "@npc_ai"]
}
