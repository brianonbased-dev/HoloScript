@trait {
  name: "@goal_oriented",
  category: "behavior",
  description: "GOAP (Goal-Oriented Action Planning) agent brain. goals is the list of goal definitions. actions is the list of available actions with preconditions/effects. initial_state is the starting world state key-value map. replan_interval is how often to replan in ms (default: 5000ms). Port of GoalOrientedTrait.ts (handler name: goal_oriented).",
  props: {
    replan_interval: number = 5000
  },
  events: {
    on_plan: "goal_oriented:plan",
    on_goal_reached: "goal_oriented:goal_reached",
    on_stuck: "goal_oriented:stuck",
    set_goal: "goal_oriented.set_goal",
    abort: "goal_oriented.abort"
  },
  behaviors: ["@ai_npc_brain", "@autonomous_agenda", "@behavior_tree"]
}
