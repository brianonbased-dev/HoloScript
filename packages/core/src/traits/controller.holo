@trait {
  name: "@controller",
  category: "input",
  description: "XR controller input mapper. haptic_on_button fires haptic feedback on button press (default: true). haptic_intensity is the haptic pulse strength [0,1] (default: 0.3). deadzone is the analog stick deadzone [0,1] (default: 0.1). trigger_threshold is the trigger activation threshold [0,1] (default: 0.5). grip_threshold is the grip activation threshold [0,1] (default: 0.5). button_mapping is the custom button remapping list. Port of ControllerInputTrait.ts (handler name: controller).",
  props: {
    haptic_on_button: boolean = true,
    haptic_intensity: number = 0.3,
    deadzone: number = 0.1,
    trigger_threshold: number = 0.5,
    grip_threshold: number = 0.5
  },
  events: {
    on_button: "controller:button",
    on_trigger: "controller:trigger",
    on_grip: "controller:grip",
    on_thumbstick: "controller:thumbstick",
    haptic: "controller.haptic"
  },
  behaviors: ["@avatar_intent"]
}
