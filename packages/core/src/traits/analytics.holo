@trait {
  name: "@analytics",
  category: "analytics",
  description: "Scene analytics. enabled activates collection (default: true). scene_id is the analytics scene identifier. privacy_level: strict (default), balanced, permissive. sampling_strategy: adaptive (default), fixed, always. sampling_rate is the fixed sampling fraction (default: 0.1). Port of AnalyticsTrait.ts (handler name: analytics).",
  props: {
    enabled: boolean = true,
    scene_id: string = "",
    privacy_level: enum("strict" | "balanced" | "permissive") = "strict",
    sampling_strategy: enum("adaptive" | "fixed" | "always") = "adaptive",
    sampling_rate: number = 0.1
  },
  events: {
    on_event: "analytics:event",
    track: "analytics.track"
  },
  behaviors: ["@abtest", "@telemetry", "@service_observability"]
}
