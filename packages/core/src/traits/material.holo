@trait {
  name: "@material",
  category: "render",
  description: "Surface material system. Config is material-type-dependent and passed through to MaterialTrait instance (PBR, unlit, toon, subsurface, etc.). Port of MaterialTrait.ts (handler name: material).",
  props: {},
  events: {
    on_applied: "material_attached",
    set: "material.set",
    update: "material.update"
  },
  behaviors: ["@advanced_pbr", "@material_x"]
}
