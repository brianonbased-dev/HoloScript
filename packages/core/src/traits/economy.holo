@trait {
  name: "@economy",
  category: "economy",
  description: "In-world economy primitives — balance, spend limits, transaction history, and bounties. initial_balance is the starting token balance (default: 100). default_spend_limit is the max spend per period (default: 0 — unlimited). spend_limit_period is the limit reset period in ms (default: 3,600,000 — 1 hour). max_transaction_history is the kept transaction count (default: 200). default_bounty_deadline is the bounty expiry in ms (default: 300,000 — 5 minutes). Port of EconomyPrimitivesTrait.ts (handler name: economy).",
  props: {
    initial_balance: number = 100,
    default_spend_limit: number = 0,
    spend_limit_period: number = 3600000,
    max_transaction_history: number = 200,
    default_bounty_deadline: number = 300000
  },
  events: {
    on_transaction: "economy:transaction",
    on_limit_reached: "economy:limit_reached",
    on_bounty_claimed: "economy:bounty_claimed",
    spend: "economy.spend",
    earn: "economy.earn",
    post_bounty: "economy.post_bounty"
  },
  behaviors: ["@token_gated", "@audit_log"]
}
