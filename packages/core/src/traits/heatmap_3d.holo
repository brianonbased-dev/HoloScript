@trait {
  name: "@heatmap_3d",
  category: "analytics",
  description: "3D spatial heatmap visualization — accumulates event positions and renders a volumetric density overlay. data_source is the event source URL. color_map: viridis (default), plasma, magma, inferno, hot, cool. opacity is the heatmap volume opacity [0,1] (default: 0.7). resolution is the voxel grid resolution (default: 32). Port of Heatmap3DTrait.ts (handler name: heatmap_3d).",
  props: {
    data_source: string = "",
    color_map: enum("viridis" | "plasma" | "magma" | "inferno" | "hot" | "cool") = "viridis",
    opacity: number = 0.7,
    resolution: number = 32
  },
  events: {
    on_updated: "heatmap_3d:updated",
    on_cleared: "heatmap_3d:cleared",
    record: "heatmap_3d.record",
    clear: "heatmap_3d.clear"
  },
  behaviors: ["@gaze_focus_analytics", "@compute_shader"]
}
