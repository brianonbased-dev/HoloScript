@trait {
  name: "@holomap_splat_output",
  category: "reconstruction",
  description: "HoloMap splat output — exports the reconstructed world twin as a Gaussian splat for rendering. Port of HoloMapSplatOutputTrait.ts (handler name: holomap_splat_output).",
  props: {},
  events: {
    on_exported: "holomap_splat_output:exported",
    on_error: "holomap_splat_output:error",
    export: "holomap_splat_output.export"
  },
  behaviors: ["@holomap_reconstruction", "@gaussian_splat"]
}
