// @constants_containers_storage — Registry: container/storage entity trait name set.
//
// Native .hsplus surface for core/traits/constants/containers-storage.ts.

@trait constants_containers_storage {
  capability_tags: ["constants", "containers_storage", "trait_registry", "tag_set", "core"]

  @on_spawn => {
    emit("constants_containers_storage_ready", {})
  }

  @receipt constants_containers_storage_config {
    type: "ConstantsContainersStorageReceipt"
    timestamp: now()
  }
}
