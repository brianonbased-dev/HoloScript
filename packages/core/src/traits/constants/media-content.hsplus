// @constants_media_content — Registry: media and content delivery trait name set.
//
// Native .hsplus surface for core/traits/constants/media-content.ts.

@trait constants_media_content {
  capability_tags: ["constants", "media_content", "trait_registry", "tag_set", "core"]

  @on_spawn => {
    emit("constants_media_content_ready", {})
  }

  @receipt constants_media_content_config {
    type: "ConstantsMediaContentReceipt"
    timestamp: now()
  }
}
