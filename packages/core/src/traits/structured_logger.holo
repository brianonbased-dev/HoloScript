@trait {
  name: "@structured_logger",
  category: "ops",
  description: "Structured JSON logger. min_level: debug, info (default), warn, error. max_entries is the ring-buffer size (default: 1000). rotation_count is the entry count that triggers rotation (default: 200). emit_events emits log events to the scene graph (default: true). Port of StructuredLoggerTrait.ts (handler name: structured_logger).",
  props: {
    min_level: enum("debug" | "info" | "warn" | "error") = "info",
    max_entries: number = 1000,
    rotation_count: number = 200,
    emit_events: boolean = true
  },
  events: {
    on_log: "structured_logger:log",
    on_rotated: "structured_logger:rotated",
    log: "structured_logger.log"
  },
  behaviors: ["@log_aggregator", "@service_observability", "@audit_log"]
}
