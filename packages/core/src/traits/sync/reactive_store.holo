@trait {
  name: "@reactive_store",
  category: "sync",
  description: "Reactive key-value store with change propagation. Entities subscribe to slices; writes trigger dependency-tracked re-renders or event dispatches. Authored from ReactiveStoreTrait.ts.",
  props: {
    namespace: string = "",
    initial_state: dict<string, string> = {},
    persist: boolean = false,
    debounce_ms: number = 16,
    max_listeners_per_key: number = 100,
    ssr_hydrate: boolean = false
  },
  events: {
    attached: "reactive_store_attached",
    detached: "reactive_store_detached",
    on_change: "reactive_store_change",
    on_batch: "reactive_store_batch",
    on_reset: "reactive_store_reset",
    set: "reactive_store_set",
    batch_set: "reactive_store_batch_set",
    reset: "reactive_store_trigger_reset"
  },
  behaviors: ["@global_state", "@data_binding"]
}
