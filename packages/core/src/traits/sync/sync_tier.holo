@trait {
  name: "@sync_tier",
  category: "sync",
  description: "Multi-tier sync policy controller. Assigns entity state properties to sync tiers (realtime, eventual, cold) and routes updates through the appropriate transport. Authored from SyncTierTrait.ts.",
  props: {
    realtime_keys: list<string> = [],
    eventual_keys: list<string> = [],
    cold_keys: list<string> = [],
    realtime_transport: enum("websocket" | "webrtc" | "holoscript") = "holoscript",
    eventual_interval_ms: number = 5000,
    cold_on_exit: boolean = true,
    compress: boolean = true
  },
  events: {
    attached: "sync_tier_attached",
    detached: "sync_tier_detached",
    on_realtime_update: "sync_tier_realtime",
    on_eventual_flush: "sync_tier_eventual_flush",
    on_cold_persist: "sync_tier_cold_persist",
    on_conflict: "sync_tier_conflict",
    flush: "sync_tier_flush"
  },
  behaviors: ["@global_state", "@offline_sync", "@realtime_collab"]
}
