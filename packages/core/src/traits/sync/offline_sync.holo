@trait {
  name: "@offline_sync",
  category: "sync",
  description: "Offline-first data synchronisation for HoloScript entities. strategy controls the cache/network priority order: local_first reads from the local cache and only contacts the network when the cache misses or expires, cache_then_network serves cached data immediately then refreshes from the network in the background, network_then_cache tries the network first and falls back to cache on failure. conflict determines resolution when local and remote data diverge: server_wins discards local changes (safe for read-heavy entities), client_wins keeps local changes (safe for authoritative-client scenarios), merge triggers the on_conflict event so upstream logic can perform a 3-way merge. max_cache_mb caps the size of the local cache partition for this entity in megabytes (0 = unlimited). sync_on_reconnect automatically flushes the pending queue when network connectivity is restored. on_sync fires after a successful network flush reporting count of synced items; on_conflict fires when a merge conflict is detected with local and remote payloads; on_error fires on network or cache failure with a reason code. Pairs with @agent_memory for persistent agent knowledge and @crdt for concurrent multi-author merging. Research: OfflineSyncTrait.ts — OfflineSyncConfig, sync:queue / sync:flush / sync:status events.",
  props: {
    strategy: enum("local_first" | "cache_then_network" | "network_then_cache") = "local_first",
    conflict: enum("server_wins" | "client_wins" | "merge") = "server_wins",
    max_cache_mb: number = 50,
    sync_on_reconnect: boolean = true
  },
  events: {
    attached: "offline_sync:attached",
    detached: "offline_sync:detached",
    on_sync: "offline_sync:sync",
    on_conflict: "offline_sync:conflict",
    on_error: "offline_sync:error",
    on_queue: "sync:queue",
    on_flush: "sync:flush",
    on_status: "sync:status",
    on_queued: "sync:queued",
    on_flushed: "sync:flushed",
    on_status_changed: "sync:status_changed"
  },
  behaviors: ["@agent_memory"]
}
