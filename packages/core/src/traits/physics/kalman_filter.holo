@trait {
  name: "@kalman_filter",
  category: "physics",
  description: "Kalman filter for sensor fusion and state estimation. Fuses noisy position, velocity, and acceleration measurements from GPS, IMU, and visual odometry into a smoothed posterior estimate. Authored from KalmanFilterTrait.ts.",
  props: {
    state_dim: number = 6,
    obs_dim: number = 3,
    process_noise: number = 0.001,
    measurement_noise: number = 0.1,
    initial_covariance: number = 1.0,
    mode: enum("linear" | "ekf" | "ukf") = "ekf",
    update_rate_hz: number = 30
  },
  events: {
    attached: "kalman_filter_attached",
    detached: "kalman_filter_detached",
    on_predict: "kalman_filter_predict",
    on_update: "kalman_filter_update",
    on_diverge: "kalman_filter_diverge",
    observe: "kalman_filter_observe"
  },
  behaviors: ["@sensor", "@imu"]
}
