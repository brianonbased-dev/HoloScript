@trait {
  name: "@thermal_model",
  category: "physics",
  description: "Thermal simulation model for heat transfer. Simulates conduction, convection, and radiation across entity surfaces using a finite-difference grid, exporting temperature maps for rendering or failure-prediction analytics. Authored from ThermalModelTrait.ts.",
  props: {
    ambient_temp_c: number = 25.0,
    initial_temp_c: number = 25.0,
    conductivity_w_mk: number = 50.0,
    specific_heat_j_kgk: number = 500.0,
    density_kg_m3: number = 7800.0,
    radiation_emissivity: number = 0.8,
    grid_resolution: number = 16,
    dt_s: number = 0.05,
    heat_source_w: number = 0.0
  },
  events: {
    attached: "thermal_model_attached",
    detached: "thermal_model_detached",
    on_step: "thermal_model_step",
    on_overheat: "thermal_model_overheat",
    step: "thermal_model_trigger_step"
  },
  behaviors: ["@pid_controller", "@digital_twin", "@sensor_hub"]
}
