@trait {
  name: "@destruction",
  category: "physics",
  description: "Real-time mesh destruction and fracture simulation. Pre-fractures meshes into rigid shards that fly apart on impact above a threshold. Authored from DestructionTrait.ts.",
  props: {
    fracture_mode: enum("voronoi" | "radial" | "shard" | "pre_cut") = "voronoi",
    shard_count: number = 16,
    impulse_threshold: number = 100.0,
    min_shard_mass: number = 0.1,
    debris_lifetime_s: number = 5.0,
    debris_pool_size: number = 64,
    play_sound: boolean = true,
    particle_emitter: boolean = true
  },
  events: {
    attached: "destruction_attached",
    detached: "destruction_detached",
    on_fracture: "destruction_fracture",
    on_shard: "destruction_shard",
    on_settle: "destruction_settle",
    explode: "destruction_trigger_explode"
  },
  behaviors: ["@rigid_body", "@particle_emitter"]
}
