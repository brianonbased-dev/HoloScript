@trait {
  name: "@soft_body_pro",
  category: "physics",
  description: "Extended soft body simulation with FEM-based elasticity, plastic deformation, fracture, and tearing. Higher fidelity than @soft_body for medical and manufacturing digital twins. Authored from SoftBodyProTrait.ts.",
  props: {
    youngs_modulus: number = 1e6,
    poisson_ratio: number = 0.45,
    density: number = 1000.0,
    damping: number = 0.05,
    fracture_threshold: number = 0.0,
    plastic_yield: number = 0.0,
    solver: enum("fem" | "pbd" | "mpm" | "sph") = "fem",
    substeps: number = 10,
    gpu_accelerated: boolean = true
  },
  events: {
    attached: "soft_body_pro_attached",
    detached: "soft_body_pro_detached",
    on_deform: "soft_body_pro_deform",
    on_fracture: "soft_body_pro_fracture",
    on_tear: "soft_body_pro_tear",
    on_settle: "soft_body_pro_settle",
    reset: "soft_body_pro_reset"
  },
  behaviors: ["@soft_body", "@rigid_body"]
}
