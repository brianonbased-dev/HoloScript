@trait {
  name: "@quantum_circuit",
  category: "physics",
  description: "General-purpose quantum circuit declaration and execution trait. qubits sets the width of the register. gates is the ordered list of gate operations to apply; each entry carries a name (e.g. H, CNOT, RZ, SWAP, Toffoli) and a targets array of qubit indices. shots is the number of measurement samples to draw from the statevector; higher counts reduce sampling variance. backend selects the execution engine: simulator runs a local statevector or stabiliser simulator (zero cost, deterministic under a fixed seed); ibm_quantum dispatches to an IBM Quantum cloud backend via the HoloScript credentials vault; ionq routes to an IonQ trapped-ion backend; holoscript delegates to the HoloScript quantum inference adapter registry which picks the cheapest available executor. on_result fires after sampling with a counts dict mapping bitstring → frequency, plus a backend_info object. Pairs with @inference for hybrid quantum-classical loops (VQE, QAOA) and @version for circuit schema migration. Research: QuantumCircuitTrait.ts, QuantumCircuitCompiler.ts, VQERunnerTrait.ts.",
  props: {
    qubits: number = 2,
    gates: list<dict<string, unknown>> = [],
    shots: number = 1024,
    backend: enum("simulator" | "ibm_quantum" | "ionq" | "holoscript") = "simulator"
  },
  events: {
    attached: "quantum_circuit:attached",
    detached: "quantum_circuit:detached",
    compiled: "quantum_circuit:compiled",
    result: "quantum_circuit:result",
    error: "quantum_circuit:error",
    timeout: "quantum_circuit:timeout",
    on_run: "quantum_circuit:run",
    on_compile: "quantum_circuit:compile",
    on_abort: "quantum_circuit:abort"
  },
  behaviors: ["@inference"]
}
