@trait {
  name: "@package_signing",
  category: "security",
  description: "Package signing and verification. Config is key-scheme-dependent. Port of PackageSigningTrait.ts (handler name: package_signing).",
  props: {},
  events: {
    on_signed: "package_signing:signed",
    on_verified: "package_signing:verified",
    on_tampered: "package_signing:tampered",
    sign: "package_signing.sign",
    verify: "package_signing.verify"
  },
  behaviors: ["@hsm_integration", "@provenance", "@audit_log"]
}
