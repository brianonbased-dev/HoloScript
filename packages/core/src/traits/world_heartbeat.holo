@trait {
  name: "@world_heartbeat",
  category: "world",
  description: "World liveness heartbeat. interval_ms is the heartbeat cadence in ms (default: 1,000ms). redundancy is the number of redundant heartbeat channels (default: 2). failover_threshold is the missed heartbeat count before failover (default: 3). Port of WorldHeartbeatTrait.ts (handler name: world_heartbeat).",
  props: {
    interval_ms: number = 1000,
    redundancy: number = 2,
    failover_threshold: number = 3
  },
  events: {
    on_beat: "world_heartbeat:beat",
    on_failover: "world_heartbeat:failover"
  },
  behaviors: ["@world_state", "@service_observability", "@rollback"]
}
