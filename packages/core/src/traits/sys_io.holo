@trait {
  name: "@sys_io",
  category: "system",
  description: "System I/O adapter for filesystem and process interaction. allow_write enables write access (default: false — read-only). Port of SysIoTrait.ts (handler name: sys_io).",
  props: {
    allow_write: boolean = false
  },
  events: {
    on_read: "sys_io:read",
    on_written: "sys_io:written",
    on_error: "sys_io:error",
    read: "sys_io.read",
    write: "sys_io.write"
  },
  behaviors: ["@file_system", "@sandbox_execution"]
}
