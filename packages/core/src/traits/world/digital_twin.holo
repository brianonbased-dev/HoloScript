@trait {
  name: "@digital_twin",
  category: "world",
  description: "Digital twin root binding. Synchronizes a virtual entity's state with a real-world physical asset via IoT data streams, DTDL models, or URDF sensor topics. Authored from DigitalTwinTrait.ts.",
  props: {
    asset_id: string = "",
    model_url: string = "",
    protocol: enum("dtdl" | "urdf" | "opcua" | "mqtt" | "holoscript") = "holoscript",
    telemetry_url: string = "",
    update_rate_hz: number = 1,
    sync_direction: enum("physical_to_virtual" | "virtual_to_physical" | "bidirectional") = "physical_to_virtual",
    shadow_mode: boolean = false
  },
  events: {
    attached: "digital_twin_attached",
    detached: "digital_twin_detached",
    on_sync: "digital_twin_sync",
    on_drift: "digital_twin_drift",
    on_alert: "digital_twin_alert",
    on_command: "digital_twin_command",
    command: "digital_twin_trigger_command"
  },
  behaviors: ["@sensor", "@twin_actuator", "@telemetry", "@data_lineage"]
}
