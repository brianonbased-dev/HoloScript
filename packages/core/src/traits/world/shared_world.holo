@trait {
  name: "@shared_world",
  category: "world",
  description: "Multi-user shared world session handle. Establishes the collaborative session namespace, manages join/leave, player roster, session code, and authority rules for the shared entity graph. Authored from SharedWorldTrait.ts.",
  props: {
    session_id: string = "",
    max_players: number = 16,
    join_mode: enum("open" | "invite" | "code" | "closed") = "open",
    session_code: string = "",
    authority: enum("host" | "distributed" | "server") = "server",
    auto_create: boolean = true,
    persist_on_empty: boolean = false
  },
  events: {
    attached: "shared_world_attached",
    detached: "shared_world_detached",
    on_player_join: "shared_world_join",
    on_player_leave: "shared_world_leave",
    on_session_created: "shared_world_created",
    on_session_end: "shared_world_end",
    create: "shared_world_create",
    join: "shared_world_join_trigger"
  },
  behaviors: ["@networked", "@state_sync", "@signaling"]
}
