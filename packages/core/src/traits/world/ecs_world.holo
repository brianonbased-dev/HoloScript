@trait {
  name: "@ecs_world",
  category: "world",
  description: "Entity-Component-System world registry. Manages entity lifecycles, component pools, and system execution order within a HoloScript scene. Authored from ECSWorldTrait.ts.",
  props: {
    max_entities: number = 65536,
    fixed_step_hz: number = 60,
    variable_step: boolean = true,
    max_step_ms: number = 50,
    culling: boolean = true,
    spatial_partitioning: enum("octree" | "grid" | "bvh" | "none") = "bvh",
    enable_physics: boolean = true
  },
  events: {
    attached: "ecs_world_attached",
    detached: "ecs_world_detached",
    on_tick: "ecs_world_tick",
    on_entity_spawn: "ecs_world_spawn",
    on_entity_destroy: "ecs_world_destroy",
    on_pause: "ecs_world_pause",
    on_resume: "ecs_world_resume",
    pause: "ecs_world_trigger_pause",
    resume: "ecs_world_trigger_resume"
  },
  behaviors: ["@world_clock", "@world_border", "@zone_director"]
}
