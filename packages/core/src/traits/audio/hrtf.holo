@trait {
  name: "@hrtf",
  category: "audio",
  description: "Head-Related Transfer Function (HRTF) binaural spatialization for realistic 3D audio rendering. profile selects the HRTF measurement set: generic uses a one-size-fits-all average model suitable for most listeners; personalized applies a per-subject dataset keyed by the listener's anthropometric profile; sofa_file loads an AES-69 SOFA-format dataset from sofa_url for research or production pipeline integration. sofa_url is the remote or local URL to a SOFA file (only consumed when profile=sofa_file). head_tracking enables real-time listener-orientation updates from the device IMU or XR head pose — when true the HRTF azimuth/elevation update per frame. room_mode governs the acoustic environment modelled alongside the HRTF filter: anechoic applies the raw HRTF with no room contribution; reverberant adds a diffuse-field reverberation tail; room applies a full early-reflections + late-reverb model derived from @environmental_audio dimensions. elevation_accuracy selects the spherical grid density for elevation interpolation: coarse uses the standard 50-point HRTF grid; fine uses the full 1250-point dataset with sub-degree interpolation (higher CPU). on_profile_change fires when the active HRTF dataset is swapped at runtime. Research: HRTFTrait.ts v2.0.0 — CIPIC/LISTEN/ARI/THU databases, SOFA loader, binaural crossfade, ITD models, near-field correction.",
  props: {
    profile: enum("generic" | "personalized" | "sofa_file") = "generic",
    sofa_url: string = "",
    head_tracking: boolean = true,
    room_mode: enum("anechoic" | "reverberant" | "room") = "anechoic",
    elevation_accuracy: enum("coarse" | "fine") = "coarse"
  },
  events: {
    attached: "hrtf:attached",
    detached: "hrtf:detached",
    profile_loaded: "hrtf:profile_loaded",
    profile_load_error: "hrtf:profile_load_error",
    on_profile_change: "hrtf:set_profile",
    on_set_room_mode: "hrtf:set_room_mode",
    on_set_head_tracking: "hrtf:set_head_tracking",
    listener_updated: "hrtf:listener_updated"
  },
  behaviors: ["@environmental_audio"]
}
