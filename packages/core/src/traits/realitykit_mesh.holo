@trait {
  name: "@realitykit_mesh",
  category: "xr",
  description: "RealityKit mesh anchor. mesh_classification enables semantic mesh labels (default: true). physics_enabled generates physics colliders (default: true). occlusion_enabled uses mesh for occlusion (default: true). collision_margin is the physics collision margin in meters (default: 0.02m). Port of RealityKitMeshTrait.ts (handler name: realitykit_mesh).",
  props: {
    mesh_classification: boolean = true,
    physics_enabled: boolean = true,
    occlusion_enabled: boolean = true,
    collision_margin: number = 0.02
  },
  events: {
    on_anchored: "realitykit_mesh:anchored",
    on_updated: "realitykit_mesh:updated"
  },
  behaviors: ["@room_mesh", "@scene_reconstruction", "@openxr_hal"]
}
