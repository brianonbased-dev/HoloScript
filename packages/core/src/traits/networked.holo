@trait {
  name: "@networked",
  category: "multiplayer",
  description: "Generic multiplayer network synchronization. Config is transport-dependent and passed through to NetworkedTrait instance. Port of NetworkedTrait.ts (handler name: networked).",
  props: {},
  events: {
    on_connected: "networked_attached",
    on_message: "networked:message",
    on_disconnected: "networked:disconnected",
    send: "networked.send"
  },
  behaviors: ["@crdt_room", "@websocket"]
}
