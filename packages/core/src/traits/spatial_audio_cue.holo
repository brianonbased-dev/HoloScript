@trait {
  name: "@spatial_audio_cue",
  category: "audio",
  description: "Spatial audio cue for accessibility and navigation. cue_type: navigation (default), alert, ambient, earcon. earcon is the earcon sound asset URL. spatial positions the cue in 3D space (default: true). repeat_interval is the auto-repeat interval in ms (default: 0 = no repeat). Port of SpatialAudioCueTrait.ts (handler name: spatial_audio_cue).",
  props: {
    cue_type: enum("navigation" | "alert" | "ambient" | "earcon") = "navigation",
    earcon: string = "",
    spatial: boolean = true,
    repeat_interval: number = 0
  },
  events: {
    on_played: "spatial_audio_cue:played",
    play: "spatial_audio_cue.play",
    stop: "spatial_audio_cue.stop"
  },
  behaviors: ["@ambisonics", "@spatial_voice", "@accessible"]
}
