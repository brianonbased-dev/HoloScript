// @discord_trait — Discord integration: send messages, read channels, role-based world access.
//
// Native .hsplus surface for core/traits/DiscordTrait.ts.

@trait discord_trait {
  capability_tags: ["discord", "send_messages", "channel_read", "role_access", "core"]

  @on_spawn(guild_id) => {
    init_discord(guild_id)
    emit("discord_ready", {})
  }

  @on_send(channel_id, message) => {
    send_discord_message(channel_id, message)
  }

  @receipt discord_trait_config {
    type: "DiscordTraitReceipt"
    timestamp: now()
  }
}
