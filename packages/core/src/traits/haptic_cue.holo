@trait {
  name: "@haptic_cue",
  category: "haptics",
  description: "Haptic feedback cue. pattern: pulse (default), click, double_click, rumble, custom. intensity is the haptic strength [0,1] (default: 0.5). duration is the pulse duration in ms (default: 100ms). repeat is the number of additional repeats after the first (default: 0). Port of HapticCueTrait.ts (handler name: haptic_cue).",
  props: {
    pattern: enum("pulse" | "click" | "double_click" | "rumble" | "custom") = "pulse",
    intensity: number = 0.5,
    duration: number = 100,
    repeat: number = 0
  },
  events: {
    on_played: "haptic_cue:played",
    play: "haptic_cue.play",
    stop: "haptic_cue.stop"
  },
  behaviors: ["@controller", "@grab_feedback_profile"]
}
