@trait {
  name: "@wot_thing",
  category: "iot",
  description: "W3C Web of Things Thing Description. title is the Thing name (required). security: nosec (default), basic, bearer, digest, apikey. base is the base URL for interaction affordances (default: none). Port of WoTThingTrait.ts (handler name: wot_thing).",
  props: {
    title: string = "",
    security: enum("nosec" | "basic" | "bearer" | "digest" | "apikey") = "nosec"
  },
  events: {
    on_action: "wot_thing:action",
    on_property_changed: "wot_thing:property_changed",
    on_event: "wot_thing:event"
  },
  behaviors: ["@sensor", "@twin_actuator", "@mqtt_source"]
}
