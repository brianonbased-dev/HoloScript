@trait {
  name: "@gotcha",
  category: "documentation",
  description: "Runtime gotcha annotation — emits a warning event when a known footgun condition is triggered. warning is the warning message (required). severity: info, warning (default), critical. mitigation is the recommended fix. triggers_on is the list of event names that trigger the gotcha check. Port of GotchaTrait.ts (handler name: gotcha).",
  props: {
    warning: string = "",
    severity: enum("info" | "warning" | "critical") = "warning",
    mitigation: string = ""
  },
  events: {
    on_triggered: "gotcha:triggered",
    check: "gotcha.check"
  },
  behaviors: ["@alert", "@audit_log"]
}
