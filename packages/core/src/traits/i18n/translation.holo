@trait {
  name: "@translation",
  category: "i18n",
  description: "ICU-compatible translation key resolver with namespace scoping, lazy bundle loading, and configurable interpolation delimiters. locale is the active BCP-47 locale tag (e.g. 'en-US', 'fr', 'ja'); defaults to 'en-US'. fallback_locale is the locale used when the active bundle does not contain a requested key; prevents untranslated-key bleed-through. lazy_load delays fetching the translation bundle until the first key lookup is requested, reducing initial payload; when false the bundle for locale is fetched on attach. namespace scopes the key resolver to a named message bundle file (e.g. 'common', 'errors', 'product') allowing per-feature bundle splitting without key collision. interpolation_prefix and interpolation_suffix are the delimiters that bracket variable placeholders inside message strings (default '{{' / '}}' for ICU-style; set to '{' / '}' for simple Mustache, or '%{' / '}' for Ruby-i18n style). on_locale_changed fires after the active locale has been swapped and the new bundle is ready, carrying the previous and new locale tags — downstream components should re-resolve their keys on receipt. Research: TranslationTrait.ts, LocaleTrait.ts, RtlTrait.ts, SubtitleTrait.ts.",
  props: {
    locale: string = "en-US",
    fallback_locale: string = "en-US",
    lazy_load: boolean = true,
    namespace: string = "common",
    interpolation_prefix: string = "{{",
    interpolation_suffix: string = "}}"
  },
  events: {
    attached: "translation:attached",
    detached: "translation:detached",
    bundle_loading: "translation:bundle_loading",
    bundle_ready: "translation:bundle_ready",
    bundle_error: "translation:bundle_error",
    locale_changed: "translation:locale_changed",
    key_missing: "translation:key_missing",
    translated: "translation:translated",
    on_locale_changed: "translation:cmd_set_locale",
    on_load_bundle: "translation:cmd_load_bundle",
    on_translate: "translation:cmd_translate",
    on_set_namespace: "translation:cmd_set_namespace"
  },
  behaviors: ["@accessible"]
}
