@trait {
  name: "@rtl",
  category: "i18n",
  description: "Right-to-left layout adapter. Mirrors spatial UI panels, text alignment, and icon direction for Arabic, Hebrew, Farsi, and Urdu locales. Authored from RtlTrait.ts.",
  props: {
    enabled: boolean = false,
    auto_detect: boolean = true,
    mirror_icons: boolean = true,
    text_align: enum("auto" | "right" | "left") = "auto",
    number_format: enum("western" | "arabic_indic" | "eastern_arabic") = "western",
    bidi_isolate: boolean = true
  },
  events: {
    attached: "rtl_attached",
    detached: "rtl_detached",
    on_direction_change: "rtl_direction_change",
    set_rtl: "rtl_set"
  },
  behaviors: ["@localization", "@ui_theme", "@accessibility"]
}
