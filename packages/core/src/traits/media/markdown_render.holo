@trait {
  name: "@markdown_render",
  category: "media",
  description: "Markdown source-to-HTML rendering pipeline with configurable dialect, extension list, output sanitization, and dark-mode theming. source is the raw Markdown string to render; update source to trigger a fresh render pass. flavor selects the parsing dialect: commonmark follows the CommonMark spec exactly; gfm enables GitHub Flavored Markdown additions (tables, strikethrough, task lists, autolinks); holoscript extends gfm with HoloScript-native link syntax that resolves @entity: and holo: URL schemes into scene references. extensions is an ordered list of plugin identifiers that the runtime injects before the render pass (e.g. 'math-katex', 'mermaid', 'syntax-highlight'); unsupported identifiers are skipped and logged. sanitize strips XSS vectors (script tags, data: URIs, on* attributes) from the generated HTML before emission; disable only in fully-trusted author contexts. dark_mode inverts the default token palette — heading, code, link, and blockquote colours swap to their dark-surface counterparts. on_render fires after every successful render pass, carrying the generated HTML string. on_click_link fires when the user activates a hyperlink in the rendered output, carrying the raw href for navigation handling or interception. on_copy_code fires when the user copies a fenced code block, carrying the block content. Pairs with @text_render for inline rich-text display, @pdf_generator for print export, and @subtitle for accessible caption overlays. Research: MarkdownRenderTrait.ts (sanitize, gfm flags), TextRenderTrait.ts (output surface integration).",
  props: {
    source: string = "",
    flavor: enum("commonmark" | "gfm" | "holoscript") = "gfm",
    extensions: array<string> = [],
    sanitize: boolean = true,
    dark_mode: boolean = false
  },
  events: {
    attached: "markdown:attached",
    detached: "markdown:detached",
    rendered: "markdown:rendered",
    render_error: "markdown:render_error",
    link_clicked: "markdown:link_clicked",
    code_copied: "markdown:code_copied",
    on_render: "markdown:render",
    on_set_source: "markdown:set_source",
    on_click_link: "markdown:click_link",
    on_copy_code: "markdown:copy_code",
    on_clear: "markdown:clear"
  },
  behaviors: ["@text_render"]
}
