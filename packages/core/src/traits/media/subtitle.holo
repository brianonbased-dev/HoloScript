@trait {
  name: "@subtitle",
  category: "media",
  description: "Timed-text caption overlay for media surfaces and live speech. track_url points to an external caption file; leave empty to rely solely on the on_show_line command for programmatic injection (e.g., from a speech-recognition pipeline). language is a BCP 47 language tag (e.g. 'en', 'fr', 'zh-Hant') that both selects the active caption track when multiple tracks are present and provides the source locale for any downstream translation. format selects the caption container: vtt (WebVTT — browser-native), srt (SubRip — broad tool support), ttml (TTML/DFXP — broadcast and accessibility), json (HoloScript streaming JSON cues). style controls visual presentation density: none renders no decoration beyond the text itself, minimal adds a semi-transparent pill background, full applies the system caption style (font, shadow, outline), accessible applies WCAG 2.1 AA high-contrast defaults including larger font and solid background. max_lines caps the number of simultaneously visible lines; older cues scroll off the top when the limit is reached. position anchors the caption region in the viewport: top / bottom are fixed edges, custom uses offset_y as a 0–1 normalised vertical position from the top. offset_y is only applied when position = 'custom'. Events: cue_shown / cue_hidden are outbound per-cue lifecycle notifications. on_show_line is the inbound command for programmatic injection of a caption string without a timed file. on_clear removes all visible cues immediately. Pairs with @video for frame-synchronised delivery and @streaming for live-caption ingest from an RTMP/WebRTC source. Research: SubtitleTrait.ts v2.0.",
  props: {
    track_url: string = "",
    language: string = "en",
    format: enum("vtt" | "srt" | "ttml" | "json") = "vtt",
    style: enum("none" | "minimal" | "full" | "accessible") = "minimal",
    max_lines: number = 2,
    position: enum("top" | "bottom" | "custom") = "bottom",
    offset_y: number = 0.0
  },
  events: {
    attached: "subtitle:attached",
    detached: "subtitle:detached",
    cue_shown: "subtitle:cue_shown",
    cue_hidden: "subtitle:cue_hidden",
    track_loaded: "subtitle:track_loaded",
    track_error: "subtitle:track_error",
    on_show_line: "subtitle:cmd_show_line",
    on_clear: "subtitle:cmd_clear",
    on_set_track: "subtitle:cmd_set_track",
    on_set_style: "subtitle:cmd_set_style"
  },
  behaviors: ["@video"]
}
