@trait {
  name: "@cinematic_seq",
  category: "media",
  description: "Cinematic sequence player that orchestrates camera moves, entity animations, audio cues, and UI overlays into a timed cutscene. Authored from CinematicSeqTrait.ts.",
  props: {
    sequence_url: string = "",
    format: enum("holoscript" | "json" | "csv") = "holoscript",
    skip_enabled: boolean = true,
    letterbox: boolean = true,
    freeze_player: boolean = true,
    blend_time_ms: number = 300,
    auto_play: boolean = false
  },
  events: {
    attached: "cinematic_seq_attached",
    detached: "cinematic_seq_detached",
    on_play: "cinematic_seq_play",
    on_cue: "cinematic_seq_cue",
    on_skip: "cinematic_seq_skip",
    on_end: "cinematic_seq_end",
    play: "cinematic_seq_trigger_play",
    skip: "cinematic_seq_trigger_skip",
    stop: "cinematic_seq_trigger_stop"
  },
  behaviors: ["@timeline", "@animation", "@ai_camera"]
}
