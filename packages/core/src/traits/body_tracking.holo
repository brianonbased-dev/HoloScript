@trait {
  name: "@body_tracking",
  category: "xr",
  description: "source is the tracking input (no default): live_self is the user's own local capture device, verified at runtime against a capture the runtime opened (LocalCapture.ts), else the generic avatar is shown; recording (replayed mocap, imported expression or gait data) and remote_user (someone else's capture) are a likeness and need a @consent_gate grant plus the render_likeness rule's yes, as does a missing source (HS1011). Full-body skeletal tracking from XR sensor data. mode: upper_body (default), full_body, hands_only. joint_smoothing is the temporal smoothing factor [0,1] (default: 0.5). prediction enables physics-based motion prediction (default: true). avatar_binding auto-binds tracked joints to the avatar rig (default: true). calibrate_on_start runs calibration pose on attach (default: true). tracking_confidence_threshold is the minimum confidence to accept a joint pose (default: 0.5). Port of BodyTrackingTrait.ts (handler name: body_tracking).",
  props: {
    source: enum("live_self" | "recording" | "remote_user"),
    mode: enum("upper_body" | "full_body" | "hands_only") = "upper_body",
    joint_smoothing: number = 0.5,
    prediction: boolean = true,
    avatar_binding: boolean = true,
    calibrate_on_start: boolean = true,
    tracking_confidence_threshold: number = 0.5
  },
  events: {
    on_calibrated: "body_tracking:calibrated",
    on_pose: "body_tracking:pose",
    on_lost: "body_tracking:lost",
    calibrate: "body_tracking.calibrate"
  },
  behaviors: ["@auto_rig", "@avatar_embodiment", "@hand_mesh_ai"]
}
