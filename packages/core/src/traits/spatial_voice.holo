@trait {
  name: "@spatial_voice",
  category: "audio",
  description: "Spatial voice audio. range is the audible radius in meters (default: 20m). rolloff: inverse (default), linear, exponential. rolloff_factor controls attenuation steepness (default: 1.0). hrtf enables HRTF spatial audio (default: true). Port of SpatialVoiceTrait.ts (handler name: spatial_voice).",
  props: {
    range: number = 20,
    rolloff: enum("inverse" | "linear" | "exponential") = "inverse",
    rolloff_factor: number = 1.0,
    hrtf: boolean = true
  },
  events: {
    on_started: "spatial_voice:started",
    on_stopped: "spatial_voice:stopped"
  },
  behaviors: ["@ambisonics", "@hrtf", "@remote_presence"]
}
