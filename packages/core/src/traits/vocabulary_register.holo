@trait {
  name: "@vocabulary_register",
  category: "language",
  description: "Domain vocabulary register for style injection. active_register is the named register to apply (default: modern-corporate). max_injected_entries is the cap on injected vocabulary terms (default: 20). prepend_tone_hint prepends the register tone hint to model prompts (default: true). Port of VocabularyRegisterTrait.ts (handler name: vocabulary_register).",
  props: {
    active_register: string = "modern-corporate",
    max_injected_entries: number = 20,
    prepend_tone_hint: boolean = true
  },
  events: {
    on_register_changed: "vocabulary_register:register_changed",
    set_register: "vocabulary_register.set_register",
    inject: "vocabulary_register.inject"
  },
  behaviors: ["@translation", "@verbal_fingerprint", "@neural_link"]
}
