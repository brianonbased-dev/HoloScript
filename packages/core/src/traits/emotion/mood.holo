@trait {
  name: "@mood",
  category: "emotion",
  description: "Affective mood state for entities, NPCs, and environment atmospheres. base_mood sets the resting emotional disposition from a discrete palette: calm/curious/excited/sad/angry/fearful/neutral. intensity is a 0-1 scalar amplifying the mood's perceptual strength (0 = imperceptible, 1 = full expression). volatility controls how readily the mood transitions in response to external influences (0 = locked, 1 = maximally reactive). recovery_rate governs how quickly intensity decays back toward a neutral floor per second. influences is an ordered list of event or trait names that may trigger mood transitions (e.g. ['@collision', 'npc:threat_detected']). on_change_event is the event name dispatched when mood or intensity changes, enabling downstream reactions in behavior trees and environment systems. Composes with @emotion for PAD-space detail and @animation for expression playback. Research: MoodTrait.ts moodHandler / SUPPORTED_MOODS / MoodConfig / MoodState.",
  props: {
    base_mood: enum("calm" | "curious" | "excited" | "sad" | "angry" | "fearful" | "neutral") = "neutral",
    intensity: number = 0.7,
    volatility: number = 0.3,
    recovery_rate: number = 0.1,
    influences: list<string> = [],
    on_change_event: string = "mood:changed"
  },
  events: {
    attached: "mood:attached",
    detached: "mood:detached",
    changed: "mood:changed",
    intensity_decayed: "mood:intensity_decayed",
    on_set_mood: "mood:set_mood",
    on_set_intensity: "mood:set_intensity",
    on_reset: "mood:reset",
    on_query: "mood:query"
  },
  behaviors: ["@emotion"]
}
