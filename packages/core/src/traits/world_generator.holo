@trait {
  name: "@world_generator",
  category: "world",
  description: "AI world generator. prompt is the generation prompt. engine: sovereign-3d (default), holo-sdf, trellis. format: 3dgs (default), glb, usd. quality: medium (default), low, high. Port of WorldGeneratorTrait.ts (handler name: world_generator).",
  props: {
    prompt: string = "",
    engine: enum("sovereign-3d" | "holo-sdf" | "trellis") = "sovereign-3d",
    format: enum("3dgs" | "glb" | "usd") = "3dgs",
    quality: enum("low" | "medium" | "high") = "medium"
  },
  events: {
    on_generated: "world_generator:generated",
    on_progress: "world_generator:progress",
    generate: "world_generator.generate"
  },
  behaviors: ["@world_foundation_model", "@world_state", "@scene_graph"]
}
