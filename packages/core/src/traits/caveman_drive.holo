@trait {
  name: "@caveman_drive",
  category: "behavior",
  description: "Sovereign-LLM-driven NPC drive system for the caveman archetype. Five scalar drives [0,1] (hunger, thirst, fatigue, fear, curiosity) updated via pure-math on every tick. LLM called only when a drive >= 0.8, attention_target changes, or the action queue is empty — targeting >=90% ticks LLM-free. ai_lod tier controls LLM allowance: near (default, full reasoning), mid (reserved), far (LLM disabled entirely). Composes with AIDriverTrait + BehaviorTreeTrait + NeuralAnimationTrait. Part of GLB->HoloScript $BRIAN Caveman pipeline. Port of CavemanDriveTrait.ts.",
  props: {
    ai_lod: enum("near" | "mid" | "far") = "near"
  },
  events: {
    on_drive_changed: "caveman_drive:drive_changed",
    on_action: "caveman_drive:action",
    on_llm_called: "caveman_drive:llm_called",
    set_lod: "caveman_drive.set_lod"
  },
  behaviors: ["@ai_npc_brain", "@behavior_tree", "@neural_animation"]
}
