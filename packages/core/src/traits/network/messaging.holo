@trait {
  name: "@messaging",
  category: "network",
  description: "Protocol-agnostic pub/sub and message-queue bridge for HoloScript entities. channel is the topic, subject, or channel name subscribed and published on — interpretation is protocol-specific (MQTT topic path, WebSocket room id, SSE event stream name, SignalR hub method, or HoloScript mesh channel). protocol selects the transport: mqtt uses the MQTT 3.1.1/5.0 publish-subscribe broker pattern and is the default for IoT and edge telemetry, websocket uses a direct bidirectional socket (JSON framing), sse opens a server-sent events stream (receive-only; pair on_send events with an outbound @webhook), signalr connects to a Microsoft SignalR hub for .NET interop, holoscript uses the built-in HoloMesh mesh-message bus. qos is the MQTT quality-of-service level: 0 = fire-and-forget, 1 = at-least-once, 2 = exactly-once; ignored for non-MQTT transports. persist, when true, stores undelivered messages locally until the connection is re-established (QoS 1/2 semantics without a broker; uses the entity's @offline_sync if attached). max_queue caps the local message buffer size when persist is true; oldest messages are dropped when the cap is reached. filter_expression is an optional string expression applied to incoming messages — only messages whose payload matches the expression are delivered to on_message. Syntax is protocol-specific: MQTT topic wildcards (+ #), JSONPath for websocket/SSE/holoscript, SignalR method name for signalr. on_message fires for each delivered inbound message carrying channel, payload, and metadata. on_send is the command event for outbound dispatch, accepting a payload and optional override channel. on_error fires on connection failure or malformed message with a reason string. Research: MessagingTrait.ts v4.0, MQTTSinkTrait.ts, MQTTSourceTrait.ts, SseTrait.ts, CspChannelTrait.ts.",
  props: {
    channel: string = "",
    protocol: enum("mqtt" | "websocket" | "sse" | "signalr" | "holoscript") = "holoscript",
    qos: enum("0" | "1" | "2") = "1",
    persist: boolean = false,
    max_queue: number = 1000,
    filter_expression: string = ""
  },
  events: {
    attached: "messaging:attached",
    detached: "messaging:detached",
    connected: "messaging:connected",
    disconnected: "messaging:disconnected",
    on_message: "messaging:message_received",
    on_send: "messaging:cmd_send",
    on_error: "messaging:error",
    on_subscribe: "messaging:cmd_subscribe",
    on_unsubscribe: "messaging:cmd_unsubscribe",
    queue_full: "messaging:queue_full"
  },
  behaviors: ["@offline_sync"]
}
