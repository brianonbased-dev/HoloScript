@trait {
  name: "@sms",
  category: "network",
  description: "SMS/MMS messaging sender for alerts, 2FA, and notification delivery. Integrates with Twilio, Vonage, or HoloScript mesh bridges. Authored from SmsTrait.ts.",
  props: {
    provider: enum("twilio" | "vonage" | "aws_sns" | "holoscript") = "holoscript",
    from_number: string = "",
    auth_secret: string = "",
    max_length: number = 160,
    unicode: boolean = false,
    delivery_report: boolean = false
  },
  events: {
    attached: "sms_attached",
    detached: "sms_detached",
    on_send: "sms_send",
    on_delivered: "sms_delivered",
    on_receive: "sms_receive",
    on_error: "sms_error",
    send: "sms_trigger_send"
  },
  behaviors: ["@messaging", "@alert"]
}
