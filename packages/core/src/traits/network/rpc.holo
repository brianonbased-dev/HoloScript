@trait {
  name: "@rpc",
  category: "network",
  description: "Remote procedure call stub. Exposes entity methods as typed RPC endpoints callable from peers, other agents, or external services over WebSocket or HTTP. Authored from RpcTrait.ts.",
  props: {
    transport: enum("websocket" | "http" | "grpc" | "holoscript") = "holoscript",
    methods: list<{ name: string, schema_url: string }> = [],
    timeout_ms: number = 5000,
    retry_max: number = 3,
    auth: enum("none" | "token" | "wallet" | "mtls") = "token",
    compression: boolean = true
  },
  events: {
    attached: "rpc_attached",
    detached: "rpc_detached",
    on_call: "rpc_call",
    on_result: "rpc_result",
    on_error: "rpc_error",
    on_timeout: "rpc_timeout",
    call: "rpc_trigger_call"
  },
  behaviors: ["@rest_client", "@service_mesh"]
}
