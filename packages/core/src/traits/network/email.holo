@trait {
  name: "@email",
  category: "network",
  description: "Transactional email sender with template rendering, attachment support, and delivery tracking. Integrates with SendGrid, Postmark, SES, or SMTP. Authored from EmailTrait.ts.",
  props: {
    provider: enum("sendgrid" | "postmark" | "ses" | "smtp" | "holoscript") = "holoscript",
    from_address: string = "",
    credentials_secret: string = "",
    reply_to: string = "",
    default_template_id: string = "",
    rate_limit_per_hour: number = 100,
    track_opens: boolean = false,
    track_clicks: boolean = false
  },
  events: {
    attached: "email_attached",
    detached: "email_detached",
    on_send: "email_send",
    on_delivered: "email_delivered",
    on_open: "email_open",
    on_click: "email_click",
    on_bounce: "email_bounce",
    on_error: "email_error",
    send: "email_trigger_send"
  },
  behaviors: ["@messaging", "@alert", "@push_notification"]
}
