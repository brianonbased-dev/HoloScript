@trait {
  name: "@rest_endpoint",
  category: "network",
  description: "Entity-scoped REST API endpoint. Exposes entity state and actions via HTTP routes with request validation, auth middleware, and response transforms. Authored from RestEndpointTrait.ts.",
  props: {
    base_path: string = "/",
    routes: list<{ method: enum("GET" | "POST" | "PUT" | "PATCH" | "DELETE"), path: string, action: string }> = [],
    auth: enum("none" | "bearer" | "api_key" | "wallet") = "none",
    rate_limit_rpm: number = 0,
    cors_origins: list<string> = [],
    response_schema_url: string = ""
  },
  events: {
    attached: "rest_endpoint_attached",
    detached: "rest_endpoint_detached",
    on_request: "rest_endpoint_request",
    on_response: "rest_endpoint_response",
    on_error: "rest_endpoint_error",
    on_auth_fail: "rest_endpoint_auth_fail"
  },
  behaviors: ["@rpc", "@rate_limiter", "@audit_log"]
}
