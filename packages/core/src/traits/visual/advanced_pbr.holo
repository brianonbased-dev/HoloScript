@trait {
  name: "@advanced_pbr",
  category: "visual",
  description: "Extended physically-based rendering material with second-layer optical phenomena beyond the base metallic-roughness model. subsurface_scattering enables volumetric light transport through translucent materials such as skin, wax, and marble; sss_radius is the mean free-path radius in world units controlling how far light scatters beneath the surface. anisotropy biases specular reflections along a tangent direction in [0, 1] — 0 is isotropic; 1 produces strong directional highlights (brushed metal, hair). clearcoat adds a thin dielectric coating layer in [0, 1] — 1 is a full lacquer finish over the base material. sheen_color is a linear RGB triple that tints the retroreflective sheen lobe used for fabric and velvet. iridescence in [0, 1] adds thin-film interference colour shift across the viewing angle (soap bubbles, oil slicks). transmission in [0, 1] controls the fraction of light transmitted through the surface for glass and water simulation; 0 = fully opaque. dispersion enables chromatic dispersion (wavelength-dependent refraction) when transmission > 0. on_update fires after any property change, carrying the mutated field name and new value. Research: AdvancedPBRTrait.ts ClearcoatConfig / AnisotropyConfig / IridescenceConfig / TransmissionConfig / SubsurfaceScatteringConfig.",
  props: {
    subsurface_scattering: boolean = false,
    sss_radius: number = 0.1,
    anisotropy: number = 0.0,
    clearcoat: number = 0.0,
    sheen_color: vec3 = [1.0, 1.0, 1.0],
    iridescence: number = 0.0,
    transmission: number = 0.0,
    dispersion: boolean = false
  },
  events: {
    attached: "advanced_pbr:attached",
    detached: "advanced_pbr:detached",
    configured: "advanced_pbr:configured",
    updated: "advanced_pbr:updated",
    error: "advanced_pbr:error",
    on_update: "advanced_pbr:update",
    on_set_clearcoat: "advanced_pbr:set_clearcoat",
    on_set_transmission: "advanced_pbr:set_transmission",
    on_set_anisotropy: "advanced_pbr:set_anisotropy",
    on_set_sss: "advanced_pbr:set_sss"
  },
  behaviors: ["@material", "@rendering"]
}
