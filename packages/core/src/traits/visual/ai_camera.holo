@trait {
  name: "@ai_camera",
  category: "visual",
  description: "AI-driven camera director that autonomously frames subjects, selects shot compositions, and adapts exposure in real time. mode sets the overall cinematographic intent: portrait prioritises face-centred tight framing and shallow depth of field, action maintains wide FOV and predictive tracking for fast-moving subjects, documentary biases toward environmental context and natural headroom, cinematic applies letterbox aspect and rule-of-thirds re-framing. auto_focus governs the focus subject selection: face triggers face-detection and keeps the primary face sharp, subject uses AI saliency to pick the most visually prominent subject, point locks on a world-space coordinate supplied via the on_set_focus_point command. exposure_mode controls how sensor parameters are derived: auto evaluates scene luminance per frame and adjusts exposure continuously, manual uses fixed shutter/iso values supplied via on_set_exposure, hdr blends multiple exposures for high-dynamic-range scenes. ai_enhance activates AI super-resolution and noise reduction as a post-process pass after the main render. stabilization enables gyroscopic warp stabilization of the output image to suppress camera shake. on_capture fires after each frame is finalised and written to the render target, carrying frame index and timestamp. on_switch fires when the runtime transitions between mode values, carrying old and new mode. on_zoom fires when the focal length changes, carrying the new focal length in millimetres. on_error fires on AI-model inference failure or hardware timeout, carrying the error code. Research: AiCameraTrait.ts v5.1, PhysicalCameraInputTrait.ts, PassthroughCameraTrait.ts.",
  props: {
    mode: enum("portrait" | "action" | "documentary" | "cinematic") = "documentary",
    auto_focus: enum("face" | "subject" | "point") = "subject",
    exposure_mode: enum("auto" | "manual" | "hdr") = "auto",
    ai_enhance: boolean = false,
    stabilization: boolean = true
  },
  events: {
    attached: "ai_camera:attached",
    detached: "ai_camera:detached",
    captured: "ai_camera:captured",
    mode_switched: "ai_camera:mode_switched",
    zoomed: "ai_camera:zoomed",
    focus_locked: "ai_camera:focus_locked",
    exposure_adjusted: "ai_camera:exposure_adjusted",
    error: "ai_camera:error",
    on_capture: "ai_camera:capture",
    on_switch_mode: "ai_camera:switch_mode",
    on_zoom: "ai_camera:zoom",
    on_set_focus_point: "ai_camera:set_focus_point",
    on_set_exposure: "ai_camera:set_exposure"
  }
}
