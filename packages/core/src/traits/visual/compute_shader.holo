@trait {
  name: "@compute_shader",
  category: "visual",
  description: "GPU compute shader dispatch. Binds a WGSL/GLSL/MSL compute kernel and exposes workgroup dispatch with typed buffer bindings. Authored from ComputeShaderTrait.ts.",
  props: {
    shader_url: string = "",
    workgroup_x: number = 1,
    workgroup_y: number = 1,
    workgroup_z: number = 1,
    bindings: list<{ name: string, type: string }> = [],
    backend: enum("webgpu" | "vulkan" | "metal" | "holoscript") = "webgpu",
    auto_dispatch: boolean = false,
    dispatch_interval_ms: number = 0
  },
  events: {
    attached: "compute_shader_attached",
    detached: "compute_shader_detached",
    on_dispatch: "compute_shader_dispatch",
    on_complete: "compute_shader_complete",
    on_error: "compute_shader_error",
    dispatch: "compute_shader_trigger_dispatch"
  },
  behaviors: ["@rendering"]
}
