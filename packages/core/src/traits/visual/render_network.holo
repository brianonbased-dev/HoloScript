@trait {
  name: "@render_network",
  category: "visual",
  description: "Distributed rendering network coordinator. Splits frame workloads across multiple GPU nodes, composites results, and streams the final image to the client. Authored from RenderNetworkTrait.ts.",
  props: {
    worker_urls: list<string> = [],
    split_mode: enum("tile" | "multi_view" | "layer" | "lod") = "tile",
    tile_count: number = 4,
    quality: enum("draft" | "balanced" | "high" | "max") = "balanced",
    compression: enum("jpeg" | "avif" | "webp" | "none") = "avif",
    target_fps: number = 60,
    fallback_local: boolean = true
  },
  events: {
    attached: "render_network_attached",
    detached: "render_network_detached",
    on_frame_ready: "render_network_frame_ready",
    on_worker_join: "render_network_worker_join",
    on_worker_fail: "render_network_worker_fail",
    on_latency: "render_network_latency"
  },
  behaviors: ["@render_pipeline", "@streaming", "@webrtc"]
}
