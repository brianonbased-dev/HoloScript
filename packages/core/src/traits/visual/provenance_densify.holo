@trait {
  name: "@provenance_densify",
  category: "visual",
  description: "Generative provenance densifier for sparse reconstruction meshes. Applies Wan2.1-based video diffusion inpainting to fill temporal gaps and view-coverage holes in HoloGram capture sessions, producing photorealistic dense output. D.101 carve-out 2026-06-24. Authored from ProvenanceDensifyTrait.ts.",
  props: {
    model_url: string = "",
    backend: enum("wan2_1" | "holoscript") = "wan2_1",
    strength: number = 0.6,
    guidance_scale: number = 7.5,
    steps: number = 20,
    target_resolution: enum("512" | "768" | "1024") = "768",
    preserve_geometry: boolean = true,
    gpu_budget_gb: number = 8.0
  },
  events: {
    attached: "provenance_densify_attached",
    detached: "provenance_densify_detached",
    on_densify: "provenance_densify_densify",
    on_complete: "provenance_densify_complete",
    on_error: "provenance_densify_error",
    densify: "provenance_densify_trigger"
  },
  behaviors: ["@stable_diffusion", "@diffusion_realtime", "@data_lineage"]
}
