@trait {
  name: "@advanced_lighting",
  category: "visual",
  description: "High-fidelity scene lighting pipeline with switchable rendering modes, global illumination, and probe-based irradiance caching. mode selects the lighting algorithm: lumen uses Unreal-style software GI with screen-space and mesh distance fields; path_trace engages a reference-quality path tracer (offline or progressive accumulation); rtgi uses hardware ray-tracing for real-time indirect diffuse and specular; baked relies on pre-computed lightmaps and irradiance volumes, consuming no per-frame GPU budget. bounce_count controls the maximum indirect-light bounce depth (1–8); higher counts increase realism at the cost of performance — baked ignores this at runtime. probe_density sets the spatial density of light probes per world metre for irradiance caching; higher density improves accuracy of indirect lighting on dynamic objects. shadow_mode governs the shadow algorithm: pcss applies percentage-closer soft shadows for contact-hardening penumbra; raytraced uses ray-traced shadows with physically correct area penumbra; cascaded uses cascaded shadow maps for outdoor sun lighting — fastest option, hard-edged. auto_exposure enables histogram-based automatic exposure (EV) compensation so scenes self-calibrate across bright and dark areas. on_bake fires when a lightmap bake completes, carrying duration_ms and texel_count. on_update fires each frame with the current rendering mode, active probe count, and GPU time budget consumed. Research: AdvancedLightingTrait.ts, LightingTrait.ts.",
  props: {
    mode: enum("lumen" | "path_trace" | "rtgi" | "baked") = "lumen",
    bounce_count: number = 3,
    probe_density: number = 1.0,
    shadow_mode: enum("pcss" | "raytraced" | "cascaded") = "pcss",
    auto_exposure: boolean = true
  },
  events: {
    attached: "advanced_lighting:attached",
    detached: "advanced_lighting:detached",
    configured: "advanced_lighting:configured",
    baked: "advanced_lighting:baked",
    updated: "advanced_lighting:updated",
    shadow_mode_changed: "advanced_lighting:shadow_mode_changed",
    error: "advanced_lighting:error",
    on_set_mode: "advanced_lighting:set_mode",
    on_bake: "advanced_lighting:bake",
    on_update: "advanced_lighting:update",
    on_set_shadow_mode: "advanced_lighting:set_shadow_mode",
    on_set_auto_exposure: "advanced_lighting:set_auto_exposure"
  },
  behaviors: ["@lighting", "@rendering"]
}
