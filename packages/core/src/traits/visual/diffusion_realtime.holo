@trait {
  name: "@diffusion_realtime",
  category: "visual",
  description: "Real-time diffusion model rendering overlay. Applies latent diffusion passes to the live WebGPU frame buffer for style transfer, upscaling, or world-skin swap. Authored from DiffusionRealtimeTrait.ts.",
  props: {
    model_url: string = "",
    strength: number = 0.4,
    prompt: string = "",
    style_image_url: string = "",
    guidance_scale: number = 3.5,
    steps: number = 4,
    mode: enum("style_transfer" | "upscale" | "world_skin" | "depth_aware") = "style_transfer",
    target_fps: number = 10
  },
  events: {
    attached: "diffusion_realtime_attached",
    detached: "diffusion_realtime_detached",
    on_frame: "diffusion_realtime_frame",
    on_mode_change: "diffusion_realtime_mode_change",
    set_strength: "diffusion_realtime_set_strength"
  },
  behaviors: ["@stable_diffusion", "@render_pipeline"]
}
