@trait {
  name: "@rendering",
  category: "visual",
  description: "Global renderer configuration trait controlling GPU backend selection, frame rate budget, vertical sync, shadow pipeline, anti-aliasing, and tone mapping. renderer selects the graphics backend: webgpu uses the WebGPU API (lowest-level, full compute + ray-trace access), webgl2 uses WebGL 2.0 (broadest compatibility, no compute shaders), cpu uses a software rasteriser (headless, CI, and accessibility fallback). resolution_scale is a multiplier applied to the output framebuffer dimensions: 1.0 = native, 0.5 = half-resolution upscaled, 1.5 = supersampled. target_fps is the requested frame rate cap in frames per second; the runtime throttles to this ceiling when the GPU headroom allows. vsync synchronises frame presentation to the display refresh interval to eliminate tearing (true) or presents as fast as rendered (false). shadows enables the global shadow pipeline; disabling shadows overrides per-entity @shadow cast/receive settings and removes all shadow map allocations. anti_alias selects the temporal or multi-sample anti-aliasing strategy: none disables AA entirely, msaa2/msaa4/msaa8 apply multi-sample AA at 2×/4×/8× sample counts, taa applies temporal AA accumulating across frames for near-native quality at low per-frame cost. tone_map selects the operator that converts HDR linear radiance to the display's LDR range: none clips to [0,1] directly, aces applies the Academy Color Encoding System filmic curve, filmic applies a generic filmic S-curve, reinhard applies the classic Reinhard luminance mapping. Pairs with @material, @lighting, and @shadow for per-entity pipeline participation. Research: RenderingTrait.ts, RenderPipelineTrait.ts, RenderNetworkTrait.ts.",
  props: {
    renderer: enum("webgpu" | "webgl2" | "cpu") = "webgpu",
    resolution_scale: number = 1.0,
    target_fps: number = 60,
    vsync: boolean = true,
    shadows: boolean = true,
    anti_alias: enum("none" | "msaa2" | "msaa4" | "msaa8" | "taa") = "msaa4",
    tone_map: enum("none" | "aces" | "filmic" | "reinhard") = "aces"
  },
  events: {
    attached: "rendering:attached",
    detached: "rendering:detached",
    configured: "rendering:configured",
    frame_start: "rendering:frame_start",
    frame_end: "rendering:frame_end",
    resize: "rendering:resize",
    backend_lost: "rendering:backend_lost",
    backend_restored: "rendering:backend_restored",
    on_configure: "rendering:configure",
    on_set_renderer: "rendering:set_renderer",
    on_set_resolution_scale: "rendering:set_resolution_scale",
    on_set_target_fps: "rendering:set_target_fps",
    on_set_vsync: "rendering:set_vsync",
    on_set_shadows: "rendering:set_shadows",
    on_set_anti_alias: "rendering:set_anti_alias",
    on_set_tone_map: "rendering:set_tone_map"
  },
  behaviors: []
}
