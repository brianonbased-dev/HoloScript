@trait {
  name: "@reid_embedding",
  category: "visual",
  description: "Re-identification embedding generator. Extracts appearance feature vectors from detected objects or persons, enabling multi-camera tracking and re-entry association. Authored from ReidEmbeddingTrait.ts.",
  props: {
    model_url: string = "",
    model_type: enum("osnet" | "fastreid" | "clip" | "holoscript") = "holoscript",
    embedding_dim: number = 512,
    gallery_size: number = 1000,
    match_threshold: number = 0.7,
    normalize: boolean = true,
    update_gallery: boolean = true
  },
  events: {
    attached: "reid_embedding_attached",
    detached: "reid_embedding_detached",
    on_embed: "reid_embedding_embed",
    on_match: "reid_embedding_match",
    on_new_id: "reid_embedding_new_id",
    embed: "reid_embedding_trigger_embed",
    clear_gallery: "reid_embedding_clear"
  },
  behaviors: ["@vision", "@object_tracking", "@segment"]
}
