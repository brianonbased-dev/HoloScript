@trait {
  name: "@render_pipeline",
  category: "visual",
  description: "Custom WebGPU/WebGL render pipeline definition. Configures pass order (geometry, shadows, lighting, post), blend states, depth test, and target resolution. Authored from RenderPipelineTrait.ts.",
  props: {
    passes: list<{ name: string, enabled: boolean, priority: number }> = [],
    target_resolution: enum("native" | "half" | "quarter" | "custom") = "native",
    custom_width: number = 1920,
    custom_height: number = 1080,
    hdr: boolean = true,
    msaa_samples: number = 4,
    backend: enum("webgpu" | "webgl2" | "holoscript") = "webgpu"
  },
  events: {
    attached: "render_pipeline_attached",
    detached: "render_pipeline_detached",
    on_frame_begin: "render_pipeline_frame_begin",
    on_frame_end: "render_pipeline_frame_end",
    on_resize: "render_pipeline_resize",
    on_pass_complete: "render_pipeline_pass_complete",
    set_resolution: "render_pipeline_set_resolution"
  },
  behaviors: ["@rendering", "@stereoscopic_camera"]
}
