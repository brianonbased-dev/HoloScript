@trait {
  name: "@qr_decode",
  category: "visual",
  description: "QR code and barcode decoder from camera frames or image URLs. Uses ZXing or a WebAssembly decoder to extract encoded URLs, agent handles, or arbitrary payloads from visual input. Authored from QrDecodeTrait.ts.",
  props: {
    mode: enum("camera" | "image_url" | "canvas") = "camera",
    formats: list<enum("qr_code" | "data_matrix" | "ean_13" | "code_128")> = [],
    scan_rate_hz: number = 5,
    min_confidence: number = 0.8,
    auto_navigate: boolean = false,
    highlight: boolean = true
  },
  events: {
    attached: "qr_decode_attached",
    detached: "qr_decode_detached",
    on_scan: "qr_decode_scan",
    on_error: "qr_decode_error",
    scan: "qr_decode_trigger_scan"
  },
  behaviors: ["@vision", "@deep_link"]
}
