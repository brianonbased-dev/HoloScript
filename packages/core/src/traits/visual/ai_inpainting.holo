@trait {
  name: "@ai_inpainting",
  category: "visual",
  description: "AI-powered inpainting that fills, removes, or modifies masked regions of textures and rendered frames using diffusion models. model selects the inference backend: stable_diffusion uses SD-inpaint or compatible checkpoints, flux uses FLUX-fill for high-fidelity region synthesis, holoscript routes through the HoloScript sovereign inference service. mask_mode controls how the inpaint region is specified: auto derives a mask from scene depth or segmentation heuristics, manual accepts an explicit mask supplied via on_set_mask. prompt is the text conditioning the inpaint fill; empty string uses unconditional fill guided only by the surrounding context. strength (0–1.0) governs how aggressively the diffusion process replaces the masked region; values near 0 preserve the original, near 1 allow complete synthesis. steps is the number of diffusion denoising steps; higher values improve quality at the cost of latency. feather_px is the mask feathering radius in pixels; non-zero values blend the inpainted region smoothly into the surrounding image. Send ai_inpainting:inpaint {prompt, regionId} to trigger a fill; result arrives via ai_inpainting:complete. ai_inpainting:progress fires with intermediate previews at each denoising step when the model supports it. Research: AiInpaintingTrait.ts, StableDiffusionTrait.ts, DiffusionRealtimeTrait.ts.",
  props: {
    model: enum("stable_diffusion" | "flux" | "holoscript") = "stable_diffusion",
    mask_mode: enum("auto" | "manual") = "auto",
    prompt: string = "",
    strength: number = 0.75,
    steps: number = 20,
    feather_px: number = 8
  },
  events: {
    attached: "ai_inpainting:attached",
    detached: "ai_inpainting:detached",
    ready: "ai_inpainting:ready",
    complete: "ai_inpainting:complete",
    progress: "ai_inpainting:progress",
    error: "ai_inpainting:error",
    on_inpaint: "ai_inpainting:inpaint",
    on_set_mask: "ai_inpainting:set_mask",
    on_set_prompt: "ai_inpainting:set_prompt"
  }
}
