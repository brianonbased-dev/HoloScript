@trait {
  name: "@gpu_particle",
  category: "visual",
  description: "GPU-accelerated compute-shader particle system supporting millions of particles with force fields, collisions, and procedural behavior. Authored from GPUParticleTrait.ts.",
  props: {
    max_particles: number = 1000000,
    emission_rate: number = 10000,
    lifetime_s: number = 2.0,
    start_speed: number = 5.0,
    start_size: number = 0.01,
    start_color: string = "#ffffff",
    texture_url: string = "",
    force_fields: list<{ type: enum("gravity" | "wind" | "vortex" | "attractor"), strength: number }> = [],
    collision: boolean = false,
    sort: boolean = false
  },
  events: {
    attached: "gpu_particle_attached",
    detached: "gpu_particle_detached",
    on_emit: "gpu_particle_emit",
    on_expire: "gpu_particle_expire",
    play: "gpu_particle_play",
    stop: "gpu_particle_stop",
    burst: "gpu_particle_burst"
  },
  behaviors: ["@particle_emitter", "@compute_shader", "@rendering"]
}
