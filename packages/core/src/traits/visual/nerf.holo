@trait {
  name: "@nerf",
  category: "visual",
  description: "Neural Radiance Field renderer. Loads a pre-trained NeRF model and renders novel views into the live scene via ray marching on WebGPU compute shaders. Authored from NerfTrait.ts.",
  props: {
    model_url: string = "",
    format: enum("instant_ngp" | "nerfstudio" | "3dgs" | "holoscript") = "instant_ngp",
    resolution: enum("256" | "512" | "1024") = "512",
    samples_per_ray: number = 64,
    near_plane: number = 0.1,
    far_plane: number = 100.0,
    exposure: number = 1.0
  },
  events: {
    attached: "nerf_attached",
    detached: "nerf_detached",
    on_loaded: "nerf_loaded",
    on_frame: "nerf_frame",
    on_error: "nerf_error"
  },
  behaviors: ["@compute_shader", "@rendering", "@scene_reconstruction"]
}
