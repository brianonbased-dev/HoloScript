@trait {
  name: "@photogrammetry",
  category: "visual",
  description: "Photogrammetry reconstruction pipeline trigger. Accepts a set of RGB images or video frames, submits to a COLMAP or instant-NGP reconstruction backend, and links the output mesh/splat into the entity's geometry slot. Authored from PhotogrammetryTrait.ts.",
  props: {
    images_url: string = "",
    backend: enum("colmap" | "instant_ngp" | "glomap" | "holoscript") = "holoscript",
    output_format: enum("gltf" | "ply" | "splat" | "nerf") = "splat",
    quality: enum("draft" | "medium" | "high") = "medium",
    geo_reference: boolean = false,
    coordinate_frame: string = "world"
  },
  events: {
    attached: "photogrammetry_attached",
    detached: "photogrammetry_detached",
    on_start: "photogrammetry_start",
    on_progress: "photogrammetry_progress",
    on_complete: "photogrammetry_complete",
    on_error: "photogrammetry_error",
    reconstruct: "photogrammetry_trigger"
  },
  behaviors: ["@point_cloud", "@nerf", "@gltf"]
}
