@trait {
  name: "@point_cloud",
  category: "visual",
  description: "3D point cloud renderer. Displays LiDAR, photogrammetry, or synthetic point data as GPU-instanced splat or circle primitives with per-point color and intensity attributes. Authored from PointCloudTrait.ts.",
  props: {
    src_url: string = "",
    format: enum("ply" | "laz" | "e57" | "pcd" | "holoscript") = "ply",
    point_size: number = 0.01,
    point_shape: enum("circle" | "square" | "splat") = "circle",
    max_points: number = 2000000,
    color_mode: enum("rgb" | "intensity" | "classification" | "height") = "rgb",
    dynamic_lod: boolean = true
  },
  events: {
    attached: "point_cloud_attached",
    detached: "point_cloud_detached",
    on_load: "point_cloud_load",
    on_lod_change: "point_cloud_lod",
    on_error: "point_cloud_error"
  },
  behaviors: ["@rendering", "@gpu_buffer", "@scene_reconstruction"]
}
