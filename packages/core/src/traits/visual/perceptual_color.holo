@trait {
  name: "@perceptual_color",
  category: "visual",
  description: "Perceptually uniform color space manager. Converts color values between sRGB, linear, OKLCH, and Display P3, applies color-blind simulation filters, and enforces WCAG contrast ratios for UI elements. Authored from PerceptualColorTrait.ts.",
  props: {
    space: enum("srgb" | "linear" | "oklch" | "display_p3" | "rec2020") = "srgb",
    colorblind_mode: enum("none" | "protanopia" | "deuteranopia" | "tritanopia" | "achromatopsia") = "none",
    wcag_level: enum("none" | "aa" | "aaa") = "aa",
    gamut_clip: boolean = true,
    tone_map: boolean = false
  },
  events: {
    attached: "perceptual_color_attached",
    detached: "perceptual_color_detached",
    on_mode_change: "perceptual_color_change",
    set_mode: "perceptual_color_set"
  },
  behaviors: ["@high_contrast", "@ui_theme", "@accessibility"]
}
