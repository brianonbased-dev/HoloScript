@trait {
  name: "@spatial_panel",
  category: "xr",
  description: "XR floating spatial UI panel anchored in world space. place is the panel position {x, y, z} in world/local space (default: {x:0, y:1.3, z:1.5} — eye level, 1.5m ahead). size is the panel dimensions {width, height} in meters (default: 1.2x1.2m). title is the panel header. follow_head makes the panel billboard/follow the user gaze (default: true). follow_distance is the target distance from the user when following (default: 1.2m). ambient enables ambient lighting on the panel (default: true). Emits panel:mount on attach. Port of SpatialPanelTrait.ts (handler name: spatial_panel).",
  props: {
    place_x: number = 0.0,
    place_y: number = 1.3,
    place_z: number = 1.5,
    width: number = 1.2,
    height: number = 1.2,
    title: string = "Universal QR Scanner",
    follow_head: boolean = true,
    follow_distance: number = 1.2,
    ambient: boolean = true
  },
  events: {
    on_mount: "panel:mount",
    on_dismiss: "panel:dismiss",
    dismiss: "panel.dismiss",
    set_position: "panel.set_position"
  },
  behaviors: ["@app_onboarding", "@tutorial"]
}
