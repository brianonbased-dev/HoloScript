@trait {
  name: "@compute",
  category: "webgpu",
  description: "Accelerator-neutral compute intent with optional WebGPU/WGSL execution. Authors declare the outcome, allowed accelerator classes, placement policy, quality rule, deadline, and spend ceiling; the sovereign ComputeWorkUnitCompiler emits a holoscript.compute-work-unit.v1 producer contract independently of backend shader generation. External bridge placement is only a request and requires runtime admission. Live device health, quota, credentials, prices, and leases are executor-injected and never language defaults. Legacy shader-only declarations remain valid. Port of ComputeTrait.ts (handler name: compute).",
  props: {
    workgroup_size: list<number> = [64, 1, 1],
    dispatch: list<number> = [1, 1, 1],
    shader_source: string = "",
    intent: string = "",
    allowed_accelerators: list<enum("cpu" | "gpu" | "npu" | "other")> = ["cpu"],
    placement_policy: enum("local_only" | "owned_fleet" | "external_bridge_requested") = "local_only",
    data_classification: enum("public" | "internal" | "confidential" | "restricted") = "confidential",
    quality_metric: string = "exact_result",
    quality_operator: enum("eq" | "lte" | "gte") = "eq",
    quality_threshold: number = 0,
    quality_reference: enum("none" | "cpu_reference") = "none",
    deadline_ms: number = 0,
    budget_currency: enum("USD") = "USD",
    max_cost_minor_units: number = 0,
    allow_fallback: boolean = true,
    auto_dispatch: boolean = false,
    dispatch_on_update: boolean = false,
    shared_memory_size: number = 0
  },
  events: {
    attached: "compute_attached",
    detached: "compute_detached",
    on_ready: "compute_ready",
    on_complete: "compute_complete",
    on_error: "compute_error",
    on_work_unit: "compute_work_unit",
    dispatch: "compute_trigger_dispatch",
    read_buffer: "compute_trigger_read_buffer"
  },
  behaviors: ["@gpu_physics", "@tensor_rt_inference", "@jetson_gpu"]
}
