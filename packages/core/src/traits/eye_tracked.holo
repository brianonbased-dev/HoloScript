@trait {
  name: "@eye_tracked",
  category: "xr",
  description: "Eye-tracked gaze interaction. dwell_enabled activates dwell-to-select (default: true). dwell_time is the dwell duration in ms before activation (default: 1000ms). dwell_feedback shows a dwell progress indicator (default: true). gaze_highlight highlights this object when gazed (default: true). highlight_color is the highlight color (default: #00ffff). Port of EyeTrackedTrait.ts (handler name: eye_tracked).",
  props: {
    dwell_enabled: boolean = true,
    dwell_time: number = 1000,
    dwell_feedback: boolean = true,
    gaze_highlight: boolean = true,
    highlight_color: string = "#00ffff"
  },
  events: {
    on_gaze_enter: "eye_tracked:gaze_enter",
    on_gaze_exit: "eye_tracked:gaze_exit",
    on_dwell: "eye_tracked:dwell",
    on_selected: "eye_tracked:selected"
  },
  behaviors: ["@accessible", "@gaze_focus_analytics"]
}
