@trait {
  name: "@permission",
  category: "security",
  description: "Fine-grained permission record for a principal-resource-action triple. Evaluated by @rbac at runtime, supporting conditional expressions, scope constraints, and expiry timestamps. Authored from PermissionTrait.ts.",
  props: {
    principal: string = "",
    resource: string = "",
    actions: list<string> = [],
    effect: enum("allow" | "deny") = "allow",
    conditions: dict<string, string> = {},
    expires_at: string = "",
    scope: enum("global" | "team" | "world" | "entity") = "entity"
  },
  events: {
    attached: "permission_attached",
    detached: "permission_detached",
    on_grant: "permission_grant",
    on_revoke: "permission_revoke",
    on_expire: "permission_expire",
    check: "permission_check"
  },
  behaviors: ["@rbac", "@role", "@jwt"]
}
