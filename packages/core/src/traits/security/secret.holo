@trait {
  name: "@secret",
  category: "security",
  description: "Vault-backed secret management with key-lifecycle control. key_name is the logical identifier used to address the secret across resolution backends. scope pins the secret to a visibility plane: node resolves only within the current entity, scene within the active scene, world across all entities in the world, global across all worlds in the deployment. rotation_days sets the automatic rotation cadence in whole days (0 = manual rotation only); the trait fires on_rotate at each cycle boundary and the host must supply a new value via the secret:rotate event. encrypt_at_rest forces in-process encryption of the cached value using the active @encryption algorithm before the secret is written to any durable store; if no @encryption trait is composed, AES-256-GCM with an HKDF-derived key is used as default. vault_backend selects the resolution backend: local reads from environment variables or the HoloScript in-process vault; holokey resolves through the sovereign HoloKey vault (I.022, $0 on-box operation); aws routes to AWS Secrets Manager; azure routes to Azure Key Vault. Compose with @encryption for layered at-rest protection and with @resource_accounting for audit receipts. Research: SecretTrait.ts v5.1, I.022 sovereign vault LIVE, wisdom_holokey-vault-cutover-proven-prod.md.",
  props: {
    key_name: string = "",
    scope: enum("node" | "scene" | "world" | "global") = "node",
    rotation_days: number = 0,
    encrypt_at_rest: boolean = true,
    vault_backend: enum("local" | "holokey" | "aws" | "azure") = "holokey"
  },
  events: {
    attached: "secret:attached",
    detached: "secret:detached",
    stored: "secret:store",
    retrieved: "secret:retrieve",
    result: "secret:result",
    expired: "secret:expired",
    deleted: "secret:deleted",
    on_rotate: "secret:rotate",
    on_expire: "secret:expire",
    on_access: "secret:access"
  },
  behaviors: ["@encryption"]
}
