@trait {
  name: "@jwt",
  category: "security",
  description: "JWT issuance and verification. Signs tokens with a secret or RSA key, verifies incoming JWTs, validates claims (exp, iss, aud), and provides a refresh-token rotation flow. Authored from JwtTrait.ts.",
  props: {
    algorithm: enum("hs256" | "rs256" | "es256" | "ps256") = "hs256",
    secret: string = "",
    issuer: string = "",
    audience: string = "",
    expiry_s: number = 3600,
    refresh_expiry_s: number = 604800,
    clock_skew_s: number = 30
  },
  events: {
    attached: "jwt_attached",
    detached: "jwt_detached",
    on_issue: "jwt_issue",
    on_verify: "jwt_verify",
    on_refresh: "jwt_refresh",
    on_revoke: "jwt_revoke",
    on_invalid: "jwt_invalid",
    issue: "jwt_trigger_issue",
    verify: "jwt_trigger_verify"
  },
  behaviors: ["@sso", "@rbac", "@api_key"]
}
