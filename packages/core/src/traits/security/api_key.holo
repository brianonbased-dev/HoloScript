@trait {
  name: "@api_key",
  category: "security",
  description: "API key lifecycle manager. Issues, rotates, scopes, and revokes API keys for entities and agents. Supports prefix-based key formats with HMAC verification. Authored from ApiKeyTrait.ts.",
  props: {
    prefix: string = "hk_",
    scopes: list<string> = [],
    ttl_days: number = 365,
    rotation_days: number = 90,
    max_keys_per_entity: number = 10,
    hash_algorithm: enum("sha256" | "sha512" | "blake3") = "sha256",
    revoke_on_breach: boolean = true
  },
  events: {
    attached: "api_key_attached",
    detached: "api_key_detached",
    on_issue: "api_key_issue",
    on_verify: "api_key_verify",
    on_revoke: "api_key_revoke",
    on_rotate: "api_key_rotate",
    on_expire: "api_key_expire",
    issue: "api_key_trigger_issue",
    verify: "api_key_trigger_verify",
    revoke: "api_key_trigger_revoke"
  },
  behaviors: ["@secret", "@audit_log", "@access_control"]
}
