@trait {
  name: "@consent_gate",
  category: "security",
  description: "Consent enforcement gate that blocks data access or feature activation until explicit user consent is recorded and unexpired. Authored from ConsentGateTrait.ts.",
  props: {
    purpose: string = "",
    consent_version: string = "1.0",
    required: boolean = true,
    allow_withdraw: boolean = true,
    ttl_days: number = 0,
    ui_prompt: enum("banner" | "modal" | "inline" | "silent") = "modal",
    log_decisions: boolean = true
  },
  events: {
    attached: "consent_gate_attached",
    detached: "consent_gate_detached",
    on_grant: "consent_gate_grant",
    on_deny: "consent_gate_deny",
    on_withdraw: "consent_gate_withdraw",
    on_expire: "consent_gate_expire",
    prompt: "consent_gate_prompt",
    withdraw: "consent_gate_trigger_withdraw"
  },
  behaviors: ["@privacy", "@audit_log", "@access_control"]
}
