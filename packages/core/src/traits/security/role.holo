@trait {
  name: "@role",
  category: "security",
  description: "Named role definition with permission set and inheritance chain. Consumed by @rbac to resolve effective permissions for a principal, supporting wildcard matching and hierarchical role trees. Authored from RoleTrait.ts.",
  props: {
    role_name: string = "",
    permissions: list<string> = [],
    inherits: list<string> = [],
    description: string = "",
    is_system_role: boolean = false,
    max_sessions: number = 0
  },
  events: {
    attached: "role_attached",
    detached: "role_detached",
    on_grant: "role_grant",
    on_revoke: "role_revoke",
    on_inherit_change: "role_inherit_change",
    grant: "role_trigger_grant",
    revoke: "role_trigger_revoke"
  },
  behaviors: ["@rbac", "@jwt"]
}
