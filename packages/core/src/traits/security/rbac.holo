@trait {
  name: "@rbac",
  category: "security",
  description: "Role-based access control policy engine. Assigns roles to principals, maps roles to permissions, and enforces checks at entity action boundaries. Authored from RBACTrait.ts.",
  props: {
    roles: list<{ name: string, permissions: list<string>, inherits: list<string> }> = [],
    default_role: string = "guest",
    deny_by_default: boolean = true,
    wildcard_permission: string = "*",
    audit_all: boolean = false,
    backend: enum("memory" | "holoscript" | "opa" | "cedar") = "holoscript"
  },
  events: {
    attached: "rbac_attached",
    detached: "rbac_detached",
    on_grant: "rbac_grant",
    on_deny: "rbac_deny",
    on_role_change: "rbac_role_change",
    on_error: "rbac_error",
    check: "rbac_check",
    assign_role: "rbac_assign",
    revoke_role: "rbac_revoke"
  },
  behaviors: ["@access_control", "@audit_log", "@identity_provider"]
}
