@trait {
  name: "@audit_log",
  category: "security",
  description: "Immutable append-only audit trail with hash-chain integrity, severity filtering, compliance tagging, and configurable retention. log_url is the remote SIEM or webhook endpoint that receives critical-severity entries in real time; leave empty to disable remote forwarding. actions is an allow-list of action strings accepted into the log (e.g. 'user.login', 'scene.delete'); an empty list accepts all actions. severity controls the minimum severity level recorded: info captures all entries, warn skips info-level, error skips info+warn, critical records only critical events. on_entry fires when a new entry is appended to the log, carrying the entry payload including timestamp, actor, action, result, and severity. on_flush fires when the in-memory buffer is persisted or forwarded to log_url, carrying entry count and destination. on_alert fires for any critical-severity entry regardless of include_stack, carrying the full entry payload for immediate incident triage. include_stack attaches a caller stack trace to every entry — useful for development audits but disable in production to avoid sensitive path leakage. max_retention_days controls how long persisted entries are kept before eviction (0 = indefinite). Pairs with @rbac and @access_control for policy-change audit, @secret for secret-access audit, @consent_gate for consent event logging. Research: AuditLogTrait.ts, RBACTrait.ts.",
  props: {
    log_url: string = "",
    actions: array<string> = [],
    severity: enum("info" | "warn" | "error" | "critical") = "info",
    include_stack: boolean = false,
    max_retention_days: number = 90
  },
  events: {
    attached: "audit_log:attached",
    detached: "audit_log:detached",
    on_entry: "audit_log:entry",
    on_flush: "audit_log:flush",
    on_alert: "audit_log:alert",
    on_query: "audit_log:query",
    on_export: "audit_log:export",
    on_set_severity: "audit_log:set_severity",
    entry_added: "audit_log:added",
    flushed: "audit_log:flushed",
    alerted: "audit_log:alerted",
    query_result: "audit_log:query_result",
    exported: "audit_log:exported"
  },
  behaviors: ["@telemetry"]
}
