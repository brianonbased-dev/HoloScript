@trait {
  name: "@oauth",
  category: "security",
  description: "OAuth 2.0 / PKCE authorization code flow handler. Initiates the auth redirect, exchanges the code for access and refresh tokens, stores them in the HoloKey vault, and fires events on token refresh. Authored from OauthTrait.ts.",
  props: {
    provider: enum("google" | "github" | "discord" | "holoscript" | "custom") = "holoscript",
    client_id_secret: string = "",
    redirect_uri: string = "",
    scopes: list<string> = [],
    pkce: boolean = true,
    auto_refresh: boolean = true,
    token_store: enum("vault" | "memory" | "cookie") = "vault"
  },
  events: {
    attached: "oauth_attached",
    detached: "oauth_detached",
    on_login: "oauth_login",
    on_logout: "oauth_logout",
    on_token_refresh: "oauth_refresh",
    on_error: "oauth_error",
    login: "oauth_trigger_login",
    logout: "oauth_trigger_logout"
  },
  behaviors: ["@sso", "@jwt", "@mfa"]
}
