@trait {
  name: "@webhook_out",
  category: "integration",
  description: "Outbound webhook with retry. max_retries is the delivery retry limit (default: 3). timeout_ms is the per-attempt timeout in ms (default: 5,000ms). Port of WebhookOutTrait.ts (handler name: webhook_out).",
  props: {
    max_retries: number = 3,
    timeout_ms: number = 5000
  },
  events: {
    on_sent: "webhook_out:sent",
    on_failed: "webhook_out:failed",
    send: "webhook_out.send"
  },
  behaviors: ["@webhook", "@pipeline", "@messaging"]
}
