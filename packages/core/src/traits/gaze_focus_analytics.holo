@trait {
  name: "@gaze_focus_analytics",
  category: "xr",
  description: "VR/XR gaze heatmap and focus analytics. resolution is the heatmap grid dimensions [columns, rows] (default: [16, 9]). decay_rate_s is the heatmap cell half-life in seconds (default: 30.0s). export_event is the event type that triggers heatmap export (default: session_end). export_format: json or csv. session_id labels the analytics export. max_peers is the maximum tracked peer count for multi-user sessions (default: 64). min_confidence is the minimum eye-tracking confidence score to record a gaze hit (default: 0.5). emit_live_updates enables per-frame live heatmap events (default: false). Port of GazeFocusAnalyticsTrait.ts (handler name: gaze_focus_analytics).",
  props: {
    decay_rate_s: number = 30.0,
    export_event: string = "session_end",
    export_format: enum("json" | "csv") = "json",
    session_id: string = "",
    max_peers: number = 64,
    min_confidence: number = 0.5,
    emit_live_updates: boolean = false
  },
  events: {
    on_gaze_hit: "gaze_focus_hit",
    on_exported: "gaze_focus_exported",
    on_peer_gaze: "gaze_focus_peer_gaze",
    export: "gaze_focus_export",
    reset: "gaze_focus_reset"
  },
  behaviors: ["@plane_detection", "@passthrough_camera"]
}
