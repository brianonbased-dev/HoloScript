@trait {
  name: "@roadmap_node",
  category: "ux",
  description: "Roadmap milestone node — renders a timeline milestone with optional progress and interactivity. milestone_id identifies the node. show_progress displays a progress indicator (default: true). interactive enables click/tap interaction (default: true). Port of RoadmapTrait.ts (handler name: roadmap_node).",
  props: {
    milestone_id: string = "",
    show_progress: boolean = true,
    interactive: boolean = true
  },
  events: {
    on_clicked: "roadmap_node:clicked",
    on_completed: "roadmap_node:completed",
    update_progress: "roadmap_node.update_progress"
  },
  behaviors: ["@interactive_graph", "@accessible"]
}
