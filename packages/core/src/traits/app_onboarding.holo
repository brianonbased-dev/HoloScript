@trait {
  name: "@onboarding",
  category: "ux",
  description: "XR app onboarding/tutorial trait — presents the introductory UI flow for a HoloScript application. title is the onboarding screen title (default: Universal QR Scanner). tagline is the one-line description. how_to_use is an ordered list of instruction steps {icon, text}. aim_tip is a contextual hint shown during active use. start_action is the primary CTA label (default: Start scanning). tutorial_action is the secondary CTA for a guided tutorial (default: See how it works). Emits onboarding:show on attach and onboarding:complete when dismissed. NOTE: this is the core XR app tutorial handler; the hr-workforce @onboarding handles employee checklist onboarding. Port of core/traits/OnboardingTrait.ts (handler name: onboarding).",
  props: {
    title: string = "Universal QR Scanner",
    tagline: string = "",
    aim_tip: string = "",
    start_action: string = "Start scanning",
    tutorial_action: string = "See how it works"
  },
  events: {
    on_show: "onboarding:show",
    on_complete: "onboarding:complete",
    show: "onboarding:show",
    complete: "onboarding:complete"
  },
  behaviors: ["@tutorial", "@qr_decode"]
}
