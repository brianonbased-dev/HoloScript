@trait {
  name: "@analytics",
  category: "analytics",
  description: "Comprehensive analytics pipeline orchestrator for product, user, and session telemetry with multi-provider routing, PII scrubbing, consent gating, and adaptive sampling. provider selects the analytics backend: google routes to Google Analytics 4 via the Measurement Protocol; mixpanel posts to Mixpanel's Ingestion API with all standard MP event fields; segment routes through Segment's unified pipeline (Segment then fan-outs to downstream destinations per the workspace config); holoscript routes to the HoloScript internal analytics store for training-data and provenance pipelines. on_page_view fires when the attached entity signals a 'page' or 'scene' view transition, carrying the view identifier and referrer. on_event fires on any named product event, carrying event_name, a string-keyed string properties dict, and the resolved provider id. on_identify fires when a user or agent identity is established, carrying user_id and traits dict; dispatches an Identify call to the provider. on_group fires when the user is associated with an account or organisation, carrying group_id and group traits dict; dispatches a Group call where supported. sampling_rate (0.0–1.0) gates the fraction of events forwarded to the provider — events sampled out are still locally counted via on_event but suppressed from the network call; 1.0 disables sampling. pii_strip removes values matching known PII patterns (email, phone, IPv4, full names) from the properties dict before dispatch; the stripped keys are enumerated in on_event as 'stripped_keys'. consent_required gates all provider dispatch behind an explicit consent signal; if true and consent has not been granted, events are queued locally and flushed only after on_consent_granted fires. Pairs with @analytics_event for individual event declarations, @telemetry for system-metric observability, and @session for session-scoped context. Research: AnalyticsTrait.ts, TelemetryTrait.ts, SegmentTrait.ts.",
  props: {
    provider: enum("google" | "mixpanel" | "segment" | "holoscript") = "holoscript",
    sampling_rate: number = 1.0,
    pii_strip: boolean = true,
    consent_required: boolean = false
  },
  events: {
    attached: "analytics:attached",
    detached: "analytics:detached",
    on_page_view: "analytics:page_view",
    on_event: "analytics:event",
    on_identify: "analytics:identify",
    on_group: "analytics:group",
    page_view_sent: "analytics:page_view_sent",
    event_sent: "analytics:event_sent",
    identify_sent: "analytics:identify_sent",
    group_sent: "analytics:group_sent",
    consent_granted: "analytics:consent_granted",
    consent_revoked: "analytics:consent_revoked",
    on_consent_granted: "analytics:grant_consent",
    on_consent_revoked: "analytics:revoke_consent",
    on_set_provider: "analytics:set_provider",
    on_set_sampling_rate: "analytics:set_sampling_rate",
    on_flush: "analytics:flush",
    on_reset: "analytics:reset",
    error: "analytics:error"
  },
  behaviors: ["@analytics_event", "@telemetry"]
}
