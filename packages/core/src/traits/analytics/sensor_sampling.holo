@trait {
  name: "@sensor_sampling",
  category: "analytics",
  description: "Domain-neutral signal acquisition pipeline with configurable sampling strategy, windowed aggregation, and optional normalisation. Covers robotics joint encoders, IoT environment sensors, scientific instruments, XR biofeedback, and any time-series input. method selects when readings enter the pipeline: fixed_rate samples at a regular interval (set via debounce_ms as the period), on_change fires only when the incoming value differs from the last buffered reading by more than a deadband, triggered accumulates readings only between explicit on_arm and on_disarm command events. window_size is the number of readings retained in the rolling buffer; older readings are discarded once the buffer is full. debounce_ms is the minimum time in milliseconds between accepted readings regardless of method — prevents burst flooding on noisy sensor lines; for fixed_rate mode this doubles as the sampling period. aggregate selects the windowed statistic emitted by on_sample: none emits the raw reading, mean computes the arithmetic mean over the window, median returns the middle value, max_min emits a pair of the extreme values. normalize maps the aggregated value into the [0, 1] range using the observed window minimum and maximum as dynamic bounds; useful for display and downstream ML inputs. on_sample fires after each accepted and aggregated reading. on_window_complete fires when the rolling buffer reaches window_size for the first time, and again each time a reading evicts the oldest entry (i.e. once the window is full, fires on every new reading). Research: SensorSamplingTrait.ts v1.0.0 ring-buffer + noise models + windowed stats.",
  props: {
    window_size: number = 32,
    method: enum("fixed_rate" | "on_change" | "triggered") = "fixed_rate",
    debounce_ms: number = 100,
    aggregate: enum("none" | "mean" | "median" | "max_min") = "none",
    normalize: boolean = false
  },
  events: {
    attached: "sensor_sampling:attached",
    detached: "sensor_sampling:detached",
    on_sample: "sensor_sampling:sample",
    on_window_complete: "sensor_sampling:window_complete",
    on_record: "sensor_sampling:record",
    on_arm: "sensor_sampling:arm",
    on_disarm: "sensor_sampling:disarm",
    on_reset: "sensor_sampling:reset",
    on_set_method: "sensor_sampling:set_method",
    on_set_aggregate: "sensor_sampling:set_aggregate"
  }
}
