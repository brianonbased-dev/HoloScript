@trait {
  name: "@analytics_event",
  category: "analytics",
  description: "Declarative product analytics event tracker with batching, flushing, and multi-backend routing. event_name is the canonical name of the event emitted to the analytics backend (e.g. 'scene_loaded', 'agent_spawned'); the consuming backend uses this as the event identifier in its schema. properties is a string-keyed string dict of static attributes attached to every emission of this event; dynamic properties are merged at track time via the on_track command event. backend selects the analytics destination: amplitude and mixpanel route to their respective cloud SDKs, segment routes through Segment's unified pipeline, holoscript routes to the HoloScript internal analytics store for training-data and provenance pipelines. batch_size is the maximum number of events held in the outbound buffer before an automatic flush; reaching this threshold fires on_flush before the buffer fills. flush_interval_ms is the periodic flush cadence independent of batch_size; both triggers are OR-gated. on_track fires when a single event is appended to the outbound buffer, carrying event_name, merged properties, and a monotonic sequence number. on_flush fires when the batch is dispatched, carrying batch size and destination backend. on_error fires on delivery failure, carrying the backend error and the undelivered batch for retry. Pairs with @telemetry for system-metric observability, @event_log for in-scene structured logging, and @session for session-scoped user context. Research: AnalyticsTrait.ts, TelemetryTrait.ts.",
  props: {
    event_name: string = "",
    properties: dict<string, string> = {},
    backend: enum("amplitude" | "mixpanel" | "segment" | "holoscript") = "holoscript",
    batch_size: number = 50,
    flush_interval_ms: number = 10000
  },
  events: {
    attached: "analytics_event:attached",
    detached: "analytics_event:detached",
    on_track: "analytics_event:track",
    on_flush: "analytics_event:flush",
    on_error: "analytics_event:error",
    on_set_backend: "analytics_event:set_backend",
    on_set_properties: "analytics_event:set_properties",
    tracked: "analytics_event:tracked",
    flushed: "analytics_event:flushed",
    error: "analytics_event:errored",
    backend_changed: "analytics_event:backend_changed"
  },
  behaviors: ["@telemetry"]
}
