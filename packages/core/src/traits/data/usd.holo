@trait {
  name: "@usd",
  category: "data",
  description: "OpenUSD (Universal Scene Description) import/export with layer composition, variant sets, and time-sampled animation. Supports USDZ for Apple AR. Configurable purpose filter (default/render/proxy/guide), lazy/eager/deferred payload loading, skeletal animation, blend shapes, physics, MaterialX/preview/native material conversion, up-axis (Y/Z), instancing, and subdivision. Port of USDTrait.ts (handler name: usd).",
  props: {
    source: string = "",
    layer: string = "",
    variant_set: string = "",
    variant: string = "",
    purpose: enum("default" | "render" | "proxy" | "guide") = "default",
    time_code: number = 0.0,
    payload_loading: enum("eager" | "lazy" | "deferred") = "eager",
    enable_ar: boolean = false,
    ar_anchor: enum("plane" | "face" | "world" | "image") = "plane",
    scale: number = 1.0,
    up_axis: enum("y" | "z") = "y",
    meters_per_unit: number = 1.0,
    enable_skeletal: boolean = true,
    enable_blend_shapes: boolean = true,
    enable_physics: boolean = false,
    material_conversion: enum("preview" | "materialx" | "native") = "preview",
    cast_shadows: boolean = true,
    receive_shadows: boolean = true,
    auto_play: boolean = false,
    loop_animation: boolean = true,
    frame_rate: number = 24,
    streaming_priority: enum("critical" | "high" | "normal" | "low") = "normal",
    enable_instancing: boolean = true,
    subdivision_level: number = 0
  },
  events: {
    attached: "usd_attached",
    detached: "usd_detached",
    on_loaded: "usd_loaded",
    on_error: "usd_error",
    on_animation_frame: "usd_animation_frame",
    load: "usd_load",
    unload: "usd_unload",
    set_variant: "usd_set_variant",
    play: "usd_play",
    stop: "usd_stop",
    seek: "usd_seek"
  },
  behaviors: ["@gltf", "@material_x", "@physics_body"]
}
