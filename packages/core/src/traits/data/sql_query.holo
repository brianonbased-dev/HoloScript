@trait {
  name: "@sql_query",
  category: "data",
  description: "Native SQL query execution bridge. Accepts sql:exec and sql:prepare commands, tracking query count and emitting results capped at max_results. Port of SqlQueryTrait.ts (handler name: sql_query).",
  props: {
    max_results: number = 1000
  },
  events: {
    attached: "sql_query_attached",
    detached: "sql_query_detached",
    on_result: "sql_result",
    on_prepared: "sql_prepared",
    on_error: "sql_error",
    exec: "sql_exec",
    prepare: "sql_prepare"
  },
  behaviors: ["@database", "@vector_db", "@faceted_search"]
}
