@trait {
  name: "@incident",
  category: "reliability",
  description: "Incident tracker — records and manages operational incidents. max_incidents is the maximum retained incidents (default: 200). auto_archive_resolved archives resolved incidents automatically (default: true). Port of IncidentTrait.ts (handler name: incident).",
  props: {
    max_incidents: number = 200,
    auto_archive_resolved: boolean = true
  },
  events: {
    on_opened: "incident:opened",
    on_resolved: "incident:resolved",
    on_archived: "incident:archived",
    open: "incident.open",
    resolve: "incident.resolve",
    archive: "incident.archive"
  },
  behaviors: ["@healthcheck", "@alert", "@audit_log"]
}
