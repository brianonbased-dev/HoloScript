@trait {
  name: "@lobby",
  category: "multiplayer",
  description: "Multiplayer lobby — manages player slots, matchmaking, and session start. Config is game-type-dependent and passed through to LobbyTrait instance. Port of LobbyTrait.ts (handler name: lobby).",
  props: {},
  events: {
    on_player_joined: "lobby:player_joined",
    on_player_left: "lobby:player_left",
    on_started: "lobby:started",
    on_full: "lobby:full",
    join: "lobby.join",
    leave: "lobby.leave",
    start: "lobby.start"
  },
  behaviors: ["@co_located", "@crdt_room"]
}
