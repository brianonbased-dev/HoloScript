@trait {
  name: "@zero_knowledge_proof",
  category: "web3",
  description: "Zero-knowledge proof generator. proof_system: zk_snark (default), zk_stark, bulletproofs, plonk, groth16. Port of ZeroKnowledgeProofTrait.ts (handler name: zero_knowledge_proof).",
  props: {
    proof_system: enum("zk_snark" | "zk_stark" | "bulletproofs" | "plonk" | "groth16") = "zk_snark"
  },
  events: {
    on_proved: "zero_knowledge_proof:proved",
    on_verified: "zero_knowledge_proof:verified",
    prove: "zero_knowledge_proof.prove",
    verify: "zero_knowledge_proof.verify"
  },
  behaviors: ["@zk_private", "@token_gated", "@package_signing"]
}
