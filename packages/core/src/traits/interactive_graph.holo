@trait {
  name: "@interactive_graph",
  category: "visualization",
  description: "Interactive graph visualization with hover/click inspection. hover_highlight highlights nodes on hover (default: true). click_inspect opens an inspection panel on click (default: true). edge_highlight highlights connected edges (default: true). multi_select enables multi-node selection (default: true). tooltip_delay is the hover tooltip delay in ms (default: 300ms). Port of InteractiveGraphTrait.ts (handler name: interactive_graph).",
  props: {
    hover_highlight: boolean = true,
    click_inspect: boolean = true,
    edge_highlight: boolean = true,
    multi_select: boolean = true,
    tooltip_delay: number = 300
  },
  events: {
    on_node_click: "interactive_graph:node_click",
    on_edge_click: "interactive_graph:edge_click",
    on_select: "interactive_graph:select"
  },
  behaviors: ["@heatmap_3d", "@data_binding"]
}
