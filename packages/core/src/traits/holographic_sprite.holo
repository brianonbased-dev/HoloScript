@trait {
  name: "@holographic_sprite",
  category: "render",
  description: "Holographic sprite — renders a 2D image as a depth-displaced holographic billboard. imageSourceProp is the prop name holding the image URL. segmentMethod: ai, depth, alpha (default segmentation approach). depthMode: disparity, metric, relative (default depth extraction mode). displacementScale is the depth extrusion strength (default: 1.0). Port of HolographicSpriteTrait.ts (handler name: @holographic_sprite — note the @ prefix in the TS source).",
  props: {
    image_source_prop: string = "imageSource",
    segment_method: string = "ai",
    depth_mode: string = "disparity",
    depth_interval_ms: number = 1000,
    displacement_scale: number = 1.0
  },
  events: {
    on_loaded: "holographic_sprite:loaded",
    on_error: "holographic_sprite:error",
    load: "holographic_sprite.load"
  },
  behaviors: ["@depth_estimation", "@gaussian_splat"]
}
