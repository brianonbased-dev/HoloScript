@trait {
  name: "@morph",
  category: "animation",
  description: "Blend shape morph target animator. Config is target-dependent and passed through to MorphTrait instance. Port of MorphTrait.ts (handler name: morph).",
  props: {},
  events: {
    on_morphed: "morph:morphed",
    set_weight: "morph.set_weight",
    blend: "morph.blend"
  },
  behaviors: ["@emotion", "@lip_sync", "@face_tracking"]
}
