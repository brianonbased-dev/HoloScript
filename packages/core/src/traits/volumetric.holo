@trait {
  name: "@volumetric",
  category: "rendering",
  description: "Volumetric data renderer. src is the data source URL. render_mode: splat (default), voxel, mip. point_size is the splat/voxel display size (default: 1.0). opacity is the volume opacity (default: 1.0). Port of VolumetricTrait.ts (handler name: volumetric).",
  props: {
    src: string = "",
    render_mode: enum("splat" | "voxel" | "mip") = "splat",
    point_size: number = 1.0,
    opacity: number = 1.0
  },
  events: {
    on_loaded: "volumetric:loaded",
    on_rendered: "volumetric:rendered"
  },
  behaviors: ["@point_cloud", "@volumetric_video", "@post_process"]
}
