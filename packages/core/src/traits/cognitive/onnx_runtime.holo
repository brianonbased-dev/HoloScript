@trait {
  name: "@onnx_runtime",
  category: "cognitive",
  description: "Event-driven ONNX model execution runtime with pluggable backend dispatch. model_url is the local file path or registry URI of the .onnx model weights to load. providers is a priority-ordered list of execution backends tried in sequence: cpu runs ONNX Runtime on the host CPU; webgpu dispatches to GPU compute shaders for in-browser/on-device acceleration; wasm uses the pure-WASM ONNX Runtime fallback for maximum portability. input_names declares the model's named input tensors so the handler can validate caller payloads before dispatch. output_names declares the named output tensors to extract from the backend result. warm_up pre-warms the backend on attach by running a zero-tensor dummy pass, reducing first-inference latency. quantized indicates the model uses INT8/FP16 weights requiring a quantization-aware backend path. Emit onnx:load {modelId, modelUrl} to load a model; onnx:run {modelId, inputs} to run inference; result arrives as onnx:output {modelId, outputs, durationMs}; onnx:dispose {modelId} frees backend resources. Backpressure: no internal queue — callers must batch for multi-NPC scenes. Research: OnnxRuntimeTrait.ts, InferenceTrait.ts, engines/onnx-adapter.ts.",
  props: {
    model_url: string = "",
    providers: list<enum("cpu" | "webgpu" | "wasm")> = ["cpu"],
    input_names: list<string> = [],
    output_names: list<string> = [],
    warm_up: boolean = false,
    quantized: boolean = false
  },
  events: {
    attached: "onnx:attached",
    detached: "onnx:detached",
    loaded: "onnx:loaded",
    output: "onnx:output",
    disposed: "onnx:disposed",
    error: "onnx:error",
    on_load: "onnx:load",
    on_run: "onnx:run",
    on_dispose: "onnx:dispose"
  },
  behaviors: ["@inference"]
}
