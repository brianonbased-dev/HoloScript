@trait {
  name: "@local_inference",
  category: "cognitive",
  description: "On-device LLM inference via llama.cpp or ONNX runtimes. Routes inference requests to the local model binary before falling back to the cloud endpoint, enabling offline and low-latency agent responses. Authored from LocalInferenceTrait.ts.",
  props: {
    model_path: string = "",
    backend: enum("llama_cpp" | "onnx" | "mlx" | "holoscript") = "llama_cpp",
    context_length: number = 4096,
    threads: number = 4,
    gpu_layers: number = 0,
    quantization: enum("fp16" | "q4_k_m" | "q8_0" | "q6_k") = "q4_k_m",
    temperature: number = 0.7,
    cloud_fallback: boolean = true
  },
  events: {
    attached: "local_inference_attached",
    detached: "local_inference_detached",
    on_loaded: "local_inference_loaded",
    on_complete: "local_inference_complete",
    on_error: "local_inference_error",
    on_fallback: "local_inference_fallback",
    infer: "local_inference_trigger"
  },
  behaviors: ["@llm_agent", "@inference"]
}
