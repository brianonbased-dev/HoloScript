@trait {
  name: "@local_llm",
  category: "cognitive",
  description: "Local LLM session wrapper. Maintains a persistent llama.cpp session with system prompt, history compression, and tool-call parsing so agents can use a local model with the same interface as the cloud LLM provider. Authored from LocalLLMTrait.ts.",
  props: {
    model_id: string = "",
    system_prompt: string = "",
    max_tokens: number = 512,
    history_turns: number = 20,
    tool_call_format: enum("json" | "xml" | "holoscript") = "json",
    stream: boolean = false,
    stop_sequences: list<string> = []
  },
  events: {
    attached: "local_llm_attached",
    detached: "local_llm_detached",
    on_response: "local_llm_response",
    on_tool_call: "local_llm_tool_call",
    on_error: "local_llm_error",
    chat: "local_llm_chat",
    clear_history: "local_llm_clear"
  },
  behaviors: ["@local_inference", "@llm_agent"]
}
