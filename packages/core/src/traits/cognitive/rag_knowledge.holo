@trait {
  name: "@rag_knowledge",
  category: "cognitive",
  description: "Retrieval-augmented generation knowledge base. Indexes documents, embeddings, and world state; retrieves context passages for LLM inference. Authored from RAGKnowledgeTrait.ts.",
  props: {
    vector_store: enum("pinecone" | "weaviate" | "qdrant" | "pgvector" | "holoscript") = "holoscript",
    embed_model: string = "text-embedding-3-small",
    chunk_size: number = 512,
    chunk_overlap: number = 64,
    top_k: number = 5,
    namespace: string = "",
    rerank: boolean = false,
    hybrid_search: boolean = false
  },
  events: {
    attached: "rag_knowledge_attached",
    detached: "rag_knowledge_detached",
    on_indexed: "rag_knowledge_indexed",
    on_retrieved: "rag_knowledge_retrieved",
    on_error: "rag_knowledge_error",
    index: "rag_knowledge_index",
    retrieve: "rag_knowledge_retrieve",
    clear: "rag_knowledge_clear"
  },
  behaviors: ["@knowledge_graph", "@agent_memory", "@llm_agent"]
}
