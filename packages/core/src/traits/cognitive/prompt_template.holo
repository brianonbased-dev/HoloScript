@trait {
  name: "@prompt_template",
  category: "cognitive",
  description: "Parameterized prompt template for LLM agents. Stores a Jinja-style or f-string template with named slots, renders it with runtime prop values, and pipes the result to the configured LLM provider. Authored from PromptTemplateTrait.ts.",
  props: {
    template: string = "",
    system_template: string = "",
    input_vars: list<string> = [],
    output_format: enum("text" | "json" | "markdown" | "holoscript") = "text",
    max_tokens: number = 512,
    temperature: number = 0.7,
    model: string = ""
  },
  events: {
    attached: "prompt_template_attached",
    detached: "prompt_template_detached",
    on_render: "prompt_template_render",
    on_response: "prompt_template_response",
    on_error: "prompt_template_error",
    render: "prompt_template_trigger_render"
  },
  behaviors: ["@llm_agent", "@local_llm"]
}
