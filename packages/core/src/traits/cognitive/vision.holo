@trait {
  name: "@vision",
  category: "cognitive",
  description: "Computer vision pipeline with pluggable model dispatch for object detection, semantic segmentation, image classification, and visual embedding. model selects the inference backbone: yolo runs a YOLO-family detector (fast, bbox-primary), grounding_dino combines an open-vocabulary text query with a vision transformer for zero-shot detection, sam2 runs Segment Anything Model 2 for prompt-driven mask generation, clip runs OpenAI CLIP for image-text similarity and embedding extraction, holoscript dispatches through the HoloScript MCP vision adapter registry. task scopes the pipeline output: detect emits bounding boxes + labels, segment emits per-object masks, classify returns a ranked label list, embed returns a latent vector for downstream similarity search or retrieval. confidence_threshold discards predictions below this score (0–1). labels is an allowlist of class names to retain; empty list = all classes. interval_ms controls the periodic inference cadence when running continuously (0 = event-driven only). gpu_infer routes inference to the GPU backend when available; false = CPU fallback. on_detect fires per frame when detections exceed threshold; on_segment fires with mask output; on_embed fires with the embedding vector. Research: VisionTrait.ts v1.0 scan + detection loop.",
  props: {
    model: enum("yolo" | "grounding_dino" | "sam2" | "clip" | "holoscript") = "holoscript",
    task: enum("detect" | "segment" | "classify" | "embed") = "detect",
    confidence_threshold: number = 0.5,
    labels: list<string> = [],
    interval_ms: number = 0,
    gpu_infer: boolean = true
  },
  events: {
    attached: "vision:attached",
    detached: "vision:detached",
    ready: "vision:ready",
    detect: "vision:detect",
    segment: "vision:segment",
    classify: "vision:classify",
    embed: "vision:embed",
    scan_complete: "vision:scan_complete",
    error: "vision:error",
    on_scan: "vision:cmd_scan",
    on_set_labels: "vision:cmd_set_labels",
    on_set_model: "vision:cmd_set_model",
    on_set_task: "vision:cmd_set_task"
  },
  behaviors: ["@inference", "@onnx_runtime"]
}
