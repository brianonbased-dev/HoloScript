@trait {
  name: "@gaussian_splat",
  category: "render",
  description: "3D Gaussian splatting renderer (core trait). Renders a Gaussian splat scene from a PLY/codec file. src is the splat source URL. scale is the scene scale multiplier (default: 1.0). Port of GaussianSplatTrait.ts (handler name: gaussian_splat).",
  props: {
    src: string = "",
    scale: number = 1.0
  },
  events: {
    on_loaded: "gaussian_splat:loaded",
    on_error: "gaussian_splat:error",
    load: "gaussian_splat.load"
  },
  behaviors: ["@photogrammetry", "@point_cloud"]
}
