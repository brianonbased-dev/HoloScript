@trait {
  name: "@compute",
  category: "compute",
  description: "Core compute primitive — WebGPU compute dispatch with configurable workgroup layout. workgroup_size is the [x,y,z] thread count per workgroup (default: [64,1,1]). dispatch is the [x,y,z] workgroup grid (default: [1,1,1]). shader_source is the WGSL shader code. bindings is the named buffer/texture map. auto_dispatch triggers a dispatch on every update tick (default: false). Port of ComputeTrait.ts (handler name: compute).",
  props: {
    shader_source: string = "",
    auto_dispatch: boolean = false
  },
  events: {
    on_dispatched: "compute:dispatched",
    on_complete: "compute:complete",
    dispatch: "compute.dispatch"
  },
  behaviors: ["@compute_shader", "@gpu_particle"]
}
