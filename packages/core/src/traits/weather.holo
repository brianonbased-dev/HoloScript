@trait {
  name: "@weather",
  category: "world",
  description: "Dynamic weather and day/night cycle. day_length_seconds is the in-world day duration (default: 1200s). start_time is the initial time of day in 24h (default: 12 = noon). latitude affects sun angle (default: 45°). initial_weather: clear (default), rain, fog, storm, snow. Port of WeatherHubTrait.ts (handler name: weather).",
  props: {
    day_length_seconds: number = 1200,
    start_time: number = 12,
    latitude: number = 45,
    initial_weather: enum("clear" | "rain" | "fog" | "storm" | "snow") = "clear"
  },
  events: {
    on_weather_changed: "weather:weather_changed",
    on_time_changed: "weather:time_changed",
    set_weather: "weather.set_weather"
  },
  behaviors: ["@volumetric_clouds", "@environmental_audio", "@global_illumination"]
}
