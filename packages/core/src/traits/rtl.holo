@trait {
  name: "@rtl",
  category: "i18n",
  description: "Right-to-left text direction. rtl_locales is the list of BCP-47 locale codes treated as RTL (default: [ar, he, fa, ur]). Port of RtlTrait.ts (handler name: rtl).",
  props: {
    rtl_locales: array = ["ar", "he", "fa", "ur"]
  },
  events: {
    on_direction_changed: "rtl:direction_changed"
  },
  behaviors: ["@translation", "@accessible", "@subtitle"]
}
