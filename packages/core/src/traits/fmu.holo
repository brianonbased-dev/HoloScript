@trait {
  name: "@fmu",
  category: "simulation",
  description: "FMI (Functional Mockup Interface) co-simulation trait. source is the path or URI to the .fmu file. modelIdentifier is the FMU model identifier (default: holoscript_fmu). fmiVersion is the FMI specification version (default: 3.0). mode: co-simulation (time-stepping black box) or model-exchange (solver exposed). inputs is a list of FMU input variable bindings {name, unit, source}. outputs is a list of FMU output variable bindings {name, unit, target}. parameters is a list of FMU parameter overrides {name, value}. stepSize is the co-simulation step size in seconds (default: 0.01s = 100 Hz). Port of FMUTrait.ts (handler name: fmu).",
  props: {
    source: string = "",
    model_identifier: string = "holoscript_fmu",
    fmi_version: string = "3.0",
    mode: enum("co-simulation" | "model-exchange") = "co-simulation",
    step_size: number = 0.01
  },
  events: {
    on_initialized: "fmu_initialized",
    on_step: "fmu_step",
    on_terminated: "fmu_terminated",
    on_error: "fmu_error",
    initialize: "fmu_initialize",
    step: "fmu_step_cmd",
    terminate: "fmu_terminate"
  },
  behaviors: ["@control_loop", "@sensor_sampling"]
}
