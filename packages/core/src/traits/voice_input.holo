@trait {
  name: "@voice_input",
  category: "audio",
  description: "Speech-to-text voice input. Config is device-dependent and set at class construction. Port of VoiceInputTrait.ts (handler name: voice_input).",
  props: {},
  events: {
    on_transcript: "voice_input:transcript",
    on_started: "voice_input:started",
    on_stopped: "voice_input:stopped",
    start: "voice_input.start",
    stop: "voice_input.stop"
  },
  behaviors: ["@spatial_voice", "@voice_output", "@npc_ai"]
}
