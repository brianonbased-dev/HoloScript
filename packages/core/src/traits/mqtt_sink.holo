@trait {
  name: "@mqtt_sink",
  category: "iot",
  description: "MQTT sink — publishes scene node state to an MQTT broker. broker is the MQTT broker URL (default: mqtt://localhost:1883). topic is the publish topic (default: holoscript/{nodeId}/state). retain sets the MQTT retain flag (default: false). qos is the quality of service level [0,1,2] (default: 0). Port of MQTTSinkTrait.ts (handler name: mqtt_sink). broker URL is an edge-local default, override for remote brokers.",
  props: {
    broker: string = "mqtt://localhost:1883",
    topic: string = "holoscript/{nodeId}/state",
    retain: boolean = false,
    qos: number = 0
  },
  events: {
    on_published: "mqtt_sink:published",
    on_error: "mqtt_sink:error",
    publish: "mqtt_sink.publish"
  },
  behaviors: ["@digital_twin", "@mqtt_source"]
}
