@trait {
  name: "@jetson_gpu",
  category: "hardware",
  description: "Jetson Orin GPU configuration — sets SoC power mode and enables hardware acceleration for local inference. soc: orin-nano (default), orin-nx, agx-orin, xavier-nx, nano. power_mode: MAXN_SUPER (default — all cores + GPU at max). nvpmodel_index is the NVPModel index to set (default: 0 = MAXN). jetson_clocks enables maximum frequency locking (default: true). jetpack_version is the installed JetPack version. cuda_compute_capability is the GPU compute capability (default: 8.7). Port of JetsonGPUTrait.ts.",
  props: {
    soc: enum("orin-nano" | "orin-nx" | "agx-orin" | "xavier-nx" | "nano") = "orin-nano",
    power_mode: string = "MAXN_SUPER",
    nvpmodel_index: number = 0,
    jetson_clocks: boolean = true,
    jetpack_version: string = "6.2.1",
    cuda_compute_capability: string = "8.7"
  },
  events: {
    on_configured: "jetson_gpu:configured",
    on_error: "jetson_gpu:error"
  },
  behaviors: ["@local_llm", "@compute_shader", "@gpu_particle"]
}
