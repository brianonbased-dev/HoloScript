@trait {
  name: "@orbital",
  category: "simulation",
  description: "Orbital mechanics simulation — computes Keplerian orbits and N-body interactions. Config is orbit-parameter-dependent. Port of OrbitalTrait.ts (handler name: orbital).",
  props: {},
  events: {
    on_updated: "orbital:updated",
    on_periapsis: "orbital:periapsis",
    tick: "orbital.tick"
  },
  behaviors: ["@physics", "@emergent_spacetime"]
}
