@trait {
  name: "@gltf",
  category: "interop",
  description: "glTF 2.0 asset loader and exporter. Imports geometry, PBR materials, animations, and skins from .glb/.gltf files and round-trips HoloScript entities back to glTF for external tooling. Authored from GLTFTrait.ts.",
  props: {
    src_url: string = "",
    draco_compression: boolean = false,
    cast_shadow: boolean = true,
    receive_shadow: boolean = true,
    auto_scale: boolean = false,
    target_scale: number = 1.0,
    animation_autoplay: boolean = false,
    morph_targets: boolean = true
  },
  events: {
    attached: "gltf_attached",
    detached: "gltf_detached",
    on_load: "gltf_load",
    on_error: "gltf_error",
    on_export: "gltf_export",
    play_animation: "gltf_play_animation",
    export: "gltf_trigger_export"
  },
  behaviors: ["@rendering", "@skeleton", "@anim"]
}
