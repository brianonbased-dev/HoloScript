@trait {
  name: "@fbx",
  category: "interop",
  description: "FBX asset importer. Converts Autodesk FBX meshes, rigs, and take-based animations to HoloScript-native skeleton and geometry representations via a server-side pipeline. Authored from FBXTrait.ts.",
  props: {
    src_url: string = "",
    convert_to_gltf: boolean = true,
    extract_animations: boolean = true,
    extract_skeleton: boolean = true,
    scale_factor: number = 1.0,
    unit: enum("cm" | "m" | "inch" | "foot") = "cm",
    blend_shape: boolean = true
  },
  events: {
    attached: "fbx_attached",
    detached: "fbx_detached",
    on_convert: "fbx_convert",
    on_complete: "fbx_complete",
    on_error: "fbx_error",
    convert: "fbx_trigger_convert"
  },
  behaviors: ["@gltf", "@skeleton", "@anim"]
}
