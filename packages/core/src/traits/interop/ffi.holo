@trait {
  name: "@ffi",
  category: "interop",
  description: "Foreign Function Interface bridge. Calls into compiled native libraries (Rust WASM, C/C++ via Emscripten, ONNX runtimes) from HoloScript trait handlers without leaving the WASM sandbox. Authored from FfiTrait.ts.",
  props: {
    library_url: string = "",
    language: enum("rust_wasm" | "cpp_emscripten" | "onnx" | "python_pyodide") = "rust_wasm",
    exports: list<string> = [],
    memory_pages: number = 256,
    shared_memory: boolean = false,
    timeout_ms: number = 5000
  },
  events: {
    attached: "ffi_attached",
    detached: "ffi_detached",
    on_loaded: "ffi_loaded",
    on_call: "ffi_call",
    on_error: "ffi_error",
    call: "ffi_trigger_call"
  },
  behaviors: ["@wasm", "@sandbox"]
}
