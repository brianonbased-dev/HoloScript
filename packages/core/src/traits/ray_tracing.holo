@trait {
  name: "@ray_tracing",
  category: "rendering",
  description: "Hardware ray tracing renderer. Config is device- and pipeline-dependent and set at instance construction. Port of RayTracingTrait.ts (handler name: ray_tracing).",
  props: {},
  events: {
    on_frame: "ray_tracing:frame",
    on_converged: "ray_tracing:converged"
  },
  behaviors: ["@ray_trace", "@global_illumination", "@post_process"]
}
