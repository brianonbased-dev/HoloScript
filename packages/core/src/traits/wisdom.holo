@trait {
  name: "@wisdom",
  category: "knowledge",
  description: "Wisdom entry — a durable cross-session insight. description is the insight body. source: community (default), founder, agent, research. applies_to is the list of contexts this wisdom applies in (default: []). examples are concrete usage examples (default: []). Port of WisdomTrait.ts (handler name: wisdom).",
  props: {
    description: string = "",
    source: enum("community" | "founder" | "agent" | "research") = "community",
    applies_to: array = [],
    examples: array = []
  },
  events: {
    on_stored: "wisdom:stored",
    on_recalled: "wisdom:recalled"
  },
  behaviors: ["@knowledge_graph", "@rag_knowledge", "@memory_crystal"]
}
