@trait {
  name: "@vector_db",
  category: "ml",
  description: "Vector database backend. embedding_model is the sentence encoder model (default: sentence-transformers). dimension is the embedding vector size (default: 384). similarity_metric: cosine (default), dot, euclidean. max_entries is the database capacity (default: 10,000). Port of VectorDBTrait.ts (handler name: vector_db).",
  props: {
    embedding_model: string = "sentence-transformers",
    dimension: number = 384,
    similarity_metric: enum("cosine" | "dot" | "euclidean") = "cosine",
    max_entries: number = 10000
  },
  events: {
    on_inserted: "vector_db:inserted",
    on_queried: "vector_db:queried",
    insert: "vector_db.insert",
    query: "vector_db.query"
  },
  behaviors: ["@rag_knowledge", "@memory_crystal", "@vector_search"]
}
