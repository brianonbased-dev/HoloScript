@trait {
  name: "@trait_marketplace",
  category: "marketplace",
  description: "HoloMesh trait marketplace — lists and sells trait compositions on-chain. platform_fee_percent is the taker fee (default: 5%). platform_did is the platform DID for fee routing. max_listings_per_agent is the per-agent listing cap (default: 50). max_price is the maximum listing price in tokens (default: 10,000). min_seller_reputation is the minimum seller score to list (default: 0). Port of HolomeshMarketplaceTrait.ts (handler name: trait_marketplace).",
  props: {
    platform_fee_percent: number = 5,
    platform_did: string = "did:pkh:eip155:84532:0xHoloScriptPlatform",
    max_listings_per_agent: number = 50,
    max_price: number = 10000,
    min_seller_reputation: number = 0
  },
  events: {
    on_listed: "trait_marketplace:listed",
    on_sold: "trait_marketplace:sold",
    on_delisted: "trait_marketplace:delisted",
    list: "trait_marketplace.list",
    buy: "trait_marketplace.buy",
    delist: "trait_marketplace.delist"
  },
  behaviors: ["@economy", "@token_gated", "@audit_log"]
}
