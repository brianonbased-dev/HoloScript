@trait {
  name: "@hand_mesh_ai",
  category: "xr",
  description: "XR hand tracking with AI-generated mesh overlay. Extends the base hand tracking trait with real-time mesh generation. hand_model: mediapipe_hands (default) or custom. joint_count is the tracked joint count (default: 21 — MediaPipe hand skeleton). bimanual_tracking enables simultaneous two-hand tracking (default: false). mesh_resolution: low, medium (default), or high. texture_enabled overlays a skin texture on the mesh (default: false). vertex_count is the mesh vertex budget (default: 256). real_time_generation rebuilds the mesh every frame (default: true). gesture_detection enables gesture classifier inference (default: false). inference_fps is the inference rate in Hz (default: 30). temporal_smoothing is the exponential smoothing factor 0-1 (default: 0.3). Port of HandMeshAITrait.ts (handler name: hand_mesh_ai).",
  props: {
    hand_model: enum("mediapipe_hands" | "custom") = "mediapipe_hands",
    joint_count: number = 21,
    bimanual_tracking: boolean = false,
    mesh_resolution: enum("low" | "medium" | "high") = "medium",
    texture_enabled: boolean = false,
    vertex_count: number = 256,
    real_time_generation: boolean = true,
    gesture_detection: boolean = false,
    inference_fps: number = 30,
    temporal_smoothing: number = 0.3
  },
  events: {
    on_hand_detected: "hand_mesh_detected",
    on_hand_lost: "hand_mesh_lost",
    on_gesture: "hand_mesh_gesture",
    on_mesh_updated: "hand_mesh_updated"
  },
  behaviors: ["@grab_feedback_profile", "@gaze_focus_analytics"]
}
