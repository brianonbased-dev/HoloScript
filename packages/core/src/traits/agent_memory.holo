@trait {
  name: "@agent_memory",
  category: "agent",
  description: "Persistent agent memory store — IndexedDB-backed episodic memory with optional embedding-based RAG retrieval and Postgres sync. max_memories is the maximum stored memory entries (default: 10,000). embedding_model is the embedding provider (default: none — keyword search only; options: none, text-embedding-3-small, etc). embedding_dim is the vector dimension (default: 384). auto_compress automatically summarizes old memories (default: true). sync_to_postgres enables Postgres sync for cross-device continuity (default: false). db_name is the IndexedDB database name (default: holoscript-agent-memory). Port of AgentMemoryTrait.ts (handler name: agent_memory).",
  props: {
    max_memories: number = 10000,
    embedding_model: string = "none",
    embedding_dim: number = 384,
    auto_compress: boolean = true,
    sync_to_postgres: boolean = false,
    postgres_url: string = "",
    db_name: string = "holoscript-agent-memory"
  },
  events: {
    on_stored: "agent_memory:stored",
    on_recalled: "agent_memory:recalled",
    on_compressed: "agent_memory:compressed",
    store: "agent_memory.store",
    recall: "agent_memory.recall",
    forget: "agent_memory.forget"
  },
  behaviors: ["@provenance", "@llm_agent"]
}
