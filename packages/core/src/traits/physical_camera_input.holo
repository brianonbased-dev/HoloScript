@trait {
  name: "@physical_camera_input",
  category: "sensing",
  description: "Physical camera input driver for robot/edge camera integration. source is the V4L2 device path (default: /dev/video0). width/height set the capture resolution (default: 1920x1080). fps is the capture frame rate (default: 30). format: rgb8 (default), yuv420, nv12, or raw_bayer. depth_enabled enables depth frame capture (default: false). depth_min_m/depth_max_m define the depth range (default: 0.1-10m). frame_dir is the local directory for frame buffering (default: /tmp/holo-frames). max_frames_queued caps the in-memory frame queue to prevent OOM (default: 5). emit_perception emits perception events (default: true). Port of PhysicalCameraInputTrait.ts (handler name: physical_camera_input).",
  props: {
    source: string = "/dev/video0",
    width: number = 1920,
    height: number = 1080,
    fps: number = 30,
    format: enum("rgb8" | "yuv420" | "nv12" | "raw_bayer") = "rgb8",
    depth_enabled: boolean = false,
    depth_min_m: number = 0.1,
    depth_max_m: number = 10.0,
    frame_dir: string = "/tmp/holo-frames",
    max_frames_queued: number = 5,
    emit_perception: boolean = true
  },
  events: {
    on_frame: "physical_camera_frame",
    on_depth_frame: "physical_camera_depth_frame",
    on_connected: "physical_camera_connected",
    on_disconnected: "physical_camera_disconnected",
    start: "physical_camera_start",
    stop: "physical_camera_stop"
  },
  behaviors: ["@ros2_hardware_loop", "@sensor_sampling"]
}
