@trait {
  name: "@gesture_recognition",
  category: "xr",
  description: "Hand and body gesture classifier. Recognizes discrete gestures (pinch, grab, swipe, wave) and continuous pose streams from tracking input. Authored from GestureRecognitionTrait.ts.",
  props: {
    gestures: list<string> = [],
    provider: enum("mediapipe" | "htc" | "meta" | "holoscript") = "holoscript",
    confidence_min: number = 0.7,
    hands: enum("left" | "right" | "both") = "both",
    require_confirm_frames: number = 3,
    cooldown_ms: number = 300
  },
  events: {
    attached: "gesture_attached",
    detached: "gesture_detached",
    on_gesture: "gesture_recognized",
    on_candidate: "gesture_candidate",
    on_lost: "gesture_lost",
    on_pose_update: "gesture_pose_update",
    register_gesture: "gesture_register"
  },
  behaviors: ["@hand_tracking"]
}
