@trait {
  name: "@object_tracking",
  category: "xr",
  description: "Multi-mode real-world object tracking for AR/XR sessions. tracking_mode selects the detection algorithm: color tracks objects by hue/saturation signature; aruco detects printed ArUco marker IDs; neural runs a lightweight classification model to track an object class by name; depth uses structured-light or ToF depth maps for silhouette tracking. target_class names the object class for neural mode (e.g. 'cup', 'hand', 'face'). confidence_min is the minimum per-detection confidence score [0,1] below which detections are discarded. smooth_factor is the low-pass weight applied to incoming pose deltas (0 = no smoothing, 1 = frozen). max_targets caps the number of simultaneously tracked instances. Send object_tracking:acquire {targetId} to begin tracking a specific target; tracking:pose events feed updated poses. Research: ObjectTrackingTrait.ts, MultiTargetTrackingTrait.ts, KalmanFilterTrait.ts.",
  props: {
    tracking_mode: enum("color" | "aruco" | "neural" | "depth") = "neural",
    target_class: string = "object",
    confidence_min: number = 0.6,
    smooth_factor: number = 0.2,
    max_targets: number = 4,
    auto_recover: boolean = true,
    visualization: boolean = false
  },
  events: {
    attached: "object_tracking:attached",
    detached: "object_tracking:detached",
    detected: "tracking:detected",
    lost: "tracking:lost",
    updated: "tracking:updated",
    recovery_attempt: "tracking:recovery_attempt",
    anchor_removed: "tracking:anchor_removed",
    on_acquire: "tracking:acquire",
    on_release: "tracking:release",
    on_set_mode: "object_tracking:set_mode"
  },
  behaviors: ["@transform", "@spatial_anchor"]
}
