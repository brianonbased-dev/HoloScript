@trait {
  name: "@spatial_panel",
  category: "xr",
  description: "World-locked XR UI panel for menus, HUDs, and floating content. Positions in 3D space with follow modes, fade-on-approach, and depth sort. Authored from SpatialPanelTrait.ts.",
  props: {
    width_m: number = 0.5,
    height_m: number = 0.4,
    follow_mode: enum("none" | "gaze_lazy" | "body_locked" | "hand_locked") = "none",
    depth_m: number = 0.8,
    opacity: number = 1.0,
    billboard: boolean = false,
    fade_on_approach: boolean = true,
    curved: boolean = false,
    curve_radius_m: number = 1.0
  },
  events: {
    attached: "spatial_panel_attached",
    detached: "spatial_panel_detached",
    on_show: "spatial_panel_show",
    on_hide: "spatial_panel_hide",
    on_interact: "spatial_panel_interact",
    on_approach: "spatial_panel_approach",
    show: "spatial_panel_trigger_show",
    hide: "spatial_panel_trigger_hide",
    toggle: "spatial_panel_trigger_toggle"
  },
  behaviors: ["@xr_interaction", "@ui_theme"]
}
