@trait {
  name: "@persistent_anchor",
  category: "xr",
  description: "Persistent XR spatial anchor with cross-session recall. Stores anchor pose in cloud or on-device persistent anchor storage, recalls it on the next session, and applies drift correction from relocated planes. Authored from PersistentAnchorTrait.ts.",
  props: {
    anchor_id: string = "",
    backend: enum("webxr" | "arcore" | "arkit" | "holoscript") = "holoscript",
    persist_cloud: boolean = true,
    drift_correction: boolean = true,
    expiry_days: number = 180,
    quality_threshold: number = 0.75
  },
  events: {
    attached: "persistent_anchor_attached",
    detached: "persistent_anchor_detached",
    on_created: "persistent_anchor_created",
    on_recalled: "persistent_anchor_recalled",
    on_lost: "persistent_anchor_lost",
    on_drift: "persistent_anchor_drift",
    create: "persistent_anchor_create",
    recall: "persistent_anchor_recall"
  },
  behaviors: ["@xr_anchor", "@spatial_anchor", "@rooftop_anchor"]
}
