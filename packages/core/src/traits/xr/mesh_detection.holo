@trait {
  name: "@mesh_detection",
  category: "xr",
  description: "Real-time environment mesh reconstruction for spatial understanding in AR/XR. detect_mode selects what the spatial sensor surfaces: plane detects flat planar surfaces only (fastest); mesh reconstructs arbitrary triangulated environment geometry; image triggers on tracked image targets and yields a plane at the marker pose. max_meshes caps the number of simultaneously tracked meshes to bound GPU memory — excess meshes are dropped by priority. plane_axes filters plane candidates: horizontal matches floors and tables; vertical matches walls and doors; any accepts all orientations. update_rate_hz controls how many times per second the mesh is re-evaluated from sensor data (higher = more responsive, higher CPU cost). semantic_labels annotates mesh blocks with scene-understanding labels (floor, wall, ceiling, table, chair, door, window) when the platform supports it; attach cost is platform-dependent. Research: MeshDetectionTrait.ts MeshDetectionConfig / PlaneDetectionTrait.ts / SpatialAwarenessTrait.ts.",
  props: {
    detect_mode: enum("plane" | "mesh" | "image") = "plane",
    max_meshes: number = 64,
    plane_axes: enum("horizontal" | "vertical" | "any") = "any",
    update_rate_hz: number = 10,
    semantic_labels: boolean = false
  },
  events: {
    attached: "mesh_detection:attached",
    detached: "mesh_detection:detached",
    mesh_added: "mesh_detection:mesh_added",
    mesh_updated: "mesh_detection:mesh_updated",
    mesh_removed: "mesh_detection:mesh_removed",
    plane_added: "mesh_detection:plane_added",
    plane_updated: "mesh_detection:plane_updated",
    plane_removed: "mesh_detection:plane_removed",
    scan_progress: "mesh_detection:scan_progress",
    on_pause: "mesh_detection:pause",
    on_resume: "mesh_detection:resume",
    on_set_mode: "mesh_detection:set_mode"
  },
  behaviors: ["@xr_session"]
}
