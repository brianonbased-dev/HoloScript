@trait {
  name: "@passthrough_camera",
  category: "xr",
  description: "Mixed reality passthrough camera compositor. Blends the device's live camera feed with the rendered scene at configurable opacity and applies environmental lighting estimation from the video stream. Authored from PassthroughCameraTrait.ts.",
  props: {
    opacity: number = 1.0,
    mode: enum("full" | "layer" | "portal" | "depth_mask") = "full",
    color_correct: boolean = true,
    edge_smoothing: boolean = true,
    dynamic_lighting: boolean = true,
    layer_order: number = -1
  },
  events: {
    attached: "passthrough_camera_attached",
    detached: "passthrough_camera_detached",
    on_enable: "passthrough_camera_enable",
    on_disable: "passthrough_camera_disable",
    on_frame: "passthrough_camera_frame",
    enable: "passthrough_camera_trigger_enable",
    disable: "passthrough_camera_trigger_disable"
  },
  behaviors: ["@light_estimation", "@depth_estimation", "@surface_detection"]
}
