@trait {
  name: "@room_mesh",
  category: "xr",
  description: "Room-scale mesh from the XR scene understanding API. Captures the full volumetric mesh of the physical environment (walls, floor, ceiling, furniture) for occlusion, physics colliders, and spatial audio geometry. Authored from RoomMeshTrait.ts.",
  props: {
    quality: enum("low" | "medium" | "high") = "medium",
    update_rate_hz: number = 2,
    max_triangles: number = 500000,
    shadow_caster: boolean = false,
    physics_collider: boolean = true,
    audio_occluder: boolean = true,
    visible: boolean = false
  },
  events: {
    attached: "room_mesh_attached",
    detached: "room_mesh_detached",
    on_update: "room_mesh_update",
    on_complete: "room_mesh_complete",
    on_error: "room_mesh_error"
  },
  behaviors: ["@mesh_collider", "@audio_occlusion", "@plane_detection"]
}
