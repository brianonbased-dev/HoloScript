@trait {
  name: "@spatial_persona",
  category: "xr",
  description: "XR spatial persona — the shareable public face of a user in shared XR space. Stores avatar, name card, presence ring, and interaction affordances for co-presence sessions. Authored from SpatialPersonaTrait.ts.",
  props: {
    avatar_url: string = "",
    display_name: string = "",
    tag_color: string = "#6366f1",
    name_plate_visible: boolean = true,
    presence_ring: boolean = true,
    interaction_radius_m: number = 2.0,
    share_gaze: boolean = false
  },
  events: {
    attached: "spatial_persona_attached",
    detached: "spatial_persona_detached",
    on_enter_view: "spatial_persona_enter_view",
    on_exit_view: "spatial_persona_exit_view",
    on_proximity: "spatial_persona_proximity",
    on_interact: "spatial_persona_interact",
    wave: "spatial_persona_wave"
  },
  behaviors: ["@presence", "@avatar_embodiment", "@xr_interaction"]
}
