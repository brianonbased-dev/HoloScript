@trait {
  name: "@seated",
  category: "xr",
  description: "Seated VR comfort mode for XR entities and environments. comfort_mode declares the expected physical posture of the user: standing locks ergonomic bounds to upright interaction heights, seated adjusts reach and viewpoint offsets for a chair-level origin, supine targets lying-flat viewing angles and minimal reach constraints. min_height_m and max_height_m clamp the entity's interaction anchor to a comfortable vertical band in metres above the floor calibration plane — content outside this band is repositioned to avoid neck strain. auto_recenter triggers an automatic floor and head-height recalibration whenever the user changes posture (sit-to-stand or stand-to-sit transition detected via headset Y velocity); disable for manual-only recalibration workflows. on_sit fires when a seated posture is detected. on_stand fires when the user returns to standing. on_adjust fires whenever min_height_m, max_height_m, or comfort_mode changes at runtime. Pairs with @transform for anchor placement, @haptic for posture-confirmation feedback, and @trigger for play-boundary enforcement. Research: SeatedTrait.ts v1.0.0 calibrated height + snap turn.",
  props: {
    comfort_mode: enum("standing" | "seated" | "supine") = "seated",
    min_height_m: number = 0.5,
    max_height_m: number = 1.8,
    auto_recenter: boolean = true
  },
  events: {
    attached: "seated:attached",
    detached: "seated:detached",
    calibrated: "seated:calibrated",
    on_sit: "seated:sit",
    on_stand: "seated:stand",
    on_adjust: "seated:adjust",
    on_recenter: "seated:recenter",
    on_set_comfort_mode: "seated:set_comfort_mode",
    on_set_height_range: "seated:set_height_range"
  },
  behaviors: ["@transform"]
}
