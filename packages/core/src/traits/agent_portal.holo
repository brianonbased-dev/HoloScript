@trait {
  name: "@agent_portal",
  category: "agent",
  description: "Agent-to-agent WebSocket portal for cross-scene communication. scene_id/scene_name identify the scene context. agent_id is the local agent. relay_url is the portal relay endpoint (default: ws://localhost:4200/portal). auto_reconnect enables automatic reconnection (default: true). reconnect_delay is the ms between reconnect attempts (default: 3000). max_reconnect_attempts is the reconnect cap (default: 10). heartbeat_interval is the keepalive cadence in ms (default: 30000). offline_threshold is the missed heartbeats before offline (default: 3). max_hop_count limits message relay hops (default: 5). Port of AgentPortalTrait.ts (handler name: agent_portal).",
  props: {
    scene_id: string = "",
    scene_name: string = "Untitled Scene",
    agent_id: string = "",
    relay_url: string = "ws://localhost:4200/portal",
    auto_reconnect: boolean = true,
    reconnect_delay: number = 3000,
    max_reconnect_attempts: number = 10,
    heartbeat_interval: number = 30000,
    offline_threshold: number = 3,
    max_hop_count: number = 5
  },
  events: {
    on_connected: "agent_portal:connected",
    on_disconnected: "agent_portal:disconnected",
    on_message: "agent_portal:message",
    send: "agent_portal.send",
    connect: "agent_portal.connect",
    disconnect: "agent_portal.disconnect"
  },
  behaviors: ["@agent_discovery", "@world_portal"]
}
