@trait {
  name: "@reputation_ledger",
  category: "economics",
  description: "On-chain or off-chain reputation score ledger. Tracks agent/user ratings, endorsements, violations, and calculates composite trust score. Authored from ReputationLedgerTrait.ts.",
  props: {
    backend: enum("holoscript" | "base" | "ceramic" | "memory") = "holoscript",
    initial_score: number = 100.0,
    min_score: number = 0.0,
    max_score: number = 1000.0,
    decay_per_day: number = 0.0,
    endorsement_weight: number = 1.0,
    violation_weight: number = 5.0,
    public: boolean = true
  },
  events: {
    attached: "reputation_ledger_attached",
    detached: "reputation_ledger_detached",
    on_endorse: "reputation_ledger_endorse",
    on_violate: "reputation_ledger_violate",
    on_score_change: "reputation_ledger_score_change",
    on_threshold: "reputation_ledger_threshold",
    endorse: "reputation_ledger_trigger_endorse",
    report: "reputation_ledger_trigger_report"
  },
  behaviors: ["@identity_provider", "@audit_log"]
}
