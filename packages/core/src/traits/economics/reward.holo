@trait {
  name: "@reward",
  category: "economics",
  description: "Agent reward signal tracker. Accumulates scalar reward events from goal completions, user ratings, and environmental triggers into an episodic return for reinforcement learning pipelines. Authored from RewardTrait.ts.",
  props: {
    discount_factor: number = 0.99,
    accumulate: boolean = true,
    episode_length: number = 1000,
    clip_range: number = 1.0,
    normalize: boolean = true,
    export_on_episode_end: boolean = true,
    export_path: string = ""
  },
  events: {
    attached: "reward_attached",
    detached: "reward_detached",
    on_reward: "reward_signal",
    on_episode_end: "reward_episode_end",
    on_export: "reward_export",
    add_reward: "reward_add",
    reset_episode: "reward_reset"
  },
  behaviors: ["@feedback_loop", "@analytics"]
}
