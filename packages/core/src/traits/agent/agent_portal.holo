@trait {
  name: "@agent_portal",
  category: "agent",
  description: "Cross-scene agent communication via WebSocket relay server. Extends in-scene MultiAgent messaging to federated multi-scene networks. Supports unicast and broadcast messaging, federated agent discovery, agent migration with state serialization, heartbeat-based scene presence, and hop-count TTL to prevent message loops.",
  props: {
    scene_id: string = "",
    scene_name: string = "Untitled Scene",
    agent_id: string = "",
    capabilities: string[] = [],
    relay_url: string = "ws://localhost:4200/portal",
    auth_token: string = "",
    auto_reconnect: boolean = true,
    reconnect_delay: number = 3000,
    max_reconnect_attempts: number = 10,
    heartbeat_interval: number = 30000,
    offline_threshold: number = 3,
    max_hop_count: number = 5,
    default_ttl: number = 60000,
    max_outbox_size: number = 200
  },
  events: {
    init: "portal:init",
    connected: "portal:connected",
    disconnected: "portal:disconnected",
    disconnecting: "portal:disconnecting",
    reconnecting: "portal:reconnecting",
    heartbeat: "portal:heartbeat",
    message_in: "portal:message_in",
    message_out: "portal:message_out",
    relay_send: "portal:relay_send",
    scene_discovered: "portal:scene_discovered",
    scene_lost: "portal:scene_lost",
    agent_migrated: "portal:agent_migrated",
    agent_arrived: "portal:agent_arrived",
    federation_query: "portal:federation_query",
    stats: "portal:stats",
    on_ws_connected: "portal:ws_connected",
    on_ws_disconnected: "portal:ws_disconnected",
    on_send: "portal:send",
    on_broadcast: "portal:broadcast",
    on_relay_message: "portal:relay_message",
    on_scene_announce: "portal:scene_announce",
    on_query_agents: "portal:query_agents",
    on_remote_agents: "portal:remote_agents",
    on_migrate_out: "portal:migrate_out",
    on_migrate_in: "portal:migrate_in",
    on_get_stats: "portal:get_stats"
  }
}
