@trait {
  name: "@care_ethics",
  category: "agent",
  description: "Care ethics alignment layer for agent decision-making. Weights choices by relational impact, vulnerability of affected parties, and contextual harm prevention. Authored from CareEthicsTrait.ts.",
  props: {
    vulnerability_weight: number = 2.0,
    harm_threshold: number = 0.3,
    relational_context: boolean = true,
    override_on_harm: boolean = true,
    log_decisions: boolean = true,
    consult_human_above: number = 0.8
  },
  events: {
    attached: "care_ethics_attached",
    detached: "care_ethics_detached",
    on_decision: "care_ethics_decision",
    on_override: "care_ethics_override",
    on_consult: "care_ethics_consult",
    evaluate: "care_ethics_evaluate"
  },
  behaviors: ["@llm_agent", "@autonomous_agenda"]
}
