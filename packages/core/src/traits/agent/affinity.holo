@trait {
  name: "@affinity",
  category: "agent",
  description: "Relational dynamics simulation for agent dyads. Wires a scene-graph node to the AffinityODESolver (Strogatz-Rinaldi coupled ODEs). Supports optional Sternberg triangular state [Intimacy, Passion, Commitment] and Nash-equilibrium effort control. Used by Brittney authority locus and ConversationDaemon for affective-state tracking per dyad.",
  props: {
    agent_ids: string[] = ["agent_R", "agent_J"],
    archetypes: string[] = ["eager_beaver", "cautious_lover"],
    initial_feelings: number[] = [0.5, 0.5],
    enable_sternberg: boolean = false,
    enable_nash_effort: boolean = false,
    time_step: number = 0.1,
    max_time: number = 0
  },
  events: {
    create: "affinity_create",
    destroy: "affinity_destroy"
  },
  behaviors: ["@agent_discovery"]
}
