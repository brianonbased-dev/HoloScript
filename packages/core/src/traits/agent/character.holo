@trait {
  name: "@character",
  category: "agent",
  description: "Character entity composition root. Bundles skeleton, locomotion, brain, voice, and memory into a single high-level character archetype. Authored from CharacterTrait.ts.",
  props: {
    archetype: enum("humanoid" | "creature" | "robot" | "npc" | "player" | "custom") = "humanoid",
    name: string = "",
    faction: string = "",
    level: number = 1,
    interactive: boolean = true,
    persistent: boolean = true,
    brain_skill: string = ""
  },
  events: {
    attached: "character_attached",
    detached: "character_detached",
    on_spawn: "character_spawn",
    on_death: "character_death",
    on_level_up: "character_level_up",
    on_interact: "character_interact",
    spawn: "character_trigger_spawn",
    despawn: "character_trigger_despawn"
  },
  behaviors: ["@skeleton", "@avatar_embodiment", "@llm_agent", "@agent_memory"]
}
