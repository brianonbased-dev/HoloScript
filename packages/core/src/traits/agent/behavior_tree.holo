@trait {
  name: "@behavior_tree",
  category: "agent",
  description: "Full behavior tree execution engine for HoloScript agents. root_node names the root BTNode registered in the shared scene graph. tick_rate_hz controls how many evaluation ticks fire per second. blackboard is a runtime key/value store shared across all nodes in the tree, enabling inter-node communication without coupling. debug_mode surfaces per-node tick results as structured events; max_depth caps recursive descent to prevent runaway trees. Composes with @llm_agent and @npc_ai for cognitive action dispatch inside tree leaves. on_tick fires after each root evaluation; on_success/fail/running report the last composite result; on_reset wipes blackboard and node states for a fresh run.",
  props: {
    root_node: string = "",
    tick_rate_hz: number = 10,
    blackboard: dict<string, string> = {},
    debug_mode: boolean = false,
    max_depth: number = 64,
    restart_on_complete: boolean = false
  },
  events: {
    attached: "behavior_tree:attached",
    detached: "behavior_tree:detached",
    tick: "behavior_tree:tick",
    success: "behavior_tree:success",
    failure: "behavior_tree:failure",
    running: "behavior_tree:running",
    blackboard_set: "behavior_tree:blackboard_set",
    blackboard_cleared: "behavior_tree:blackboard_cleared",
    depth_exceeded: "behavior_tree:depth_exceeded",
    on_tick: "behavior_tree:do_tick",
    on_reset: "behavior_tree:reset",
    on_blackboard_write: "behavior_tree:write_blackboard",
    on_set_root: "behavior_tree:set_root"
  },
  behaviors: ["@npc_ai"]
}
