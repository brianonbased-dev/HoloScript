@trait {
  name: "@negotiation",
  category: "agent",
  description: "Multi-agent negotiation protocol enabling nodes to initiate, participate in, and resolve structured negotiation sessions. strategy selects the bargaining posture: cooperative maximises joint utility through integrative moves and package deals; competitive pursues maximum individual gain via distributive tactics and anchoring; principled uses interest-based negotiation (Fisher-Ury) — separates positions from interests and seeks objective criteria. offers is the ordered list of value–priority pairs this agent is willing to table, where each entry carries a semantic value (resource, price, schedule, term) and a priority weight (0–1) used to rank counter-offer acceptance. accept_threshold (0–1) is the minimum utility score a counter-offer must achieve for this agent to accept without further rounds — computed against the offers list weights. on_offer fires when a new offer arrives from a counterpart; on_counter fires when the agent produces a counter-offer; on_accept fires when both parties converge; on_reject fires when the session terminates in failure; on_stall fires when max_rounds is reached without resolution. max_rounds caps the number of exchange cycles before the trait emits on_stall and the session is closed; 0 means unlimited rounds. Research: NegotiationTrait.ts v3.1.0 — multi-agent sessions, voting mechanisms (majority/unanimity/weighted), proposal lifecycle, audit trail.",
  props: {
    strategy: enum("cooperative" | "competitive" | "principled") = "cooperative",
    offers: list<{value: string, priority: number}> = [],
    accept_threshold: number = 0.6,
    max_rounds: number = 10
  },
  events: {
    attached: "negotiation:attached",
    detached: "negotiation:detached",
    session_started: "negotiation:session_started",
    session_resolved: "negotiation:session_resolved",
    on_offer: "negotiation:offer_received",
    on_counter: "negotiation:counter_offered",
    on_accept: "negotiation:accepted",
    on_reject: "negotiation:rejected",
    on_stall: "negotiation:stalled",
    on_initiate: "negotiation:initiate",
    on_withdraw: "negotiation:withdraw"
  },
  behaviors: ["@multi_agent"]
}
