@trait {
  name: "@hitl",
  category: "agent",
  description: "Human-in-the-Loop approval gateway for autonomous agent actions. queue_url is the webhook or API endpoint that receives pending approval requests — the trait POSTs a JSON task envelope and polls or awaits a callback; leave empty to use the HoloScript built-in approval UI. reviewer_id names the required human reviewer (wallet address, user ID, or role slug); if empty any registered operator may approve. confidence_threshold (0–1) is the minimum agent-reported confidence required to attempt autonomous execution without human approval — actions below this threshold are always queued for review. auto_approve_above (0–1) sets a second, higher threshold above which the trait auto-approves without queuing, useful for high-confidence routine actions where operator fatigue is a concern. escalate_below (0–1) is the confidence level below which the action is escalated to a higher-authority reviewer or emergency-stop channel rather than the normal queue. timeout_ms is the maximum time in milliseconds to wait for a human decision; 0 means wait indefinitely. on_task_sent fires immediately when an approval request leaves the agent; on_approved/on_rejected fire when the human decision arrives; on_escalated fires when the escalate_below threshold or a rule triggers escalation. Research: HITLTrait.ts v3.1.0 — approval request lifecycle, escalation rules, rollback checkpoints, constitutional validator, audit logger.",
  props: {
    queue_url: string = "",
    reviewer_id: string = "",
    confidence_threshold: number = 0.7,
    auto_approve_above: number = 0.95,
    escalate_below: number = 0.3,
    timeout_ms: number = 300000
  },
  events: {
    attached: "hitl:attached",
    detached: "hitl:detached",
    on_task_sent: "hitl:task_sent",
    on_approved: "hitl:approved",
    on_rejected: "hitl:rejected",
    on_escalated: "hitl:escalated",
    on_timeout: "hitl:timeout",
    on_auto_approved: "hitl:auto_approved",
    on_submit: "hitl:submit",
    on_cancel: "hitl:cancel"
  },
  behaviors: ["@llm_agent"]
}
