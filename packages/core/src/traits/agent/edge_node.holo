@trait {
  name: "@edge_node",
  category: "agent",
  description: "Sovereign edge compute node declaration. Marks a composition as a persistent edge agent with a named handle, geographic region, and compute class. Drives the EdgeCompiler board-claim loop: the node polls tasks tagged for its region/compute class, runs them local-first, and offloads to the fleet when local utilization exceeds offload_threshold. Pairs with @agent_discovery for mesh presence.",
  props: {
    node_id: string = "",
    region: string = "us-west",
    compute_class: enum("cpu" | "gpu" | "npu" | "hybrid") = "cpu",
    latency_target_ms: number = 50,
    offload_threshold: number = 0.85
  },
  events: {
    attached: "edge_node:attached",
    detached: "edge_node:detached",
    tick: "edge_node:tick",
    task_claimed: "edge_node:task_claimed",
    task_done: "edge_node:task_done",
    task_failed: "edge_node:task_failed",
    offloaded: "edge_node:offloaded",
    degraded: "edge_node:degraded",
    recovered: "edge_node:recovered",
    on_tick: "edge_node:do_tick",
    on_offload: "edge_node:do_offload"
  },
  behaviors: ["@agent_discovery"]
}
