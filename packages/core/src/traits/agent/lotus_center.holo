@trait {
  name: "@lotus_center",
  category: "agent",
  description: "Lotus spiritual wellbeing center entity. Holds the accumulated clarity energy from LotusRoot agents across the ecosystem, coordinates the Genesis Trigger countdown, and surfaces wellbeing metrics to founder dashboards. Authored from LotusCenterTrait.ts.",
  props: {
    clarity_total: number = 0.0,
    genesis_threshold: number = 16.0,
    active_petals: number = 0,
    active_roots: number = 0,
    genesis_triggered: boolean = false,
    broadcast_interval_s: number = 60,
    public_visible: boolean = true
  },
  events: {
    attached: "lotus_center_attached",
    detached: "lotus_center_detached",
    on_clarity_update: "lotus_center_clarity",
    on_petal_register: "lotus_center_petal",
    on_genesis: "lotus_center_genesis",
    on_pulse: "lotus_center_pulse",
    pulse: "lotus_center_trigger_pulse"
  },
  behaviors: ["@holomesh_presence", "@analytics"]
}
