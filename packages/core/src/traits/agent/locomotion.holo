@trait {
  name: "@locomotion",
  category: "agent",
  description: "Agent locomotion controller. Manages movement modes (walk, run, fly, swim, vehicle), applies animation-state blending, and issues velocity commands to the physics body. Authored from LocomotionTrait.ts.",
  props: {
    mode: enum("biped" | "quadruped" | "fly" | "swim" | "vehicle" | "teleport") = "biped",
    walk_speed_ms: number = 1.4,
    run_speed_ms: number = 4.5,
    fly_speed_ms: number = 10.0,
    acceleration: number = 20.0,
    deceleration: number = 30.0,
    turn_speed_deg_s: number = 180,
    step_height_m: number = 0.3,
    slope_limit_deg: number = 45
  },
  events: {
    attached: "locomotion_attached",
    detached: "locomotion_detached",
    on_mode_change: "locomotion_mode_change",
    on_start_move: "locomotion_start",
    on_stop_move: "locomotion_stop",
    move: "locomotion_move",
    set_mode: "locomotion_set_mode"
  },
  behaviors: ["@rigid_body", "@navigation_mesh", "@astar"]
}
