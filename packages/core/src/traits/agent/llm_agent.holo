@trait {
  name: "@llm_agent",
  category: "agent",
  description: "LLM-powered decision-making node with bounded autonomy and conversation history. model names the hosted or on-device model. system_prompt seeds the agent policy. context_window and xr_context_limit bound prompt memory, protecting XR/edge devices from KV-cache expansion. max_actions_per_turn, bounded_autonomy, and rate_limit_ms gate tool/action loops. memory_key links to @agent_memory for durable recall. Research: LLMAgentTrait.ts v2.0.0 + G.XR.04 XR context-limit + P.XR.05 spatial verification.",
  props: {
    model: string = "gpt-4",
    system_prompt: string = "",
    context_window: number = 4096,
    max_tokens: number = 4096,
    temperature: number = 0,
    tool_use: boolean = false,
    streaming: boolean = false,
    memory_key: string = "",
    on_response_event: string = "llm_agent:response",
    max_actions_per_turn: number = 3,
    bounded_autonomy: boolean = true,
    rate_limit_ms: number = 1000,
    max_history_length: number = 50,
    xr_context_limit: number = 4096,
    enable_spatial_verification: boolean = false
  },
  events: {
    attached: "llm_agent:attached",
    detached: "llm_agent:detached",
    ready: "llm_agent:ready",
    request: "llm_agent:request",
    response: "llm_agent:response",
    tool_call: "llm_agent:tool_call",
    tool_result: "llm_agent:tool_result",
    turn_limit_reached: "llm_agent:turn_limit_reached",
    escalation: "llm_agent:escalation",
    rate_limited: "llm_agent:rate_limited",
    history_cleared: "llm_agent:history_cleared",
    on_prompt: "llm_agent:prompt",
    on_clear_history: "llm_agent:clear_history",
    on_set_system_prompt: "llm_agent:set_system_prompt"
  },
  behaviors: ["@agent_memory"]
}
