@trait {
  name: "@patrol",
  category: "agent",
  description: "Waypoint patrol behavior. Cycles the agent through an ordered or randomized waypoint list, pausing at each for a configured dwell time, and handles obstacle avoidance via the navmesh. Authored from PatrolTrait.ts.",
  props: {
    waypoints: list<{ x: number, y: number, z: number }> = [],
    order: enum("sequential" | "random" | "ping_pong") = "sequential",
    dwell_time_s: number = 2.0,
    move_speed_ms: number = 2.0,
    on_blocked: enum("wait" | "skip" | "abort") = "wait",
    alert_on_sight: boolean = true,
    sight_range_m: number = 15.0
  },
  events: {
    attached: "patrol_attached",
    detached: "patrol_detached",
    on_arrive: "patrol_arrive",
    on_dwell: "patrol_dwell",
    on_sight: "patrol_sight",
    start: "patrol_start",
    stop: "patrol_stop"
  },
  behaviors: ["@locomotion", "@astar", "@waypoint_graph"]
}
