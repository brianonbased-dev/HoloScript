@trait {
  name: "@tracking_topology",
  category: "agent",
  description: "Multi-target tracking topology declaration for sensor networks and spatial agent meshes. topology_type selects the graph structure: star places all nodes connected to a single hub (lowest latency, single point of failure); mesh creates fully- or partially-connected peer links for redundancy; ring connects nodes in a closed loop with deterministic message propagation; hub_spoke clusters leaf nodes around secondary hubs that connect to a root hub. node_limit caps the maximum number of tracked nodes admitted to the topology; additional nodes are queued until capacity is available. edge_capacity is the maximum number of active edges (associations between node pairs) maintained simultaneously — edges beyond this limit are dropped in order of lowest confidence first. redundancy_factor is the target number of independent paths the topology must maintain between any two nodes; the runtime attempts to add or repair edges until this factor is met. When topology_type is star or hub_spoke the hub identity is the first node added; for mesh and ring the runtime discovers the structure from upsert events. Pairs with @kalman_filter and @multi_agent for live tracking scenes and with @telemetry for stats emission. Research: TrackingTopologyTrait.ts — topology_upsert_headset, topology_upsert_target, topology_association, topology_stats, topology_query.",
  props: {
    topology_type: enum("star" | "mesh" | "ring" | "hub_spoke") = "star",
    node_limit: number = 64,
    edge_capacity: number = 256,
    redundancy_factor: number = 1,
    refresh_rate_ms: number = 100,
    show_labels: boolean = true,
    animate_data_flow: boolean = true
  },
  events: {
    attached: "tracking_topology:attached",
    detached: "tracking_topology:detached",
    refreshed: "tracking_topology:refreshed",
    on_node_added: "tracking_topology:node_added",
    on_node_removed: "tracking_topology:node_removed",
    on_path_changed: "tracking_topology:path_changed",
    on_edge_dropped: "tracking_topology:edge_dropped",
    on_capacity_exceeded: "tracking_topology:capacity_exceeded",
    on_upsert_node: "tracking_topology:upsert_node",
    on_remove_node: "tracking_topology:remove_node",
    on_association: "tracking_topology:association",
    on_stats: "tracking_topology:stats",
    on_query: "tracking_topology:query"
  },
  behaviors: ["@multi_agent", "@telemetry"]
}
