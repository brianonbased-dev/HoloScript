@trait {
  name: "@multi_agent",
  category: "agent",
  description: "Multi-agent coordination hub. Registers this node in an agent roster, manages inter-agent messaging (unicast + broadcast), task delegation with capability matching, shared state with last-write-wins conflict resolution, and heartbeat-based liveness monitoring. role determines whether this node acts as coordinator (host), equal peer, or read-only observer. sync_rate_hz governs how often the roster and shared state are reconciled. broadcast_mode selects the delivery topology: direct = point-to-point unicast fan-out, relay = single hop through the host, mesh = gossip across all online peers. message_ttl_ms caps how long undelivered messages remain in the outbox. discovery_scope controls which network boundary peer advertisements cross. Research: MultiAgentTrait.ts v3.1.0 — multi-agent choreography, uAA2++ protocol.",
  props: {
    role: enum("host" | "peer" | "observer") = "peer",
    max_peers: number = 32,
    sync_rate_hz: number = 10,
    broadcast_mode: enum("direct" | "relay" | "mesh") = "mesh",
    message_ttl_ms: number = 60000,
    discovery_scope: enum("local" | "room" | "world") = "room"
  },
  events: {
    attached: "multi_agent:attached",
    detached: "multi_agent:detached",
    peer_joined: "multi_agent:peer_joined",
    peer_left: "multi_agent:peer_left",
    message_received: "multi_agent:message_received",
    message_sent: "multi_agent:message_sent",
    task_delegated: "multi_agent:task_delegated",
    task_completed: "multi_agent:task_completed",
    task_failed: "multi_agent:task_failed",
    state_updated: "multi_agent:state_updated",
    heartbeat: "multi_agent:heartbeat",
    roster_changed: "multi_agent:roster_changed",
    on_send: "multi_agent:send",
    on_broadcast: "multi_agent:broadcast",
    on_delegate_task: "multi_agent:delegate_task",
    on_set_state: "multi_agent:set_state",
    on_query_peers: "multi_agent:query_peers"
  },
  behaviors: ["@agent_discovery"]
}
