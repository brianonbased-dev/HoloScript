@trait {
  name: "@autonomous_agenda",
  category: "agent",
  description: "Long-horizon autonomous agenda planner. Maintains a rolling goal stack, selects the highest-priority achievable goal, and dispatches sub-tasks without human prompting. Authored from AutonomousAgendaTrait.ts.",
  props: {
    goals: list<{ id: string, description: string, priority: number, deadline: number }> = [],
    max_active_tasks: number = 3,
    reflect_interval_ms: number = 60000,
    auto_derive: boolean = true,
    safety_check: boolean = true,
    goal_memory_key: string = ""
  },
  events: {
    attached: "autonomous_agenda_attached",
    detached: "autonomous_agenda_detached",
    on_goal_start: "autonomous_agenda_goal_start",
    on_goal_complete: "autonomous_agenda_goal_complete",
    on_goal_fail: "autonomous_agenda_goal_fail",
    on_reflect: "autonomous_agenda_reflect",
    add_goal: "autonomous_agenda_add",
    clear_goals: "autonomous_agenda_clear"
  },
  behaviors: ["@llm_agent", "@behavior_tree", "@blackboard"]
}
