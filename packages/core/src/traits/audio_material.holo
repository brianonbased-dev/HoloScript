@trait {
  name: "@audio_material",
  category: "audio",
  description: "Acoustic surface material — defines how this surface absorbs, reflects, transmits, and scatters sound energy. absorption_coefficients is a frequency-band map {125Hz, 250Hz, 500Hz, 1kHz, 2kHz, 4kHz} of absorption factors [0,1]. reflection_coefficient is the specular reflection fraction (default: 0.5). transmission_coefficient is the sound transmission fraction (default: 0.1). scattering_coefficient is the diffuse scattering fraction (default: 0.3). material_preset is a named preset (concrete, wood, carpet, glass, curtain; default: concrete). Port of AudioMaterialTrait.ts (handler name: audio_material).",
  props: {
    reflection_coefficient: number = 0.5,
    transmission_coefficient: number = 0.1,
    scattering_coefficient: number = 0.3,
    material_preset: enum("concrete" | "wood" | "carpet" | "glass" | "curtain" | "custom") = "concrete"
  },
  events: {
    on_registered: "audio_material:registered",
    set_preset: "audio_material.set_preset"
  },
  behaviors: ["@audio_occlusion", "@audio_portal"]
}
