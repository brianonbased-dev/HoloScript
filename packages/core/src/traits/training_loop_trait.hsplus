// @training_loop_trait — Training loop: epoch/batch iteration with loss tracking and checkpoint.
//
// Native .hsplus surface for core/traits/TrainingLoopTrait.ts.

@trait training_loop_trait {
  capability_tags: ["training_loop", "epoch_batch", "loss_tracking", "checkpoint", "core"]

  @on_spawn(config) => {
    init_training_loop(config)
    emit("training_loop_ready", {})
  }

  @on_train(dataset, epochs) => {
    metrics = run_training_loop(dataset, epochs)
    emit("training_complete", { epochs })
    return metrics
  }

  @receipt training_loop_trait_config {
    type: "TrainingLoopTraitReceipt"
    timestamp: now()
  }
}
