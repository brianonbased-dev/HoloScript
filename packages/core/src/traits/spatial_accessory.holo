@trait {
  name: "@spatial_accessory",
  category: "xr",
  description: "Spatial accessory controller. device_type: stylus (default), ring, glove, controller. device_id is the device identifier. tracking_mode: optical (default), imu, magnetic. attach_point is the skeleton attach bone. Port of SpatialAccessoryTrait.ts (handler name: spatial_accessory).",
  props: {
    device_type: enum("stylus" | "ring" | "glove" | "controller") = "stylus",
    device_id: string = "",
    tracking_mode: enum("optical" | "imu" | "magnetic") = "optical",
    attach_point: string = "custom"
  },
  events: {
    on_detected: "spatial_accessory:detected",
    on_lost: "spatial_accessory:lost",
    on_action: "spatial_accessory:action"
  },
  behaviors: ["@hand_tracking", "@controller_input", "@gesture_recognition"]
}
