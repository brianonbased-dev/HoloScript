@trait {
  name: "@slack",
  category: "integration",
  description: "Slack messaging. webhook_url is the incoming webhook URL. default_channel is the default channel (default: #general). Port of SlackTrait.ts (handler name: slack).",
  props: {
    webhook_url: string = "",
    default_channel: string = "#general"
  },
  events: {
    on_sent: "slack:sent",
    on_error: "slack:error",
    send: "slack.send"
  },
  behaviors: ["@slack_alert", "@messaging", "@webhook_out"]
}
