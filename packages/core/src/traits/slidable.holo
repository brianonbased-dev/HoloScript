@trait {
  name: "@slidable",
  category: "ui",
  description: "Swipe/slide interaction. Config is gesture-and-axis-dependent and set at instance construction. Port of SlidableTrait.ts (handler name: slidable).",
  props: {},
  events: {
    on_slide: "slidable:slide",
    on_released: "slidable:released",
    on_snapped: "slidable:snapped"
  },
  behaviors: ["@pressable", "@scrollable", "@gesture_recognition"]
}
