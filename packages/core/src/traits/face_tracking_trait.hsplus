// @face_tracking_trait — Face tracking: landmarks, blend shapes, expression mapping for avatars.
//
// source: "live_self" | "recording" | "remote_user" (no default; see the .holo definition).
// live_self data is applied only from a local capture the runtime opened (LocalCapture.ts);
// otherwise the avatar falls back to the generic one. recording / remote_user / missing are a
// likeness: @consent_gate grant + render_likeness yes (HS1011).
//
// Native .hsplus surface for core/traits/FaceTrackingTrait.ts.

@trait face_tracking_trait {
  capability_tags: ["face_tracking", "landmarks", "blend_shapes", "expression_avatar", "core"]

  @on_spawn(device_id) => {
    init_face_tracking(device_id)
    emit("face_tracking_ready", {})
  }

  @on_frame(frame_data) => {
    if (source == "live_self" && !is_local_capture(frame_data.capture, "face")) {
      emit("avatar_generic_fallback", {})
      return
    }
    expression = process_face_frame(frame_data)
    emit("face_expression_updated", {})
    return expression
  }

  @receipt face_tracking_trait_config {
    type: "FaceTrackingTraitReceipt"
    timestamp: now()
  }
}
