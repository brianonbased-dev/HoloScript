@trait {
  name: "@frame_declaration",
  category: "agent",
  description: "Agent frame declaration — declares the trust and capability tier of a brain node. domain is the domain scope (* = all, or a specific domain; default: *). horizon is the planning time horizon (default: empty — no limit). capability_tier is the agent capability level [0-3] (default: 2). trust_tier is the trust level [0-3] (default: 2). allowed_tools is the tool allowlist (empty = inherit from tier). Port of FrameDeclarationTrait.ts (handler name: frame_declaration).",
  props: {
    domain: string = "*",
    horizon: string = "",
    capability_tier: number = 2,
    trust_tier: number = 2
  },
  events: {
    on_declared: "frame_declared",
    on_violation: "frame_violation"
  },
  behaviors: ["@edge_node", "@consent_gate"]
}
