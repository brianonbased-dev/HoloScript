@trait {
  name: "@user_monitor",
  category: "ux",
  description: "User behaviour monitor for adaptive assistance. update_rate is the samples per second (default: 0.2 Hz = every 5s). jitter_sensitivity is the hand-jitter detection threshold (default: 0.5). adaptive_assistance triggers contextual help when struggle is detected (default: true). Port of UserMonitorTrait.ts (handler name: user_monitor).",
  props: {
    update_rate: number = 0.2,
    jitter_sensitivity: number = 0.5,
    adaptive_assistance: boolean = true
  },
  events: {
    on_struggle: "user_monitor:struggle",
    on_idle: "user_monitor:idle",
    on_engaged: "user_monitor:engaged"
  },
  behaviors: ["@service_observability", "@onboarding", "@tutorial"]
}
