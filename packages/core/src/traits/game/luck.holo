@trait {
  name: "@luck",
  category: "game",
  description: "Entity luck attribute for loot tables, critical hit modifiers, and random-event weighting. Applies a luck multiplier to weighted probability draws and integrates with item-drop and encounter systems. Authored from LuckTrait.ts.",
  props: {
    base_luck: number = 0.0,
    bonus_luck: number = 0.0,
    max_luck: number = 100.0,
    luck_decay: number = 0.0,
    apply_to_loot: boolean = true,
    apply_to_crits: boolean = true,
    apply_to_encounters: boolean = false
  },
  events: {
    attached: "luck_attached",
    detached: "luck_detached",
    on_luck_change: "luck_change",
    on_lucky_event: "luck_lucky",
    on_unlucky_event: "luck_unlucky"
  },
  behaviors: ["@stats", "@inventory"]
}
