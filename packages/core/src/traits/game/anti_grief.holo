@trait {
  name: "@anti_grief",
  category: "game",
  description: "Anti-griefing system for multiplayer worlds. Monitors for destructive player behavior (spawn-killing, object spamming, trapping) and applies graduated sanctions. Authored from AntiGriefTrait.ts.",
  props: {
    kill_streak_threshold: number = 5,
    object_spam_threshold: number = 20,
    trap_detection: boolean = true,
    auto_sanction: boolean = true,
    sanction_levels: list<enum("warn" | "mute" | "kick" | "ban")> = [],
    cooldown_s: number = 300,
    report_webhook: string = ""
  },
  events: {
    attached: "anti_grief_attached",
    detached: "anti_grief_detached",
    on_violation: "anti_grief_violation",
    on_sanction: "anti_grief_sanction",
    on_report: "anti_grief_report",
    on_appeal: "anti_grief_appeal",
    report: "anti_grief_trigger_report"
  },
  behaviors: ["@reputation_ledger", "@audit_log", "@access_control"]
}
