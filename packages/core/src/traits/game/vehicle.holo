@trait {
  name: "@vehicle",
  category: "game",
  description: "Drivable vehicle physics controller. Simulates a four-wheeled vehicle via suspension ray-casts, differential slip, and engine torque curves, accepting throttle/steer/brake inputs from the player or AI and broadcasting speed and collision events. Authored from VehicleTrait.ts.",
  props: {
    max_speed_m_s: number = 30,
    acceleration: number = 15,
    braking: number = 25,
    steering_angle_deg: number = 35,
    center_of_mass_y: number = -0.3,
    wheel_radius_m: number = 0.35,
    engine_sound_url: string = ""
  },
  events: {
    attached: "vehicle_attached",
    detached: "vehicle_detached",
    on_enter: "vehicle_enter",
    on_exit: "vehicle_exit",
    on_crash: "vehicle_crash",
    enter: "vehicle_trigger_enter",
    exit: "vehicle_trigger_exit"
  },
  behaviors: ["@kinematic_body", "@mount_point", "@platform_controller"]
}
