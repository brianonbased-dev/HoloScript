@trait {
  name: "@state_machine",
  category: "game",
  description: "Declarative finite state machine (FSM) for entity behavioural logic. initial_state names the starting state key. states is a dictionary from state name to a state descriptor containing optional on_enter_event and on_exit_event strings (emitted when entering or leaving that state) and a transitions list; each transition specifies the target state (to), an optional boolean-expression condition string (condition) evaluated against entity state each tick, and a priority integer for deterministic tie-breaking when multiple conditions are true simultaneously. auto_advance enables tick-driven automatic evaluation of transitions each update so condition-based transitions fire without an explicit trigger event; when false the FSM advances only via the on_transition command event. debug emits a state_machine:debug event on every evaluation cycle with the current state and evaluated conditions for observability tooling. on_state_changed is the event emitted whenever the active state changes (payload: {from, to, transition_index}). Backed by StateMachineTrait.ts handler with sm:transition / sm:query protocol; native .holo declaration extends it with declarative transitions, auto_advance, and per-state lifecycle events. Research: StateMachineTrait.ts, AnimationStateMachine.ts.",
  props: {
    initial_state: string = "idle",
    states: dict<string, {
      on_enter_event: string,
      on_exit_event: string,
      transitions: array<{
        to: string,
        condition: string,
        priority: number
      }>
    }> = {},
    auto_advance: boolean = true,
    debug: boolean = false,
    on_state_changed: string = "state_machine:state_changed"
  },
  events: {
    attached: "state_machine:attached",
    detached: "state_machine:detached",
    state_entered: "state_machine:state_entered",
    state_exited: "state_machine:state_exited",
    state_changed: "state_machine:state_changed",
    transition_blocked: "state_machine:transition_blocked",
    debug: "state_machine:debug",
    on_transition: "state_machine:transition",
    on_query: "state_machine:query",
    on_reset: "state_machine:reset"
  }
}
