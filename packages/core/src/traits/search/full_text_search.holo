@trait {
  name: "@full_text_search",
  category: "search",
  description: "Full-text search indexing and querying with configurable tokenization, fuzzy matching, and highlighted result extraction. Maintains an in-scene inverted-index over declared index_fields; supports standard, ngram, and edge_ngram tokenizers; fuzzy tolerance is toggle-gated to avoid penalty on exact-match queries; highlight wraps matched spans in a <mark> tag for downstream renderers. Backed by FullTextSearchTrait.ts handler and FacetedSearchTrait.ts for faceted narrowing.",
  props: {
    index_fields: array<string> = [],
    tokenizer: enum("standard" | "ngram" | "edge_ngram") = "standard",
    fuzzy: boolean = false,
    highlight: boolean = true,
    max_results: number = 50
  },
  events: {
    attached: "fts:attached",
    detached: "fts:detached",
    indexed: "fts:indexed",
    results: "fts:results",
    cleared: "fts:cleared",
    on_index: "fts:index",
    on_search: "fts:search",
    on_clear: "fts:clear"
  }
}
