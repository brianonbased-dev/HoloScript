@trait {
  name: "@spatial_awareness",
  category: "xr",
  description: "Spatial awareness compositor. Config is device-and-session-dependent and passed through to SpatialAwarenessTrait instance. Port of SpatialAwarenessTrait.ts (handler name: spatial_awareness).",
  props: {},
  events: {
    on_updated: "spatial_awareness:updated",
    on_surface_detected: "spatial_awareness:surface_detected"
  },
  behaviors: ["@scene_reconstruction", "@mesh_detection", "@plane_detection"]
}
