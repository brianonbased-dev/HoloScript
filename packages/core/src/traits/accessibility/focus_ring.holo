@trait {
  name: "@focus_ring",
  category: "accessibility",
  description: "Visual focus indicator ring for spatial objects. Renders a configurable highlight around the focused node to support keyboard and gaze navigation accessibility.",
  props: {
    color: string = "#ffffff",
    width: number = 0.04,
    opacity: number = 0.9,
    pulse: boolean = true,
    pulse_speed: number = 1.5,
    offset: number = 0.02,
    visible: boolean = false
  },
  events: {
    show: "accessibility_focus_ring",
    hide: "accessibility_focus_ring"
  }
}
