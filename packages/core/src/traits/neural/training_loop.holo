@trait {
  name: "@training_loop",
  category: "neural",
  description: "On-device supervised training loop for HoloScript neural compositions. epochs is the total number of passes over the training dataset. batch_size is the number of samples processed per gradient step. learning_rate is the global step size multiplier applied by the optimizer. optimizer selects the gradient update rule: adam applies adaptive per-parameter learning rates with moment estimates (recommended default), sgd applies vanilla stochastic gradient descent, rmsprop applies root-mean-square gradient scaling, adagrad applies accumulated per-parameter gradient scaling (good for sparse data). loss_fn selects the loss surface: mse minimises mean squared error (regression tasks), cross_entropy minimises categorical cross-entropy (classification tasks), huber is a robust loss that behaves as mse near zero and mae far from zero (outlier-resistant regression). on_epoch fires at the end of each full pass over the dataset carrying epoch number, mean loss, and mean metric score. on_step fires after every gradient update carrying step index, batch loss, and current learning rate. on_eval fires when an evaluation pass completes (distinct from training steps) carrying eval_loss and eval_metric. on_complete fires when all epochs finish carrying final_loss, best_epoch, and checkpoint path if checkpoint_interval > 0. checkpoint_interval is the number of epochs between automatic model weight saves; 0 disables checkpointing. Research: TrainingLoopTrait.ts v5.1.",
  props: {
    epochs: number = 100,
    batch_size: number = 32,
    learning_rate: number = 0.001,
    optimizer: enum("adam" | "sgd" | "rmsprop" | "adagrad") = "adam",
    loss_fn: enum("mse" | "cross_entropy" | "huber") = "mse",
    checkpoint_interval: number = 0
  },
  events: {
    attached: "training_loop:attached",
    detached: "training_loop:detached",
    started: "training_loop:started",
    on_epoch: "training_loop:epoch",
    on_step: "training_loop:step",
    on_eval: "training_loop:eval",
    on_complete: "training_loop:complete",
    checkpoint_saved: "training_loop:checkpoint_saved",
    on_start: "training_loop:cmd_start",
    on_stop: "training_loop:cmd_stop",
    on_pause: "training_loop:cmd_pause",
    on_resume: "training_loop:cmd_resume",
    on_set_lr: "training_loop:cmd_set_lr",
    on_step_input: "training_loop:cmd_step"
  },
  behaviors: ["@neural_animation"]
}
