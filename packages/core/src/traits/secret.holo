@trait {
  name: "@secret",
  category: "security",
  description: "Encrypted secret store. max_secrets is the secret capacity (default: 100). auto_expire automatically removes expired secrets (default: true). Port of SecretTrait.ts (handler name: secret). Secrets are stored encrypted, never in plaintext.",
  props: {
    max_secrets: number = 100,
    auto_expire: boolean = true
  },
  events: {
    on_stored: "secret:stored",
    on_expired: "secret:expired",
    store: "secret.store",
    resolve: "secret.resolve",
    revoke: "secret.revoke"
  },
  behaviors: ["@encryption", "@api_key", "@package_signing"]
}
