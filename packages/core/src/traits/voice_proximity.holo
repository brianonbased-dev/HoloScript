@trait {
  name: "@voice_proximity",
  category: "audio",
  description: "Proximity-based voice attenuation. min_distance is the full-volume radius in meters (default: 1m). max_distance is the silence radius in meters (default: 20m). falloff: logarithmic (default), linear, exponential. directional applies cone-shaped attenuation (default: false). Port of VoiceProximityTrait.ts (handler name: voice_proximity).",
  props: {
    min_distance: number = 1,
    max_distance: number = 20,
    falloff: enum("logarithmic" | "linear" | "exponential") = "logarithmic",
    directional: boolean = false
  },
  events: {
    on_in_range: "voice_proximity:in_range",
    on_out_of_range: "voice_proximity:out_of_range"
  },
  behaviors: ["@spatial_voice", "@reverb_zone", "@remote_presence"]
}
