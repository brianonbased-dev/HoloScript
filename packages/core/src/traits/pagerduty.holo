@trait {
  name: "@pagerduty",
  category: "ops",
  description: "PagerDuty incident alerting integration. severity: critical (default), error, warning, info. Port of PagerdutyTrait.ts (handler name: pagerduty).",
  props: {
    severity: enum("critical" | "error" | "warning" | "info") = "critical"
  },
  events: {
    on_triggered: "pagerduty:triggered",
    on_resolved: "pagerduty:resolved",
    trigger: "pagerduty.trigger",
    resolve: "pagerduty.resolve"
  },
  behaviors: ["@incident", "@slo_monitor", "@audit_log"]
}
