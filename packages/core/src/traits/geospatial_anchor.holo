@trait {
  name: "@geospatial_anchor",
  category: "xr",
  description: "Geospatial cloud anchor at a specific lat/lon/alt. latitude/longitude/altitude set the anchor's real-world position (defaults: 0, 0, 0). altitude_type: terrain (default), rooftop, floor. Port of GeospatialAnchorTrait.ts (handler name: geospatial_anchor).",
  props: {
    latitude: number = 0,
    longitude: number = 0,
    altitude: number = 0,
    altitude_type: enum("terrain" | "rooftop" | "floor") = "terrain"
  },
  events: {
    on_resolved: "geospatial_anchor:resolved",
    on_failed: "geospatial_anchor:failed",
    resolve: "geospatial_anchor.resolve"
  },
  behaviors: ["@anchor", "@persistent_anchor"]
}
