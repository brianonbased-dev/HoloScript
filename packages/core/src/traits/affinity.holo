@trait {
  name: "@affinity",
  category: "social",
  description: "Affinity relationship model between agent pairs — Sternberg triangular love theory + Nash effort equilibrium. agent_ids is the list of agent identifiers in the relationship [R, J]. archetypes defines the personality archetypes. initial_feelings is the starting affinity vector [0,1] for each agent (default: [0.5, 0.5]). enable_sternberg activates Sternberg's intimacy/passion/commitment model. enable_nash_effort activates Nash equilibrium effort optimization. time_step is the model update rate in seconds (default: 0.1). Port of AffinityTrait.ts (handler name: affinity).",
  props: {
    enable_sternberg: boolean = false,
    enable_nash_effort: boolean = false,
    time_step: number = 0.1
  },
  events: {
    on_updated: "affinity:updated",
    on_peak: "affinity:peak",
    on_collapsed: "affinity:collapsed",
    update: "affinity.update"
  },
  behaviors: ["@ai_companion", "@agent_memory"]
}
