@trait {
  name: "@image_resize",
  category: "media",
  description: "Image resize and compression. max_width is the output width cap in px (default: 2048). max_height is the output height cap in px (default: 2048). quality is the JPEG/WebP quality [0–100] (default: 85). Port of ImageResizeTrait.ts (handler name: image_resize).",
  props: {
    max_width: number = 2048,
    max_height: number = 2048,
    quality: number = 85
  },
  events: {
    on_resized: "image_resize:resized",
    on_error: "image_resize:error",
    resize: "image_resize.resize"
  },
  behaviors: ["@ai_upscaling", "@ai_inpainting"]
}
