@trait {
  name: "@volumetric_clouds",
  category: "rendering",
  description: "Volumetric cloud layer. altitude is the cloud base height in meters (default: 500m). thickness is the cloud layer depth in meters (default: 200m). absorption_coeff is the absorption coefficient (default: 0.04). scattering_coeff is the scattering coefficient (default: 0.06). Port of VolumetricCloudsTrait.ts (handler name: volumetric_clouds).",
  props: {
    altitude: number = 500,
    thickness: number = 200,
    absorption_coeff: number = 0.04,
    scattering_coeff: number = 0.06
  },
  events: {
    on_updated: "volumetric_clouds:updated"
  },
  behaviors: ["@volumetric", "@global_illumination", "@post_process"]
}
