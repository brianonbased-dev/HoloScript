@trait {
  name: "@spatial_profiler",
  category: "diagnostics",
  description: "XR spatial performance profiler. sample_rate_ms is the FPS/draw-call sample cadence in ms (default: 16ms = 60fps). Port of SpatialProfilerTrait.ts (handler name: spatial_profiler).",
  props: {
    sample_rate_ms: number = 16
  },
  events: {
    on_sample: "spatial_profiler:sample",
    on_report: "spatial_profiler:report",
    start: "spatial_profiler.start",
    stop: "spatial_profiler.stop",
    report: "spatial_profiler.report"
  },
  behaviors: ["@profiler", "@jetson_gpu", "@service_observability"]
}
