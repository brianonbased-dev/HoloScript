@trait {
  name: "@workflow",
  category: "coordination",
  description: "Multi-step workflow orchestration with step tracking. Manages named workflows as ordered step lists with a current-index cursor and pending/in_progress/completed status. Port of WorkflowTrait.ts (handler name: workflow).",
  props: {
    max_steps: number = 50
  },
  events: {
    attached: "workflow_attached",
    detached: "workflow_detached",
    on_created: "workflow_created",
    on_advanced: "workflow_advanced",
    on_completed: "workflow_completed",
    create: "workflow_create",
    advance: "workflow_advance"
  },
  behaviors: ["@journal", "@state_machine", "@task_queue"]
}
