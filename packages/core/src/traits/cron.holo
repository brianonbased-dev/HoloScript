@trait {
  name: "@cron",
  category: "scheduling",
  description: "Persistent cron job scheduler with IndexedDB storage. timezone is the IANA timezone for schedule evaluation (default: UTC). max_jobs is the maximum registered jobs (default: 100). poll_interval_ms is the tick check frequency (default: 30,000ms). missed_job_strategy handles jobs missed while offline: run_once (default), skip, run_all. persist saves jobs to IndexedDB across sessions (default: true). Port of CronTrait.ts (handler name: cron).",
  props: {
    timezone: string = "UTC",
    max_jobs: number = 100,
    poll_interval_ms: number = 30000,
    missed_job_strategy: enum("run_once" | "skip" | "run_all") = "run_once",
    persist: boolean = true
  },
  events: {
    on_fired: "cron:fired",
    on_missed: "cron:missed",
    on_overflow: "cron:overflow",
    add: "cron.add",
    remove: "cron.remove",
    pause: "cron.pause"
  },
  behaviors: ["@batch_job", "@autonomous_agenda"]
}
