@trait {
  name: "@avatar_embodiment",
  category: "xr",
  description: "Full-body avatar embodiment controller. tracking_source: ai (default), mocap, controller, skeleton. ik_mode: upper_body (default), full_body, face, none. mirror_expressions mirrors the user's facial expressions to the avatar (default: true). lip_sync enables lip sync from audio (default: true). emotion_directives applies LLM-directed emotion blends (default: true). eye_tracking_forward drives eye direction from eye tracker (default: false). personal_space_radius defines the personal space bubble in meters (default: 0.5). conversation_fillers enables idle motion/blinks (default: true). Port of AvatarEmbodimentTrait.ts (handler name: avatar_embodiment).",
  props: {
    tracking_source: enum("ai" | "mocap" | "controller" | "skeleton") = "ai",
    ik_mode: enum("upper_body" | "full_body" | "face" | "none") = "upper_body",
    mirror_expressions: boolean = true,
    lip_sync: boolean = true,
    emotion_directives: boolean = true,
    eye_tracking_forward: boolean = false,
    personal_space_radius: number = 0.5,
    conversation_fillers: boolean = true
  },
  events: {
    on_calibrated: "avatar_embodiment:calibrated",
    on_expression: "avatar_embodiment:expression",
    on_gesture: "avatar_embodiment:gesture",
    calibrate: "avatar_embodiment.calibrate"
  },
  behaviors: ["@auto_rig", "@body_tracking", "@neural_animation"]
}
