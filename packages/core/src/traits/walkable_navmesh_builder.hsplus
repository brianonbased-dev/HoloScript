// @walkable_navmesh_builder — Walkable navmesh builder: bakes navigable area from scene geometry.
//
// Native .hsplus surface for core/traits/WalkableNavmeshBuilder.ts.

@trait walkable_navmesh_builder {
  capability_tags: ["walkable_navmesh_builder", "navmesh_bake", "scene_geometry", "walkable_area", "core"]

  @on_spawn(config) => {
    init_walkable_navmesh_builder(config)
    emit("walkable_navmesh_builder_ready", {})
  }

  @on_bake(scene_meshes) => {
    navmesh = bake_walkable_navmesh(scene_meshes)
    emit("navmesh_baked", {})
    return navmesh
  }

  @receipt walkable_navmesh_builder_config {
    type: "WalkableNavmeshBuilderReceipt"
    timestamp: now()
  }
}
