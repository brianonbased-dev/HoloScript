@trait {
  name: "@tensorrt_inference",
  category: "hardware",
  description: "NVIDIA TensorRT quantized inference declaration for Jetson edge nodes. Declares the engine path, precision, ONNX source, batch/workspace budget, and engine-cache policy used to build or load a device-specific TensorRT engine. Port of TensorRTInferenceTrait.ts (handler name: tensorrt_inference).",
  props: {
    engine_path: string = "/opt/holoscript/engines/model.fp16.trt",
    precision: enum("fp32" | "fp16" | "int8") = "fp16",
    onnx_path: string = "/opt/holoscript/models/model.onnx",
    max_batch_size: number = 1,
    workspace_mb: number = 4096,
    cache_engine: boolean = true
  },
  events: {
    loaded: "tensorrt_inference:loaded",
    inferred: "tensorrt_inference:inferred",
    error: "tensorrt_inference:error",
    load: "tensorrt_inference:load",
    infer: "tensorrt_inference:infer"
  },
  behaviors: ["@jetson_gpu"]
}
