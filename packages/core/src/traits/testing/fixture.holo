@trait {
  name: "@fixture",
  category: "testing",
  description: "Test fixture loader. Seeds a named entity with deterministic prop values, synthetic identities, and reset callbacks for use in holotest suites and CI pipelines. Authored from FixtureTrait.ts.",
  props: {
    fixture_name: string = "",
    seed: number = 42,
    reset_on_each_test: boolean = true,
    fixtures_url: string = "",
    overrides: dict<string, string> = {},
    tags: list<string> = []
  },
  events: {
    attached: "fixture_attached",
    detached: "fixture_detached",
    on_setup: "fixture_setup",
    on_teardown: "fixture_teardown",
    on_reset: "fixture_reset",
    setup: "fixture_trigger_setup",
    teardown: "fixture_trigger_teardown"
  },
  behaviors: ["@validation"]
}
