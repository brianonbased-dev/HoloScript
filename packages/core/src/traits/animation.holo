@trait {
  name: "@animation",
  category: "animation",
  description: "Animation controller that wraps an AnimationTrait instance on the node. Manages animation layers (e.g., Base Layer), blend trees, and cross-fade transitions. defaultConfig is empty — animation state is resolved from the node's skeleton and animation clips at runtime. Emits animation_attached/detached lifecycle events. Port of AnimationTrait.ts (handler name: animation).",
  props: {},
  events: {
    on_attached: "animation_attached",
    on_detached: "animation_detached",
    on_state_changed: "animation_state_changed",
    play: "animation_play",
    stop: "animation_stop",
    crossfade: "animation_crossfade"
  },
  behaviors: ["@auto_rig", "@locomotion", "@neural_expression"]
}
