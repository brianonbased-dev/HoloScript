const WGSL_SCATTER = /* wgsl */\`
struct VIn { @location(0) pos: vec3<f32>, @location(1) norm: vec3<f32> };
struct VOut { @builtin(position) clip: vec4<f32>, @location(0) shade: f32 };
fn hash11(v: f32) -> f32 { return fract(sin(v * 12.9898) * 43758.5453); }
@vertex fn vs_scatter(i: VIn, @builtin(instance_index) instance: u32) -> VOut {
