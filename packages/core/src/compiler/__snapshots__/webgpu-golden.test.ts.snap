const WGSL_VERTEX = /* wgsl */\`
struct Uniforms { model: mat4x4<f32> };
struct Camera { viewProj: mat4x4<f32> };
@group(0) @binding(0) var<uniform> u: Uniforms;
@group(0) @binding(2) var<uniform> cam: Camera;
struct VIn { @location(0) pos: vec3<f32>, @location(1) norm: vec3<f32> };
struct VOut { @builtin(position) clip: vec4<f32>, @location(0) wNorm: vec3<f32>, @location(1) wPos: vec3<f32> };
@vertex fn vs_main(i: VIn) -> VOut {
  var o: VOut; let w = u.model * vec4<f32>(i.pos, 1.0);
  o.clip = cam.viewProj * w; o.wNorm = normalize((u.model * vec4<f32>(i.norm, 0.0)).xyz); o.wPos = w.xyz; return o; }\`;

const WGSL_FRAGMENT = /* wgsl */\`
struct Mat { color: vec4<f32>, rm: vec4<f32>, emissive: vec4<f32> };
struct Light { ct: vec4<f32>, posW: vec4<f32>, dirW: vec4<f32> };
struct Lights { count: vec4<f32>, items: array<Light, 4> };
@group(0) @binding(1) var<uniform> mat: Mat;
@group(0) @binding(3) var<uniform> lights: Lights;
struct FIn { @location(0) wNorm: vec3<f32>, @location(1) wPos: vec3<f32> };
@fragment fn fs_main(i: FIn) -> @location(0) vec4<f32> {
  let N = normalize(i.wNorm);
  var acc = vec3<f32>(0.0, 0.0, 0.0);
  let n = i32(lights.count.x);
  for (var k = 0; k < n; k = k + 1) {
    let lt = lights.items[k];
    var L = normalize(-lt.dirW.xyz);
    if (lt.ct.w > 0.5) { L = normalize(lt.posW.xyz - i.wPos); }
    let d = max(dot(N, L), 0.0) * (1.0 - mat.rm[0] * 0.5);
    acc = acc + lt.ct.rgb * d;
  }
  let lit = mat.color.rgb * (0.15 + acc);
  let emit = mat.emissive.rgb * mat.rm[2];
  return vec4<f32>(lit + emit, mat.color.a); }\`;

const WGSL_SPLAT = /* wgsl */\`
struct Splat { center: vec3<f32>, opacity: f32, cov: array<f32,6>, sh: vec3<f32> };
@group(0) @binding(0) var<storage, read> splats: array<Splat>;
struct SO { @builtin(position) p: vec4<f32>, @location(0) c: vec4<f32>, @location(1) uv: vec2<f32> };
@vertex fn vs_splat(@builtin(vertex_index) vi: u32, @builtin(instance_index) ii: u32) -> SO {
  var q = array<vec2<f32>,4>(vec2(-1,-1),vec2(1,-1),vec2(-1,1),vec2(1,1));
  var o: SO; let s = splats[ii]; o.p = vec4<f32>(s.center.xy + q[vi]*0.01, s.center[2], 1.0);
  o.c = vec4<f32>(s.sh, s.opacity); o.uv = q[vi]; return o; }
@fragment fn fs_splat(i: SO) -> @location(0) vec4<f32> {
  let a = i.c.a * exp(-dot(i.uv, i.uv) * 4.0); if (a < 0.01) { discard; }
  return vec4<f32>(i.c.rgb * a, a); }\`;

