    out.push(0, hy, 0, (c0+c1)*0.5*nyx, ny, (s0+s1)*0.5*nyx);
    out.push(radius*c0, -hy, radius*s0, c0*nyx, ny, s0*nyx);
    out.push(radius*c1, -hy, radius*s1, c1*nyx, ny, s1*nyx);
    out.push(0, -hy, 0, 0, -1, 0, radius*c1, -hy, radius*s1, 0, -1, 0, radius*c0, -hy, radius*s0, 0, -1, 0);
