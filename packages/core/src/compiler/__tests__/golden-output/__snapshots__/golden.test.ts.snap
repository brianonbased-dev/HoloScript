"// Auto-generated by HoloScript WebGPUCompiler
// Source: composition "GoldenScene"
// Do not edit manually — regenerate from .holo source

// === WebGPU Device Initialization ===
const canvas = document.querySelector("canvas") as HTMLCanvasElement;
const adapter = await navigator.gpu.requestAdapter();
if (!adapter) throw new Error("WebGPU not supported");
const device = await adapter.requestDevice();
document.body.dataset.holoscriptWebgpu = "device-ready";
const context = canvas.getContext("webgpu") as GPUCanvasContext;
const format = navigator.gpu.getPreferredCanvasFormat();
context.configure({ device, format, alphaMode: "premultiplied" });
const MSAA_COUNT = 4;
const msaaTexture = device.createTexture({ size: [canvas.width, canvas.height], sampleCount: MSAA_COUNT, format, usage: GPUTextureUsage.RENDER_ATTACHMENT });
const depthTexture = device.createTexture({ size: [canvas.width, canvas.height], sampleCount: MSAA_COUNT, format: "depth24plus", usage: GPUTextureUsage.RENDER_ATTACHMENT });

function createBuffer(device: GPUDevice, data: Float32Array, usage: number): GPUBuffer {
  const buf = device.createBuffer({ size: data.byteLength, usage: usage | GPUBufferUsage.COPY_DST });
  device.queue.writeBuffer(buf, 0, data); return buf;
}
function createStorageBuffer(device: GPUDevice, size: number): GPUBuffer {
  return device.createBuffer({ size, usage: GPUBufferUsage.STORAGE | GPUBufferUsage.VERTEX | GPUBufferUsage.COPY_DST });
}
function createFallbackTexture(device, rgba) {
  const tex = device.createTexture({ size: [1, 1, 1], format: "rgba8unorm", usage: GPUTextureUsage.TEXTURE_BINDING | GPUTextureUsage.COPY_DST });
  device.queue.writeTexture({ texture: tex }, new Uint8Array(rgba), { bytesPerRow: 4 }, [1, 1, 1]);
  return tex;
}
async function loadTexture2D(src) {
  const sampler = device.createSampler({ magFilter: "linear", minFilter: "linear", mipmapFilter: "linear", addressModeU: "repeat", addressModeV: "repeat" });
  try {
    const resp = await fetch(src);
    if (!resp.ok) throw new Error(\`texture fetch \${resp.status}\`);
    const bitmap = await createImageBitmap(await resp.blob());
    const texture = device.createTexture({ size: [bitmap.width, bitmap.height, 1], format: "rgba8unorm", usage: GPUTextureUsage.TEXTURE_BINDING | GPUTextureUsage.COPY_DST | GPUTextureUsage.RENDER_ATTACHMENT });
    device.queue.copyExternalImageToTexture({ source: bitmap }, { texture }, [bitmap.width, bitmap.height]);
    return { src, texture, view: texture.createView(), sampler, loaded: true };
  } catch {
    const texture = createFallbackTexture(device, [255, 255, 255, 255]);
    return { src, texture, view: texture.createView(), sampler, loaded: false };
  }
}
async function loadMaterialTextureSet(maps) {
  const entries = await Promise.all(Object.entries(maps).map(async ([kind, src]) => [kind, await loadTexture2D(src)]));
  return Object.fromEntries(entries);
}
const assetLoader = {
  async load(src) {
    return { src, kind: "external-model", loaded: false };
  },
};
function makeParticleCloud(count, seed) {
  let s = seed || 1;
  const rnd = () => { s = (s * 1664525 + 1013904223) >>> 0; return s / 4294967296; };
  const data = new Float32Array(count * 8);
  for (let i = 0; i < count; i++) {
    const o = i * 8;
    data[o + 0] = rnd() * 1.8 - 0.9; data[o + 1] = rnd() * 1.2 - 0.6; data[o + 2] = rnd() * 1.8 - 0.9;
    data[o + 3] = 0.0; data[o + 4] = 0.25 + rnd(); data[o + 5] = 0.0; data[o + 6] = rnd(); data[o + 7] = 0.0;
  }
  return data;
}

// === Geometry Helpers ===
function generateCubeVertices(size) {
  const s = size / 2;
  return new Float32Array([
    -s,-s, s, 0,0,1,  s,-s, s, 0,0,1,  s, s, s, 0,0,1, -s,-s, s, 0,0,1,  s, s, s, 0,0,1, -s, s, s, 0,0,1,
     s,-s,-s, 0,0,-1, -s,-s,-s, 0,0,-1, -s, s,-s, 0,0,-1,  s,-s,-s, 0,0,-1, -s, s,-s, 0,0,-1,  s, s,-s, 0,0,-1,
    -s,-s,-s, -1,0,0, -s,-s, s, -1,0,0, -s, s, s, -1,0,0, -s,-s,-s, -1,0,0, -s, s, s, -1,0,0, -s, s,-s, -1,0,0,
     s,-s, s, 1,0,0,  s,-s,-s, 1,0,0,  s, s,-s, 1,0,0,  s,-s, s, 1,0,0,  s, s,-s, 1,0,0,  s, s, s, 1,0,0,
    -s, s, s, 0,1,0,  s, s, s, 0,1,0,  s, s,-s, 0,1,0, -s, s, s, 0,1,0,  s, s,-s, 0,1,0, -s, s,-s, 0,1,0,
    -s,-s,-s, 0,-1,0,  s,-s,-s, 0,-1,0,  s,-s, s, 0,-1,0, -s,-s,-s, 0,-1,0,  s,-s, s, 0,-1,0, -s,-s, s, 0,-1,0
  ]);
}
function generatePlaneVertices(width, depth) {
  const x = width / 2, z = depth / 2;
  return new Float32Array([-x,0,-z,0,1,0, x,0,-z,0,1,0, x,0,z,0,1,0, -x,0,-z,0,1,0, x,0,z,0,1,0, -x,0,z,0,1,0]);
}
function generateSphereVertices(radius, lat, lon) {
  const rings = Math.max(3, lat | 0), segs = Math.max(3, lon | 0); const out = [];
  const P = (ri, si) => {
    const phi = Math.PI * ri / rings, theta = 2 * Math.PI * si / segs;
    const nx = Math.sin(phi) * Math.cos(theta), ny = Math.cos(phi), nz = Math.sin(phi) * Math.sin(theta);
    return [nx * radius, ny * radius, nz * radius, nx, ny, nz];
  };
  for (let ri = 0; ri < rings; ri++) { for (let si = 0; si < segs; si++) {
    const a = P(ri, si), b = P(ri + 1, si), c = P(ri + 1, si + 1), d = P(ri, si + 1);
    out.push(...a, ...b, ...c, ...a, ...c, ...d);
  } } return new Float32Array(out);
}
function generateCylinderVertices(radius, height, segments) {
  const segs = Math.max(3, segments | 0), hy = height / 2, out = [];
  for (let i = 0; i < segs; i++) {
    const t0 = 2*Math.PI*i/segs, t1 = 2*Math.PI*(i+1)/segs;
    const c0 = Math.cos(t0), s0 = Math.sin(t0), c1 = Math.cos(t1), s1 = Math.sin(t1);
    const b0 = [radius*c0, -hy, radius*s0, c0, 0, s0], t0v = [radius*c0, hy, radius*s0, c0, 0, s0];
    const b1 = [radius*c1, -hy, radius*s1, c1, 0, s1], t1v = [radius*c1, hy, radius*s1, c1, 0, s1];
    out.push(...b0, ...b1, ...t1v, ...b0, ...t1v, ...t0v);
    out.push(0, hy, 0, 0, 1, 0, radius*c0, hy, radius*s0, 0, 1, 0, radius*c1, hy, radius*s1, 0, 1, 0);
    out.push(0, -hy, 0, 0, -1, 0, radius*c1, -hy, radius*s1, 0, -1, 0, radius*c0, -hy, radius*s0, 0, -1, 0);
  } return new Float32Array(out);
}
function generateConeVertices(radius, height, segments) {
