// === WGSL Shader Sources ===
const WGSL_VERTEX = /* wgsl */\`
struct Uniforms { model: mat4x4<f32> };
struct Camera { viewProj: mat4x4<f32> };
@group(0) @binding(0) var<uniform> u: Uniforms;
@group(0) @binding(2) var<uniform> cam: Camera;
struct VIn { @location(0) pos: vec3<f32>, @location(1) norm: vec3<f32> };
struct VOut { @builtin(position) clip: vec4<f32>, @location(0) wNorm: vec3<f32>, @location(1) wPos: vec3<f32> };
@vertex fn vs_main(i: VIn) -> VOut {
  var o: VOut; let w = u.model * vec4<f32>(i.pos, 1.0);
  o.clip = cam.viewProj * w; o.wNorm = normalize((u.model * vec4<f32>(i.norm, 0.0)).xyz); o.wPos = w.xyz; return o; }\`;

const WGSL_FRAGMENT = /* wgsl */\`
struct Mat { color: vec4<f32>, rm: vec4<f32>, emissive: vec4<f32> };
struct Light { ct: vec4<f32>, posW: vec4<f32>, dirW: vec4<f32> };
struct Lights { count: vec4<f32>, items: array<Light, 4> };
@group(0) @binding(1) var<uniform> mat: Mat;
@group(0) @binding(3) var<uniform> lights: Lights;
struct FIn { @location(0) wNorm: vec3<f32>, @location(1) wPos: vec3<f32> };
@fragment fn fs_main(i: FIn) -> @location(0) vec4<f32> {
  let N = normalize(i.wNorm);
  var acc = vec3<f32>(0.0, 0.0, 0.0);
  let n = i32(lights.count.x);
  for (var k = 0; k < n; k = k + 1) {
    let lt = lights.items[k];
    var L = normalize(-lt.dirW.xyz);
    if (lt.ct.w > 0.5) { L = normalize(lt.posW.xyz - i.wPos); }
    let d = max(dot(N, L), 0.0) * (1.0 - mat.rm[0] * 0.5);
    acc = acc + lt.ct.rgb * d;
  }
  let lit = mat.color.rgb * (0.15 + acc);
  let emit = mat.emissive.rgb * mat.rm[2];
  return vec4<f32>(lit + emit, mat.color.a); }\`;

const WGSL_SPLAT = /* wgsl */\`
struct Splat { center: vec3<f32>, opacity: f32, cov: array<f32,6>, sh: vec3<f32> };
@group(0) @binding(0) var<storage, read> splats: array<Splat>;
struct SO { @builtin(position) p: vec4<f32>, @location(0) c: vec4<f32>, @location(1) uv: vec2<f32> };
@vertex fn vs_splat(@builtin(vertex_index) vi: u32, @builtin(instance_index) ii: u32) -> SO {
  var q = array<vec2<f32>,4>(vec2(-1,-1),vec2(1,-1),vec2(-1,1),vec2(1,1));
  var o: SO; let s = splats[ii]; o.p = vec4<f32>(s.center.xy + q[vi]*0.01, s.center[2], 1.0);
  o.c = vec4<f32>(s.sh, s.opacity); o.uv = q[vi]; return o; }
@fragment fn fs_splat(i: SO) -> @location(0) vec4<f32> {
  let a = i.c.a * exp(-dot(i.uv, i.uv) * 4.0); if (a < 0.01) { discard; }
  return vec4<f32>(i.c.rgb * a, a); }\`;

const WGSL_POINT = /* wgsl */\`
struct PO { @builtin(position) p: vec4<f32>, @location(0) c: vec4<f32> };
@vertex fn vs_point(@location(0) pos: vec3<f32>, @location(1) col: vec4<f32>) -> PO { var o: PO; o.p = vec4<f32>(pos, 1.0); o.c = col; return o; }
@fragment fn fs_point(i: PO) -> @location(0) vec4<f32> { return i.c; }\`;

const WGSL_PARTICLE_RENDER = /* wgsl */\`
struct PVO { @builtin(position) p: vec4<f32>, @location(0) life: f32 };
@vertex fn vs_particle(@location(0) pos: vec3<f32>, @location(1) vel: vec3<f32>, @location(2) life: f32) -> PVO { var o: PVO; o.p = vec4<f32>(pos, 1.0); o.life = life; return o; }
@fragment fn fs_particle(i: PVO) -> @location(0) vec4<f32> {
  let t = clamp(i.life, 0.0, 1.0); return vec4<f32>(mix(vec3(1.0,0.2,0.0), vec3(1.0,1.0,0.5), t), t*0.8); }\`;

const WGSL_SCATTER = /* wgsl */\`
struct VIn { @location(0) pos: vec3<f32>, @location(1) norm: vec3<f32> };
struct VOut { @builtin(position) clip: vec4<f32>, @location(0) shade: f32 };
fn hash11(v: f32) -> f32 { return fract(sin(v * 12.9898) * 43758.5453); }
@vertex fn vs_scatter(i: VIn, @builtin(instance_index) instance: u32) -> VOut {
  let id = f32(instance);
  let x = hash11(id + 1.0) * 1.8 - 0.9; let z = hash11(id + 7.0) * 1.8 - 0.9;
  let scale = 0.35 + hash11(id + 13.0) * 0.45;
  var o: VOut; o.clip = vec4<f32>(i.pos.x * scale + x, i.pos.y * scale - 0.65, i.pos.z * scale + z, 1.0);
  o.shade = 0.45 + max(i.norm.y, 0.0) * 0.45; return o; }
@fragment fn fs_scatter(i: VOut) -> @location(0) vec4<f32> { return vec4<f32>(0.08 * i.shade, 0.34 * i.shade, 0.12 * i.shade, 1.0); }\`;

const WGSL_POSTFX = /* wgsl */\`
struct VO { @builtin(position) pos: vec4<f32> };
@vertex fn vs_postfx(@builtin(vertex_index) vi: u32) -> VO {
  var p = array<vec2<f32>,3>(vec2(-1.0,-1.0), vec2(3.0,-1.0), vec2(-1.0,3.0));
  var o: VO; o.pos = vec4<f32>(p[vi], 0.0, 1.0); return o; }
@fragment fn fs_postfx() -> @location(0) vec4<f32> { return vec4<f32>(0.04, 0.08, 0.05, 0.18); }\`;

const WGSL_PARTICLE_COMPUTE = /* wgsl */\`
struct P { pos: vec3<f32>, _p0: f32, vel: vec3<f32>, life: f32 };
@group(0) @binding(0) var<storage, read> pin: array<P>;
@group(0) @binding(1) var<storage, read_write> pout: array<P>;
@group(0) @binding(2) var<uniform> dt: f32;
@compute @workgroup_size(64) fn cs_particle_update(@builtin(global_invocation_id) gid: vec3<u32>) {
  let i = gid[0]; if (i >= arrayLength(&pin)) { return; } var p = pin[i];
  p.vel[1] -= 9.81 * dt; p.pos += p.vel * dt; p.life -= dt;
  if (p.life <= 0.0) { p.pos = vec3(0.0); p.vel = vec3(0.0, 5.0, 0.0); p.life = 2.0; }
  pout[i] = p; }\`;

const WGSL_PHYSICS_COMPUTE = /* wgsl */\`
struct Body { pos: vec3<f32>, mass: f32, vel: vec3<f32>, _p: f32 };
@group(0) @binding(0) var<storage, read_write> bodies: array<Body>;
@group(0) @binding(1) var<uniform> dt: f32;
@compute @workgroup_size(64) fn cs_physics_step(@builtin(global_invocation_id) gid: vec3<u32>) {
  let i = gid[0]; if (i >= arrayLength(&bodies)) { return; } var b = bodies[i];
