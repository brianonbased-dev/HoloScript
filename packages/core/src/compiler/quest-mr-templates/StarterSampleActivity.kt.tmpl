/** What to do with a scanned payload: OPEN it in the Quest browser, or COPY it to the clipboard. */
enum class QrAction { OPEN, COPY }

/** A classified QR payload: its content kind, the result-card label, and the primary action. */
data class QrContent(val kind: String, val label: String, val action: QrAction)

/** Host-library facts consumed by the HoloScript admission decision. Kept Android-free for JVM tests. */
internal object QrPayloadFacts {
  private fun normalizedLines(text: String): List<String> =
      text.replace("\r\n", "\n").replace('\r', '\n').split('\n')

  private fun validStructuredEnvelope(
      text: String,
      begin: String,
      end: String,
  ): Boolean {
    val lines = normalizedLines(text)
    return lines.size >= 3 &&
        lines.first().trim().equals(begin, ignoreCase = true) &&
        lines.last().trim().equals(end, ignoreCase = true) &&
        lines.subList(1, lines.lastIndex).all { line ->
          val separator = line.indexOf(':')
          separator > 0 && separator < line.lastIndex
        }
  }

  fun structuredMultiline(text: String): Boolean {
    val trimmed = text.trim()
    return trimmed.startsWith("BEGIN:VCARD", ignoreCase = true) ||
        trimmed.startsWith("BEGIN:VEVENT", ignoreCase = true)
  }

  fun controlsSafe(text: String): Boolean {
    val structured = structuredMultiline(text)
    return text.all { ch ->
      !Character.isISOControl(ch) ||
          (structured && (ch == '\n' || ch == '\r' || ch == '\t'))
    }
  }

  fun syntaxSafe(text: String): Boolean {
    val trimmed = text.trim()
    if (trimmed.startsWith("BEGIN:VCARD", ignoreCase = true)) {
      return validStructuredEnvelope(trimmed, "BEGIN:VCARD", "END:VCARD")
    }
    if (trimmed.startsWith("BEGIN:VEVENT", ignoreCase = true)) {
      return validStructuredEnvelope(trimmed, "BEGIN:VEVENT", "END:VEVENT")
    }
    val declaresWebScheme =
        trimmed.startsWith("http:", ignoreCase = true) ||
            trimmed.startsWith("https:", ignoreCase = true)
    if (!declaresWebScheme) return true
    val uri = try { URI(trimmed).parseServerAuthority() } catch (_: Exception) { return false }
    val validPort = uri.port == -1 || uri.port in 1..65535
    return (uri.scheme.equals("http", true) || uri.scheme.equals("https", true)) &&
        !uri.host.isNullOrBlank() &&
        uri.userInfo == null &&
        validPort
  }
}

