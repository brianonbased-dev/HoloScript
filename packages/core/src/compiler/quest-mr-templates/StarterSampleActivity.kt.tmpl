  /** A short confirmation beep on a successful decode (reuses one ToneGenerator). */
  private fun playScanTone() {
    try {
      val tg = toneGen ?: ToneGenerator(AudioManager.STREAM_MUSIC, 80).also { toneGen = it }
      tg.startTone(ToneGenerator.TONE_PROP_BEEP, 150)
    } catch (e: Exception) {
      Log.w(tag, "scan tone failed: ${e.message}")
    }
  }

  /** Load the language-declared URL collection, migrating the legacy newline form once. */
  private fun loadBookmarks(prefs: SharedPreferences): List<String> {
    val encoded = prefs.getString(PREFS_BOOKMARKS, "") ?: ""
    val raw = mutableListOf<String>()
    try {
      if (encoded.trimStart().startsWith("[")) {
        val array = JSONArray(encoded)
        for (index in 0 until array.length()) raw += array.optString(index)
      } else {
        raw += encoded.split("\n")
      }
    } catch (_: Exception) {
      return emptyList()
    }
    val valid = raw.filter(::isSafeBookmarkUrl)
    val normalized = if (BOOKMARK_DEDUPLICATE) valid.distinct() else valid
    return normalized.take(MAX_BOOKMARKS)
  }

  private fun isSafeBookmarkUrl(value: String): Boolean {
    if (value.isBlank() || value.any(Character::isISOControl)) return false
    val uri = try { Uri.parse(value) } catch (_: Exception) { return false }
    return (uri.scheme.equals("http", true) || uri.scheme.equals("https", true)) &&
        !uri.host.isNullOrBlank()
  }

  /** Persist the bookmark list as a JSON array in app-private SharedPreferences. */
  private fun saveBookmarks(list: List<String>) {
    if (!BOOKMARKS_ENABLED) return
    try {
      val prefs: SharedPreferences = getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE)
      val encoded = JSONArray()
      list.take(MAX_BOOKMARKS).filter(::isSafeBookmarkUrl).forEach { encoded.put(it) }
      prefs.edit().putString(PREFS_BOOKMARKS, encoded.toString()).apply()
    } catch (e: Exception) {
      Log.w(tag, "save bookmarks failed: ${e.message}")
    }
  }

  /** Copy a non-link result (Wi-Fi, contact, text, …) to the clipboard so the user can use it. */
  private fun copyToClipboard(text: String) {
    try {
      val cm =
          getSystemService(android.content.Context.CLIPBOARD_SERVICE)
              as android.content.ClipboardManager
      cm.setPrimaryClip(android.content.ClipData.newPlainText("QR", text))
      ScannerState.status = "Copied"
    } catch (e: Exception) {
      Log.w(tag, "clipboard failed: ${e.message}")
    }
  }

  private fun hasCameraPermission(): Boolean =
      checkSelfPermission(cameraPermission) == PackageManager.PERMISSION_GRANTED

  override fun onRequestPermissionsResult(
      requestCode: Int,
      permissions: Array<out String>,
      grantResults: IntArray,
  ) {
    super.onRequestPermissionsResult(requestCode, permissions, grantResults)
    if (requestCode == REQUEST_CAMERA &&
        grantResults.isNotEmpty() &&
        grantResults[0] == PackageManager.PERMISSION_GRANTED) {
      maybeStartScanner()
    } else if (requestCode == REQUEST_CAMERA) {
      ScannerState.status = "Camera permission denied. Enable “Headset cameras” to scan."
    }
  }

  override fun onSpatialShutdown() {
    controller?.stop()
    controller = null
    toneGen?.release()
    toneGen = null
    super.onSpatialShutdown()
  }

