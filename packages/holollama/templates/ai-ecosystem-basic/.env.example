# Public HoloLlama harness example. Copy to .env locally and fill only what you use.

HOLOLLAMA_PROFILE=jetson-orin
HOLOLLAMA_ENDPOINT=http://127.0.0.1:18080
HOLOLLAMA_TEAM_ID=local-team

# Optional remote integrations.
HOLOSCRIPT_MCP_URL=https://mcp.holoscript.net/mcp
HOLOMESH_ORCHESTRATOR_URL=https://mcp-orchestrator-production-45f9.up.railway.app

# Secrets are local only. Do not commit filled values.
HOLOSCRIPT_MCP_API_KEY=
HOLOSCRIPT_API_KEY=

