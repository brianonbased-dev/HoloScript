{
  "name": "@holoscript/holollama",
  "version": "0.1.0",
  "description": "Native HoloScript utilities for planning and operating llama.cpp HoloLlama serving nodes.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "holollama": "./bin/holollama.cjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "dependencies": {
    "@holoscript/core": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsup": "^8.0.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "holoscript",
    "holollama",
    "llama.cpp",
    "local-llm",
    "jetson",
    "mcp"
  ],
  "license": "MIT",
  "author": "Brian X Base Team",
  "homepage": "https://github.com/brianonbased-dev/HoloScript#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/brianonbased-dev/HoloScript.git",
    "directory": "packages/holollama"
  },
  "bugs": {
    "url": "https://github.com/brianonbased-dev/HoloScript/issues"
  }
}
