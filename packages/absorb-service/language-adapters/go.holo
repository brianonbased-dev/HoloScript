@language_adapter {
  id: "go"
  language: "go"
  grammarPackage: "tree-sitter-go"
  extensions: [".go"]
  symbols: [
    {
      nodeType: "function_declaration",
      kind: "function",
      nameField: "name",
      exportedByCapitalization: true,
      signatureTemplate: "func {name}({field:parameters}){?field:result: {field:result}}"
    },
    {
      nodeType: "method_declaration",
      kind: "method",
      nameField: "name",
      ownerFromField: {
        field: "receiver",
        childType: "parameter_declaration",
        typeField: "type",
        stripPrefix: "*"
      },
      signatureTemplate: "func ({field:receiver}) {name}({field:parameters})"
    },
    {
      nodeType: "type_declaration",
      kind: "type_alias",
      specChild: "type_spec",
      nameField: "name",
      exportedByCapitalization: true,
      kindByChildType: {
        field: "type",
        map: { struct_type: "struct", interface_type: "interface" },
        fallback: "type_alias"
      },
      fields: {
        whenChildType: "struct_type",
        listType: "field_declaration_list",
        itemType: "field_declaration",
        nameField: "name",
        kind: "field"
      },
      signatureTemplate: "type {name} {kindWord:type}"
    },
    {
      nodeType: "const_declaration",
      kind: "constant",
      specChild: "const_spec",
      nameField: "name",
      exportedByCapitalization: true,
      noSignature: true
    },
    {
      nodeType: "var_declaration",
      kind: "constant",
      specChild: "var_spec",
      nameField: "name",
      exportedByCapitalization: true,
      noSignature: true
    }
  ]
  pathImports: [
    {
      declNodeType: "import_declaration",
      specNodeType: "import_spec",
      specListNodeType: "import_spec_list",
      pathField: "path"
    }
  ]
  calls: [
    {
      callNodeType: "call_expression",
      functionField: "function",
      selector: {
        nodeType: "selector_expression",
        ownerField: "operand",
        nameField: "field",
        bareType: "identifier"
      }
    }
  ]
}
