@language_adapter {
  id: "csharp"
  language: "csharp"
  grammarPackage: "tree-sitter-c-sharp"
  extensions: [".cs"]
  symbols: [
    {
      nodeType: "class_declaration",
      kind: "class",
      nameField: "name",
      container: true,
      signatureTemplate: "class {name}"
    },
    {
      nodeType: "interface_declaration",
      kind: "interface",
      nameField: "name",
      container: true,
      signatureTemplate: "interface {name}"
    },
    {
      nodeType: "struct_declaration",
      kind: "struct",
      nameField: "name",
      container: true,
      signatureTemplate: "struct {name}"
    },
    {
      nodeType: "enum_declaration",
      kind: "enum",
      nameField: "name",
      noSignature: true
    },
    {
      nodeType: "method_declaration",
      kind: "method",
      nameField: "name",
      signatureTemplate: "{name}({field:parameters})"
    },
    {
      nodeType: "constructor_declaration",
      kind: "method",
      nameField: "name",
      signatureTemplate: "{name}({field:parameters})"
    }
  ]
  moduleImports: [
    {
      declNodeType: "using_directive",
      moduleChildTypes: ["identifier", "qualified_name"]
    }
  ]
  calls: [
    {
      callNodeType: "invocation_expression",
      functionField: "function",
      selector: {
        nodeType: "member_access_expression",
        ownerField: "expression",
        nameField: "name",
        bareType: "identifier"
      }
    }
  ]
}
