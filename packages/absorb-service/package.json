{
  "name": "@holoscript/absorb-service",
  "version": "6.1.2",
  "description": "Codebase intelligence, recursive self-improvement pipeline, and daemon system for HoloScript",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.map",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./engine": {
      "types": "./dist/engine/index.d.ts",
      "import": "./dist/engine/index.js",
      "require": "./dist/engine/index.cjs"
    },
    "./ingest": {
      "types": "./dist/ingest/index.d.ts",
      "import": "./dist/ingest/index.js",
      "require": "./dist/ingest/index.cjs"
    },
    "./gev": {
      "types": "./dist/gev/index.d.ts",
      "import": "./dist/gev/index.js",
      "require": "./dist/gev/index.cjs"
    },
    "./holoabsorb": {
      "types": "./dist/holoabsorb/index.d.ts",
      "import": "./dist/holoabsorb/index.js",
      "require": "./dist/holoabsorb/index.cjs"
    },
    "./pipeline": {
      "types": "./dist/pipeline/index.d.ts",
      "import": "./dist/pipeline/index.js",
      "require": "./dist/pipeline/index.cjs"
    },
    "./daemon": {
      "types": "./dist/daemon/index.d.ts",
      "import": "./dist/daemon/index.js",
      "require": "./dist/daemon/index.cjs"
    },
    "./self-improvement": {
      "types": "./dist/self-improvement/index.d.ts",
      "import": "./dist/self-improvement/index.js",
      "require": "./dist/self-improvement/index.cjs"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js",
      "require": "./dist/mcp/index.cjs"
    },
    "./credits": {
      "types": "./dist/credits/index.d.ts",
      "import": "./dist/credits/index.js",
      "require": "./dist/credits/index.cjs"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js",
      "require": "./dist/schema.cjs"
    },
    "./bridge": {
      "types": "./dist/bridge.d.ts",
      "import": "./dist/bridge.js",
      "require": "./dist/bridge.cjs"
    }
  },
  "scripts": {
    "start": "node --max-old-space-size=8192 dist/index.js",
    "build": "tsup",
    "dev": "tsup --watch",
    "self-improve": "tsx src/self-improvement/run-self-improve.ts",
    "self-improve:targets": "tsx src/self-improvement/run-self-improve.ts --targets-only",
    "test": "vitest run --passWithNoTests --maxWorkers=4",
    "audit:holoabsorb": "node scripts/audit-holoabsorb.mjs",
    "audit:paper5-visual-v4": "node scripts/audit-paper-5-visual-v4.mjs",
    "benchmark:holoabsorb": "node scripts/bench-holoabsorb.mjs",
    "benchmark:holoabsorb-checkpoints": "node scripts/bench-holoabsorb-checkpoint-retention.mjs",
    "benchmark:holoabsorb-hybrid": "node scripts/bench-holoabsorb-hybrid.mjs",
    "benchmark:holoabsorb-refresh": "node scripts/bench-holoabsorb-refresh.mjs",
    "benchmark:holoabsorb-transport": "node scripts/bench-holoabsorb-transport.mjs",
    "benchmark:paper5-visual-agent": "node scripts/bench-paper-5-visual-agent-study.mjs",
    "execute:paper5-visual-v4": "node scripts/execute-paper-5-visual-v4.mjs",
    "prepare:paper5-visual-v4": "node scripts/prepare-paper-5-visual-v4.mjs",
    "generate:language-registry": "tsx scripts/check-language-registry.mjs --write",
    "check:language-registry": "tsx scripts/check-language-registry.mjs",
    "generate:language-traits": "tsx scripts/gen-language-traits.mjs",
    "check:language-traits": "tsx scripts/gen-language-traits.mjs --check",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --passWithNoTests --maxWorkers=4"
  },
  "keywords": [
    "holoscript",
    "codebase",
    "intelligence",
    "absorb",
    "pipeline",
    "self-improvement",
    "daemon",
    "graph-rag",
    "gev",
    "holoembed",
    "holograph"
  ],
  "author": "Brian X Base Team",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://github.com/brianonbased-dev/HoloScript#readme",
  "bugs": {
    "url": "https://github.com/brianonbased-dev/HoloScript/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/brianonbased-dev/HoloScript.git",
    "directory": "packages/absorb-service"
  },
  "dependencies": {
    "@holoscript/core": "workspace:^",
    "@holoscript/config": "workspace:^",
    "@holoscript/holoembed": "workspace:^",
    "@holoscript/holollama": "workspace:^",
    "@holoscript/llm-provider": "workspace:^",
    "@holoscript/meaning": "workspace:^",
    "@holoscript/uaal": "workspace:^",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vitest/coverage-v8": "^4.1.5",
    "drizzle-orm": ">=0.45.2",
    "eslint": "^9.39.1",
    "openai": "^6.32.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.5",
    "zod": "^4.3.6"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^3.8.1",
    "tree-sitter": "0.22.4",
    "tree-sitter-c-sharp": "0.23.1",
    "tree-sitter-cpp": "^0.23.4",
    "tree-sitter-go": "^0.23.4",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.23.1",
    "tree-sitter-kotlin": "^0.3.8",
    "tree-sitter-php": "^0.23.12",
    "tree-sitter-python": "^0.23.6",
    "tree-sitter-ruby": "^0.23.1",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-swift": "^0.7.0",
    "tree-sitter-typescript": "^0.23.2",
    "web-tree-sitter": "^0.24.0"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsup": "^8.0.1"
  }
}
