// @python_adapter — tree-sitter language adapter for Python source files.
//
// Native .hsplus surface for PythonAdapter.ts (absorb-service/engine/adapters).
//
// Extracts symbols, imports, and call edges from Python source via tree-sitter-python.
//
// PythonAdapter (PythonAdapter.ts):
//   language: "python"
//   extensions: [".py", ".pyi"]
//   grammar: "tree-sitter-python"
//
// Extracted symbol types:
//   class_definition (+ extractMethods for nested methods)
//   function_definition (module-level and class methods)
//   decorated_definition (@decorator support)
//   assignment (module-level variable assignments)
//
// Visibility convention:
//   _private  → private
//   __dunder__ → private (dunder methods)
//   public    → no underscore prefix

@trait python_adapter {
  capability_tags: ["python_adapter", "tree_sitter", "language_adapter", "python", "absorb_service"]

  @on_spawn => {
    adapter = init_python_adapter()
    emit("python_adapter_ready", {
      language: "python",
      extensions: [".py", ".pyi"]
    })
  }

  @on_extract_symbols(tree, file_path) => {
    symbols = adapter.extract_symbols(tree, file_path)
    return symbols
  }

  @on_extract_imports(tree, file_path) => {
    return adapter.extract_imports(tree, file_path)
  }

  @on_extract_calls(tree, file_path) => {
    return adapter.extract_calls(tree, file_path)
  }

  @receipt python_adapter_config {
    type: "PythonAdapterReceipt"
    language: "python"
    extensions: [".py", ".pyi"]
    grammar: "tree-sitter-python"
    visibility_rule: "_name=private; __dunder__=private; no prefix=public"
    timestamp: now()
  }
}
