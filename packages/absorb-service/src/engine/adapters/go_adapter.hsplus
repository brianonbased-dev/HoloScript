// @go_adapter — tree-sitter language adapter for Go source files.
//
// Native .hsplus surface for GoAdapter.ts (absorb-service/engine/adapters).
//
// Extracts symbols, imports, and call edges from Go source via tree-sitter-go.
// Go naming convention: uppercase first letter = exported (isExported).
//
// GoAdapter (GoAdapter.ts):
//   language: "go"
//   extensions: [".go"]
//   grammar: "tree-sitter-go"
//
// Extracted symbol types: function, method, struct, interface, type_alias, const, var
// Visibility: goVisibility(name) — uppercase = public, lowercase = private
//
// Extracted import forms: standard ("fmt"), qualified ("pkg/sub")
// Call extraction: call_expression → selector_expression

@trait go_adapter {
  capability_tags: ["go_adapter", "tree_sitter", "language_adapter", "go", "absorb_service"]

  @on_spawn => {
    adapter = init_go_adapter()
    emit("go_adapter_ready", {
      language: "go",
      extensions: [".go"]
    })
  }

  @on_extract_symbols(tree, file_path) => {
    symbols = adapter.extract_symbols(tree, file_path)
    return symbols
  }

  @on_extract_imports(tree, file_path) => {
    return adapter.extract_imports(tree, file_path)
  }

  @on_extract_calls(tree, file_path) => {
    return adapter.extract_calls(tree, file_path)
  }

  @receipt go_adapter_config {
    type: "GoAdapterReceipt"
    language: "go"
    extensions: [".go"]
    grammar: "tree-sitter-go"
    visibility_rule: "uppercase first letter = public/exported; lowercase = private"
    timestamp: now()
  }
}
