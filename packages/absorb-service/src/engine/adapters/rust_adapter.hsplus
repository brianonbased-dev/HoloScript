// @rust_adapter — tree-sitter language adapter for Rust source files.
//
// Native .hsplus surface for RustAdapter.ts (absorb-service/engine/adapters).
//
// Extracts symbols, imports, and call edges from Rust source via tree-sitter-rust.
//
// RustAdapter (RustAdapter.ts):
//   language: "rust"
//   extensions: [".rs"]
//   grammar: "tree-sitter-rust"
//
// Extracted symbol types:
//   struct_item (hasModifier pub → public)
//   enum_item, fn_item, trait_item, impl_item, use_item
//   const_item, static_item, type_alias_item
//
// Visibility: `pub` modifier = public; absence = private
// Uses hasModifier(node, 'pub') from BaseAdapter

@trait rust_adapter {
  capability_tags: ["rust_adapter", "tree_sitter", "language_adapter", "rust", "absorb_service"]

  @on_spawn => {
    adapter = init_rust_adapter()
    emit("rust_adapter_ready", {
      language: "rust",
      extensions: [".rs"]
    })
  }

  @on_extract_symbols(tree, file_path) => {
    symbols = adapter.extract_symbols(tree, file_path)
    return symbols
  }

  @on_extract_imports(tree, file_path) => {
    return adapter.extract_imports(tree, file_path)
  }

  @on_extract_calls(tree, file_path) => {
    return adapter.extract_calls(tree, file_path)
  }

  @receipt rust_adapter_config {
    type: "RustAdapterReceipt"
    language: "rust"
    extensions: [".rs"]
    grammar: "tree-sitter-rust"
    visibility_rule: "pub modifier = public; no modifier = private"
    timestamp: now()
  }
}
