// @holoembed_provider -- Absorb GraphRAG adapter for @holoscript/holoembed.
//
// Native .hsplus surface for HoloEmbedProvider.ts (absorb-service/engine/providers).
//
// Vector math is canonical in @holoscript/holoembed. Absorb keeps only the
// EmbeddingProvider and ExternalSymbolDefinition adapter so GraphRAG, HoloEmbed,
// and GEV stay in one embedding space.

composition "AbsorbHoloEmbedProviderSurface" {
  module AbsorbHoloEmbedProvider {
    state {
      provider: "holoembed"
      canonical_encoder: "@holoscript/holoembed/HoloEmbedEncoder"
      embedding_dim: 768
      structural_weight: 0.12
      weight_semantic_aliases: true
      capability_tags: [
        "holoembed_provider",
        "768_dim_embeddings",
        "graph_rag",
        "nl_to_code",
        "absorb_service",
        "canonical_holoembed",
        "gev"
      ]
    }

    action initialize() {
      emit("holoembed_provider_ready", {
        provider: this.state.provider,
        dim: this.state.embedding_dim,
        canonical_encoder: this.state.canonical_encoder
      });

      return {
        provider: this.state.provider,
        embedding_dim: this.state.embedding_dim,
        structural_weight: this.state.structural_weight,
        no_external_key: true
      };
    }

    action get_embeddings(texts) {
      emit("holoembed_text_batch_requested", {
        texts: texts,
        embedding_dim: this.state.embedding_dim
      });

      return {
        input: "string_array",
        output: "number_matrix",
        encoder_method: "HoloEmbedEncoder.encodeText"
      };
    }

    action embed_symbol(symbol, graph_enrichment) {
      emit("holoembed_symbol_requested", {
        symbol: symbol,
        graph_enrichment: graph_enrichment,
        embedding_dim: this.state.embedding_dim
      });

      return {
        input: "ExternalSymbolDefinition",
        enrichment: "GraphEnrichment",
        output: "Float32Array",
        encoder_method: "HoloEmbedEncoder.encode"
      };
    }

    action receipt() {
      return {
        type: "HoloEmbedProviderReceipt",
        provider: this.state.provider,
        canonical_encoder: this.state.canonical_encoder,
        dim: this.state.embedding_dim,
        structural_weight: this.state.structural_weight,
        layout: {
          structural_dims: "0-383",
          trigram_name_dims: "384-511",
          trigram_doc_dims: "512-639",
          trigram_event_dims: "640-767"
        },
        adapter_only: true,
        timestamp: current_time()
      };
    }

    exports { initialize, get_embeddings, embed_symbol, receipt, state }
  }
}
