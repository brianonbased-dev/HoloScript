// @graph_selection_manager — Multi-select state for interactive codebase graph visualization.
//
// Native .hsplus surface for GraphSelectionManager.ts (absorb-service/engine/visualization).
//
// Manages additive selection, subgraph extraction, context generation for
// AI queries, and N-hop neighborhood expansion.
//
// GraphSelectionManager (GraphSelectionManager.ts):
//   selectedIds: Set<String>  — current multi-selection
//
// SelectionSubgraph { nodes, edges, symbols, unresolved_node_ids }
// SelectionContext  { text, symbol_count, file_count, communities, visual_focus }
// VisualGraphFocusReceipt {
//   selected_node_ids, selected_symbol_keys, selected_files, selected_communities,
//   neighbor_node_ids, unresolved_node_ids, citations, selected_edge_count,
//   resolution_rate
// }
//
// Scene node IDs are collision-safe identities (symbol__stable_hash). A visible
// selection must resolve by that identity and file:line provenance, never by
// taking the first same-name symbol in the graph.
//
// Operations:
//   select(nodeId)           → Bool (true if newly added)
//   deselect(nodeId)         → Bool (true if removed)
//   clear()                  → clears all
//   getSubgraph()            → SelectionSubgraph
//   getContext()             → SelectionContext (AI-query-ready text)
//   expandNHops(n)           → adds all nodes within N import/call hops

@trait graph_selection_manager {
  capability_tags: ["graph_selection_manager", "multi_select", "subgraph_extraction", "ai_context", "visual_focus_receipt", "n_hop_expansion", "codebase_visualization", "holoabsorb"]

  @on_spawn(graph_ref) => {
    manager = init_graph_selection_manager(graph_ref)
    emit("graph_selection_manager_ready", {})
  }

  // Select a node; returns true if newly added
  @on_select(node_id) => {
    added = manager.select(node_id)
    if added { emit("node_selected", { node_id: node_id }) }
    return added
  }

  // Deselect a node; returns true if removed
  @on_deselect(node_id) => {
    removed = manager.deselect(node_id)
    if removed { emit("node_deselected", { node_id: node_id }) }
    return removed
  }

  // Clear all selections
  @on_clear => {
    manager.clear()
    emit("selection_cleared", {})
  }

  // Extract a subgraph of selected nodes + their interconnecting edges
  @on_get_subgraph => {
    subgraph = manager.get_subgraph()
    emit("subgraph_extracted", { node_count: subgraph.nodes.size })
    return subgraph
  }

  // Generate AI-query-ready context from current selection
  @on_get_context => {
    ctx = manager.get_context()
    return ctx
  }

  // Convert current visual intent into bounded, cited GraphRAG evidence.
  @on_get_visual_focus(max_neighbors) => {
    focus = manager.get_visual_focus(max_neighbors)
    emit("visual_focus_receipted", {
      resolved: focus.citations.size
      unresolved: focus.unresolved_node_ids.size
      resolution_rate: focus.resolution_rate
    })
    return focus
  }

  // Expand selection by N import/call hops
  @on_expand_n_hops(n) => {
    added_count = manager.expand_n_hops(n)
    emit("selection_expanded", { hops: n, added: added_count })
    return added_count
  }

  @receipt graph_selection_manager_config {
    type: "VisualGraphFocusReceipt"
    schema: "holoscript.holoabsorb.visual-graph-focus.v1"
    edge_types: ["import", "call"]
    identity: "collision-safe scene node plus file:line citation"
    context_use: "explicit visual selection is a bounded GraphRAG scoring signal"
    timestamp: now()
  }
}
