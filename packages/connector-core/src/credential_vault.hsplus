// @credential_vault — Secure credential store interface for external service connectors.
//
// Native .hsplus surface for CredentialVault.ts (connector-core).
//
// CredentialVault interface (CredentialVault.ts):
//   store(key, value)   — store a credential securely
//   retrieve(key)       — retrieve by key (null if not found)
//   revoke(key)         — revoke and destroy a credential
//   refresh(key)        — refresh an expiring token (OAuth etc.)
//
// InMemoryCredentialVault: process-local implementation for TESTS/DEV ONLY.
// Production: wire to HoloKey vault (resolve via secrets-broker).
//
// SECURITY: values stored via this trait MUST flow through HoloKey in production.
// InMemory is structurally unsafe for real secrets (no encryption, no ACL).

@trait credential_vault {
  // Storage backend: "holokey" (production) | "memory" (dev/test only)
  backend: enum("holokey" | "memory") = "holokey"

  capability_tags: ["credential_vault", "secret_storage", "connector_core", "oauth", "holokey_backed"]

  @on_spawn => {
    if backend == "memory" {
      emit("credential_vault_warning", { reason: "InMemory vault is for DEV/TEST only — no encryption" })
    }
    vault = init_credential_vault({ backend: backend })
    emit("credential_vault_ready", { backend: backend })
  }

  // Store a credential (value must come from HoloKey in production — never a literal)
  @on_store(key, value) => {
    vault.store(key, value)
    emit("credential_stored", { key: key })
  }

  @on_retrieve(key) => {
    return vault.retrieve(key)
  }

  @on_revoke(key) => {
    vault.revoke(key)
    emit("credential_revoked", { key: key })
  }

  @on_refresh(key) => {
    return vault.refresh(key)
  }

  @receipt credential_vault_config {
    type: "CredentialVaultReceipt"
    backend: backend
    dev_only_warning: backend == "memory"
    timestamp: now()
  }
}
