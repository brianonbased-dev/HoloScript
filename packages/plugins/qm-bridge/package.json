{
  "name": "@holoscript/qm-bridge",
  "version": "1.0.3",
  "description": "Quantum mechanics bridge plugin for HoloScript. Wraps Psi4 (CCSD molecular), Quantum ESPRESSO (DFT solid-state), TBLite (semi-empirical), IBM Quantum (VQE/QAOA circuits), and PySCF (PBC/materials DFT + OpenFermion Hamiltonian export) under unified SimulationContract scale-tag dispatch.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "plugin.manifest.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "pnpm -w exec vitest run --root packages/plugins/qm-bridge --config vitest.config.ts",
    "lint": "eslint src --ext .ts",
    "clean": "rimraf dist",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "holoscript",
    "plugin",
    "quantum-mechanics",
    "qm-bridge",
    "psi4",
    "quantum-espresso",
    "tblite",
    "dft",
    "computational-chemistry",
    "materials-science",
    "D.026"
  ],
  "author": "brianonbased-dev",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brianonbased-dev/HoloScript.git",
    "directory": "packages/plugins/qm-bridge"
  },
  "homepage": "https://github.com/brianonbased-dev/HoloScript#readme",
  "bugs": {
    "url": "https://github.com/brianonbased-dev/HoloScript/issues"
  },
  "dependencies": {
    "@holoscript/engine": "workspace:^"
  },
  "peerDependencies": {
    "@holoscript/core": ">=8.0.0"
  },
  "devDependencies": {
    "@holoscript/core": "workspace:^",
    "typescript": "^5.0.0",
    "vitest": "^4.1.5"
  }
}
