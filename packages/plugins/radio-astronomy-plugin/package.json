{
  "name": "@holoscript/radio-astronomy-plugin",
  "version": "2.0.4",
  "description": "Radio Astrophysics plugin for HoloScript spatial environments. Adds primitives for interferometers, pulsar analysis, and synchrotron emissions.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "plugin.manifest.json"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "clean": "rimraf dist",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "holoscript",
    "plugin",
    "astrophysics",
    "radio-astronomy",
    "science"
  ],
  "author": "brianonbased-dev",
  "license": "MIT",
  "peerDependencies": {
    "@holoscript/core": ">=8.0.0",
    "@holoscript/engine": ">=6.1.4"
  },
  "peerDependenciesMeta": {
    "@holoscript/engine": {
      "optional": true
    }
  },
  "devDependencies": {
    "@holoscript/engine": "workspace:*",
    "typescript": "^5.0.0",
    "vitest": "^4.1.5"
  }
}
