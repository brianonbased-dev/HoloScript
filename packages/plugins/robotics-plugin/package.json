{
  "name": "@holoscript/robotics-plugin",
  "version": "2.0.3",
  "description": "HoloScript plugin for robotics: compile-time USD/URDF codegen + runtime ROS2/Gazebo integration. VR robot programming and digital twins.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "plugin.manifest.json"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "clean": "rimraf dist",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "holoscript",
    "plugin",
    "robotics",
    "ros2",
    "gazebo",
    "urdf",
    "usd",
    "vr",
    "digital-twin"
  ],
  "author": "HoloScript Contributors",
  "license": "MIT",
  "peerDependencies": {
    "@holoscript/core": ">=8.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@holoscript/core": "workspace:*"
  }
}
