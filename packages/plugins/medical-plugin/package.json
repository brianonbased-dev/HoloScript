{
  "name": "@holoscript/medical-plugin",
  "version": "2.0.3",
  "description": "DICOM medical imaging and surgical simulation for HoloScript - VR medical training. THIN: DICOM viewer and surgical interfaces are type-only stubs; only clinical calculators are implemented.",
  "releaseLane": "v0-preview",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "plugin.manifest.json",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --sourcemap --external @holoscript/core",
    "test": "vitest run",
    "clean": "rimraf dist",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "holoscript",
    "plugin",
    "medical",
    "dicom",
    "surgical",
    "vr",
    "healthcare"
  ],
  "author": "HoloScript Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brianonbased-dev/HoloScript.git",
    "directory": "packages/plugins/medical-plugin"
  },
  "peerDependencies": {
    "@holoscript/core": ">=8.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
