// @delegated_authority — declares an entity's scope tier and autonomy limits.
//
// Maps to the delegated-authority module (delegated-authority.ts) and the
// sovereign seat hierarchy (D.051: T0>T1>T2>T3). Every agent entity that
// makes decisions should carry this trait so its autonomy is expressed as
// data, not code — the trait becomes the authoritative record consulted by
// the runner's DECIDE→EXECUTE→ANNOUNCE loop.
//
// Scope tier semantics (D.051):
//   T0 = Joseph decision lane — exact-four protected classes only
//   T1 = Senior agent — cross-team decisions and architecture within active rails
//   T2 = Agent — within-team decisions, local mutations, reversible ops
//   T3 = Observer — read-only, can propose but not execute
//
// Joseph review is limited to the exact four protected classes:
//   1. Spend beyond an active rail, or treasury-master/Trezor recovery,
//      new-wallet, custody/mint authority, or permanent seat-wallet mutation
//   2. Physical-world commitment requiring Joseph body/signature/presence
//   3. Public commitment under Joseph name/face/voice
//   4. Governance-tier founder-authority or escalation-criteria mutation
// Legal/export/compliance/IRB/privacy routes to specialists. Missing tools or
// credentials route to platform controls. Force-push and hard-reset are
// prohibited and replanned; neither is Joseph-approvable.
//
// Usage:
//   entity#my_agent @delegated_authority(
//     scope_tier: "t2"
//     can_push_to_main: true
//     can_sign_wallet_ops: true
//   ) { ... }

@trait delegated_authority {
  // Scope tier per D.051 sovereign seat hierarchy
  scope_tier: enum("t0" | "t1" | "t2" | "t3") = "t2"

  // Whether this entity may commit and push to main (F.089: direct to main)
  can_push_to_main: Bool = true

  // Whether this entity may sign and broadcast wallet ops (up to daily cap)
  can_sign_wallet_ops: Bool = false

  // Required active wallet/on-chain rail in USD
  wallet_daily_cap_usd: Float

  // Required active paid-GPU rail in USD (owned local fleet remains free)
  gpu_daily_cap_usd: Float

  // Typed router keeps Joseph, specialist, platform, and prohibited paths separate
  escalation_target: String = "authority_router"

  capability_tags: ["delegated_authority", "scope_tier", "autonomy_policy", "exact_four_aware", "typed_authority_routes"]

  @on_spawn => {
    register_authority({
      scope_tier: scope_tier,
      can_push_to_main: can_push_to_main,
      can_sign_wallet_ops: can_sign_wallet_ops,
      wallet_daily_cap_usd: wallet_daily_cap_usd,
      gpu_daily_cap_usd: gpu_daily_cap_usd,
      escalation_target: escalation_target
    })
    emit("authority_registered", {
      scope_tier: scope_tier,
      can_push_to_main: can_push_to_main,
      can_sign_wallet_ops: can_sign_wallet_ops
    })
  }

  @on_action_check(action) => {
    decision = classify_authority(action, scope_tier, {
      wallet_daily_cap_usd: wallet_daily_cap_usd,
      gpu_daily_cap_usd: gpu_daily_cap_usd
    })
    if decision.route == "prohibited_replan" {
      emit("authority_operation_prohibited", {
        action: action.type,
        reason: decision.reason
      })
      return replan_action(action, decision.reason)
    }
    if decision.route == "specialist_review" {
      emit("authority_specialist_review_required", {
        action: action.type,
        specialty: decision.specialty,
        reason: decision.reason
      })
      return route_to_specialist(action, decision.specialty)
    }
    if decision.route == "platform_control" {
      emit("authority_platform_control_required", {
        action: action.type,
        reason: decision.reason
      })
      return { proceed: false, route: "platform_control", reason: decision.reason }
    }
    if decision.route == "joseph_exact_four" {
      emit("authority_joseph_decision_required", {
        action: action.type,
        protected_class: decision.protected_class,
        escalation_target: escalation_target
      })
      return { proceed: false, route: "joseph_exact_four", reason: decision.reason }
    }
    return { proceed: true, route: "autonomous", reason: decision.reason }
  }

  @receipt authority_grant {
    type: "DelegatedAuthorityReceipt"
    scope_tier: scope_tier
    can_push_to_main: can_push_to_main
    can_sign_wallet_ops: can_sign_wallet_ops
    wallet_daily_cap_usd: wallet_daily_cap_usd
    gpu_daily_cap_usd: gpu_daily_cap_usd
    timestamp: now()
  }
}
