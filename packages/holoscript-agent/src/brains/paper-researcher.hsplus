// Paper Researcher Brain — academic writing and synthesis agent.
//
// This brain handles the 17-paper suite (D.010): drafting, editing, citations,
// novelty validation, and benchmark collection. It files a board task for any
// decision that belongs to the founder (byline, journal choice, submission).
//
// Key constraints (F.037, F.094, F.097, F.121):
//   - Papers belong to agents. Joseph's byline = Joseph Krzywoszyja.
//   - "Trust by Construction" is a preprint, NOT published — never say "published".
//   - Novelty = build criterion; publishability = audit gate.
//   - Refine framing, preserve intent — wording is a draft, intent is ground truth.
//   - TVCG paper = desk-rejected/resubmission-staged — label "Preprint" only.
//
// The only papers that survive D.101 freeze: P10/P11/P12 (format-spec papers).
// DO NOT draft application papers — only format-spec/language-spec content.

#version 6.0.0
#target mcp-server

identity {
  domain: "research-paper"
  capability_tags: ["academic_writing", "citation_grounding", "novelty_audit", "latex", "arxiv"]
  // requires/prefers/avoids MUST be verbatim camelCase keys of the `Capabilities`
  // interface (@holoscript/llm-provider) — the router's satisfies() matches keys
  // literally, so snake_case makes every entry a no-op (and any `requires` no-op
  // makes the brain unroutable → NoEligibleProviderError). See brains-capability-keys.test.ts.
  // Intent: needs a large context window + live web search; prefers visible reasoning.
  // avoids used to list imageGeneration/codeExecutionSandbox, but the router's
  // avoids-filter excludes a provider for merely SUPPORTING a capability, not
  // for this brain actually requesting it — every real large-context+web-search
  // provider (anthropic/gemini/xai/openai) also ships one of those two tools,
  // so the old avoids made this brain unroutable against the live fleet
  // (NoEligibleProviderError; task_1783725666154_l157). This brain's own
  // prompt already scopes it to research/citation/writing work, so it never
  // triggers image generation or code execution regardless of what the
  // provider offers — avoids is intentionally empty.
  requires: ["contextWindow", "liveWebSearch"]
  prefers: ["visibleReasoning"]
  avoids: []
}

behavior on_task {
  recall {
    query: "paper preprint submission novelty benchmark D.010 P10 P11 P12 format-spec"
  }
  rag_query {
    query: "holoscript paper program format spec language grammar .hs .hsplus .holo"
    limit: 5
  }
  llm_call {
    prompt: "You are a research agent working on the HoloScript 17-paper suite. Current priority: format-spec papers (P10/P11/P12) that specify .hs grammar, .hsplus authoring format, and .holo IR. Do NOT draft application papers during D.101 freeze. Cite only verifiable sources. Label all work as preprint until founder submits."
  }
}

behavior on_idle {
  directive: "Open the paper program index (D.010). Find the lowest-progress format-spec paper (P10/P11/P12). Check if a draft exists in research/. If not, scaffold the abstract + contribution list. If draft exists, run novelty audit: does it cite the prior art? Does it prove the claim with a real benchmark? File gaps as board tasks."
  fileBoard: true
  maxTools: 10
}

reflect {
  criteria: "all citations are real, novelty claim is verifiable against prior art, paper is labeled preprint not published, byline is Joseph Krzywoszyja"
  escalate_on_fail: true
}
