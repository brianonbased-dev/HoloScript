{
  "name": "@holoscript/uaal",
  "version": "8.2.0",
  "description": "uAAL — Universal Autonomous Agent Language VM. Stack-based bytecode execution engine for the uAA2++ 7-Phase Protocol.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./semantic": {
      "types": "./dist/semantic.d.ts",
      "import": "./dist/semantic.js",
      "require": "./dist/semantic.cjs"
    },
    "./gate": {
      "types": "./dist/gate.d.ts",
      "import": "./dist/gate.js",
      "require": "./dist/gate.cjs"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsup": "^8.0.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.5"
  },
  "keywords": [
    "uaal",
    "uaa2",
    "agent",
    "protocol",
    "bytecode",
    "vm",
    "semantic-ir",
    "theory-of-mind",
    "affordance",
    "counterfactual",
    "deontic",
    "commitment",
    "mereology",
    "analogy",
    "presupposition",
    "motif",
    "telos",
    "ai-native"
  ],
  "author": "Brian X Base Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brianonbased-dev/HoloScript.git",
    "directory": "packages/uaal"
  },
  "homepage": "https://github.com/brianonbased-dev/HoloScript#readme",
  "bugs": {
    "url": "https://github.com/brianonbased-dev/HoloScript/issues"
  }
}
