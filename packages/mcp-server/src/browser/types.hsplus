// @browser_types — Browser types: type definitions for MCP server browser automation state and actions.
//
// Native .hsplus surface for mcp-server/src/browser/types.ts.

@trait browser_types {
  capability_tags: ["browser_types", "browser_action_schema", "mcp_browser_types", "mcp_server"]
  @on_spawn => { emit("browser_types_ready", {}) }
  @receipt browser_types_config { type: "BrowserTypesReceipt"; timestamp: now() }
}
