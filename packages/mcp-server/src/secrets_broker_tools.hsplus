// @secrets_broker_tools — Secrets broker tools: MCP tools for secrets grant, resolve, and revoke via HoloKey vault.
//
// Native .hsplus surface for mcp-server/src/secrets-broker-tools.ts.

@trait secrets_broker_tools {
  capability_tags: ["secrets_broker_tools", "holokey_secrets_mcp", "vault_grant_revoke_mcp", "mcp_server"]
  @on_spawn => { emit("secrets_broker_tools_ready", {}) }
  @on_grant(secret_name, grantee) => { result = grant_secret(secret_name, grantee); return result }
  @on_revoke(grant_id) => { revoke_secret_grant(grant_id) }
  @receipt secrets_broker_tools_config { type: "SecretsBrokerToolsReceipt"; timestamp: now() }
}
