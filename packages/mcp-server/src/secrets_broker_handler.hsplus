// @secrets_broker_handler — Secrets broker handler: routes HoloKey secrets grant/resolve requests.
//
// Native .hsplus surface for mcp-server/src/secrets-broker-handler.ts.

@trait secrets_broker_handler {
  capability_tags: ["secrets_broker_handler", "holokey_grant_resolve_route", "secrets_request_dispatch", "mcp_server"]
  @on_spawn => { emit("secrets_broker_handler_ready", {}) }
  @on_handle(request) => { result = handle_secrets_broker(request); return result }
  @receipt secrets_broker_handler_config { type: "SecretsBrokerHandlerReceipt"; timestamp: now() }
}
