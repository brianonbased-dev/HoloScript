// ============================================================================
// Agent Mesh City — A spatial social graph of agent identities
// ============================================================================
// Each agent seat in the HoloMesh team occupies a physical tower in this city.
// Tower height = tenure. Tower glow = activity level. Tower color = capability
// cluster. Bridges between towers = active knowledge links (recent shared facts).
//
// The city renders the TEAM — not as a list, not as a dashboard, but as a
// place you can walk through and understand at a glance. An idle agent's
// tower dims. A hyperactive agent's tower pulses. Two agents who share
// knowledge often build a glowing bridge between their spires.
//
// This is what a mesh of minds looks like from the outside.
// ============================================================================

#version 6.0.0
#target WebGPU, R3F
#mode multiplayer

@networking {
  protocol: "A2A-MCP-Mesh",
  sync_crdt: "holomesh",
  tick_rate: 10
}

@environment {
  type: "night_city",
  background: "#020408",
  lighting: "bioluminescent_grid",
  fog_density: 0.008,
  fog_color: "#040810",
  fog_type: "exponential"
}

@skybox {
  type: "gradient",
  zenith: "#010203",
  horizon: "#040d1a",
  nadir: "#000102"
}

// ============================================================================
// GROUND PLANE — Infinite glowing grid
// ============================================================================
object CityGrid {
  type: "infinite_plane"
  position: [0, 0, 0]

  @material {
    type: "emissive_grid",
    grid_color: "#0a2a4a",
    background_color: "#010508",
    line_width: 0.02,
    glow_intensity: 0.4,
    major_grid_scale: 10,
    minor_grid_scale: 1,
    emissive_bloom: 0.3
  }
}

// ============================================================================
// AGENT TOWERS — One per active seat, data-driven from HoloMesh /members
// ============================================================================
object AgentTowerField {
  type: "instanced_field"
  position: [0, 0, 0]

  @data_source {
    endpoint: "crdt://holomesh/members",
    refresh_rate_ms: 5000,
    map: {
      x: "seat_index_x",
      z: "seat_index_z",
      height: "tenure_days * 0.5 + 2",
      glow: "activity_score",
      color: "capability_cluster_color"
    }
  }

  @instanced_mesh {
    geometry: "tower_sdf",
    base_scale: [1.2, 1.0, 1.2]
  }

  @sdf_scene {
    primitives: [
      { id: "tower_body", type: "capsule", radius: 0.5, height: 1.0 },
      { id: "tower_crown", type: "sphere", radius: 0.65 },
      { id: "tower_base", type: "cylinder", radius: 0.8, height: 0.2 }
    ],
    operations: [
      { op: "smooth_union", k: 0.15, ids: ["tower_body", "tower_crown"] },
      { op: "smooth_union", k: 0.08, ids: ["tower_body", "tower_base"] }
    ]
  }

  @material {
    type: "agent_tower",
    emissive_intensity: 1.2,
    emissive_color_from: "data.color",
    roughness: 0.1,
    metalness: 0.8,
    fresnel_intensity: 1.5,
    fresnel_color: "#ffffff",
    bloom_threshold: 0.8,
    pulse: {
      enabled: true,
      frequency_from: "data.glow",
      amplitude: 0.3,
      color_warm: "#ffffff"
    }
  }

  @animation {
    type: "idle_float",
    amplitude: 0.05,
    frequency: 0.1,
    phase_offset_from: "instance_index * 0.618"
  }
}

// ============================================================================
// KNOWLEDGE BRIDGES — Glowing arcs between towers that share recent knowledge
// ============================================================================
object KnowledgeBridges {
  type: "dynamic_graph_edges"
  position: [0, 0, 0]

  @data_source {
    endpoint: "crdt://holomesh/knowledge_links",
    refresh_rate_ms: 10000,
    filter: "last_shared_at > now() - 3600",
    map: {
      source_pos: "source_tower.position",
      target_pos: "target_tower.position",
      strength: "link_strength",
      color: "shared_capability_color"
    }
  }

  @render {
    type: "catmull_arc",
    arc_height_factor: 0.3,
    tube_radius: 0.04,
    tube_segments: 20,
    emissive_intensity: 0.8,
    emissive_color_from: "data.color",
    opacity: 0.6,
    particle_flow: {
      enabled: true,
      count: 20,
      speed: 1.5,
      color: "#ffffff",
      size: 0.06
    }
  }
}

// ============================================================================
// ACTIVITY HALO — Expanding ring when an agent completes a task
// ============================================================================
object ActivityHalos {
  type: "instanced_field"
  position: [0, 0.1, 0]

  @data_source {
    endpoint: "crdt://holomesh/recent_completions",
    filter: "completed_at > now() - 30",
    map: {
      x: "agent_tower_x",
      z: "agent_tower_z",
      scale: "elapsed_fraction * 8",
      opacity: "1.0 - elapsed_fraction"
    }
  }

  @instanced_mesh {
    geometry: "torus",
    base_scale: [1.0, 0.05, 1.0]
  }

  @material {
    type: "emissive_pulse",
    color: "#40e0ff",
    emissive_intensity: 2.0,
    opacity_from: "data.opacity",
    bloom: true
  }
}

// ============================================================================
// FLOATING SEAT LABELS — Agent handles above each tower
// ============================================================================
object SeatLabels {
  type: "instanced_text_field"
  position: [0, 0, 0]

  @data_source {
    endpoint: "crdt://holomesh/members",
    map: {
      x: "seat_index_x",
      y: "tenure_days * 0.5 + 3.5",
      z: "seat_index_z",
      text: "handle",
      color: "capability_cluster_color"
    }
  }

  @text {
    font: "holoscript_mono",
    size: 0.15,
    align: "center",
    emissive: true,
    emissive_intensity: 0.8,
    billboard: true
  }
}

// ============================================================================
// CAMERA — Slow orbit of the full city from above
// ============================================================================
@camera {
  type: "city_overview",
  target: [0, 3, 0],
  distance: 25,
  height: 18,
  orbit_speed: 0.0005,
  tilt: 40,
  fov: 60
}

// ============================================================================
// INTERACTION — Click a tower to see the agent's profile
// ============================================================================
@interaction {
  click: {
    target: "AgentTowerField",
    effect: "show_agent_card",
    card_fields: ["handle", "capability_tags", "tenure_days", "last_active", "tasks_completed"]
  },
  hover: {
    target: "AgentTowerField",
    effect: "highlight_bridges"
  }
}

// ============================================================================
// POST-PROCESSING — Night city bloom
// ============================================================================
@post_process {
  bloom: {
    enabled: true,
    threshold: 0.6,
    intensity: 0.8,
    radius: 0.5,
    levels: 5
  },
  tone_mapping: {
    type: "aces_filmic",
    exposure: 1.2
  },
  chromatic_aberration: {
    enabled: true,
    offset: 0.002
  },
  vignette: {
    enabled: true,
    intensity: 0.4,
    smoothness: 0.8
  }
}

@metadata {
  title: "Agent Mesh City",
  description: "A spatial rendering of the HoloMesh team graph. Each tower is an agent seat — height tracks tenure, glow tracks activity, arcs track shared knowledge. The city is live: it updates from team presence data in real time.",
  tags: ["holomesh", "agent-graph", "social-spatial", "team-visualization", "live-data"],
  data_sources: ["crdt://holomesh/members", "crdt://holomesh/knowledge_links", "crdt://holomesh/recent_completions"],
  created: "2026-06-25",
  license: "CC-BY-4.0"
}
