// ============================================================================
// Proof-of-Play — Interaction as computation attestation
// ============================================================================
// Based on P.GOLD.004: Proof-of-Play — the thesis that INTERACTION IS
// COMPUTATION. Every verified user interaction produces a cryptographic
// receipt: a player who sustains 90fps on a physics puzzle PROVES their
// system ran real compute. A ghost avatar whose CRDT gossip fails this test
// cannot participate in the authoritative world state.
//
// In this world, the Proof-of-Play arena is a floating puzzle chamber.
// Players (agents or humans) approach physics interaction stations and
// solve them. A correct, consistent solution at threshold framerate
// generates a PoP receipt that appears as a glowing crystal above the
// station. Accumulated PoP receipts unlock access to the inner sanctum —
// a zone visible only to verified participants.
//
// The arena is also the HoloMesh quality gate: any agent whose CAEL chain
// contains W.107 trust-epoch entries but fails the PoP challenge is tagged
// as a potential hallucination source and quarantined from the sanctum.
// ============================================================================

#version 6.0.0
#target WebGPU, R3F, quest
#mode multiplayer

@networking {
  protocol: "A2A-MCP-Mesh",
  sync_crdt: "holomesh",
  tick_rate: 90
}

@environment {
  type: "floating_void",
  background: "#010106",
  ambient_light: "#050318",
  fog_type: "none"
}

// ============================================================================
// ARENA PLATFORM — The central proving ground
// ============================================================================
object ArenaPlatform {
  type: "sdf_volume"
  position: [0, 0, 0]

  @sdf_scene {
    primitives: [
      { id: "disk",      type: "cylinder", radius: 20, height: 0.5 },
      { id: "ring_cut",  type: "cylinder", radius: 14, height: 0.8 },
      { id: "center",    type: "cylinder", radius: 6,  height: 0.6 }
    ],
    operations: [
      { op: "subtract", ids: ["disk", "ring_cut"] },
      { op: "union",    ids: ["disk", "center"] }
    ]
  }

  @material {
    type: "pbr_metallic",
    base_color: "#060420",
    roughness: 0.15,
    metalness: 0.8,
    emissive: "#0a0830",
    emissive_intensity: 0.3
  }
}

// ============================================================================
// PHYSICS INTERACTION STATIONS — Eight PoP challenge puzzles
// ============================================================================
object PoP_Stations {
  type: "instanced_field"
  position: [0, 0, 0]

  @circular_layout {
    count: 8,
    radius: 16,
    height: 0
  }

  @instanced_mesh {
    geometry: "puzzle_station",
    base_scale: [1.0, 1.0, 1.0]
  }

  @sdf_scene {
    primitives: [
      { id: "pedestal", type: "cylinder", radius: 0.8, height: 1.0 },
      { id: "puzzle",   type: "rounded_box", size: [1.2, 0.8, 1.2], radius: 0.1 }
    ],
    operations: [
      { op: "union", ids: ["pedestal", "puzzle"] }
    ]
  }

  @material {
    type: "pbr_metallic",
    base_color: "#0a0830",
    roughness: 0.2,
    metalness: 0.9,
    emissive: "#2010a0",
    emissive_intensity: 0.6
  }

  @interaction {
    approach: {
      distance: 2.5,
      effect: "activate_challenge",
      challenge_type: "physics_sustain_90fps"
    },
    complete: {
      effect: "emit_pop_receipt",
      receipt_type: "ProofOfPlay",
      duration_threshold_ms: 5000,
      framerate_threshold: 90
    }
  }
}

// ============================================================================
// PoP RECEIPT CRYSTALS — Glow above solved stations
// ============================================================================
object PopReceiptCrystals {
  type: "instanced_field"
  position: [0, 2.5, 0]

  @data_source {
    endpoint: "crdt://holomesh/pop_receipts",
    filter: "session = current_session",
    map: {
      station_x: "station_x",
      station_z: "station_z",
      solver_color: "solver_capability_color",
      timestamp: "issued_at"
    }
  }

  @instanced_mesh {
    geometry: "octahedron",
    base_scale: [0.5, 0.5, 0.5]
  }

  @material {
    type: "emissive_crystal",
    color_from: "data.solver_color",
    emissive_intensity: 2.0,
    roughness: 0.0,
    refraction: 0.95,
    bloom: true
  }

  @animation {
    type: "rotate_float",
    rotation_speed: 0.5,
    float_amplitude: 0.1,
    phase_offset_from: "instance_index * 0.8"
  }
}

// ============================================================================
// GHOST QUARANTINE ZONE — Failed PoP agents drift here
// ============================================================================
object GhostZone {
  type: "sdf_volume"
  position: [0, -5, 0]

  @sdf_scene {
    primitives: [
      { id: "void_disk", type: "cylinder", radius: 8, height: 0.1 }
    ]
  }

  @material {
    type: "emissive_grid",
    grid_color: "#300010",
    background_color: "#050005",
    line_width: 0.01,
    emissive_bloom: 0.15
  }
}

object GhostAgents {
  type: "instanced_field"
  position: [0, -5, 0]

  @data_source {
    endpoint: "crdt://holomesh/pop_failures",
    filter: "session = current_session",
    map: {
      x: "ghost_x",
      z: "ghost_z",
      opacity: "0.15"
    }
  }

  @instanced_mesh {
    geometry: "agent_silhouette",
    base_scale: [0.8, 0.8, 0.8]
  }

  @material {
    type: "emissive_ghost",
    color: "#400020",
    emissive_intensity: 0.3,
    opacity: 0.15,
    dither: true
  }
}

// ============================================================================
// INNER SANCTUM — Visible only to verified (PoP-receipted) participants
// ============================================================================
object InnerSanctum {
  type: "sdf_volume"
  position: [0, 0.3, 0]

  @visibility_gate {
    condition: "viewer.pop_receipts >= 3",
    hide_when_locked: true,
    show_lock_indicator: true
  }

  @sdf_scene {
    primitives: [
      { id: "dome",   type: "sphere",   radius: 5.5 },
      { id: "floor",  type: "cylinder", radius: 5.8, height: 0.2 }
    ],
    operations: [
      { op: "smooth_union", k: 0.3, ids: ["dome", "floor"] }
    ]
  }

  @material {
    type: "emissive_glass",
    base_color: "#040218",
    emissive: "#8040ff",
    emissive_intensity: 0.5,
    opacity: 0.15,
    refraction: 0.9,
    bloom: true
  }
}

object SanctumContent {
  type: "group"
  position: [0, 1.5, 0]

  @visibility_gate {
    condition: "viewer.pop_receipts >= 3"
  }

  object KnowledgeOrb {
    type: "sdf_volume"
    position: [0, 0, 0]
    @sdf_scene { primitives: [{ id: "orb", type: "sphere", radius: 1.5 }] }
    @material {
      type: "emissive_crystal",
      base_color: "#080430",
      emissive: "#a060ff",
      emissive_intensity: 3.0,
      bloom: true
    }
    @data_source {
      endpoint: "crdt://holomesh/knowledge_entries",
      filter: "tier = 'gold'",
      sort: "graduated_at desc",
      limit: 1
    }
    @interaction {
      click: { effect: "reveal_gold_knowledge_entry" }
    }
  }
}

// ============================================================================
// FRAMERATE COUNTER — Live fps display during challenge
// ============================================================================
object FPSCounter {
  type: "text_hud"
  position: [0, 1.6, -2]

  @hud {
    mode: "spatial_hud",
    anchor: "player_front",
    font: "holoscript_mono",
    size: 0.12,
    color: "#60ff60",
    emissive: true
  }

  @data_source {
    endpoint: "crdt://local/framerate",
    reactive: true,
    format: "{value:.0f} fps"
  }
}

// ============================================================================
// CAMERA
// ============================================================================
@camera {
  type: "first_person",
  height: 1.7,
  speed: 2.0,
  collision: true,
  fov: 90
}

@post_process {
  bloom: {
    enabled: true,
    threshold: 0.4,
    intensity: 1.5,
    radius: 0.8,
    levels: 6
  },
  tone_mapping: { type: "aces_filmic", exposure: 1.1 },
  vignette: { enabled: true, intensity: 0.4, smoothness: 0.8 }
}

@metadata {
  title: "Proof-of-Play",
  description: "Interaction as computation attestation (P.GOLD.004). Solve physics puzzles at 90fps to earn PoP receipts. Three receipts unlock the inner sanctum. Agents who fail the framerate threshold are tagged as ghosts and quarantined. Based on: Proof-of-Play — Interaction as Computation Attestation.",
  tags: ["holomesh", "proof-of-play", "computation-attestation", "physics-challenge", "anti-hallucination"],
  data_sources: ["crdt://holomesh/pop_receipts", "crdt://holomesh/pop_failures", "crdt://holomesh/knowledge_entries"],
  created: "2026-06-25",
  license: "CC-BY-4.0"
}
