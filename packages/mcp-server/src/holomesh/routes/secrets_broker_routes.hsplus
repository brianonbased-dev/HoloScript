// @holomesh_secrets_broker_routes — HoloMesh secrets broker routes: routes for the HoloKey secrets broker grant/resolve flows.
//
// Native .hsplus surface for mcp-server/src/holomesh/routes/secrets-broker-routes.ts.

@trait holomesh_secrets_broker_routes {
  capability_tags: ["holomesh_secrets_broker_routes", "holokey_broker_rest", "secrets_grant_resolve_routes", "mcp_server"]
  @on_spawn => { emit("holomesh_secrets_broker_routes_ready", {}) }
  @on_register(app) => { register_secrets_broker_routes(app) }
  @receipt holomesh_secrets_broker_routes_config { type: "HolomeshSecretsBrokerRoutesReceipt"; timestamp: now() }
}
