composition "Corner Shop" {
  state {
    stock: 5
    till: 0
  }

  logic {
    action buy(quantity, payment) accepted(sold) refused(nothing_to_buy, not_enough_stock, not_enough_money) {
      if (quantity < 1) {
        return { allowed: false, outcome: "nothing_to_buy" }
      }
      if (quantity > state.stock) {
        return { allowed: false, outcome: "not_enough_stock" }
      }
      if (payment < (quantity >= 3 ? quantity * 3 : quantity * 4)) {
        return { allowed: false, outcome: "not_enough_money" }
      }
      state.stock -= quantity
      state.till += quantity >= 3 ? quantity * 3 : quantity * 4
      emit("sold", { quantity: quantity, price: quantity >= 3 ? quantity * 3 : quantity * 4 })
      return {
        allowed: true,
        outcome: "sold",
        change: payment - (quantity >= 3 ? quantity * 3 : quantity * 4)
      }
    }

    action restock(amount) accepted(restocked) refused(nothing_to_add, shelf_full) {
      if (amount < 1) {
        return { allowed: false, outcome: "nothing_to_add" }
      }
      if (state.stock + amount > 12) {
        return { allowed: false, outcome: "shelf_full" }
      }
      state.stock += amount
      emit("restocked", { amount: amount })
      return { allowed: true, outcome: "restocked" }
    }

    action inventory(viewerId) {
      return { viewer: viewerId, stock: state.stock, till: state.till }
    }
  }
}
