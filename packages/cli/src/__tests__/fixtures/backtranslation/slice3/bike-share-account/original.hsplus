composition "Bike Share Account" {
  state {
    bikesOut: 0
    fineOwed: 0
  }

  logic {
    action rent(count) accepted(rented) refused(fine_unpaid, bad_count, over_limit) {
      if (state.fineOwed > 0) {
        return { allowed: false, outcome: "fine_unpaid" }
      }
      if (count < 1) {
        return { allowed: false, outcome: "bad_count" }
      }
      if (state.bikesOut + count > 2) {
        return { allowed: false, outcome: "over_limit" }
      }
      state.bikesOut += count
      emit("bikes_rented", { count: count, now_out: state.bikesOut })
      return { allowed: true, outcome: "rented" }
    }

    action giveBack(hoursLate) accepted(returned, returned_late) refused(nothing_out, bad_hours) {
      if (state.bikesOut < 1) {
        return { allowed: false, outcome: "nothing_out" }
      }
      if (hoursLate < 0) {
        return { allowed: false, outcome: "bad_hours" }
      }
      state.bikesOut -= 1
      if (hoursLate > 0) {
        state.fineOwed = state.fineOwed + hoursLate * 2 > 10 ? 10 : state.fineOwed + hoursLate * 2
        emit("returned_late", { hours_late: hoursLate, fine_owed: state.fineOwed })
        return { allowed: true, outcome: "returned_late" }
      }
      emit("returned", { now_out: state.bikesOut })
      return { allowed: true, outcome: "returned" }
    }

    action payFine(amount) accepted(fine_paid) refused(nothing_owed, not_enough) {
      if (state.fineOwed == 0) {
        return { allowed: false, outcome: "nothing_owed" }
      }
      if (amount < state.fineOwed) {
        return { allowed: false, outcome: "not_enough" }
      }
      emit("fine_paid", { paid: state.fineOwed, change: amount - state.fineOwed })
      state.fineOwed = 0
      return { allowed: true, outcome: "fine_paid" }
    }

    action account(viewerId) {
      return {
        viewer: viewerId,
        bikes_out: state.bikesOut,
        fine_owed: state.fineOwed,
        can_rent: state.fineOwed == 0 && state.bikesOut < 2
      }
    }
  }
}
