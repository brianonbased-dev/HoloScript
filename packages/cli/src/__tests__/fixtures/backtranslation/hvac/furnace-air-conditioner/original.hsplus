composition "Furnace And Air Conditioner" {
  state {
    mode: "off"
    setPoint: 70
    swing: 1
    fan: "auto"
    room: 70
    heating: false
    cooling: false
    waiting: false
    minutesSinceCompressorStopped: 60
    heatCall: false
    coolCall: false
  }

  logic {
    action setMode(mode) accepted(mode_set) refused(unknown_mode) {
      if (mode != "heat" && mode != "cool" && mode != "auto" && mode != "off") {
        return { allowed: false, outcome: "unknown_mode" }
      }
      state.mode = mode
      return { allowed: true, outcome: "mode_set" }
    }

    action setTemperature(degrees) accepted(temperature_set) refused(out_of_range) {
      if (degrees < 50 || degrees > 90) {
        return { allowed: false, outcome: "out_of_range" }
      }
      state.setPoint = degrees
      return { allowed: true, outcome: "temperature_set" }
    }

    action setSwing(degrees) accepted(swing_set) refused(bad_swing) {
      if (degrees < 1 || degrees > 3) {
        return { allowed: false, outcome: "bad_swing" }
      }
      state.swing = degrees
      return { allowed: true, outcome: "swing_set" }
    }

    action setFan(setting) accepted(fan_set) refused(unknown_fan) {
      if (setting != "auto" && setting != "on") {
        return { allowed: false, outcome: "unknown_fan" }
      }
      state.fan = setting
      return { allowed: true, outcome: "fan_set" }
    }

    action reading(room, minutes) accepted(heating, cooling, waiting, idle) refused(bad_minutes) {
      if (minutes < 0) {
        return { allowed: false, outcome: "bad_minutes" }
      }
      if (!state.cooling) {
        state.minutesSinceCompressorStopped += minutes
      }
      state.room = room
      state.waiting = false
      if (state.mode == "heat" || state.mode == "auto") {
        if (state.heatCall) {
          if (room >= state.setPoint) {
            state.heatCall = false
          }
        } else {
          if (room <= state.setPoint - state.swing) {
            state.heatCall = true
          }
        }
      } else {
        state.heatCall = false
      }
      if ((state.mode == "cool" || state.mode == "auto") && !state.heatCall) {
        if (state.coolCall) {
          if (room <= state.setPoint) {
            state.coolCall = false
          }
        } else {
          if (room >= state.setPoint + state.swing) {
            state.coolCall = true
          }
        }
      } else {
        state.coolCall = false
      }
      state.heating = state.heatCall
      if (state.coolCall) {
        if (!state.cooling) {
          if (state.minutesSinceCompressorStopped >= 5) {
            state.cooling = true
          } else {
            state.waiting = true
          }
        }
      } else {
        if (state.cooling) {
          state.cooling = false
          state.minutesSinceCompressorStopped = 0
        }
      }
      if (state.heating) {
        return { allowed: true, outcome: "heating" }
      }
      if (state.cooling) {
        return { allowed: true, outcome: "cooling" }
      }
      if (state.waiting) {
        return { allowed: true, outcome: "waiting" }
      }
      return { allowed: true, outcome: "idle" }
    }

    action status(viewerId) {
      return {
        viewer: viewerId,
        mode: state.mode,
        set_to: state.setPoint,
        room: state.room,
        heat_on: state.heating,
        cool_on: state.cooling,
        fan_running: state.fan == "on" || state.heating || state.cooling,
        waiting: state.waiting
      }
    }
  }
}
