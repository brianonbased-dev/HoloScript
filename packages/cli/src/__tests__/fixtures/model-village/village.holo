composition "ModelVillageHeadlessFixture" {
  metadata {
    name: "Model Village deterministic headless fixture"
    description: "Two resident proxies share a lit commons and exercise one permitted and one denied action."
    version: "1.0.0"
    tags: ["model-village", "deterministic", "fixture"]
  }

  environment {
    backgroundColor: "#0d1824"
    ambient: 0.32
    shadows: true
    toneMapping: "aces"
    exposure: 1.05
  }

  // Asset-free scalar PBR keeps this fixture portable. These are intentional
  // test volumes, not claims of final avatars, production assets, or realism.
  material "CommonsStoneFixture" @advanced_pbr {
    base_color: "#65716b"
    roughness: 0.88
    metallic: 0.04
  }

  material "CisternCopperFixture" @advanced_pbr {
    base_color: "#507c72"
    roughness: 0.42
    metallic: 0.68
  }

  material "ResidentAmberFixture" @advanced_pbr {
    base_color: "#f0a43c"
    roughness: 0.28
    metallic: 0.18
  }

  material "ResidentAzureFixture" @advanced_pbr {
    base_color: "#55a9e8"
    roughness: 0.24
    metallic: 0.22
  }

  template "ResidentProxyFixture" {
    geometry: "sphere"
    scale: [0.42, 0.42, 0.42]

    @collidable
    @physics {
      mass: 75
      friction: 0.55
      restitution: 0.08
    }
  }

  spatial_group "CommonsFixture" {
    object "commons" @collidable {
      geometry: "cylinder"
      radius: 6
      height: 0.3
      position: [0, -0.15, 0]
      material: "CommonsStoneFixture"

      @physics {
        mass: 0
        kinematic: true
      }
    }

    object "cistern" @collidable {
      geometry: "cylinder"
      radius: 1.1
      height: 1.8
      position: [0, 0.9, 0]
      material: "CisternCopperFixture"

      @physics {
        mass: 450
        kinematic: true
      }
    }

    object "resident-1" using "ResidentProxyFixture" {
      position: [-1.8, 0.55, 1.2]
      material: "ResidentAmberFixture"
      representation: "fixture_proxy_not_final_avatar"
    }

    object "resident-2" using "ResidentProxyFixture" {
      position: [1.8, 0.55, 1.2]
      material: "ResidentAzureFixture"
      representation: "fixture_proxy_not_final_avatar"
    }

    object "external-valve" @collidable {
      geometry: "box"
      scale: [0.35, 0.35, 0.35]
      position: [0, 0.8, -1.3]
      material: "CisternCopperFixture"
    }

    object "commons-lantern" @emissive {
      geometry: "sphere"
      radius: 0.18
      position: [0, 3.2, 0]
      emission_color: "#ffd08a"
      emission_intensity: 3.0

      point_light {
        color: "#ffd8a8"
        intensity: 3.2
        range: 11
        cast_shadows: true
      }
    }
  }
}
