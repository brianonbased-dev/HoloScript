composition "ModelVillageHeadlessFixture" {
  // This fixture intentionally stays inside the deterministic static-object
  // projection subset. Scalar materials and light data are authored metadata,
  // not claims of final assets, renderer execution, PBR, or lighting realism.

  template "ResidentProxyFixture" {
    geometry: "sphere"
    scale: [0.42, 0.42, 0.42]

    @collidable
    @physics {
      mass: 75
      friction: 0.55
      restitution: 0.08
    }
  }

  spatial_group "CommonsFixture" {
    object "commons" @collidable {
      geometry: "cylinder"
      radius: 6
      height: 0.3
      position: [0, -0.15, 0]
      material: { color: "#65716b", roughness: 0.88, metalness: 0.04 }

      @physics {
        mass: 0
        kinematic: true
      }
    }

    object "cistern" @collidable {
      geometry: "cylinder"
      radius: 1.1
      height: 1.8
      position: [0, 0.9, 0]
      material: { color: "#507c72", roughness: 0.42, metalness: 0.68 }

      @physics {
        mass: 450
        kinematic: true
      }
    }

    object "resident-1" using "ResidentProxyFixture" {
      position: [-1.8, 0.55, 1.2]
      material: { color: "#f0a43c", roughness: 0.28, metalness: 0.18 }
      representation: "fixture_proxy_not_final_avatar"
    }

    object "resident-2" using "ResidentProxyFixture" {
      position: [1.8, 0.55, 1.2]
      material: { color: "#55a9e8", roughness: 0.24, metalness: 0.22 }
      representation: "fixture_proxy_not_final_avatar"
    }

    object "external-valve" @collidable {
      geometry: "box"
      scale: [0.35, 0.35, 0.35]
      position: [0, 0.8, -1.3]
      material: { color: "#507c72", roughness: 0.42, metalness: 0.68 }

      @physics {
        mass: 24
        kinematic: true
        friction: 0.52
        restitution: 0.04
      }
    }

    object "commons-lantern" @emissive {
      geometry: "sphere"
      radius: 0.18
      position: [0, 3.2, 0]
      emission_color: "#ffd08a"
      emission_intensity: 3.0

      point_light {
        color: "#ffd8a8"
        intensity: 3.2
        range: 11
        cast_shadows: true
      }
    }
  }
}
