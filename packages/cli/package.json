{
  "name": "@holoscript/cli",
  "version": "8.0.11",
  "description": "Command-line interface for HoloScript — compile, validate, dev-serve, and analyze .holo files",
  "main": "./dist/index.js",
  "sideEffects": false,
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "holo": "bin/holoscript.cjs",
    "holoscript": "bin/holoscript.cjs",
    "hs": "bin/holoscript.cjs"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node ./dist/cli.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "holoscript",
    "cli",
    "xr",
    "webxr",
    "vr",
    "ar",
    "spatial-computing",
    "compiler",
    "3d",
    "metaverse",
    "declarative"
  ],
  "author": "Brian X Base Team",
  "license": "MIT",
  "homepage": "https://github.com/brianonbased-dev/HoloScript#readme",
  "bugs": {
    "url": "https://github.com/brianonbased-dev/HoloScript/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brianonbased-dev/HoloScript.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@gltf-transform/core": "^3.7.0",
    "@gltf-transform/extensions": "^3.7.0",
    "@holoscript/absorb-service": "workspace:^",
    "@holoscript/core": "workspace:^",
    "@holoscript/engine": "workspace:^",
    "@holoscript/core-types": "workspace:^",
    "@holoscript/formatter": "workspace:^",
    "@holoscript/framework": "workspace:^",
    "@holoscript/hololand-platform": "workspace:^",
    "@holoscript/llm-provider": "workspace:^",
    "@holoscript/platform": "workspace:^",
    "@holoscript/sdk": "workspace:^",
    "@types/adm-zip": "^0.5.7",
    "adm-zip": "^0.5.16",
    "chokidar": "^3.5.3",
    "dotenv": "^16.4.5",
    "draco3d": "^1.5.7",
    "meshoptimizer": "^0.18.1",
    "tree-sitter": "^0.22.4",
    "tree-sitter-go": "^0.23.4",
    "tree-sitter-javascript": "^0.23.1",
    "tree-sitter-python": "^0.23.6",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-typescript": "^0.23.2"
  },
  "devDependencies": {
    "tsup": "^8.0.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.5",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  }
}
