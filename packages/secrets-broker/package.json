{
  "name": "@holoscript/secrets-broker",
  "version": "6.1.1",
  "description": "HoloKey vault, service-secret resolver, KEK providers, leases, and capability-token broker for HoloScript AI surfaces.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "src/repository_identity.hsplus",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./repository-identity": {
      "types": "./dist/repository-identity.d.ts",
      "import": "./dist/repository-identity.js",
      "require": "./dist/repository-identity.cjs"
    },
    "./repository-identity/source": "./src/repository_identity.hsplus"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:repository-identity-native": "pnpm run build && node ./scripts/check-repository-identity-native.mjs",
    "prepack": "pnpm run check:repository-identity-native"
  },
  "keywords": [
    "holoscript",
    "secrets-broker",
    "x402",
    "capability-token",
    "device-flow",
    "ai-agents",
    "sovereign-primitive"
  ],
  "author": "Brian X Base Team",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/brianonbased-dev/HoloScript.git",
    "directory": "packages/secrets-broker"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsup": "^8.0.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.5"
  },
  "homepage": "https://github.com/brianonbased-dev/HoloScript#readme",
  "bugs": {
    "url": "https://github.com/brianonbased-dev/HoloScript/issues"
  },
  "holoscript": {
    "repositoryIdentity": {
      "authority": "HoloKey",
      "implementationStatus": "bounded-native-sha256-binding-with-bootstrap-contract",
      "authenticatedDurableReadback": false,
      "nativeContentBinding": {
        "scope": "single-sha256-block-borrowed-u8-max-55-bytes",
        "fixtureByteLength": 33,
        "verifiedDigestBytes": 32
      },
      "source": "./src/repository_identity.hsplus",
      "publicEntry": "./repository-identity",
      "publicationGate": "pnpm run check:repository-identity-native",
      "legacyProjection": "holorepo.* v1 wire schemas are deprecated compatibility only"
    }
  }
}
