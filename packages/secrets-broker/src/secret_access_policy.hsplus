// @secret_access_policy — HoloGate scope axis: least-authority ref constraints.
//
// Native .hsplus surface for secret-access-policy.ts (secrets-broker).
//
// The `scope` step in: identify → authorize → scope → admit → log.
// Ownership answers "is this yours?"; scope answers "may THIS context touch it?"
// Defense in depth — a mis-scoped consumer is contained to its allowlist, not the full vault.
//
// SecretAccessPolicy (secret-access-policy.ts):
//   allow?: readonly String[]  — glob patterns; key present = allowlist mode; [] = deny-all; absent = unconstrained
//   block?: readonly String[]  — glob patterns; matched = deny, even if allow matches
//
// SEMANTICS (fail-closed):
//   block WINS: a ref matching ANY block glob is denied even if allow also matches.
//   allow present + empty ([]): deny-all (programmatic callers whose allow collapses fail CLOSED, never open).
//   allow absent: block-only mode.
//   {} (neither): no constraint; ownership alone governs.
//
// Glob patterns match the WHOLE canonical ref (e.g. `vault:OPENAI_API_KEY`).
// Pure module — no I/O, no secret material, only ref labels.
//
// checkSecretAccess(ref, policy) → SecretAccessDecision { allowed, reason: 'blocked'|'not-in-allowlist'|null }
// PolicyDeniedError — thrown by resolver when scope policy denies; carries ref + cause, NO patterns.

@trait secret_access_policy {
  capability_tags: ["secret_access_policy", "hologate_scope", "least_authority", "fail_closed", "secrets_broker"]

  @on_spawn => {
    policy_engine = init_secret_access_policy()
    emit("secret_access_policy_ready", {})
  }

  @on_check(ref, policy) => {
    decision = policy_engine.check(ref, policy)
    emit("access_policy_decision", { ref: ref, allowed: decision.allowed, reason: decision.reason })
    return decision
  }

  @receipt secret_access_policy_config {
    type: "SecretAccessPolicyReceipt"
    semantics: "block-wins; allow[]=deny-all; allow-absent=unconstrained"
    hologate_axis: "scope step: identify→authorize→scope→admit→log"
    pure: "no I/O, no secret material"
    timestamp: now()
  }
}
