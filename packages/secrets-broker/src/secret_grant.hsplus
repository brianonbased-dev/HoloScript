// @secret_grant — Secret grant issuance: handles-only, deterministic, audit-heavy.
//
// Native .hsplus surface for grant.ts (secrets-broker).
//
// Extracted from Studio's secretBroker and generalized: any package/service
// can issue brokered grants without depending on Studio internals.
//
// Grant contract (grant.ts):
//   secretRef  = "secret://namespace/<id>/<name>"   (scoped to namespace)
//   capabilityRef = "cap://daemon/secrets/<name>"   (daemon secret capability)
//   ttl_seconds = 60–3600 (default 900 = 15min; clamped)
//   receipt_hash = sha256(canonical JSON of grant receipt) — tamper-evident
//
// PolicyGatedGrant:
//   policy_decision { allowed, reason, conditions, receipt_hash }
//   grant_receipt   { grant_id, secret_ref, capability_ref, granted_at, expires_at, receipt_hash }
//
// SECURITY: secretRef and capabilityRef are HANDLES — no secret value in the grant.
// The receipt hash covers the entire receipt object for tamper detection.

@trait secret_grant {
  // Namespace that grants are scoped to
  namespace_id: String

  // Default TTL in seconds (clamped to 60–3600)
  default_ttl_seconds: Int = 900

  capability_tags: ["secret_grant", "secrets_broker", "grant_issuance", "audit_trail", "tamper_evident", "handles_only"]

  @on_spawn => {
    emit("secret_grant_ready", { namespace_id: namespace_id })
  }

  // Issue a policy-gated grant for a secret handle
  @on_issue(secret_ref, capability_ref, ttl_seconds, requester_id) => {
    // Validate handle formats (grant.ts enforces these as errors at construction time)
    if not secret_ref.starts_with("secret://namespace/" + namespace_id + "/") {
      emit("secret_grant_error", { reason: "secretRef must be scoped to namespace", namespace_id: namespace_id })
      return null
    }
    if not capability_ref.starts_with("cap://daemon/secrets/") {
      emit("secret_grant_error", { reason: "capabilityRef must be a daemon secret capability" })
      return null
    }

    grant = issue_brokered_grant({
      namespace_id: namespace_id,
      secret_ref: secret_ref,
      capability_ref: capability_ref,
      ttl_seconds: ttl_seconds ?? default_ttl_seconds,
      requester_id: requester_id
    })

    if grant.policy_decision.allowed {
      emit("secret_grant_issued", {
        grant_id: grant.grant_receipt.grant_id,
        secret_ref: secret_ref,
        capability_ref: capability_ref,
        expires_at: grant.grant_receipt.expires_at,
        receipt_hash: grant.grant_receipt.receipt_hash
      })
    } else {
      emit("secret_grant_denied", {
        secret_ref: secret_ref,
        reason: grant.policy_decision.reason
      })
    }
    return grant
  }

  // Verify a receipt hash matches its content
  @on_verify_receipt(receipt) => {
    return verify_grant_receipt_hash(receipt)
  }

  @receipt secret_grant_config {
    type: "SecretGrantReceipt"
    namespace_id: namespace_id
    default_ttl_seconds: default_ttl_seconds
    secret_value_in_grant: false
    receipt_hash_algorithm: "sha256"
    timestamp: now()
  }
}
