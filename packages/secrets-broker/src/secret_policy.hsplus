// @secret_policy — Policy gate helpers for the secrets broker.
//
// Native .hsplus surface for policy.ts (secrets-broker).
//
// The canonical policy check lives in grant.ts (checkSecretGrantPolicy).
// This module is a builder surface for common SecretBrokerPolicy shapes.
//
// Policy structure (types.ts):
//   SecretBrokerPolicy {
//     secretGrants: {
//       allowedSecretRefPrefixes: String[]
//       allowedCapabilityRefs: String[]
//       allowedAgentIds?: String[]
//       blockedAgentIds?: String[]
//       requirePurpose?: Bool
//     }
//     enforcement: { onViolation: "warn" | "block" }
//   }
//
// Convenience policy builders (policy.ts):
//   allow_only(refs)               — allowlist of secret ref prefixes
//   deny_all()                     — block-by-default (empty allowlists, "*" block)
//   allow_agent_for_ref(agentId, ref) — single agent + single ref
//   from_holodoor_policy(shape)    — build from HoloDoor JSON shape

@trait secret_policy {
  // Default enforcement mode
  default_on_violation: enum("warn" | "block") = "block"

  capability_tags: ["secret_policy", "policy_gate", "secrets_broker", "grant_policy", "deny_by_default"]

  @on_spawn => {
    emit("secret_policy_ready", { default_on_violation: default_on_violation })
  }

  // Build a policy that allows only the listed secret ref prefixes
  @on_allow_only(refs) => {
    return {
      secret_grants: {
        allowed_secret_ref_prefixes: refs,
        allowed_capability_refs: ["cap://daemon/secrets/broker-only"],
        require_purpose: true
      },
      enforcement: { on_violation: default_on_violation }
    }
  }

  // Block everything (deny-by-default)
  @on_deny_all => {
    return {
      secret_grants: {
        allowed_secret_ref_prefixes: [],
        allowed_capability_refs: [],
        blocked_agent_ids: ["*"]
      },
      enforcement: { on_violation: "block" }
    }
  }

  // Allow a single agent for a single secret ref
  @on_allow_agent_for_ref(agent_id, ref) => {
    return {
      secret_grants: {
        allowed_agent_ids: [agent_id],
        allowed_secret_ref_prefixes: [ref],
        allowed_capability_refs: ["cap://daemon/secrets/broker-only"],
        require_purpose: true
      },
      enforcement: { on_violation: default_on_violation }
    }
  }

  // Build from a HoloDoor policy JSON shape
  @on_from_holodoor(shape) => {
    return {
      secret_grants: shape.secret_grants,
      enforcement: { on_violation: shape.enforcement?.on_violation ?? default_on_violation }
    }
  }

  @receipt secret_policy_config {
    type: "SecretPolicyReceipt"
    default_on_violation: default_on_violation
    timestamp: now()
  }
}
