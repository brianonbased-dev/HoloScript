// @secret_resolver — FAIL-CLOSED, audited, owner-bound secret value resolution.
//
// Native .hsplus surface for secret-resolver.ts (secrets-broker).
//
// THE ONE blessed path for server-side consumers to turn authenticated identity + vault ref → plaintext.
// Secret VALUES NEVER cross the MCP wire — broker tools are handle/lease-only; resolution here,
// inside the trusted server, using the caller's OWN verified auth.
//
// FOUR invariants (vault premortem 2026-06-08):
//   1. FAIL CLOSED: resolve with no authenticated owner is DENIED. No admin/default fallback.
//   2. SCOPED (optional): access policy checked BEFORE store is touched — no timing oracle.
//   3. OWNER-BOUND: authenticated owner passed to SecretStore.get, which re-checks isolation inside.
//   4. AUDITED: every attempt (allowed OR denied) emits audit carrying owner+ref+outcome — NEVER the value.
//
// Consumers MUST derive authenticatedOwnerId from VERIFIED auth (Studio session, Fleet seat owner),
// NEVER from untrusted request input.
//
// SecretResolveAudit { event, owner_id, ref, purpose, outcome, reason, at }  — no value
// AuthRequiredError — resolve without authenticated owner
// createSecretResolver({ store, policy?, audit? }) → SecretResolver

@trait secret_resolver {
  capability_tags: ["secret_resolver", "fail_closed", "hologate_admit", "audited", "owner_bound", "secrets_broker"]

  @on_spawn(store, policy, audit_sink) => {
    resolver = create_secret_resolver({ store: store, policy: policy, audit: audit_sink })
    emit("secret_resolver_ready", {})
  }

  @on_resolve(ref, authenticated_owner_id, purpose) => {
    result = resolver.resolve(ref, { owner_id: authenticated_owner_id, purpose: purpose })
    emit("secret_resolved", { ref: ref, outcome: result.outcome })
    return result
  }

  @receipt secret_resolver_config {
    type: "SecretResolverReceipt"
    invariants: ["fail_closed", "scoped", "owner_bound", "audited"]
    audit: "owner+ref+outcome ONLY — secret value NEVER in audit event"
    timestamp: now()
  }
}
