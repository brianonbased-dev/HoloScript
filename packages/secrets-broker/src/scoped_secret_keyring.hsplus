// @scoped_secret_keyring — Production KEK from service-scoped secret env vars.
//
// Native .hsplus surface for scoped-secret-keyring.ts (secrets-broker).
//
// Implements KmsKeyring by reading the KEK from a dedicated, service-scoped namespace.
// The premortem's accepted minimum: "a Railway secret scoped to ONLY the one service
// that decrypts, never the shared root."
//
// Deployment contract (LOAD-BEARING):
//   HOLOKEY_PROD_KEK_CURRENT — current KEK ID (service-scoped, NEVER in git/.env/Dockerfile)
//   HOLOKEY_PROD_KEK_<KEKID> — 32-byte hex KEK (service-scoped, NEVER in git/.env/Dockerfile)
//   MUST be provisioned in the platform secret UI for ONLY the resolver service, not shared root.
//
// HOLOKEY_PROD_* prefix (vs dev SECRETS_VAULT_KEK_*) signals production service-scoped material.
// Passing result to createKmsKekProvider yields productionGrade: true (gate-accepted).
//
// ScopedSecretKeyringError — thrown when material is missing or malformed (carries NO key bytes).
// ScopedSecretKeyringDeps { env?, prefix? }
// createScopedSecretKeyring(deps) → KmsKeyring
// KEK_BYTES = 32, DEFAULT_PREFIX = "HOLOKEY_PROD_KEK"

@trait scoped_secret_keyring {
  kek_bytes: Int = 32
  default_prefix: String = "HOLOKEY_PROD_KEK"

  capability_tags: ["scoped_secret_keyring", "kek_provider", "production", "holokey", "secrets_broker"]

  @on_spawn(deps) => {
    keyring = create_scoped_secret_keyring(deps)
    emit("scoped_secret_keyring_ready", { prefix: deps.prefix ?? default_prefix })
  }

  @on_get_current_kek => {
    return keyring.get_current_kek()
  }

  @on_get_kek(kek_id) => {
    return keyring.get_kek(kek_id)
  }

  @receipt scoped_secret_keyring_config {
    type: "ScopedSecretKeyringReceipt"
    kek_bytes: kek_bytes
    prefix: default_prefix
    scope: "service-scoped Railway secret — NEVER in git/.env/Dockerfile/shared root"
    grade: "productionGrade: true when wrapped with createKmsKekProvider"
    timestamp: now()
  }
}
