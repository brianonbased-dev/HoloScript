// @secret_store — Envelope-encrypted per-owner SecretStore (the value-holding half).
//
// Native .hsplus surface for secret-store.ts (secrets-broker).
//
// The lease adapter answers "may this agent read this ref?" — this module holds the actual
// encrypted value and only decrypts for the authenticated owner.
//
// Crypto — AES-256-GCM envelope encryption (matches custodial-wallet.ts house style):
//   value  ──AES-256-GCM(DEK, iv12)──▶ { ciphertext, iv, auth_tag }
//   DEK    ──AES-256-GCM(KEK, dek_iv12)──▶ { wrapped_dek, dek_iv, dek_auth_tag }
//   One fresh 32-byte DEK per secret. KEK sourced by INJECTED kekProvider (NEVER process.env here).
//   Every row records the kekId so rotateKek can re-wrap exactly the rows under an old KEK.
//
// Security invariant: get() checks owner INSIDE the function — throws OwnerMismatchError WITHOUT
// decrypting if row.owner_id !== ownerId. Isolation never assumed to live upstream.
// GCM auth tag: any tamper fails the tag check → DecryptError (never garbage output).
// Errors carry ZERO secret material.
//
// Exports (secret-store.ts):
//   createSecretStore({ backend, kekProvider }) → SecretStore
//   createInMemorySecretBackend() → SecretStoreBackend  (tests/dev)
//   SECRET_STORE_DDL — Postgres table DDL
//   OwnerMismatchError, DecryptError, SecretNotFoundError
//   KEY_BYTES=32, IV_BYTES=12, AUTH_TAG_BYTES=16, CIPHER="aes-256-gcm"

@trait secret_store {
  key_bytes: Int = 32
  iv_bytes: Int = 12
  cipher: String = "aes-256-gcm"

  capability_tags: ["secret_store", "envelope_encryption", "aes_256_gcm", "owner_isolation", "holokey", "secrets_broker"]

  @on_spawn(backend, kek_provider) => {
    store = create_secret_store({ backend: backend, kek_provider: kek_provider })
    emit("secret_store_ready", {})
  }

  @on_put(owner_id, ref, value) => {
    store.put(owner_id, ref, value)
    emit("secret_put", { ref: ref, owner_id: owner_id })
  }

  @on_get(owner_id, ref) => {
    return store.get(owner_id, ref)
  }

  @on_delete(owner_id, ref) => {
    store.delete(owner_id, ref)
    emit("secret_deleted", { ref: ref })
  }

  @on_rotate_kek(old_kek_id, new_kek_provider) => {
    count = store.rotate_kek(old_kek_id, new_kek_provider)
    emit("kek_rotated", { old_kek_id: old_kek_id, rows_rewrapped: count })
    return count
  }

  @receipt secret_store_config {
    type: "SecretStoreReceipt"
    cipher: cipher
    key_bytes: key_bytes
    iv_bytes: iv_bytes
    owner_isolation: "enforced INSIDE get() — never assumed upstream"
    errors_carry_no_secret_material: true
    timestamp: now()
  }
}
