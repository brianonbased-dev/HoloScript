// @service_secret_resolver — Vault-first / env-fallback bridge for service-side secret resolution.
//
// Native .hsplus surface for service-secret-resolver.ts (secrets-broker).
//
// Incremental migration off per-service plaintext env (no flag day, no boot coupling):
//   resolve('OPENAI_API_KEY') → vault value (if vault ON and key stored) OR process.env fallback
//   Until the key is put in the vault, nothing changes. Once it is, transparently picks it up.
//
// Fail-safe by construction: vault built lazily on first resolve and cached.
// ANY failure (no KEK, DDL/pool error, decrypt error, not-found, denied) → falls through to env.
// Logs ONE affirmation line (vault ON / OFF) for observability — silent-off vault is detectable.
//
// ServiceSecretResolverOpts (service-secret-resolver.ts):
//   env?:   Env = process.env
//   query?: SecretQueryRunner['query']  — absent → in-memory (non-persistent/dev)
//   owner?: String  — absent → derived from HoloKey/HoloMesh/fleet/Railway/x402 env signals
//   audit?: (e: SecretResolveAudit) → void
//   log?:   (msg: String) → void  (pass no-op to silence in tests)
//   vault?: HoloKeyVault | null  — pre-built vault (advanced wiring/tests)
//
// resolveServiceSecret = (name: String) → Promise<String | undefined>  — the consumer surface

@trait service_secret_resolver {
  capability_tags: ["service_secret_resolver", "vault_first", "env_fallback", "incremental_migration", "secrets_broker"]

  @on_spawn(opts) => {
    resolver = create_service_secret_resolver(opts)
    emit("service_secret_resolver_ready", {})
  }

  @on_resolve(name) => {
    value = resolver.resolve(name)
    emit("service_secret_resolved", { name: name, source: value.source })
    return value.value
  }

  @receipt service_secret_resolver_config {
    type: "ServiceSecretResolverReceipt"
    strategy: "vault-first; any vault failure → env fallback (fail-safe)"
    migration: "incremental — no flag day; swap process.env.X for resolveServiceSecret('X') in-place"
    affirmation: "logs vault ON/OFF once on first resolve"
    timestamp: now()
  }
}
