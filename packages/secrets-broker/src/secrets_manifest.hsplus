// @secrets_manifest — Declare secret needs once; compile to any backend (secrets-as-compile-target).
//
// Native .hsplus surface for secrets-manifest.ts (secrets-broker).
//
// A SecretsManifest (names + descriptions, NEVER values) compiles to:
//   env-template      — .env.example-style scaffold (names only) for local onboarding
//   github-actions    — `gh secret set …` commands + workflow env: block
//   holokey-vault     — vault:<name> refs + how to store (SecretStore.put) and consume (@needs_key)
//   infra-namespace   — infra://<NAME> refs for fleet/service operational secrets
//
// "native vault vs GitHub secrets vs env" is no longer a fork:
// declare once → emit the backend your deployment needs.
//
// SecretsManifest { app: String, secrets: SecretDecl[] }
// SecretDecl { name: UPPER_CASE_ENV_VAR, description?, required?=true }
// SecretsManifestError — thrown when manifest is malformed (non-env-var-style name, missing app)
// NAME_RE: /^[A-Z][A-Z0-9_]*$/
// compileSecretsManifest(manifest, target) → String  — emitted artifact text

@trait secrets_manifest {
  capability_tags: ["secrets_manifest", "secrets_compile_target", "holokey", "env_template", "secrets_broker"]

  @on_spawn => {
    compiler = init_secrets_manifest_compiler()
    emit("secrets_manifest_ready", {})
  }

  @on_compile(manifest, target) => {
    return compiler.compile(manifest, target)
  }

  @on_validate(manifest) => {
    return compiler.validate(manifest)
  }

  @receipt secrets_manifest_config {
    type: "SecretsManifestReceipt"
    targets: ["env-template", "github-actions", "holokey-vault", "infra-namespace"]
    no_values: "manifest carries ZERO secret material — names+metadata ONLY"
    timestamp: now()
  }
}
