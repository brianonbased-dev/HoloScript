// @postgres_secret_backend — Production Postgres storage for the encrypted SecretStore.
//
// Native .hsplus surface for postgres-secret-backend.ts (secrets-broker).
//
// Holds ONLY ciphertext + crypto metadata — NEVER plaintext values as columns, params, or logs.
// Envelope encryption lives in SecretStore; this module persists sealed SecretRow and reads it back.
//
// Decoupling: INJECTED query runner (same pattern as postgres-lease-adapter.ts + mcp-server).
// No driver runtime dep — imports only SecretStoreBackend/SecretRow types.
//
// Schema: `secret_store` table (SECRET_STORE_DDL).
// bytea ⇄ Buffer: ciphertext/crypto columns round-trip as Node Buffers (pg driver → bytea).
// timestamptz ⇄ ISO string: createdAt and lastUsedAt normalized via asIsoString helpers.
// Strict column narrowing: malformed/missing required column THROWS (never silently returns garbage).
//
// SecretQueryRunner { query(sql, params) → { rows } }
// createPostgresSecretBackend({ query }) → SecretStoreBackend
// SECRET_STORE_DDL — table DDL to run before first use

@trait postgres_secret_backend {
  capability_tags: ["postgres_secret_backend", "secret_store", "postgres", "production", "holokey", "secrets_broker"]

  @on_spawn(query_runner) => {
    backend = create_postgres_secret_backend({ query: query_runner })
    emit("postgres_secret_backend_ready", {})
  }

  @on_put(secret_row) => {
    backend.put(secret_row)
    emit("secret_stored", { ref: secret_row.ref, owner_id: secret_row.owner_id })
  }

  @on_get(ref, owner_id) => {
    return backend.get(ref, owner_id)
  }

  @on_delete(ref, owner_id) => {
    backend.delete(ref, owner_id)
    emit("secret_deleted", { ref: ref })
  }

  @receipt postgres_secret_backend_config {
    type: "PostgresSecretBackendReceipt"
    no_plaintext: "ONLY ciphertext + crypto metadata stored; plaintext NEVER in columns/params/logs"
    driver_dep: "none — injected query runner only"
    strict: "corrupt row throws, never returns garbage"
    timestamp: now()
  }
}
