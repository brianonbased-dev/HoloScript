// @holoshell_local_codebase_snapshot_receipt -- Local codebase snapshot receipt.
//
// Native .hsplus surface for framework/board/holoshell-local-codebase-snapshot-receipt.ts.
//
// Proves that a HoloShell codebase-intelligence claim was built from local
// filesystem state or an explicitly replayable sourceFiles bundle.

composition "HoloShellLocalCodebaseSnapshotReceiptSurface" {
  module HoloShellLocalCodebaseSnapshotReceiptContract {
    state {
      hash_algorithm: "sha256"
      statuses: ["ready", "warn", "blocked"]
      redaction_statuses: ["pass", "warn", "fail"]
      privacy_classes: ["source", "generated", "secret-adjacent", "unknown"]
      skip_reasons: [
        "excluded-directory",
        "excluded-file",
        "unsupported-extension",
        "too-large",
        "secret-adjacent",
        "binary",
        "file-cap",
        "byte-cap",
        "read-error"
      ]
      capability_tags: [
        "holoshell_local_codebase_snapshot_receipt",
        "codebase_snapshot",
        "sourcefiles_replay",
        "graph_receipt",
        "audit_trail",
        "framework"
      ]
    }

    action validate_shape(receipt) {
      emit("holoshell_local_codebase_snapshot_validate_requested", {
        receipt: receipt,
        hash_algorithm: this.state.hash_algorithm
      });

      return {
        receipt: receipt,
        required_fields: [
          "id",
          "workflow",
          "startedAt",
          "endedAt",
          "roots",
          "files",
          "skippedFiles",
          "sourceFiles",
          "totalFiles",
          "totalBytes",
          "maxFiles",
          "maxBytes",
          "redactionStatus",
          "status",
          "excludes",
          "replayCommand",
          "hash",
          "hashAlgorithm"
        ],
        optional_fields: ["graphReceipt", "verificationCommands", "metadata"]
      };
    }

    action receipt() {
      return {
        type: "HoloShellLocalCodebaseSnapshotReceipt",
        status_values: this.state.statuses,
        redaction_status_values: this.state.redaction_statuses,
        privacy_classes: this.state.privacy_classes,
        skip_reasons: this.state.skip_reasons,
        hash_algorithm: this.state.hash_algorithm,
        timestamp: current_time()
      };
    }

    exports { validate_shape, receipt, state }
  }
}
