// @founder_reversibility — SSOT for typed authority routing.
//
// Native .hsplus surface for framework/board/founder-reversibility.ts.
// Joseph review is limited to the exact four protected classes:
//   1. spend beyond the active rail or treasury/custody-authority identity change
//   2. physical commitment requiring Joseph body/signature/presence
//   3. public commitment under Joseph name/face/voice
//   4. governance-tier founder-authority or escalation-criteria mutation
// Specialist review, platform controls, and prohibited replanning are separate.
// Force-push and hard-reset are prohibited, never approvable.

@trait founder_reversibility {
  capability_tags: ["exact_four_authority", "typed_authority_routes", "active_rail_policy", "ssot", "framework"]

  @on_spawn => {
    emit("authority_router_ready", {})
  }

  @on_classify(intent, context) => {
    return classify_authority_route(intent, context)
  }

  @receipt founder_reversibility_config {
    type: "FounderAuthorityRoutingReceipt"
    authority_routes: ["autonomous", "joseph_exact_four", "specialist_review", "platform_control", "prohibited_replan"]
    joseph_review_classes: ["spend_or_custody", "physical_presence", "public_identity", "governance"]
    consumers: ["mcp-server authority", "studio projection"]
    timestamp: now()
  }
}
