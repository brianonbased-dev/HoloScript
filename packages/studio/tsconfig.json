{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext", "webworker"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@holoscript/core": ["../core/dist/index.d.ts"],
      "@holoscript/core/*": ["../core/dist/*"],
      "@holoscript/engine": ["../engine/src"],
      "@holoscript/engine/*": ["../engine/src/*"],
      "@holoscript/std": ["../std/src/index.ts"],
      "@holoscript/std/*": ["../std/src/*"],
      // Narrow source-maps for the specific subpath modules studio imports whose
      // packages are Docker-built with `tsup --dts-only` and therefore ship NO
      // subpath .d.ts in dist (implicit-any typecheck failures). Map ONLY the exact
      // modules imported — NOT a `/*` wildcard, which would drag the whole package's
      // type surface (e.g. r3f-renderer's R3F .tsx) into studio's typecheck and fail
      // on JSX.IntrinsicElements it doesn't augment.
      "@holoscript/r3f-renderer/hooks/useWebcamGaze": [
        "../r3f-renderer/src/hooks/useWebcamGaze.ts"
      ],
      "@holoscript/studio-plugin-sdk/sandbox": ["../studio-plugin-sdk/dist/sandbox/index.d.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "e2e",
    "playwright.config.ts",
    "drizzle.config.ts",
    "scripts",
    "**/__tests__/**",
    "**/__benchmarks__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "src/browser-benchmark.test.ts",
    "src/lib/scenarios/**"
  ]
}
