// @agent_api_route — Agent API route: spawns and communicates with HoloScript agents via the Studio API.
//
// Native .hsplus surface for studio/src/app/api/agent/route.ts.

@trait agent_api_route {
  capability_tags: ["agent_api_route", "agent_spawn_communicate_api", "studio_agent_api", "studio"]
  @on_spawn => { emit("agent_api_route_ready", {}) }
  @on_post(request) => { return invoke_agent(request) }
  @receipt agent_api_route_config { type: "AgentApiRouteReceipt"; timestamp: now() }
}
