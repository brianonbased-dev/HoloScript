// @absorb_proxy_route — Absorb proxy route: catch-all proxy forwarding absorb requests to the absorb service.
//
// Native .hsplus surface for studio/src/app/api/absorb/[...path]/route.ts.

@trait absorb_proxy_route {
  capability_tags: ["absorb_proxy_route", "absorb_service_proxy_catchall", "studio_absorb_api_proxy", "studio"]
  @on_spawn => { emit("absorb_proxy_route_ready", {}) }
  @on_request(request, path) => { return proxy_absorb_request(request, path) }
  @receipt absorb_proxy_route_config { type: "AbsorbProxyRouteReceipt"; timestamp: now() }
}
