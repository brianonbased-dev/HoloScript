// @annotations_route — Annotations route: top-level CRUD for scene annotations across all sessions.
//
// Native .hsplus surface for studio/src/app/api/annotations/route.ts.

@trait annotations_route {
  capability_tags: ["annotations_route", "scene_annotation_toplevel_api", "annotation_list_create_api", "studio"]
  @on_spawn => { emit("annotations_route_ready", {}) }
  @on_get(request) => { return list_annotations(request) }
  @on_post(request) => { return create_annotation(request) }
  @receipt annotations_route_config { type: "AnnotationsRouteReceipt"; timestamp: now() }
}
