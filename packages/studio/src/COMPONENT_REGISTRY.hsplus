// @studio_component_registry — Studio component registry: central registry of all Studio UI components and their metadata.
//
// Native .hsplus surface for studio/src/COMPONENT_REGISTRY.ts.

@trait studio_component_registry {
  capability_tags: ["studio_component_registry", "studio_ui_component_register", "component_metadata_registry", "studio"]
  @on_spawn => {
    init_studio_component_registry()
    emit("studio_component_registry_ready", {})
  }
  @receipt studio_component_registry_config { type: "StudioComponentRegistryReceipt"; timestamp: now() }
}
