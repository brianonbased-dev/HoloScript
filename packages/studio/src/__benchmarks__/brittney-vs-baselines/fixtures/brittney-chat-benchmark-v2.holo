composition "Brittney Chat Benchmark V2" {
  metadata {
    benchmark: "brittney-chat"
    version: "v2"
    regression_gate: "known-traits-only"
  }

  scene "Admission" {
    object "PromptCorpus" @data_quality @schema_migrate {
      geometry: "cube"
      position: [-1.5, 1, -3]
      scale: [0.4, 0.4, 0.4]
      color: "#4f8cff"
      state: {
        schema: "holotune.brittney-chat.v2"
        encoding: "jsonl"
        required_fields: ["system", "prompt", "chosen", "rejected", "metadata"]
      }
    }

    object "LatencyProbe" @telemetry @slo_monitor @profiler {
      geometry: "sphere"
      position: [0, 1, -3]
      scale: [0.35, 0.35, 0.35]
      color: "#00c27a"
      state: {
        metric: "chat_response_latency_ms"
        budget_ms: 2000
        percentile: "p95"
      }
    }

    object "SafetyGate" @moderation @care_ethics @audit_log {
      geometry: "cube"
      position: [1.5, 1, -3]
      scale: [0.4, 0.4, 0.4]
      color: "#ff6b6b"
      state: {
        policy: "reject_destructive_language"
        evidence: "audit_log"
        failure_mode: "safe_refusal"
      }
    }
  }
}
