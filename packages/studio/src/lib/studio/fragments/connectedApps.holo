composition "ConnectedApps" {
  @verified_view
  @native_fragment

  object "Root" {
    @layout { flex: "column", gap: "8px" }
    @theme { className: "mx-auto mt-6 max-w-[700px] rounded-xl bg-[#1a1a2e] p-6 text-[#e0e0e0]", attributes: '{"data-testid":"connected-apps"}' }
    @fetch { endpoint: "/api/oauth/grants", into: "apps", select: "grants", cache: "no-store", status: "appsStatus", error: "appsError", error_text: "Couldn't load your connected apps. Try again?" }
    @mutation { name: "revoke", method: "DELETE", endpoint: "/api/oauth/grants?id={id}", ok_status: [204, 404], pending: "revokingId", error: "appsError", error_text: "Couldn't revoke that app. Try again?", confirm: "Revoke this app's access? It will need your permission again to connect.", on_ok: { remove: { from: "apps", where: "id" } } }
    @computed { name: "rows", expr: "connectedAppRows(apps, revokingId)", from: "@/lib/oauth/connectedAppRows", uses: "connectedAppRows" }

    object "Header" {
      @layout { flex: "row", gap: "12px" }
      object "Title" {
        @text { variant: "h2", content: "Connected apps" }
        @theme { className: "m-0 text-xl" }
      }
      object "Badge" {
        @text { variant: "caption", content: "Agent access" }
        @theme { className: "rounded-full bg-[#2d2d4a] px-2 py-0.5 text-xs text-[#a0a0ff]" }
      }
    }

    object "Description" {
      @text { variant: "body", content: "Agents and apps you approved to act for you. Revoke one to cut off its access right away." }
      @theme { className: "m-0 text-sm text-[#aaa]" }
    }

    object "Loading" {
      @when { state: "appsStatus", eq: "loading" }
      @text { variant: "body", content: "Loading..." }
      @theme { className: "py-3 text-sm text-[#888]" }
    }

    object "Empty" {
      @when { state: "appsStatus", eq: "empty" }
      @text { variant: "body", content: "No connected apps." }
      @theme { className: "py-3 text-sm text-[#888]" }
    }

    object "List" {
      @when { state: "appsStatus", eq: "ready" }
      @layout { flex: "column", gap: "8px" }
      @theme { className: "m-0 list-none p-0" }

      object "Row" {
        @each { state: "rows", as: "row" }
        @projects { node: "rows" }
        @layout { flex: "row", justify: "space-between", gap: "12px" }
        @theme { className: "items-start rounded-lg bg-[#22223a] p-3" }

        object "Info" {
          @layout { flex: "column", gap: "4px" }
          @theme { className: "min-w-0" }
          object "NameLine" {
            @layout { flex: "row", gap: "8px" }
            @theme { className: "items-center font-semibold" }
            object "Name" {
              @text { variant: "body" }
              @bind { state: "row", path: "name", fallback: "Unnamed app" }
              @projects { node: "row.name" }
            }
            object "Unverified" {
              @when { state: "row", path: "unverifiedText", present: true }
              @text { variant: "caption" }
              @bind { state: "row", path: "unverifiedText", fallback: "" }
              @projects { node: "row.unverifiedText" }
              @theme { className: "rounded bg-[#4a3a1a] px-1.5 text-[0.7rem] font-medium text-[#ffcc66]", attributes: '{"title":"The app chose this name; it is not verified."}' }
            }
          }
          object "Lookalike" {
            @when { state: "row", path: "lookalikeText", present: true }
            @text { variant: "caption" }
            @bind { state: "row", path: "lookalikeText", fallback: "" }
            @projects { node: "row.lookalikeText" }
            @theme { className: "text-xs font-semibold text-[#ff9b6b]", attributes: '{"role":"note"}' }
          }
          object "AppId" {
            @text { variant: "caption" }
            @bind { state: "row", path: "appIdText", fallback: "" }
            @projects { node: "row.appIdText" }
            @theme { className: "break-all text-xs text-[#888]" }
          }
          object "Scopes" {
            @layout { flex: "column" }
            @theme { className: "m-0 pl-[18px] text-[0.8rem] text-[#ccc]" }
            object "Scope" {
              @each { state: "row", path: "scopes", as: "s" }
              @projects { node: "row.scopes" }
              object "ScopeText" {
                @projects { node: "s" }
                @text { variant: "caption" }
                @bind { state: "s", fallback: "" }
              }
            }
          }
          object "Dates" {
            @text { variant: "caption" }
            @bind { state: "row", path: "datesText", fallback: "" }
            @projects { node: "row.datesText" }
            @theme { className: "break-all text-xs text-[#888]" }
          }
        }

        object "Revoke" {
          @button { type: "button" }
          @action { call: "revoke", args: { id: "row.id" } }
          @theme { className: "shrink-0 cursor-pointer rounded-md border border-[#ff6b6b] bg-transparent px-3 py-1.5 text-[#ff6b6b] disabled:cursor-default disabled:opacity-50" }
          object "RevokeLabel" {
            @text { variant: "caption" }
            @bind { state: "row", path: "revokeLabel", fallback: "Revoke" }
            @projects { node: "row.revokeLabel" }
            @theme { attributes: '{"aria-hidden":"true"}' }
          }
          object "RevokeName" {
            @text { variant: "caption" }
            @bind { state: "row", path: "revokeName", fallback: "" }
            @projects { node: "row.revokeName" }
            @theme { className: "sr-only" }
          }
        }
      }
    }

    object "Alert" {
      @when { state: "appsError", present: true }
      @text { variant: "body" }
      @bind { state: "appsError", fallback: "" }
      @projects { node: "appsError" }
      @theme { className: "mt-3 text-sm text-[#ff9b9b]", attributes: '{"role":"alert"}' }
    }
  }
}
