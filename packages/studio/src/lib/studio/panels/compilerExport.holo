@view({ id: "compilerExport", title: "Compiler Export", icon: "Package", category: "assistant", placement: "right-rail", scope: "workspace", gate: "always", surfaceClass: "lab", defaultOpen: false, exclusiveWith: [], order: 46 })
composition "compilerExport" {
  @verified_view
  @native_panel

  state {
    status: "pending"
    targetCount: 0
    totalKb: 0
  }

  object "Root" {
    @layout { flex: "column", gap: "12px" }
    @theme { className: "p-3 h-full overflow-y-auto text-xs text-studio-text" }

    object "Title" {
      @text { variant: "h3", content: "Compiler Export" }
      @theme { className: "text-sm font-semibold text-studio-text" }
    }
    object "Subtitle" {
      @text { variant: "caption", content: "Last fan-out job — twin-checked against compile-job-studio" }
      @theme { className: "text-[10px] text-studio-muted" }
    }

    object "StatusRow" {
      @layout { flex: "row", justify: "space-between" }

      object "StatusLabel" {
        @text { variant: "caption", content: "Job status" }
        @theme { className: "text-[10px] text-studio-muted" }
      }
      object "StatusValue" {
        @text { variant: "caption" }
        @bind { state: "status", fallback: "pending" }
        @theme { className: "font-semibold text-studio-text" }
        @projects { node: "status", entity: "compile-job-studio" }
      }
    }

    object "TargetCountRow" {
      @layout { flex: "row", justify: "space-between" }

      object "TargetCountLabel" {
        @text { variant: "caption", content: "Targets compiled" }
        @theme { className: "text-[10px] text-studio-muted" }
      }
      object "TargetCountValue" {
        @text { variant: "caption" }
        @bind { state: "targetCount", fallback: "0" }
        @theme { className: "font-semibold text-studio-text" }
        @projects { node: "targetCount", entity: "compile-job-studio" }
      }
    }

    object "TotalSizeRow" {
      @layout { flex: "row", justify: "space-between" }

      object "TotalSizeLabel" {
        @text { variant: "caption", content: "Total output" }
        @theme { className: "text-[10px] text-studio-muted" }
      }
      object "TotalSizeValue" {
        @text { variant: "caption" }
        @bind { state: "totalKb", precision: 2, suffix: " KB" }
        @theme { className: "text-[10px] text-studio-muted" }
        @projects { node: "totalKb", entity: "compile-job-studio" }
      }
    }
  }
}
