// @use_orchestration_auto_save — useOrchestrationAutoSave hook: Studio hook for auto-saving orchestration workflow state.
//
// Native .hsplus surface for studio/src/hooks/useOrchestrationAutoSave.ts.

@trait use_orchestration_auto_save {
  capability_tags: ["use_orchestration_auto_save", "orchestration_auto_save_hook", "workflow_state_save", "studio"]
  @on_spawn => {
    start_orchestration_auto_save()
    emit("use_orchestration_auto_save_ready", {})
  }
  @receipt use_orchestration_auto_save_config { type: "UseOrchestrationAutoSaveReceipt"; timestamp: now() }
}
