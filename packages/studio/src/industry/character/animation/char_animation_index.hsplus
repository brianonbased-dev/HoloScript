// @industry_char_animation — Industry character animation: industry-specific character animation presets and rig configs.
//
// Native .hsplus surface for studio/src/industry/character/animation/index.ts.

@trait industry_char_animation {
  capability_tags: ["industry_char_animation", "character_animation_preset_rig", "industry_char_anim_hook", "studio"]
  @on_spawn => { emit("industry_char_animation_ready", {}) }
  @receipt industry_char_animation_config { type: "IndustryCharAnimationReceipt"; timestamp: now() }
}
