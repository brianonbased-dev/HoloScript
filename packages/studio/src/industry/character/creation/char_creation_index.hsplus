// @industry_char_creation — Industry character creation: guided character creation flow for industry vertical audiences.
//
// Native .hsplus surface for studio/src/industry/character/creation/index.ts.

@trait industry_char_creation {
  capability_tags: ["industry_char_creation", "guided_char_creation_flow", "industry_audience_char", "studio"]
  @on_spawn => { emit("industry_char_creation_ready", {}) }
  @receipt industry_char_creation_config { type: "IndustryCharCreationReceipt"; timestamp: now() }
}
