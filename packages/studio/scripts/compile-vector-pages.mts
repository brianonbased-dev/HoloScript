#!/usr/bin/env tsx
/**
 * compile-vector-pages.mts — compile HoloScript 2D-vector .holo pages to @generated
 * Next.js page.tsx via the Vector2DCompiler (the native 2D-vector / data-viz target).
 *
 * Sibling to compile-holo-pages.ts (which uses NextJSCompiler for shell pages); this one
 * handles pages whose composition is a 2D-vector scene (radar / chart). The output carries
 * the `@generated by HoloScript Vector2DCompiler` header so it passes the render-surface
 * native freeze natively. Wire into prebuild once the set of vector pages grows.
 *
 *   pnpm tsx scripts/compile-vector-pages.mts
 */
import { readFileSync, writeFileSync, mkdirSync } from 'node:fs';
import { join, dirname } from 'node:path';
import { parseHolo } from '../../core/src/parser/HoloCompositionParser';
import { Vector2DCompiler } from '../../core/src/compiler/Vector2DCompiler';
import type { HoloComposition } from '../../core/src/parser/HoloCompositionTypes';

const STUDIO_ROOT = join(import.meta.dirname || __dirname, '..');

const PAGES: Array<{ src: string; out: string; component: string }> = [
  {
    src: join(STUDIO_ROOT, 'holo-pages', 'agent-ability', 'page.holo'),
    out: join(STUDIO_ROOT, 'src', 'app', 'agent-ability', 'page.tsx'),
    component: 'AgentAbility',
  },
];

let failed = 0;
for (const page of PAGES) {
  const source = readFileSync(page.src, 'utf-8');
  const parsed = parseHolo(source);
  if (!parsed.success || !parsed.ast) {
    console.error(`✗ parse error in ${page.src}:`, JSON.stringify(parsed.errors ?? []).slice(0, 400));
    failed++;
    continue;
  }
  const { code, componentName } = new Vector2DCompiler().compile(parsed.ast as unknown as HoloComposition, {
    componentName: page.component,
  });
  mkdirSync(dirname(page.out), { recursive: true });
  writeFileSync(page.out, code);
  console.log(`✓ ${componentName} → ${page.out} (${code.length} bytes)`);
}
process.exit(failed > 0 ? 1 : 0);
