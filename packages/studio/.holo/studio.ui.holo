  api_endpoint "/api/user/api-keys/[id]" { @used_in([settings]) }
  api_endpoint "/api/users/[id]" { @used_in([settings, u_username]) }
  api_endpoint "/api/workspace/paper-opt-in" { @used_in([workspace]) }
  api_endpoint "/api/workspace/provision" { @used_in([page_tsx, start]) }

  // Zustand stores — which pages consume each store
  store AbsorbServiceStore { @used_in([absorb_admin]) }
  store AgentStore { @used_in([create, vertical, vibe]) }
  store AIStore { @used_in([vertical]) }
  store AssetStore { @used_in([create, vertical]) }
  store AvatarStore { @used_in([avatar]) }
  store BuilderStore { @used_in([create, lotus_slice, vertical, vibe, view_id]) }
  store CharacterStore { @used_in([character]) }
  store CollabStore { @used_in([create]) }
  store ConnectorStore { @used_in([integrations]) }
  store EditorStore { @used_in([build, create, lotus_slice, vertical, vibe, view_id]) }
  store HistoryLabelStore { @used_in([create]) }
  store NodeGraphStore { @used_in([create]) }
  store OrchestrationStore { @used_in([create, vibe]) }
  store PanelVisibilityStore { @used_in([create, vertical]) }
  store PhysicsStore { @used_in([create, vertical, vibe, view_id]) }
  store ProjectStore { @used_in([create]) }
  store SceneGraphStore { @used_in([build, create, lotus_slice, start, vertical, vibe, view_id]) }
  store SceneStore { @used_in([build, create, playground, start, vertical, vibe, view_id, workspace_agents_new, workspace_templates_new]) }
  store SketchStore { @used_in([create, vertical, vibe, view_id]) }
  store StudioPresetStore { @used_in([vertical]) }
  store TemporalStore { @used_in([create]) }
  store TraitState { @used_in([playground_locomotion]) }
  store WorkspaceStore { @used_in([create, vertical, vibe, workspace_agents_new, workspace_templates_new]) }

}
