// @lif_determinism_probe — Paper #2 empirical substrate: LIF GPU determinism probe.
//
// Native .hsplus surface for snn-webgpu/paper/LIFDeterminismProbe.ts.
//
// Runs a fixed-input LIF sim through the GPU; returns ProbeResult { outputHash }.
//
// Determinism scope (empirically verified 2026-05-10):
//   Same-backend: hash is bit-identical
//   Cross-vendor (NVIDIA Ampere vs Intel Gen-12LP): membrane potentials diverge by ~1.5e-5
//   → Spike masks are bit-identical cross-vendor (threshold comparison is discrete)
//   → Cryptographic determinism receipt for SPIKE DECISIONS holds cross-vendor
//   → Membrane-potential hash is backend-scoped only
//
// runLIFDeterminismProbe(ctx, { neuron_count, tick_count, stimulus_seed }) → ProbeResult

@trait lif_determinism_probe {
  capability_tags: ["lif_determinism_probe", "determinism", "paper2", "gpu_hash", "snn_webgpu"]

  @on_spawn(ctx) => {
    probe = init_lif_determinism_probe(ctx)
    emit("lif_determinism_probe_ready", {})
  }

  @on_probe(neuron_count, tick_count, stimulus_seed) => {
    result = probe.run(neuron_count, tick_count, stimulus_seed)
    emit("probe_complete", { output_hash: result.output_hash })
    return result
  }

  @receipt lif_determinism_probe_config {
    type: "LIFDeterminismProbeReceipt"
    cross_vendor_guarantee: "spike decisions (discrete threshold) — NOT membrane potentials (f32 ULP)"
    verified: "2026-05-10"
    timestamp: now()
  }
}
