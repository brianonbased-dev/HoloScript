// @lif_determinism_probe — Paper #2 empirical substrate: LIF GPU determinism probe.
//
// Native .hsplus surface for snn-webgpu/paper/LIFDeterminismProbe.ts.
//
// Runs a fixed-input LIF sim through the GPU; returns ProbeResult { outputHash }.
//
// Evidence scope:
//   output_hash covers final membrane-potential bytes, not spike masks.
//   A 2026-05-10 NVIDIA/Intel observation produced different membrane hashes.
//   Same-backend GPU repeatability requires a confirmed live GPU backend;
//   fallback/mock convergence is not hardware evidence.
//
// runLIFDeterminismProbe(ctx, { neuron_count, tick_count, stimulus_seed }) → ProbeResult

@trait lif_determinism_probe {
  capability_tags: ["lif_determinism_probe", "determinism", "paper2", "gpu_hash", "snn_webgpu"]

  @on_spawn(ctx) => {
    probe = init_lif_determinism_probe(ctx)
    emit("lif_determinism_probe_ready", {})
  }

@on_probe(neuron_count, tick_count, stimulus_seed) => {
  result = probe.run(neuron_count, tick_count, stimulus_seed)
  emit("probe_complete", { output_hash: result.output_hash })
  return result
}

@receipt lif_determinism_probe_config {
  type: "LIFDeterminismProbeReceipt"
  output_hash_scope: "final membrane-potential bytes"
  same_backend_claim: "repeatability only when a live GPU backend is confirmed"
  cross_vendor_status: "NVIDIA and Intel membrane hashes differed in the 2026-05-10 observation"
  spike_mask_status: "not measured by this probe"
  gpu_evidence_requirement: "GPU_LIVE must be true; fallback convergence is not GPU evidence"
  observation_date: "2026-05-10"
  timestamp: now()
}
}
