// @snn_accelerator — SNN-WebGPU LIF population coding for HoloEmbed.
//
// Native .hsplus surface for SnnAccelerator.ts (holoembed).
//
// Replaces static char-trigram histogram blocks with Leaky Integrate-and-Fire
// population coding (see Paper 33 — brain white-matter routing):
//
//   Input:   128-dim normalized trigram histogram h[0..127]
//   Process: inject h[i] as synaptic current into LIF neuron i
//            simulate T timesteps at dt=1ms (default T=50)
//   Output:  128-dim spike-rate vector r[i] = spikes_i / T
//
// LIF params (SnnAccelerator.ts WGSL shader):
//   tau           = 20.0 ms  (membrane time constant)
//   v_threshold   = -55.0 mV (spike threshold)
//   v_reset       = -75.0 mV (post-spike reset)
//   v_rest        = -65.0 mV (resting potential)
//   dt            = 1.0 ms   (timestep)
//   time_steps    = 50        (LIF iterations)
//   neuron_count  = 128       (= trigram histogram bins)
//   current_scale = 240.0     (scale factor for current injection)
//
// WebGPU availability: Chrome 113+ / Edge 113+ / Node.js with `webgpu` binding.
// Falls back to CPU passthrough (histogram unchanged) when GPU unavailable.
// Behavior is identical; only performance differs for large batches.
//
// Used by HoloEmbedEncoder for dims 384–767 (three trigram blocks).

@trait snn_accelerator {
  // Attempt WebGPU acceleration (falls back to CPU automatically)
  enable_gpu: Bool = true

  // LIF timestep count (default 50 = 50ms simulation)
  time_steps: Int = 50

  // Workgroup size for WGSL compute dispatch (must divide neuron_count)
  workgroup_size: Int = 64

  capability_tags: ["snn_accelerator", "lif_population_coding", "webgpu_wgsl", "holoembed", "sparse_embedding", "brain_inspired"]

  @on_spawn => {
    accel = init_snn_accelerator({ enable_gpu: enable_gpu, time_steps: time_steps })
    init_result = accel.initialize()
    emit("snn_accelerator_ready", {
      gpu_available: init_result.gpu_available,
      time_steps: time_steps
    })
  }

  // Encode 128-dim trigram histogram → 128-dim spike-rate vector
  // (GPU path via WGSL; CPU fallback returns histogram unchanged)
  @on_encode(histogram_128) => {
    return accel.encode(histogram_128)
  }

  // Encode a batch of histograms efficiently (single GPU dispatch)
  @on_encode_batch(histograms) => {
    results = accel.encode_batch(histograms)
    return results
  }

  @on_is_gpu_available => {
    return accel.is_gpu_available()
  }

  @receipt snn_accelerator_config {
    type: "SnnAcceleratorReceipt"
    enable_gpu: enable_gpu
    time_steps: time_steps
    neuron_count: 128
    lif_params: "tau=20ms, vThreshold=-55mV, vReset=-75mV, vRest=-65mV, dt=1ms, currentScale=240"
    paper_ref: "Paper 33 — brain white-matter routing"
    timestamp: now()
  }
}
