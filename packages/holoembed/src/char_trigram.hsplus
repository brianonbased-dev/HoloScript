// @char_trigram -- Char-trigram histogram encoding for HoloEmbed subword matching.
//
// Native .hsplus surface for charTrigram.ts (holoembed/src).
//
// Canonical char-trigram implementation for HoloEmbed 128-bin subword encoding.
// Absorb delegates to HoloEmbedEncoder so GraphRAG and standalone HoloEmbed
// share one vector algorithm.
//
// Algorithm (charTrigram.ts):
//   1. camelSplit: PascalCase/camelCase/snake_case/event:names -> lowercase words
//   2. Strip non-alphanumeric -> clean token sequence
//   3. Slide 3-char window over each word (no cross-word boundaries)
//   4. FNV-1a hash each trigram -> bucket in [0, 128)
//   5. Normalize bucket counts by total -> [0, 1] histogram (128-dim)
//
// Why char trigrams?
//   "PillarSliceEmitter" -> "pillar slice emitter" -> same trigrams as NL query.
//   BPE-lite: no vocabulary, no model, no training -- pure character algebra.
//   128-bin FNV: some collisions but overlap signal dominates for name-matched pairs.

composition "CharTrigramSurface" {
  module CharTrigramEncoder {
    state {
      bins: 128
      capability_tags: ["char_trigram", "holoembed", "subword_encoding", "fnv1a", "paper_26"]
      usage: "HoloEmbed subword block"
    }

    action encode(text) {
      emit("char_trigram_encode_requested", {
        text: text,
        bins: this.state.bins,
        algorithm: "fnv1a-char-trigram"
      });

      return {
        text: text,
        bins: this.state.bins,
        output: "normalized_128_bin_histogram"
      };
    }

    action camel_split(identifier) {
      return {
        identifier: identifier,
        convention: "camel-snake-event-tokenization"
      };
    }

    action receipt() {
      return {
        type: "CharTrigramReceipt",
        bins: this.state.bins,
        hash: "FNV-1a per 3-char window",
        usage: this.state.usage,
        no_model: true,
        timestamp: current_time()
      };
    }

    exports { encode, camel_split, receipt, state }
  }
}
