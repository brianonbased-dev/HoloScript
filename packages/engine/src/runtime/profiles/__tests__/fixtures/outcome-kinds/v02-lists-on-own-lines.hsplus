composition "Bike Share Return" {
  state {
    bikesOut: 0
    fineOwed: 0
  }

  logic {
    action giveBack(hoursLate)
      refused(nothing_out, bad_hours)
      accepted(returned, returned_late) {
      if (state.bikesOut < 1) {
        return { allowed: false, outcome: "nothing_out" }
      }
      if (hoursLate < 0) {
        return { allowed: false, outcome: "bad_hours" }
      }
      state.bikesOut -= 1
      if (hoursLate > 0) {
        state.fineOwed = state.fineOwed + hoursLate * 2
        emit("returned_late", { hours_late: hoursLate })
        return { allowed: true, outcome: "returned_late" }
      }
      emit("returned", { now_out: state.bikesOut })
      return { allowed: true, outcome: "returned" }
    }
  }
}
