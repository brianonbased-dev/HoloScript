composition "Early Change" {
  state {
    bikesOut: 0
    fineOwed: 0
  }

  logic {
    action giveBack(hoursLate) accepted(returned) refused(bad_hours) {
      state.bikesOut -= 1
      if (hoursLate < 0) {
        return { allowed: false, outcome: "bad_hours" }
      }
      return { allowed: true, outcome: "returned" }
    }
  }
}
