// CG-009 robotics import validation proof.
// HoloGate is a docs umbrella term. Concrete integration proof is HoloKey
// custody, UmbrellaRoute metadata, triad receipts, compiler provenance, ROS2
// topic mapping, synthetic-data fixture hashes, and CAEL replay history.
composition "RoboticsImportValidationPosture" {
  metadata {
    task: "CG-009"
    native_authoring: "holo"
    service: "packages/engine/src/simulation/RoboticsImportValidation.ts"
    fixture_test: "packages/engine/src/simulation/__tests__/RoboticsImportValidation.test.ts"
    docs_umbrella: "HoloGate"
    bridge_contract: "bridge-and-validate open robotics standards, not an Isaac Sim clone"
    concrete_tools: ["HoloKey", "UmbrellaRoute", "TriadReceipt", "URDFCompiler", "SDFCompiler", "USDPhysicsCompiler", "CAELTrace", "ROS2TopicMap"]
  }

  scene "RoboticsImportProof" {
    object "URDFROS2Lane" @urdf_compiler @ros2_bridge {
      geometry: "cube"
      position: [-2.4, 1.0, -3.0]
      scale: [0.5, 0.5, 0.5]
      color: "#2563eb"
      state: {
        artifact: "cg009-ros2-urdf"
        compiler: "URDFCompiler"
        target_context: "ros2"
        validates: ["robot root", "provenance", "topic mappings"]
      }
    }

    object "GazeboSDFLane" @sdf_compiler @gazebo_import {
      geometry: "sphere"
      position: [-0.8, 1.0, -3.0]
      scale: [0.55, 0.55, 0.55]
      color: "#16a34a"
      state: {
        artifact: "cg009-gazebo-sdf"
        compiler: "SDFCompiler"
        target_context: "gazebo"
        validates: ["sdf root", "physics scenario", "sensor coverage"]
      }
    }

    object "IsaacUSDPhysicsLane" @usd_physics_compiler @isaac_sim_target {
      geometry: "cylinder"
      position: [0.8, 1.0, -3.0]
      scale: [0.4, 0.8, 0.4]
      color: "#f59e0b"
      state: {
        artifact: "cg009-isaac-usd"
        compiler: "USDPhysicsCompiler"
        target_context: "isaac_sim"
        validates: ["usda header", "PhysicsScene", "holoscript targetContext"]
      }
    }

    object "SensorCoverage" @camera @lidar @imu {
      geometry: "torus"
      position: [2.4, 1.0, -3.0]
      scale: [0.65, 0.65, 0.65]
      color: "#db2777"
      state: {
        required: ["camera", "lidar", "imu"]
        camera_topic: "/camera/image_raw"
        lidar_topic: "/scan"
        imu_topic: "/imu/data"
      }
    }

    object "SyntheticDataAndROS2Proof" @synthetic_data @ros2_pubsub {
      geometry: "cube"
      position: [-1.2, 2.1, -3.3]
      scale: [0.45, 0.45, 0.45]
      color: "#0f766e"
      state: {
        synthetic_fixture: "cg009-synthetic-warehouse-jsonl"
        ros2_mode: "simulated"
        pubsub_topics: ["/camera/image_raw", "/scan", "/imu/data"]
        pass_fail_receipt: "per simulator target"
      }
    }

    object "HoloKeyUmbrellaTriad" @holokey @umbrella_route @triad_receipt @cael_replay {
      geometry: "torus"
      position: [1.2, 2.1, -3.3]
      scale: [0.55, 0.55, 0.55]
      color: "#7c3aed"
      state: {
        docs_umbrella: "HoloGate"
        docs_umbrella_role: "umbrella term in docs, not an executable tool"
        umbrella_route: "simulation.robotics.import-validation.cael-receipts"
        triad: ["semanticReceiptId", "provenanceReceiptId", "replayReceiptId"]
        cael: ["traceIndex", "caelTraceHash", "prevHash"]
      }
    }

    camera "RoboticsImportProofCamera" {
      position: [0, 2.5, 5.2]
      lookAt: [0, 1.3, -3]
    }

    light "RoboticsImportProofKeyLight" {
      type: "directional"
      intensity: 1.2
      position: [4, 6, 3]
    }
  }
}
