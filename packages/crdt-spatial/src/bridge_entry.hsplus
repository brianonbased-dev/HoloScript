// @bridge_entry — Lightweight Strategy C entry: SpatialCRDTBridge + types only.
//
// Native .hsplus surface for bridge-entry.ts (crdt-spatial).
//
// Avoids pulling MeshNodeIntegrator / framework economy peers.
// Re-exports only the Strategy C bridge surface:
//   SpatialCRDTBridge, quaternionMultiply, normalizeQuaternion, eulerToQuaternion, computeEffectiveRotation
//   Types: Vec3, Quaternion, SpatialTransform, SpatialCRDTBridgeConfig, EulerDelta

@trait bridge_entry {
  capability_tags: ["bridge_entry", "strategy_c", "spatial_crdt", "lightweight", "crdt_spatial"]

  @on_spawn => {
    bridge = init_spatial_crdt_bridge_entry()
    emit("bridge_entry_ready", {})
  }

  @receipt bridge_entry_config {
    type: "BridgeEntryReceipt"
    strategy: "C — lightweight entry; no MeshNodeIntegrator / framework peers"
    exports: ["SpatialCRDTBridge", "quaternionMultiply", "normalizeQuaternion", "eulerToQuaternion", "computeEffectiveRotation"]
    timestamp: now()
  }
}
