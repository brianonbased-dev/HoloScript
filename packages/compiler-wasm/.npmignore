# Keep Rust build byproducts out of npm. package.json "files" publishes both
# the browser artifacts (pkg/) and the node build (pkg-node/). The node build
# is what @holoscript/core loads through the "./node" export when it checks
# typed .hsplus functions. pkg-bundler stays out; nothing resolves it.
target/
pkg-bundler/

.idea/
.vscode/
.DS_Store
Thumbs.db
