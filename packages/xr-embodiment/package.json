{
  "name": "@holoscript/xr-embodiment",
  "version": "6.1.3",
  "description": "Reusable VR/WebXR embodiment for HoloScript — user locomotion and agent-NPC avatars in one shared spatial world.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./three": {
      "types": "./dist/three/index.d.ts",
      "import": "./dist/three/index.js",
      "require": "./dist/three/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "holoscript",
    "xr",
    "webxr",
    "vr",
    "embodiment",
    "avatar",
    "three",
    "react-three-fiber"
  ],
  "author": "Brian X Base Team",
  "homepage": "https://holoscript.net",
  "repository": {
    "type": "git",
    "url": "https://github.com/brianonbased-dev/HoloScript.git",
    "directory": "packages/xr-embodiment"
  },
  "bugs": {
    "url": "https://github.com/brianonbased-dev/HoloScript/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "three": "^0.182.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.4",
    "@react-three/fiber": "^9.5.0",
    "@react-three/xr": "^6.6.0"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "react-dom": { "optional": true },
    "@react-three/fiber": { "optional": true },
    "@react-three/xr": { "optional": true }
  },
  "devDependencies": {
    "@react-three/fiber": "^9.5.0",
    "@react-three/xr": "^6.6.0",
    "@types/react": "^19.2.7",
    "@types/three": "^0.170.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.4",
    "three": "^0.182.0",
    "tsup": "^8.0.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.5"
  }
}
