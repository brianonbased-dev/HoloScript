// ============================================================================
// Retro Pinball Table — Synthwave Edition
// A-009 refresh — 2026-06-01
//
// Original intent: complete pinball game with physics, game state, and
// interactive bumpers, targets, flippers, and scoring.
//
// Refresh adds:
//   @morph         — pop bumpers squish/pop on ball contact (blend shapes)
//   @sonification  — ball velocity magnitude mapped to synthesizer pitch
//   @bloom_reactive — score digits and bumpers pulse on point events
//
// Scene story:
//   The same retro pinball table, but now it plays itself like a living
//   instrument. As the ball gathers speed across the table, the sonification
//   engine bends a sawtooth wave from a low 60 Hz drone to a piercing 880 Hz
//   scream. Each bumper hit squishes the geometry down and rebounds it
//   upward in a satisfying micro-animation. The scoreboard digits pulse like
//   a heart — each point scored lights them briefly to 3x normal intensity
//   before fading back. The table is no longer just a game; it is a
//   score-driven musical machine.
//
// ============================================================================

composition "RetroPinball_Synthwave" {
  version: "7.0"
  description: "Synthwave pinball — morph bumpers, sonification scoring, reactive bloom digits"
  tags: ["a009", "refresh", "pinball", "game", "audio", "morph", "sonification"]

  environment {
    backgroundColor: "#080810"
    ambient: 0.35
    shadows: true
    physics: true
    physics_substeps: 4
  }

  module GameState {
    export let score: number = 0;
    export let ballsRemaining: number = 3;
    export let isPlaying: boolean = false;
    export let ballLaunched: boolean = false;
    export let multiplier: number = 1;

    export function addScore(points: number) {
      score += points * multiplier;
      emit("score_changed", score);
    }

    export function loseBall() {
      ballsRemaining--;
      ballLaunched = false;
      emit("ball_lost", ballsRemaining);
      if (ballsRemaining <= 0) {
        emit("game_over", score);
      }
    }

    export function reset() {
      score = 0;
      ballsRemaining = 3;
      multiplier = 1;
      isPlaying = true;
      emit("game_reset");
    }
  }

  module PinballPhysics {
    const GRAVITY = 9.8;
    const TABLE_TILT = 6.5;
    const BALL_MASS = 0.08;
    const BALL_RADIUS = 0.0135;
    const RESTITUTION = 0.7;
    const FLIPPER_SPEED = 1700;

    export interface BallState {
      position: Vector3;
      velocity: Vector3;
    }

    export function applyTableGravity(ball: BallState, dt: number) {
      const tiltRad = TABLE_TILT * Math.PI / 180;
      ball.velocity.z += GRAVITY * Math.sin(tiltRad) * dt;
    }

    export function velocityMagnitude(ball: BallState): number {
      const v = ball.velocity;
      return Math.sqrt(v.x * v.x + v.y * v.y + v.z * v.z);
    }

    export function checkBumperCollision(ball: BallState, bumperPos: Vector3, radius: number): boolean {
      const dx = ball.position.x - bumperPos.x;
      const dz = ball.position.z - bumperPos.z;
      const dist = Math.sqrt(dx * dx + dz * dz);
      return dist < (BALL_RADIUS + radius);
    }

    export function bounceOffBumper(ball: BallState, bumperPos: Vector3, strength: number) {
      const angle = Math.atan2(ball.position.z - bumperPos.z, ball.position.x - bumperPos.x);
      ball.velocity.x = Math.cos(angle) * strength;
      ball.velocity.z = Math.sin(angle) * strength;
    }
  }

  module InputSystem {
    let leftFlipperActive = false;
    let rightFlipperActive = false;

    export function onKeyDown(key: string) {
      if (key === 'a' || key === 'ArrowLeft') {
        leftFlipperActive = true;
        emit("flipper_left", true);
      }
      if (key === 'd' || key === 'ArrowRight') {
        rightFlipperActive = true;
        emit("flipper_right", true);
      }
      if (key === ' ') {
        emit("launch_ball");
      }
    }

    export function onKeyUp(key: string) {
      if (key === 'a' || key === 'ArrowLeft') {
        leftFlipperActive = false;
        emit("flipper_left", false);
      }
      if (key === 'd' || key === 'ArrowRight') {
        rightFlipperActive = false;
        emit("flipper_right", false);
      }
    }
  }

  template "TableBase" {
    @collidable
    geometry: "box"
    color: "#10102a"
  }

  template "TableSurface" {
    @collidable
    geometry: "box"
    color: "#0d0d20"
    friction: 0.3
  }

  template "Wall" {
    @collidable
    geometry: "box"
    color: "#cc3355"
    restitution: 0.8
  }

  template "WallGlowing" {
    @collidable
    @glowing
    geometry: "box"
    color: "#cc3355"
    emissive: "#cc3355"
    emissiveIntensity: 0.3
    restitution: 0.9
  }

  template "Flipper" {
    @kinematic
    @collidable
    geometry: "box"
    color: "#ff5566"
  }

  template "FlipperPivot" {
    @glowing
    geometry: "cylinder"
    color: "#ffcc00"
    emissive: "#ffcc00"
    emissiveIntensity: 0.8
  }

  template "Pinball" {
    @physics
    @collidable
    @gravity
    geometry: "sphere"
    color: "#d0d0d0"
    material: "metal"
    mass: 0.08
    restitution: 0.7
    friction: 0.1
    linearDamping: 0.1

    @sonification {
      data_source: "physics.velocity_magnitude"
      mapping: "pitch"
      min_freq: 60
      max_freq: 880
      min_value: 0
      max_value: 12
      pan_mode: "spatial"
      continuous: true
      instrument: "sawtooth"
      volume: 0.22
      attack: 0.05
      release: 0.15
      custom_mappings: []
    }

    state {
      launched: false
      velocity: [0, 0, 0]
    }

    @on_event("launch_ball"): () => {
      if (!this.state.launched && GameState.ballsRemaining > 0) {
        this.state.launched = true;
        this.state.velocity = [random(-0.5, 0.5), 0, -5];
        play_sound("plunger_launch");
      }
    }

    @on_collision: (other) => {
      if (other.id.startsWith("bumper")) {
        GameState.addScore(100);
        play_sound("bumper_hit");
        other.flash();
      }
      if (other.id.startsWith("target")) {
        GameState.addScore(500);
        play_sound("target_hit");
      }
    }

    @on_trigger("ballDrain"): () => {
      GameState.loseBall();
      this.reset();
    }

    action reset() {
      this.position = [1.5, 0.3, 2];
      this.state.velocity = [0, 0, 0];
      this.state.launched = false;
    }
  }

  template "PopBumper" {
    @collidable
    @glowing
    @animated
    geometry: "cylinder"
    animate: "pulse"
    impulseStrength: 3.5
    points: 100

    @morph {
      targets: ["squish", "pop"]
      presets: {
        normal: { squish: 0.0, pop: 0.0 }
        hit:    { squish: 0.8, pop: 0.0 }
        rebound: { squish: 0.0, pop: 0.6 }
      }
    }

    @bloom_reactive {
      base_intensity: 0.6
      peak_intensity: 3.5
      pulse_period_s: 0.0
      trigger: "collision_active"
    }

    action flash() {
      this.emissiveIntensity = 2.0;
      this.morph.preset = "hit";
      setTimeout(() => {
        this.morph.preset = "rebound";
        setTimeout(() => {
          this.morph.preset = "normal";
          this.emissiveIntensity = 0.6;
        }, 80);
      }, 80);
    }
  }

  template "BumperTop" {
    @glowing
    geometry: "cylinder"
    color: "#ffffff"
    emissiveIntensity: 1
  }

  template "DropTarget" {
    @collidable
    @glowing
    geometry: "box"
    color: "#44ccbb"
    emissive: "#44ccbb"
    emissiveIntensity: 0.4
    points: 500

    state {
      hit: false
    }

    @on_collision: (ball) => {
      if (!this.state.hit) {
        this.state.hit = true;
        GameState.addScore(this.points);
        this.position.y = 0.1;
        play_sound("target_drop");
      }
    }
  }

  template "Spinner" {
    @animated
    @collidable
    geometry: "box"
    color: "#9944cc"
    animate: "spin"
    animSpeed: 0
    points: 10

    @on_collision: (ball) => {
      this.animSpeed += 2;
      GameState.addScore(this.points);
    }

    @on_update: (dt) => {
      this.animSpeed = Math.max(0, this.animSpeed - dt * 0.5);
    }
  }

  template "SpinnerPost" {
    geometry: "cylinder"
    color: "#555566"
  }

  template "PlungerWall" {
    @collidable
    geometry: "box"
    color: "#222233"
  }

  template "Plunger" {
    @kinematic
    geometry: "cylinder"
    color: "#ff3333"

    state {
      pulled: false
      pullDistance: 0
    }

    @on_event("launch_ball"): () => {
      this.position.z = 2.7;
      setTimeout(() => { this.position.z = 2.5; }, 100);
    }
  }

  template "PlungerTip" {
    geometry: "sphere"
    color: "#cc0000"
  }

  template "Ramp" {
    @collidable
    geometry: "box"
    restitution: 0.5
  }

  template "Slingshot" {
    @collidable
    @kinematic
    geometry: "box"
    color: "#dd8800"
    impulseStrength: 2.5
  }

  template "LaneGuide" {
    @collidable
    geometry: "box"
    color: "#444455"
  }

  template "LightStrip" {
    @glowing
    @animated
    geometry: "box"
    animate: "flicker"
    emissiveIntensity: 1
  }

  template "ScoreBoard" {
    @glowing
    geometry: "box"
    color: "#080810"
    emissive: "#111122"
    emissiveIntensity: 0.3

    @on_event("score_changed"): (newScore) => {
      this.updateDisplay(newScore);
    }
  }

  template "ScoreDigit" {
    @glowing
    geometry: "box"
    color: "#00ff88"
    emissive: "#00ff88"
    emissiveIntensity: 1

    @bloom_reactive {
      base_intensity: 1.0
      peak_intensity: 3.2
      pulse_period_s: 0.4
      trigger: "event:score_changed"
    }

    @on_event("score_changed"): () => {
      emit("bloom_trigger");
    }
  }

  template "BallDrain" {
    @trigger
    geometry: "box"
    color: "#ff0000"
    visible: false

    @on_trigger_enter: (other) => {
      if (other.id === "pinball") {
        emit("ballDrain");
      }
    }
  }

  template "BallReturn" {
    @collidable
    geometry: "box"
    color: "#101020"
  }

  object "TableBase" using "TableBase" { position: [0, 0, 0], scale: [4, 0.2, 6] }
  object "TableSurface" using "TableSurface" { position: [0, 0.15, 0], scale: [3.8, 0.05, 5.8] }
  object "WallLeft" using "Wall" { position: [-1.85, 0.35, 0], scale: [0.1, 0.4, 6] }
  object "WallRight" using "Wall" { position: [1.85, 0.35, 0], scale: [0.1, 0.4, 6] }
  object "WallTop" using "WallGlowing" { position: [0, 0.35, -2.85], scale: [3.8, 0.4, 0.1] }

  object "FlipperLeft" using "Flipper" {
    position: [-0.5, 0.25, 2.2]
    scale: [0.6, 0.1, 0.15]
    rotation: [0, 15, 0]
    joint: { type: "hinge", anchor: [-0.75, 0.25, 2.2], axis: [0, 1, 0], limits: [-30, 30], motor_speed: 1700 }
    @on_event("flipper_left"): (active) => {
      if (active) { this.rotation.y = 45; play_sound("flipper_up"); } else { this.rotation.y = 15; }
    }
  }

  object "FlipperRight" using "Flipper" {
    position: [0.5, 0.25, 2.2]
    scale: [0.6, 0.1, 0.15]
    rotation: [0, -15, 0]
    joint: { type: "hinge", anchor: [0.75, 0.25, 2.2], axis: [0, 1, 0], limits: [-30, 30], motor_speed: 1700 }
    @on_event("flipper_right"): (active) => {
      if (active) { this.rotation.y = -45; play_sound("flipper_up"); } else { this.rotation.y = -15; }
    }
  }

  object "FlipperPivotLeft" using "FlipperPivot" { position: [-0.75, 0.25, 2.2], scale: [0.08, 0.15, 0.08] }
  object "FlipperPivotRight" using "FlipperPivot" { position: [0.75, 0.25, 2.2], scale: [0.08, 0.15, 0.08] }
  object "Pinball" using "Pinball" { position: [1.5, 0.3, 2], scale: [0.12, 0.12, 0.12] }

  object "Bumper1" using "PopBumper" { position: [0, 0.3, -1.2], scale: [0.25, 0.2, 0.25], color: "#00ffff", emissive: "#00ffff", emissiveIntensity: 0.6, animSpeed: 2 }
  object "Bumper2" using "PopBumper" { position: [-0.5, 0.3, -0.6], scale: [0.25, 0.2, 0.25], color: "#ff00ff", emissive: "#ff00ff", emissiveIntensity: 0.6, animSpeed: 2.5 }
  object "Bumper3" using "PopBumper" { position: [0.5, 0.3, -0.6], scale: [0.25, 0.2, 0.25], color: "#ffff00", emissive: "#ffff00", emissiveIntensity: 0.6, animSpeed: 1.8 }

  object "BumperTop1" using "BumperTop" { position: [0, 0.42, -1.2], scale: [0.2, 0.05, 0.2], emissive: "#00ffff" }
  object "BumperTop2" using "BumperTop" { position: [-0.5, 0.42, -0.6], scale: [0.2, 0.05, 0.2], emissive: "#ff00ff" }
  object "BumperTop3" using "BumperTop" { position: [0.5, 0.42, -0.6], scale: [0.2, 0.05, 0.2], emissive: "#ffff00" }

  object "Target1" using "DropTarget" { position: [-1.2, 0.3, -1.8], scale: [0.08, 0.25, 0.3] }
  object "Target2" using "DropTarget" { position: [-1.2, 0.3, -1.4], scale: [0.08, 0.25, 0.3] }

  object "Target3" using "DropTarget" {
    position: [-1.2, 0.3, -1.0]
    scale: [0.08, 0.25, 0.3]
    @on_collision: (ball) => {
      if (!this.state.hit) {
        this.state.hit = true;
        GameState.addScore(this.points);
        this.position.y = 0.1;
        play_sound("target_drop");
        if (Target1.state.hit && Target2.state.hit) {
          GameState.addScore(2000);
          GameState.multiplier = 2;
          play_sound("bonus");
        }
      }
    }
  }

  object "Spinner" using "Spinner" { position: [1.2, 0.3, -1.5], scale: [0.02, 0.25, 0.3] }
  object "SpinnerPost" using "SpinnerPost" { position: [1.2, 0.25, -1.5], scale: [0.04, 0.2, 0.04] }
  object "PlungerWall" using "PlungerWall" { position: [1.55, 0.3, 1], scale: [0.05, 0.3, 2.5] }
  object "Plunger" using "Plunger" { position: [1.65, 0.25, 2.5], scale: [0.1, 0.3, 0.1] }
  object "PlungerTip" using "PlungerTip" { position: [1.65, 0.35, 2.5], scale: [0.12, 0.06, 0.12] }

  object "RampLeft" using "Ramp" { position: [-1, 0.25, 0.5], scale: [0.6, 0.08, 1.2], rotation: [-10, 25, 0], color: "#22bb55" }
  object "RampRight" using "Ramp" { position: [1, 0.25, 0.5], scale: [0.6, 0.08, 1.2], rotation: [-10, -25, 0], color: "#cc3333" }

  object "SlingshotLeft" using "Slingshot" {
    position: [-1, 0.25, 1.8]
    scale: [0.5, 0.15, 0.08]
    rotation: [0, -35, 0]
    @on_collision: (ball) => { GameState.addScore(50); play_sound("slingshot"); ball.velocity.x += 1.5; ball.velocity.z -= 1.0; }
  }

  object "SlingshotRight" using "Slingshot" {
    position: [1, 0.25, 1.8]
    scale: [0.5, 0.15, 0.08]
    rotation: [0, 35, 0]
    @on_collision: (ball) => { GameState.addScore(50); play_sound("slingshot"); ball.velocity.x -= 1.5; ball.velocity.z -= 1.0; }
  }

  object "GuideLeft" using "LaneGuide" { position: [-1.4, 0.25, 1.5], scale: [0.05, 0.2, 1.5], rotation: [0, 15, 0] }
  object "GuideRight" using "LaneGuide" { position: [1.4, 0.25, 1.5], scale: [0.05, 0.2, 1.5], rotation: [0, -15, 0] }

  object "LightStrip1" using "LightStrip" { position: [-1.7, 0.45, -2], scale: [0.05, 0.05, 0.3], color: "#00ff88", emissive: "#00ff88" }
  object "LightStrip2" using "LightStrip" { position: [-1.7, 0.45, -1.5], scale: [0.05, 0.05, 0.3], color: "#ff0088", emissive: "#ff0088" }
  object "LightStrip3" using "LightStrip" { position: [-1.7, 0.45, -1], scale: [0.05, 0.05, 0.3], color: "#0088ff", emissive: "#0088ff" }
  object "LightStrip4" using "LightStrip" { position: [1.7, 0.45, -2], scale: [0.05, 0.05, 0.3], color: "#ffff00", emissive: "#ffff00" }
  object "LightStrip5" using "LightStrip" { position: [1.7, 0.45, -1.5], scale: [0.05, 0.05, 0.3], color: "#ff8800", emissive: "#ff8800" }
  object "LightStrip6" using "LightStrip" { position: [1.7, 0.45, -1], scale: [0.05, 0.05, 0.3], color: "#88ff00", emissive: "#88ff00" }

  object "ScoreBoard" using "ScoreBoard" { position: [0, 0.6, -2.7], scale: [2, 0.4, 0.1] }
  object "ScoreDigit1" using "ScoreDigit" { position: [-0.6, 0.6, -2.65], scale: [0.15, 0.25, 0.02] }
  object "ScoreDigit2" using "ScoreDigit" { position: [-0.35, 0.6, -2.65], scale: [0.15, 0.25, 0.02] }
  object "ScoreDigit3" using "ScoreDigit" { position: [-0.1, 0.6, -2.65], scale: [0.15, 0.25, 0.02] }
  object "ScoreDigit4" using "ScoreDigit" { position: [0.15, 0.6, -2.65], scale: [0.15, 0.25, 0.02] }
  object "ScoreDigit5" using "ScoreDigit" { position: [0.4, 0.6, -2.65], scale: [0.15, 0.25, 0.02] }

  object "BallDrain" using "BallDrain" { position: [0, 0.1, 3], scale: [1.5, 0.1, 0.3] }
  object "BallReturnLeft" using "BallReturn" { position: [-0.3, 0.15, 2.8], scale: [0.4, 0.1, 0.3], rotation: [20, 0, 0] }
  object "BallReturnRight" using "BallReturn" { position: [0.3, 0.15, 2.8], scale: [0.4, 0.1, 0.3], rotation: [20, 0, 0] }

  post_processing {
    bloom: { intensity: 1.1, threshold: 0.25, radius: 0.55 }
    tone_mapping: "aces"
    chromatic_aberration: { intensity: 0.003 }
  }
}
