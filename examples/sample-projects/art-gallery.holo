// ============================================================
// "Neon Horizon" — a single-artist retrospective
// ============================================================
// BRIEF (the referent, not the label): not "a gallery" but ONE
// curated show. The centerpiece work, "Neon Horizon," hangs on
// the north wall and the whole room is staged to serve it.
//   The one decision everything else obeys: an ENTRY SIGHTLINE.
//   The visitor enters from the south and looks straight down
//   the axis (-z) into a HERO WALL — one large centerpiece
//   flanked by two SMALLER studies. Not five equal canvases;
//   a show with a reading order: hero first, side studies next,
//   the two subordinate west/east works last.
//   Governed by that decision: the sculpture is pushed OFF the
//   central axis so it never blocks the hero sightline; the
//   lighting is weighted onto the centerpiece instead of spread
//   evenly; a single bench sits on the axis FACING the hero so a
//   viewer can sit and contemplate it. The room has a clear
//   FRONT (hero wall) and BACK (entrance), not four equal sides.
//   Every @advanced_pbr material and all @clickable/@hoverable
//   behavior is unchanged — this pass reshapes the STAGING to the
//   brief, not the surfaces.
// ============================================================

composition "Interactive Art Gallery" {

  // ----------------------------------------------------------
  // ENVIRONMENT
  // ----------------------------------------------------------
  // Museum-style lighting: warm ambient with directional spots.
  // A neutral skybox keeps the focus on the artwork.

  environment {
    skybox: "solid"
    background_color: "#0a0a0f"
    ambient_light: 0.3
    shadows: true
  }

  post_processing {
    bloom { intensity: 0.2, threshold: 0.9 }
    tone_mapping { mode: "aces" }
    ambient_occlusion { intensity: 0.3, radius: 0.4 }
  }

  // ----------------------------------------------------------
  // MATERIALS
  // ----------------------------------------------------------
  // Named @advanced_pbr materials for the room shell and props.
  // Paintings keep their own emissive color per-canvas (set on
  // each Painting_* object below) since each artwork is a
  // distinct hue; this material only carries the woven-canvas
  // surface response shared by all of them.

  material "GalleryCanvas" @advanced_pbr {
    base_color: "#e8e3d8"
    roughness: 0.95
    metallic: 0.0
    albedo_map: "textures/canvas_albedo.png"
    normal_map: "textures/canvas_weave_normal.png"
  }

  material "PolishedDarkStone" @advanced_pbr {
    base_color: "#1a1a24"
    roughness: 0.25
    metallic: 0.0
    albedo_map: "textures/dark_stone_albedo.png"
    normal_map: "textures/dark_stone_normal.png"
    ao_map: "textures/dark_stone_ao.png"
  }

  material "GalleryPlaster" @advanced_pbr {
    base_color: "#1c1c28"
    roughness: 0.88
    metallic: 0.0
    albedo_map: "textures/plaster_albedo.png"
    normal_map: "textures/plaster_normal.png"
  }

  material "GoldFrameMetal" @advanced_pbr {
    base_color: "#c8a84e"
    roughness: 0.3
    metallic: 0.9
    normal_map: "textures/brushed_metal_normal.png"
  }

  material "PedestalMarble" @advanced_pbr {
    base_color: "#2d2d3d"
    roughness: 0.15
    metallic: 0.0
    albedo_map: "textures/marble_albedo.png"
    normal_map: "textures/marble_normal.png"
    ao_map: "textures/marble_ao.png"
  }

  material "SculptureGlass" @advanced_pbr {
    base_color: "#00ffff"
    roughness: 0.02
    metallic: 0.0
    opacity: 0.55
    ior: 1.5
  }

  material "BronzePostMetal" @advanced_pbr {
    base_color: "#8b7355"
    roughness: 0.4
    metallic: 0.85
    normal_map: "textures/brushed_metal_normal.png"
  }

  // ----------------------------------------------------------
  // TEMPLATES
  // ----------------------------------------------------------
  // Reusable definitions to keep painting objects consistent.

  template "Painting" {
    @clickable
    @hoverable
    // Interaction with a point of view: a work in a retrospective doesn't just
    // "show an info panel" — it NOTICES a viewer's gaze and, when chosen, makes
    // itself the room's focus (house lights drop, the piece is spotlit). The
    // declared reactivity is cross-checked against the handlers by check:interaction-taste.
    @interaction_profile(react_to: "gaze click", stateful: true)

    geometry: "cube"
    material: "GalleryCanvas"

    // A viewer's gaze warms the canvas — the work registers attention.
    on_gaze(within: 8) {
      set emissiveIntensity: 0.35
    }
    on_hover_enter() {
      set emissiveIntensity: 0.5
    }
    on_hover_exit() {
      set emissiveIntensity: 0.0
    }

    // Clicking doesn't pop a generic panel — it makes THIS work the room's focus:
    // the house lights drop and the piece is spotlit while its statement is read.
    on_click() {
      set roomDim: 0.15
      set emissiveIntensity: 0.9
      trigger "focus_artwork"
    }
  }

  template "SpotLightOrb" {
    @glowing

    geometry: "sphere"
    scale: 0.08
    color: "#fff5e0"
    emissive: "#fff5e0"
    emissiveIntensity: 1.2
  }

  // ----------------------------------------------------------
  // ROOM STRUCTURE
  // ----------------------------------------------------------
  // A rectangular gallery room: floor, four walls, and ceiling.

  // Floor -- polished dark stone
  object "Floor" @collidable {
    geometry: "cube"
    position: [0, -0.05, 0]
    scale: [12, 0.1, 8]
    color: "#1a1a24"
    material: "PolishedDarkStone"
  }

  // Ceiling
  object "Ceiling" {
    geometry: "cube"
    position: [0, 4, 0]
    scale: [12, 0.1, 8]
    color: "#0f0f18"
  }

  // Back wall (north) -- paintings hang here
  object "WallNorth" @collidable {
    geometry: "cube"
    position: [0, 2, -4]
    scale: [12, 4, 0.15]
    color: "#1c1c28"
    material: "GalleryPlaster"
  }

  // Front wall (south) -- entrance side
  object "WallSouth" @collidable {
    geometry: "cube"
    position: [0, 2, 4]
    scale: [12, 4, 0.15]
    color: "#1c1c28"
    material: "GalleryPlaster"
  }

  // Left wall (west)
  object "WallWest" @collidable {
    geometry: "cube"
    position: [-6, 2, 0]
    scale: [0.15, 4, 8]
    color: "#1c1c28"
    material: "GalleryPlaster"
  }

  // Right wall (east)
  object "WallEast" @collidable {
    geometry: "cube"
    position: [6, 2, 0]
    scale: [0.15, 4, 8]
    color: "#1c1c28"
    material: "GalleryPlaster"
  }

  // ----------------------------------------------------------
  // THE HERO WALL (north) -- the show's centerpiece
  // ----------------------------------------------------------
  // What the entry sightline lands on. The reading order is set
  // by SIZE, not even spacing: the large centerpiece dominates
  // the axis, two smaller studies flank it and defer to it.

  // CENTERPIECE -- "Neon Horizon" on the entry axis, oversized.
  // This is the work the whole room is built to present.
  object "Painting_NeonHorizon" using "Painting" {
    position: [0, 2.3, -3.88]
    scale: [3.2, 2.2, 0.05]
    color: "#e74c3c"
    emissive: "#e74c3c"
    emissiveIntensity: 0.0
  }

  // Flanking study (left) -- smaller, subordinate to the hero.
  object "Painting_SolarFlare" using "Painting" {
    position: [-3.6, 2.2, -3.88]
    scale: [1.1, 0.85, 0.05]
    color: "#f39c12"
    emissive: "#f39c12"
    emissiveIntensity: 0.0
  }

  // Flanking study (right) -- smaller, subordinate to the hero.
  object "Painting_DigitalOcean" using "Painting" {
    position: [3.6, 2.2, -3.88]
    scale: [1.1, 0.85, 0.05]
    color: "#3498db"
    emissive: "#3498db"
    emissiveIntensity: 0.0
  }

  // ----------------------------------------------------------
  // SIDE STUDIES -- last in the reading order
  // ----------------------------------------------------------
  // A single small work on ONE side wall (west). The east wall is
  // deliberately left bare so the room reads as having a front and
  // a back, not four equal hanging surfaces.

  object "Painting_EmeraldDream" using "Painting" {
    position: [-5.88, 2.2, -2.4]
    scale: [0.05, 0.85, 1.1]
    color: "#2ecc71"
    emissive: "#2ecc71"
    emissiveIntensity: 0.0
  }

  // ----------------------------------------------------------
  // PAINTING FRAMES
  // ----------------------------------------------------------
  // Gold borders. The hero frame is the heaviest in the room;
  // the flanking studies and the side study carry thinner ones,
  // reinforcing the reading order by weight.

  // Hero frame -- oversized to match the centerpiece on the axis.
  object "Frame_NeonHorizon" {
    geometry: "cube"
    position: [0, 2.3, -3.90]
    scale: [3.34, 2.34, 0.03]
    color: "#c8a84e"
    material: "GoldFrameMetal"
  }

  // Flanking study frame (left) -- thin, subordinate.
  object "Frame_SolarFlare" {
    geometry: "cube"
    position: [-3.6, 2.2, -3.90]
    scale: [1.2, 0.95, 0.03]
    color: "#c8a84e"
    material: "GoldFrameMetal"
  }

  // Flanking study frame (right) -- thin, subordinate.
  object "Frame_DigitalOcean" {
    geometry: "cube"
    position: [3.6, 2.2, -3.90]
    scale: [1.2, 0.95, 0.03]
    color: "#c8a84e"
    material: "GoldFrameMetal"
  }

  // Side study frame (west wall).
  object "Frame_EmeraldDream" {
    geometry: "cube"
    position: [-5.90, 2.2, -2.4]
    scale: [0.03, 0.95, 1.2]
    color: "#c8a84e"
    material: "GoldFrameMetal"
  }

  // ----------------------------------------------------------
  // SUPPORTING SCULPTURE (off-axis)
  // ----------------------------------------------------------
  // A supporting piece in the show, deliberately pushed off the
  // central axis toward the east so it NEVER stands between the
  // entrance and the hero wall. Its form is a slender upright
  // shard on a tall plinth -- a vertical accent that leads the
  // eye up and back toward the centerpiece, not a centered cube
  // competing for the middle of the room.

  // Plinth -- taller and narrower, set to the east of the axis.
  object "Pedestal" @collidable {
    geometry: "cylinder"
    position: [3.2, 0.55, 1.4]
    scale: [0.45, 1.1, 0.45]
    color: "#2d2d3d"
    material: "PedestalMarble"
  }

  // Sculpture -- a slender upright glass shard, tilted, off-axis.
  object "Sculpture" @spinning @glowing {
    geometry: "cone"
    position: [3.2, 1.9, 1.4]
    scale: [0.32, 0.9, 0.32]
    rotation: [0, 0, 14]
    color: "#00ffff"
    emissive: "#00ffff"
    emissiveIntensity: 0.6
    material: "SculptureGlass"
    spinSpeed: 0.3
  }

  // ----------------------------------------------------------
  // LIGHTING -- weighted toward the hero
  // ----------------------------------------------------------
  // The light follows the curation. Three bright, close spots
  // wash the centerpiece; the flanking studies and the side study
  // get one dimmer spot each. The mirror-symmetric corner orbs are
  // gone -- light is staging here, not wallpaper.

  // Hero centerpiece -- a triad of bright, tight spots.
  object "HeroSpot_Center" using "SpotLightOrb" {
    position: [0, 3.7, -3.4]
    scale: 0.11
    emissiveIntensity: 1.8
  }

  object "HeroSpot_Left" using "SpotLightOrb" {
    position: [-1.3, 3.7, -3.4]
    scale: 0.1
    emissiveIntensity: 1.6
  }

  object "HeroSpot_Right" using "SpotLightOrb" {
    position: [1.3, 3.7, -3.4]
    scale: 0.1
    emissiveIntensity: 1.6
  }

  // Flanking studies -- one dim spot each, subordinate.
  object "StudySpot_Left" using "SpotLightOrb" {
    position: [-3.6, 3.6, -3.5]
    scale: 0.06
    emissiveIntensity: 0.7
  }

  object "StudySpot_Right" using "SpotLightOrb" {
    position: [3.6, 3.6, -3.5]
    scale: 0.06
    emissiveIntensity: 0.7
  }

  // Side study (west wall) -- the dimmest, last in the reading order.
  object "SideStudySpot" using "SpotLightOrb" {
    position: [-5.5, 3.6, -2.4]
    scale: 0.06
    emissiveIntensity: 0.6
  }

  // ----------------------------------------------------------
  // ENTRANCE + SEATING -- the room's back, facing the hero
  // ----------------------------------------------------------
  // Everything here flows from the entrance toward the hero wall.
  // The welcome placard greets the visitor at the back; the bench
  // sits on the entry axis, turned to FACE the centerpiece, so a
  // viewer can sit and contemplate "Neon Horizon" head-on.

  // Welcome placard -- greets the visitor at the entrance (back).
  object "WelcomePlacard" @clickable {
    geometry: "cube"
    position: [0, 1.4, 3.5]
    scale: [1.2, 0.6, 0.04]
    color: "#222233"
    emissive: "#ffffff"
    emissiveIntensity: 0.1

    @interaction_profile(react_to: "approach click", stateful: true)

    // Approaching the placard wakes it; clicking begins the guided walk that
    // leads the visitor from the entrance to the hero wall — not a generic panel.
    on_approach(within: 2) {
      set emissiveIntensity: 0.4
    }
    on_click() {
      set emissiveIntensity: 0.8
      trigger "begin_guided_route"
    }
  }

  // Viewing bench -- on the axis, set back from the hero wall,
  // its seat oriented for a viewer facing the centerpiece.
  object "ViewingBench" @collidable {
    geometry: "cube"
    position: [0, 0.35, 0.8]
    scale: [1.8, 0.12, 0.5]
    color: "#8b7355"
    material: "BronzePostMetal"

    object "BenchLeg_Front" {
      geometry: "cube"
      position: [0, -0.18, 0.18]
      scale: [1.7, 0.24, 0.06]
      color: "#8b7355"
      material: "BronzePostMetal"
    }
    object "BenchLeg_Back" {
      geometry: "cube"
      position: [0, -0.18, -0.18]
      scale: [1.7, 0.24, 0.06]
      color: "#8b7355"
      material: "BronzePostMetal"
    }
  }
}