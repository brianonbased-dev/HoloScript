// ============================================================
// Multiplayer Meeting Room - HoloScript Sample Project
// ============================================================
// A professional virtual conference room designed for multi-
// user collaboration. Features a conference table with chairs,
// a shared whiteboard, avatar spawn points, spatial audio
// zones, and networked objects that stay synchronized across
// all connected clients.
//
// PRESENTATION-FOCUS ORIENTATION: the room has a front. The
// whiteboard (north wall, z=-4) and presentation screen (east
// wall, x=+5) form a north-east presenter corner, and the room
// addresses it. A head-of-table seat anchors the far (west/south)
// end, remaining seats fan toward that corner facing the
// presenter, the table skews to point at it, and ceiling lighting
// is weighted over the presentation end and the table rather than
// spread as an even grid.
// ============================================================

composition "Multiplayer Meeting Room" {

  // ----------------------------------------------------------
  // ENVIRONMENT
  // ----------------------------------------------------------
  // Clean office-style environment with neutral lighting
  // suitable for professional meetings.

  environment {
    skybox: "office"
    ambient_light: 0.55
    shadows: true
  }

  post_processing {
    bloom: { intensity: 0.1, threshold: 0.95 }
    tone_mapping: { mode: "aces" }
    ambient_occlusion: { intensity: 0.2, radius: 0.4 }
  }

  // ----------------------------------------------------------
  // MATERIALS
  // ----------------------------------------------------------
  // Named @advanced_pbr materials for the room shell, furniture,
  // and networked props. The biophilic corner (planters, Monstera
  // stems/leaves below) already carries its own inline material
  // blocks and is left untouched.

  material "ChairLeather" @advanced_pbr {
    base_color: "#2c3e50"
    roughness: 0.35
    metallic: 0.0
    albedo_map: "textures/leather_albedo.png"
    normal_map: "textures/leather_normal.png"
  }

  material "CarpetTile" @advanced_pbr {
    base_color: "#34495e"
    roughness: 0.92
    metallic: 0.0
    albedo_map: "textures/carpet_tile_albedo.png"
    normal_map: "textures/carpet_tile_normal.png"
  }

  material "OfficeDrywall" @advanced_pbr {
    base_color: "#bdc3c7"
    roughness: 0.85
    metallic: 0.0
    albedo_map: "textures/drywall_albedo.png"
    normal_map: "textures/drywall_normal.png"
  }

  material "TableWood" @advanced_pbr {
    base_color: "#5d4037"
    roughness: 0.4
    metallic: 0.0
    albedo_map: "textures/walnut_albedo.png"
    normal_map: "textures/walnut_normal.png"
  }

  material "TableLegWood" @advanced_pbr {
    base_color: "#4e342e"
    roughness: 0.45
    metallic: 0.0
    albedo_map: "textures/walnut_albedo.png"
    normal_map: "textures/walnut_normal.png"
  }

  material "WhiteboardMatte" @advanced_pbr {
    base_color: "#ffffff"
    roughness: 0.65
    metallic: 0.0
  }

  material "BrushedSteel" @advanced_pbr {
    base_color: "#7f8c8d"
    roughness: 0.3
    metallic: 0.85
    normal_map: "textures/brushed_steel_normal.png"
  }

  material "PaperMatte" @advanced_pbr {
    base_color: "#f1c40f"
    roughness: 0.8
    metallic: 0.0
  }

  material "CeramicGlossy" @advanced_pbr {
    base_color: "#ecf0f1"
    roughness: 0.12
    metallic: 0.0
  }

  // ----------------------------------------------------------
  // TEMPLATES
  // ----------------------------------------------------------

  template "OfficeChair" {
    @collidable
    @sittable
    @networked

    geometry: "cube"
    color: "#2c3e50"
    material: "ChairLeather"
  }

  template "AvatarSpawn" {
    // Invisible markers that define where users appear
    // when they join the room. Each spawn point has a
    // unique ID so the server can assign positions.
    @networked

    geometry: "cylinder"
    scale: [0.4, 0.02, 0.4]
    color: "#00ffff"
    emissive: "#00ffff"
    emissiveIntensity: 0.3
    visible: true
  }

  // ----------------------------------------------------------
  // ROOM STRUCTURE
  // ----------------------------------------------------------
  // A rectangular conference room with walls, floor, and
  // ceiling. Neutral corporate palette.

  // Floor -- carpet tile
  object "Floor" @collidable {
    geometry: "cube"
    position: [0, -0.05, 0]
    scale: [10, 0.1, 8]
    color: "#34495e"
    material: "CarpetTile"
  }

  // Ceiling with recessed lighting look
  object "Ceiling" {
    geometry: "cube"
    position: [0, 3.2, 0]
    scale: [10, 0.1, 8]
    color: "#ecf0f1"
  }

  // Walls
  object "WallNorth" @collidable {
    geometry: "cube"
    position: [0, 1.6, -4]
    scale: [10, 3.2, 0.12]
    color: "#bdc3c7"
    material: "OfficeDrywall"
  }

  object "WallSouth" @collidable {
    geometry: "cube"
    position: [0, 1.6, 4]
    scale: [10, 3.2, 0.12]
    color: "#bdc3c7"
    material: "OfficeDrywall"
  }

  object "WallWest" @collidable {
    geometry: "cube"
    position: [-5, 1.6, 0]
    scale: [0.12, 3.2, 8]
    color: "#bdc3c7"
    material: "OfficeDrywall"
  }

  object "WallEast" @collidable {
    geometry: "cube"
    position: [5, 1.6, 0]
    scale: [0.12, 3.2, 8]
    color: "#bdc3c7"
    material: "OfficeDrywall"
  }

  // ----------------------------------------------------------
  // CONFERENCE TABLE
  // ----------------------------------------------------------
  // A large rectangular table that serves as the room's
  // centerpiece. Networked so all users see the same state.

  // Skewed slightly so the table's long axis addresses the
  // north-east presenter corner (whiteboard + screen) instead of
  // sitting square to the walls.
  object "ConferenceTable" @collidable @networked {
    geometry: "cube"
    position: [0, 0.72, 0]
    scale: [3.5, 0.08, 1.6]
    rotation: [0, -12, 0]
    color: "#5d4037"
    material: "TableWood"
  }

  // Table legs
  object "TableLeg_FL" @collidable {
    geometry: "cube"
    position: [-1.6, 0.34, 0.7]
    scale: [0.08, 0.68, 0.08]
    color: "#4e342e"
    material: "TableLegWood"
  }

  object "TableLeg_FR" @collidable {
    geometry: "cube"
    position: [1.6, 0.34, 0.7]
    scale: [0.08, 0.68, 0.08]
    color: "#4e342e"
    material: "TableLegWood"
  }

  object "TableLeg_BL" @collidable {
    geometry: "cube"
    position: [-1.6, 0.34, -0.7]
    scale: [0.08, 0.68, 0.08]
    color: "#4e342e"
    material: "TableLegWood"
  }

  object "TableLeg_BR" @collidable {
    geometry: "cube"
    position: [1.6, 0.34, -0.7]
    scale: [0.08, 0.68, 0.08]
    color: "#4e342e"
    material: "TableLegWood"
  }

  // ----------------------------------------------------------
  // CHAIRS
  // ----------------------------------------------------------
  // Seating is arranged around the presentation focus rather than
  // in a symmetric ring. Every seat faces the north-east presenter
  // corner (whiteboard on the north wall, screen on the east wall).
  // The @sittable trait lets avatars sit; @networked keeps seat
  // states in sync so others see who is seated where.

  // HEAD OF TABLE -- host anchor at the far (west/south) end,
  // set back off the short edge and turned to look straight into
  // the north-east presenter corner. This seat orients the room.
  object "Chair_Head" using "OfficeChair" {
    position: [-2.15, 0.35, 0.55]
    scale: [0.45, 0.72, 0.45]
    rotation: [0, -55, 0]
  }

  // South side -- the long run of seats that faces the presenter
  // corner across the table. Weighted toward the presentation end
  // (three seats, pulled toward the whiteboard/screen).
  object "Chair_S1" using "OfficeChair" {
    position: [-0.7, 0.35, 1.45]
    scale: [0.45, 0.7, 0.45]
    rotation: [0, -28, 0]
  }

  object "Chair_S2" using "OfficeChair" {
    position: [0.5, 0.35, 1.5]
    scale: [0.45, 0.7, 0.45]
    rotation: [0, -38, 0]
  }

  object "Chair_S3" using "OfficeChair" {
    position: [1.65, 0.35, 1.35]
    scale: [0.45, 0.7, 0.45]
    rotation: [0, -52, 0]
  }

  // North side -- fewer seats (two), tucked between the table and
  // the whiteboard so they still read toward the presenter corner
  // without blocking the head-of-table sightline.
  object "Chair_N1" using "OfficeChair" {
    position: [0.85, 0.35, -1.35]
    scale: [0.45, 0.7, 0.45]
    rotation: [0, -18, 0]
  }

  object "Chair_N2" using "OfficeChair" {
    position: [2.0, 0.35, -1.15]
    scale: [0.45, 0.7, 0.45]
    rotation: [0, -30, 0]
  }

  // ----------------------------------------------------------
  // WHITEBOARD
  // ----------------------------------------------------------
  // An interactive whiteboard on the north wall. All connected
  // users can draw on it in real time. The @clickable trait
  // activates drawing mode, and @networked ensures every
  // stroke is broadcast to every client.

  // Whiteboard surface
  object "Whiteboard" @clickable @networked {
    geometry: "cube"
    position: [0, 1.9, -3.88]
    scale: [3.0, 1.6, 0.06]
    color: "#ffffff"
    material: "WhiteboardMatte"

    state {
      drawing_active: false
      current_color: "#333333"
    }

    on_click() {
      state.drawing_active = !state.drawing_active
      if (state.drawing_active) {
        trigger "whiteboard_draw_mode"
      } else {
        trigger "whiteboard_view_mode"
      }
    }
  }

  // Whiteboard frame
  object "WhiteboardFrame" {
    geometry: "cube"
    position: [0, 1.9, -3.90]
    scale: [3.15, 1.75, 0.04]
    color: "#7f8c8d"
    material: "BrushedSteel"
  }

  // Whiteboard marker tray
  object "MarkerTray" @collidable {
    geometry: "cube"
    position: [0, 1.0, -3.82]
    scale: [1.5, 0.04, 0.1]
    color: "#95a5a6"
    material: "BrushedSteel"
  }

  // Colored markers on the tray -- clickable to change draw color
  object "Marker_Black" @clickable @grabbable @networked {
    geometry: "cylinder"
    position: [-0.4, 1.06, -3.82]
    scale: [0.02, 0.12, 0.02]
    rotation: [0, 0, 90]
    color: "#2c3e50"

    on_click() {
      Whiteboard.state.current_color = "#333333"
    }
  }

  object "Marker_Red" @clickable @grabbable @networked {
    geometry: "cylinder"
    position: [-0.15, 1.06, -3.82]
    scale: [0.02, 0.12, 0.02]
    rotation: [0, 0, 90]
    color: "#e74c3c"

    on_click() {
      Whiteboard.state.current_color = "#e74c3c"
    }
  }

  object "Marker_Blue" @clickable @grabbable @networked {
    geometry: "cylinder"
    position: [0.1, 1.06, -3.82]
    scale: [0.02, 0.12, 0.02]
    rotation: [0, 0, 90]
    color: "#3498db"

    on_click() {
      Whiteboard.state.current_color = "#3498db"
    }
  }

  object "Marker_Green" @clickable @grabbable @networked {
    geometry: "cylinder"
    position: [0.35, 1.06, -3.82]
    scale: [0.02, 0.12, 0.02]
    rotation: [0, 0, 90]
    color: "#2ecc71"

    on_click() {
      Whiteboard.state.current_color = "#2ecc71"
    }
  }

  // ----------------------------------------------------------
  // PRESENTATION SCREEN
  // ----------------------------------------------------------
  // A large display screen on the east wall for slides or
  // screen-sharing during meetings.

  object "PresentationScreen" @clickable @glowing @networked {
    geometry: "cube"
    position: [4.88, 1.8, 0]
    scale: [0.06, 1.5, 2.5]
    color: "#1a1a2e"
    emissive: "#ffffff"
    emissiveIntensity: 0.6

    state {
      presenting: false
    }

    on_click() {
      state.presenting = !state.presenting
      if (state.presenting) {
        set emissiveIntensity: 0.9
        trigger "start_presentation"
      } else {
        set emissiveIntensity: 0.3
        trigger "stop_presentation"
      }
    }
  }

  // Screen bezel
  object "ScreenBezel" {
    geometry: "cube"
    position: [4.90, 1.8, 0]
    scale: [0.04, 1.65, 2.65]
    color: "#2c3e50"
    material: "BrushedSteel"
  }

  // ----------------------------------------------------------
  // AVATAR SPAWN POINTS
  // ----------------------------------------------------------
  // Six spawn points positioned behind each chair. When a new
  // user connects, they materialize at the next available
  // spawn point. The glowing discs on the floor mark each
  // location visually.

  spatial_group "SpawnPoints" {

    object "Spawn_1" using "AvatarSpawn" {
      position: [-1.2, 0.01, 2.2]
      spawn_id: 1
    }

    object "Spawn_2" using "AvatarSpawn" {
      position: [0, 0.01, 2.2]
      spawn_id: 2
    }

    object "Spawn_3" using "AvatarSpawn" {
      position: [1.2, 0.01, 2.2]
      spawn_id: 3
    }

    object "Spawn_4" using "AvatarSpawn" {
      position: [-1.2, 0.01, -2.2]
      spawn_id: 4
    }

    object "Spawn_5" using "AvatarSpawn" {
      position: [0, 0.01, -2.2]
      spawn_id: 5
    }

    object "Spawn_6" using "AvatarSpawn" {
      position: [1.2, 0.01, -2.2]
      spawn_id: 6
    }
  }

  // ----------------------------------------------------------
  // SPATIAL AUDIO ZONES
  // ----------------------------------------------------------
  // Audio zones that apply spatial effects. The main conference
  // area has a reverb zone to simulate a room acoustic. A quiet
  // zone near the door reduces crosstalk for side conversations.

  // Main room reverb -- gives voices a natural room resonance
  object "RoomReverb" @spatial_audio @reverb_zone {
    position: [0, 1.6, 0]
    audio_falloff: "linear"
    audio_max_distance: 12
    reverb_type: "room"
    reverb_decay: 0.8
    reverb_wet: 0.25
    reverb_dry: 0.75
    room_size: [10, 3.2, 8]
  }

  // Quiet corner -- near the door (south-west corner)
  // Reduced audio propagation for private conversations
  object "QuietZone" @spatial_audio @reverb_zone {
    position: [-4, 1.6, 3]
    audio_falloff: "exponential"
    audio_max_distance: 2.5
    reverb_type: "dampened"
    reverb_decay: 0.3
    reverb_wet: 0.1
    reverb_dry: 0.9
    room_size: [2, 3.2, 2]
  }

  // Presentation audio -- directional audio zone focused
  // toward the audience when the screen is active
  object "PresentationAudio" @spatial_audio {
    position: [4.5, 1.8, 0]
    audio_falloff: "linear"
    audio_max_distance: 8
    audio_directional: true
    audio_cone_inner: 90
    audio_cone_outer: 140
    audio_direction: [-1, 0, 0]
  }

  // ----------------------------------------------------------
  // NETWORKED SHARED OBJECTS
  // ----------------------------------------------------------
  // Objects on the table that any participant can interact
  // with. All state changes are broadcast to every client.

  // Shared notepad -- click to add notes
  object "SharedNotepad" @clickable @grabbable @networked {
    geometry: "cube"
    position: [-0.5, 0.8, 0.3]
    scale: [0.25, 0.02, 0.35]
    color: "#f1c40f"
    material: "PaperMatte"

    on_click() {
      trigger "open_notepad"
    }
  }

  // Coffee mug -- grabbable decoration
  object "CoffeeMug" @grabbable @networked @collidable {
    geometry: "cylinder"
    position: [0.8, 0.82, -0.4]
    scale: [0.05, 0.1, 0.05]
    color: "#ecf0f1"
    material: "CeramicGlossy"
  }

  // Pointer stick -- for gesturing at the whiteboard
  object "Pointer" @grabbable @networked {
    geometry: "cylinder"
    position: [0.3, 0.8, 0.5]
    scale: [0.015, 0.4, 0.015]
    rotation: [0, 0, 90]
    color: "#e74c3c"
    material: "BrushedSteel"
  }

  // ----------------------------------------------------------
  // LIGHTING
  // ----------------------------------------------------------
  // Lighting is weighted toward the presentation end rather than an
  // even grid. The brightest panel washes the north-east presenter
  // corner (whiteboard + screen); a second panel lights the table;
  // the far / head-of-table end gets a single dimmer fill so the
  // room clearly brightens toward the focus.

  // Presenter-corner wash -- brightest, over the north-east
  // whiteboard/screen zone, turned to run along that corner.
  object "CeilingLight_1" @glowing {
    geometry: "cube"
    position: [2.6, 3.1, -2.4]
    scale: [1.9, 0.04, 0.45]
    rotation: [0, -35, 0]
    color: "#ffffff"
    emissive: "#ffffff"
    emissiveIntensity: 1.15
  }

  // Screen-side panel -- reinforces the east screen wall.
  object "CeilingLight_2" @glowing {
    geometry: "cube"
    position: [3.2, 3.1, 0.4]
    scale: [1.5, 0.04, 0.4]
    rotation: [0, -70, 0]
    color: "#ffffff"
    emissive: "#ffffff"
    emissiveIntensity: 1.0
  }

  // Table panel -- lights the working surface, aligned with the
  // skewed table so it reads with the room's orientation.
  object "CeilingLight_3" @glowing {
    geometry: "cube"
    position: [0.2, 3.1, -0.3]
    scale: [1.7, 0.04, 0.4]
    rotation: [0, -12, 0]
    color: "#ffffff"
    emissive: "#ffffff"
    emissiveIntensity: 0.85
  }

  // Far-end fill -- dimmer panel over the head-of-table / west end
  // so the room falls off away from the presentation focus.
  object "CeilingLight_4" @glowing {
    geometry: "cube"
    position: [-2.6, 3.1, 1.4]
    scale: [1.5, 0.04, 0.4]
    color: "#ffffff"
    emissive: "#ffffff"
    emissiveIntensity: 0.55
  }

  // ----------------------------------------------------------
  // DECORATIVE ELEMENTS
  // ----------------------------------------------------------

  // Reference-backed biophilic corner accent:
  // - Fenestrated Monstera massing:
  //   https://commons.wikimedia.org/wiki/File:Monstera_deliciosa_%2823516285899%29.jpg
  // - Terracotta container color and rim profile:
  //   https://commons.wikimedia.org/wiki/File:Red_terracotta_flowerpots.jpg
  object "PlanterSaucer" @collidable {
    geometry: "cylinder"
    position: [-4.2, 0.035, -3.2]
    scale: [0.32, 0.05, 0.32]
    color: "#8f4a2e"
    material: { baseColor: "#8f4a2e", roughness: 0.88, clayGrain: 0.22 }
  }

  object "PlanterBasin" @collidable {
    geometry: "cylinder"
    position: [-4.2, 0.25, -3.2]
    scale: [0.22, 0.46, 0.22]
    color: "#a95431"
    material: { baseColor: "#a95431", roughness: 0.9, clayGrain: 0.28 }
  }

  object "PlanterRim" @collidable {
    geometry: "cylinder"
    position: [-4.2, 0.49, -3.2]
    scale: [0.28, 0.06, 0.28]
    color: "#c0673c"
    material: { baseColor: "#c0673c", roughness: 0.86, clayGrain: 0.24 }
  }

  object "PlanterSoilDisk" {
    geometry: "cylinder"
    position: [-4.2, 0.535, -3.2]
    scale: [0.22, 0.025, 0.22]
    color: "#2e2119"
    material: { baseColor: "#2e2119", roughness: 0.98, granular: 0.34 }
  }

  object "MonsteraStemCenter" @animated {
    geometry: "cylinder"
    position: [-4.2, 0.78, -3.2]
    scale: [0.025, 0.44, 0.025]
    rotation: [0, 0, -8]
    color: "#2c6a3a"
    material: { baseColor: "#2c6a3a", roughness: 0.76 }
    animate: "sway"
    animSpeed: 0.22
  }

  object "MonsteraStemLeft" @animated {
    geometry: "cylinder"
    position: [-4.34, 0.72, -3.18]
    scale: [0.018, 0.36, 0.018]
    rotation: [0, 0, 24]
    color: "#2b6335"
    material: { baseColor: "#2b6335", roughness: 0.78 }
    animate: "sway"
    animSpeed: 0.24
  }

  object "MonsteraStemRight" @animated {
    geometry: "cylinder"
    position: [-4.03, 0.76, -3.2]
    scale: [0.018, 0.38, 0.018]
    rotation: [0, 0, -24]
    color: "#30723d"
    material: { baseColor: "#30723d", roughness: 0.76 }
    animate: "sway"
    animSpeed: 0.2
  }

  object "MonsteraLaminaLeft" @animated {
    geometry: "sphere"
    position: [-4.5, 0.98, -3.18]
    scale: [0.18, 0.3, 0.035]
    rotation: [0, -20, -18]
    color: "#1f7a45"
    material: { baseColor: "#1f7a45", roughness: 0.62, waxySheen: 0.24 }
    cutout_pattern: "fenestrated"
    animate: "sway"
    animSpeed: 0.26
  }

  object "MonsteraLaminaCenter" @animated {
    geometry: "sphere"
    position: [-4.2, 1.12, -3.2]
    scale: [0.22, 0.36, 0.04]
    rotation: [0, 0, 4]
    color: "#249154"
    material: { baseColor: "#249154", roughness: 0.58, waxySheen: 0.3 }
    cutout_pattern: "fenestrated"
    animate: "sway"
    animSpeed: 0.22
  }

  object "MonsteraLaminaRight" @animated {
    geometry: "sphere"
    position: [-3.92, 1.0, -3.16]
    scale: [0.19, 0.31, 0.035]
    rotation: [0, 18, 20]
    color: "#2aa760"
    material: { baseColor: "#2aa760", roughness: 0.6, waxySheen: 0.26 }
    cutout_pattern: "fenestrated"
    animate: "sway"
    animSpeed: 0.18
  }

  object "MonsteraLaminaRear" @animated {
    geometry: "sphere"
    position: [-4.22, 0.92, -3.42]
    scale: [0.16, 0.25, 0.035]
    rotation: [12, 0, -6]
    color: "#1b6c3e"
    material: { baseColor: "#1b6c3e", roughness: 0.66, waxySheen: 0.2 }
    cutout_pattern: "fenestrated"
    animate: "sway"
    animSpeed: 0.17
  }

  object "MonsteraCutoutA" {
    geometry: "sphere"
    position: [-4.24, 1.14, -3.155]
    scale: [0.032, 0.06, 0.012]
    color: "#0f2a1a"
    material: { baseColor: "#0f2a1a", roughness: 0.82 }
  }

  object "MonsteraCutoutB" {
    geometry: "sphere"
    position: [-4.14, 1.08, -3.152]
    scale: [0.025, 0.05, 0.012]
    color: "#0f2a1a"
    material: { baseColor: "#0f2a1a", roughness: 0.82 }
  }

  object "MonsteraCutoutC" {
    geometry: "sphere"
    position: [-4.47, 1.0, -3.135]
    scale: [0.024, 0.052, 0.012]
    color: "#0f2a1a"
    material: { baseColor: "#0f2a1a", roughness: 0.82 }
  }

  // Clock on the west wall
  object "WallClock" @animated @networked {
    geometry: "cylinder"
    position: [-4.88, 2.4, 0]
    scale: [0.01, 0.3, 0.3]
    rotation: [0, 0, 90]
    color: "#ecf0f1"
    emissive: "#ffffff"
    emissiveIntensity: 0.1
    animate: "clock_tick"
  }

  // Company logo placeholder on south wall
  object "CompanyLogo" @glowing {
    geometry: "cube"
    position: [0, 2.4, 3.88]
    scale: [1.2, 0.6, 0.04]
    color: "#2980b9"
    emissive: "#2980b9"
    emissiveIntensity: 0.3
  }
}
