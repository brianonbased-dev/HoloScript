  object "BellyPlate06" { geometry: "sphere" position: [-1.17, 1.02, 0] scale: [0.17, 0.048, 0.35] rotation: [-0.12, 0, 0] color: "#b9783f" material: "BellyHorn" }

  // Neck and head use forward-stacked forms to create a lizard skull profile.
