composition "InfernoWyrmReferenceAsset" {
  // HoloScript Native Asset
  // Reference-backed fire dragon, built from flat renderable native geometry.
  //
  // Image references used for anatomy/material decisions:
  // - Komodo side silhouette: https://commons.wikimedia.org/wiki/File:KomodoDragon_SideView.jpg
  // - Komodo head/skin massing: https://commons.wikimedia.org/wiki/File:Komodo_dragon_(Varanus_komodoensis).jpg
  // - Bat wing bone layout: https://commons.wikimedia.org/wiki/Category:Bat_wing_bones
  // - Bat skeleton proportions: https://commons.wikimedia.org/wiki/File:Eptesicus_fuscus_skeleton.jpg
  //
  // Visual target: recognizable dragon silhouette without labels: long reptile
  // torso and tail, low heavy legs, bat-like wing fingers, layered scales,
  // horns, teeth, claws, and fire glow. Every anatomical part is top-level so
  // the Three.js compiler emits it instead of collapsing nested detail.

  environment {
    skybox: "night"
    ambient_light: 0.68
    shadows: true
    tone_mapping: "aces"
    background_color: "#211616"
  }

  post_processing {
    bloom { intensity: 0.22, threshold: 0.72 }
    tone_mapping { mode: "aces" }
    ambient_occlusion { intensity: 0.62, radius: 0.9 }
    depth_of_field { focal_distance: 7.0, aperture: 6.4 }
  }

  material "ScaleDark" {
    baseColor: "#4f1c27"
    roughness: 0.82
    metalness: 0.0
  }

  material "ScaleWarm" {
    baseColor: "#7a2c22"
    roughness: 0.78
    metalness: 0.0
  }

  material "BellyHorn" {
    baseColor: "#b7824a"
    roughness: 0.7
    metalness: 0.0
  }

  material "WingMembrane" {
    baseColor: "#7a2020"
    roughness: 0.68
    metalness: 0.0
    opacity: 0.72
  }

  material "FireCore" {
    baseColor: "#ffb13b"
    roughness: 0.35
    metalness: 0.0
  }

  object "BasaltGroundShadow" { geometry: "cylinder" position: [-0.25, 0.04, 0] scale: [4.9, 0.035, 3.7] rotation: [0, 0.17, 0] color: "#1a1213" material: { roughness: 1.0, metalness: 0.0, opacity: 0.7 } }

  // Heavy varanid-inspired torso: overlapping ellipsoids create a reptile body
  // instead of a single cube or perfect sphere.
  object "ChestMass" { geometry: "sphere" position: [0.28, 1.95, 0] scale: [0.92, 0.54, 0.72] rotation: [0.08, 0, 0] color: "#4f1c27" material: "ScaleDark" }
  object "RibMass" { geometry: "sphere" position: [-0.48, 1.76, 0] scale: [0.98, 0.47, 0.68] rotation: [-0.06, 0, 0] color: "#5a2029" material: "ScaleDark" }
  object "HipMass" { geometry: "sphere" position: [-1.28, 1.48, 0] scale: [0.78, 0.39, 0.58] rotation: [-0.14, 0, 0] color: "#441923" material: "ScaleDark" }
  object "ShoulderSaddle" { geometry: "cylinder" position: [-0.04, 2.28, 0] scale: [0.46, 0.92, 0.46] rotation: [1.571, 0, 1.571] color: "#5a2029" material: "ScaleDark" }
  object "KeelUnderbody" { geometry: "sphere" position: [-0.34, 1.34, 0] scale: [1.08, 0.22, 0.42] rotation: [-0.08, 0, 0] color: "#8d5630" material: "BellyHorn" }
  object "BodyBackBridge" { geometry: "sphere" position: [-0.42, 1.72, 0] scale: [1.35, 0.3, 0.5] rotation: [-0.08, 0, 0] color: "#6a2526" material: "ScaleDark" }
  object "ChestNeckBridge" { geometry: "sphere" position: [0.78, 2.16, 0] scale: [0.82, 0.24, 0.34] rotation: [0.18, 0, 0] color: "#6a2526" material: "ScaleDark" }
  object "TailRootBridge" { geometry: "sphere" position: [-2.18, 1.21, -0.02] scale: [1.1, 0.18, 0.28] rotation: [-0.18, 0, 0] color: "#4f1c27" material: "ScaleDark" }

  object "BellyPlate01" { geometry: "sphere" position: [0.48, 1.22, 0] scale: [0.18, 0.055, 0.42] rotation: [0.08, 0, 0] color: "#c48a4b" material: "BellyHorn" }
  object "BellyPlate02" { geometry: "sphere" position: [0.16, 1.16, 0] scale: [0.2, 0.055, 0.46] rotation: [0.04, 0, 0] color: "#b9783f" material: "BellyHorn" }
