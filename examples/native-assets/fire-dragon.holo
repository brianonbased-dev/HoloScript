  object "SkullBack" { geometry: "sphere" position: [2.42, 2.92, 0] scale: [0.45, 0.34, 0.43] rotation: [0.2, 0, 0] color: "#2a1428" material: "ScaleDark" }
  object "SnoutBridge" { geometry: "sphere" position: [2.92, 2.88, 0] scale: [0.54, 0.22, 0.31] rotation: [0.02, 0, 0] color: "#5a2029" material: "ScaleDark" }
  object "UpperJaw" { geometry: "cube" position: [3.34, 2.81, 0] scale: [0.46, 0.11, 0.29] rotation: [-0.04, 0, 0] color: "#61231d" material: "ScaleWarm" }
