composition "Starfighter" {
  // ── HoloScript Native Asset ──────────────────────────────────────────────
  // A sleek starfighter with swept wings, twin engines, and cockpit.
  // Demonstrates: aerodynamic shapes, engine thrust glow, weapon hardpoints.

  environment {
    skybox: "hdr_studio"
    ambient_light: 0.25
    shadows: true
    tone_mapping: "aces"
  }

  post_processing {
    bloom { intensity: 0.35, threshold: 0.75 }
    tone_mapping { mode: "aces" }
    ambient_occlusion { intensity: 0.3, radius: 0.4 }
  }

  // ── Shared Materials ──────────────────────────────────────────────────────
  // Hull is a graduated brushed-metal system (nose darkest/roughest at the
  // leading edge, hull panels progressively smoother) instead of copy-pasted
  // metalness/roughness pairs per part (smell list §4).
  template "HullDark" {
    material: { metalness: 0.85, roughness: 0.15 }
  }
  template "HullPanel" {
    material: { metalness: 0.78, roughness: 0.2 }
  }
  template "GunmetalTrim" {
    material: { metalness: 0.95, roughness: 0.08 }
  }
  template "CanopyGlass" {
    material: { metalness: 0.2, roughness: 0.0, opacity: 0.7 }
  }
  template "NavRed" {
    material: { emissive: "#ff0000", emissiveIntensity: 3.0 }
  }
  template "NavGreen" {
    material: { emissive: "#00ff00", emissiveIntensity: 3.0 }
  }
  template "ThrustBlue" {
    material: { emissive: "#00aaff", emissiveIntensity: 5.0, opacity: 0.6 }
  }
  template "ThrustCore" {
    material: { emissive: "#ffffff", emissiveIntensity: 8.0, opacity: 0.8 }
  }

  object "Ship" @physics @animation {
    position: [0, 0, 0]

    // ── Fuselage ──────────────────────────────────────────────────────────
    object "NoseCone" using "HullDark" {
      geometry: "cone"
      position: [0, 0, 3.5]
      rotation: [90, 0, 0]
      scale: [0.35, 1.5, 0.25]
      color: "#303540"
    }
    object "ForwardFuselage" using "HullPanel" {
      geometry: "cylinder"
      position: [0, 0, 2.0]
      rotation: [90, 0, 0]
      scale: [0.4, 1.5, 0.3]
      color: "#353a45"
    }
    object "MainBody" using "HullPanel" {
      geometry: "cube"
      position: [0, 0, 0]
      scale: [1.0, 0.5, 3.0]
      color: "#404550"
    }
    object "RearFuselage" using "HullPanel" {
      geometry: "cube"
      position: [0, 0, -2.0]
      scale: [0.8, 0.45, 1.5]
      color: "#383d48"
    }

    // ── Cockpit ───────────────────────────────────────────────────────────
    object "CockpitCanopy" using "CanopyGlass" {
      geometry: "sphere"
      position: [0, 0.35, 1.5]
      scale: [0.35, 0.25, 0.6]
      color: "#3388cc"
    }
    object "CockpitFrame" using "GunmetalTrim" {
      geometry: "cube"
      position: [0, 0.28, 1.5]
      scale: [0.38, 0.04, 0.65]
      color: "#2a2e35"
    }

    // ── Wings ─────────────────────────────────────────────────────────────
    object "LeftWing" using "HullPanel" {
      geometry: "cube"
      position: [-2.5, -0.05, -0.3]
      scale: [4.0, 0.08, 1.5]
      color: "#404550"

      object "LeftWingtip" {
        geometry: "cube"
        position: [-2.0, 0, -0.2]
        scale: [0.4, 0.06, 0.8]
        color: "#353a45"
      }
      object "LeftNavLight" using "NavRed" {
        geometry: "sphere"
        position: [-2.1, 0.05, -0.6]
        scale: [0.08, 0.08, 0.08]
        color: "#ff0000"
      }
    }
    object "RightWing" using "HullPanel" {
      geometry: "cube"
      position: [2.5, -0.05, -0.3]
      scale: [4.0, 0.08, 1.5]
      color: "#404550"

      object "RightWingtip" {
        geometry: "cube"
        position: [2.0, 0, -0.2]
        scale: [0.4, 0.06, 0.8]
        color: "#353a45"
      }
      object "RightNavLight" using "NavGreen" {
        geometry: "sphere"
        position: [2.1, 0.05, -0.6]
        scale: [0.08, 0.08, 0.08]
        color: "#00ff00"
      }
    }

    // ── Engines ────────────────────────────────────────────────────────────
    object "LeftEngine" using "GunmetalTrim" {
      geometry: "cylinder"
      position: [-0.6, -0.1, -2.8]
      rotation: [90, 0, 0]
      scale: [0.3, 1.2, 0.3]
      color: "#2a2e35"

      object "LeftNozzle" {
        geometry: "cylinder"
        position: [0, -0.6, 0]
        scale: [1.1, 0.15, 1.1]
        color: "#222222"
        material: { metalness: 0.95 }
      }
      object "LeftThrust" using "ThrustBlue" {
        geometry: "cone"
        position: [0, -0.9, 0]
        scale: [0.8, 1.2, 0.8]
        color: "#00aaff"
      }
      object "LeftThrustCore" using "ThrustCore" {
        geometry: "sphere"
        position: [0, -0.7, 0]
        scale: [0.3, 0.3, 0.3]
        color: "#ffffff"

        // Pairs the thrust glow with a real light so the engine actually
        // illuminates the rear fuselage/wings instead of only self-glowing
        // (smell list §4: emissive with no paired light).
        point_light "LeftThrustGlow" {
          color: "#66ccff"
          intensity: 1.8
          position: [0, 0, 0]
          distance: 6
          decay: 2
        }
      }
    }
    object "RightEngine" using "GunmetalTrim" {
      geometry: "cylinder"
      position: [0.6, -0.1, -2.8]
      rotation: [90, 0, 0]
      scale: [0.3, 1.2, 0.3]
      color: "#2a2e35"

      object "RightNozzle" {
        geometry: "cylinder"
        position: [0, -0.6, 0]
        scale: [1.1, 0.15, 1.1]
        color: "#222222"
        material: { metalness: 0.95 }
      }
      object "RightThrust" using "ThrustBlue" {
        geometry: "cone"
        position: [0, -0.9, 0]
        scale: [0.8, 1.2, 0.8]
        color: "#00aaff"
      }
      object "RightThrustCore" using "ThrustCore" {
        geometry: "sphere"
        position: [0, -0.7, 0]
        scale: [0.3, 0.3, 0.3]
        color: "#ffffff"

        point_light "RightThrustGlow" {
          color: "#66ccff"
          intensity: 1.8
          position: [0, 0, 0]
          distance: 6
          decay: 2
        }
      }
    }

    // ── Tail Fin ──────────────────────────────────────────────────────────
    object "TailFin" using "HullPanel" {
      geometry: "cube"
      position: [0, 0.7, -2.5]
      scale: [0.06, 1.2, 0.8]
      color: "#404550"

      object "TailLight" {
        geometry: "sphere"
        position: [0, 0.55, -0.35]
        scale: [0.06, 0.06, 0.06]
        color: "#ffffff"
        material: { emissive: "#ffffff", emissiveIntensity: 2.0 }
      }
    }

    // ── Weapon Hardpoints ─────────────────────────────────────────────────
    object "LeftCannon" using "GunmetalTrim" {
      geometry: "cylinder"
      position: [-1.5, -0.15, 1.0]
      rotation: [90, 0, 0]
      scale: [0.06, 1.2, 0.06]
      color: "#222222"
    }
    object "RightCannon" using "GunmetalTrim" {
      geometry: "cylinder"
      position: [1.5, -0.15, 1.0]
      rotation: [90, 0, 0]
      scale: [0.06, 1.2, 0.06]
      color: "#222222"
    }
  }

  // ── Lighting ──────────────────────────────────────────────────────────────
  directional_light "StarLight" {
    color: "#eeeeff"
    intensity: 1.0
    position: [5, 3, 10]
  }
  ambient_light "SpaceGlow" {
    color: "#101020"
    intensity: 0.2
  }
}
