composition "Starfighter" {
  // ── HoloScript Native Asset ──────────────────────────────────────────────
  // BRIEF (the referent, not the label): a Su-47 "Berkut" interceptor.
  //   Reference silhouette: real-world forward-swept-wing prototypes (Su-47
  //   Berkut, Grumman X-29). The one decision everything else obeys:
  //   FORWARD-SWEPT WINGS — the outboard tips sit AHEAD of the wing roots, the
  //   opposite of the generic swept-back delta. This alone reads as "this
  //   fighter and not the average one" from any angle.
  //   Governed by that decision: close-coupled canards forward of the wing
  //   (the Berkut's other signature), a cockpit-forward wedge fuselage, a
  //   single canted dorsal spine (not a symmetric twin-tail), and tri-nozzle
  //   thrust. Handed front (kills the mirror-symmetry smell): a starboard-ONLY
  //   targeting pod + squadron chevron the port side does not carry, so the
  //   ship has a dominant side and a clear nose.
  //   Materials are the already-correct graduated brushed-metal system from the
  //   prior pass — this pass reshapes the FORM to the brief, not the surfaces.

  environment {
    skybox: "hdr_studio"
    ambient_light: 0.25
    shadows: true
    tone_mapping: "aces"
  }

  post_processing {
    bloom { intensity: 0.35, threshold: 0.75 }
    tone_mapping { mode: "aces" }
    ambient_occlusion { intensity: 0.3, radius: 0.4 }
  }

  // ── Shared Materials (graduated brushed-metal system, unchanged) ───────────
  template "HullDark" {
    material: { metalness: 0.85, roughness: 0.15 }
  }
  template "HullPanel" {
    material: { metalness: 0.78, roughness: 0.2 }
  }
  template "GunmetalTrim" {
    material: { metalness: 0.95, roughness: 0.08 }
  }
  template "CanopyGlass" {
    material: { metalness: 0.2, roughness: 0.0, opacity: 0.7 }
  }
  template "NavRed" {
    material: { emissive: "#ff0000", emissiveIntensity: 3.0 }
  }
  template "NavGreen" {
    material: { emissive: "#00ff00", emissiveIntensity: 3.0 }
  }
  template "ThrustBlue" {
    material: { emissive: "#00aaff", emissiveIntensity: 5.0, opacity: 0.6 }
  }
  template "ThrustCore" {
    material: { emissive: "#ffffff", emissiveIntensity: 8.0, opacity: 0.8 }
  }
  // Squadron chevron — a warm decal tone, used once, on the starboard side only.
  template "SquadronMark" {
    material: { emissive: "#ff8a2a", emissiveIntensity: 1.4 }
  }

  object "Ship" @physics @animation {
    position: [0, 0, 0]

    // ── Fuselage: cockpit-forward wedge ───────────────────────────────────
    // Sharp nose chine + a wedge forward fuselage that tapers UP toward the
    // canopy, so the ship reads nose-first rather than as a symmetric tube.
    object "NoseChine" using "HullDark" {
      geometry: "cone"
      position: [0, -0.05, 3.7]
      rotation: [90, 0, 0]
      scale: [0.28, 1.7, 0.2]
      color: "#2b2f38"
    }
    object "ForwardWedge" using "HullPanel" {
      geometry: "cube"
      position: [0, 0.02, 2.1]
      rotation: [8, 0, 0]
      scale: [0.5, 0.34, 2.2]
      color: "#353a45"
    }
    object "MainBody" using "HullPanel" {
      geometry: "cube"
      position: [0, 0, 0]
      scale: [0.95, 0.5, 3.0]
      color: "#404550"
    }
    object "RearFuselage" using "HullPanel" {
      geometry: "cube"
      position: [0, 0, -2.0]
      scale: [0.85, 0.46, 1.5]
      color: "#383d48"
    }

    // ── Cockpit (set well forward on the wedge) ───────────────────────────
    object "CockpitCanopy" using "CanopyGlass" {
      geometry: "sphere"
      position: [0, 0.34, 1.9]
      scale: [0.34, 0.26, 0.7]
      color: "#3388cc"
    }
    object "CockpitFrame" using "GunmetalTrim" {
      geometry: "cube"
      position: [0, 0.27, 1.9]
      scale: [0.37, 0.04, 0.72]
      color: "#2a2e35"
    }

    // ── Canards (Berkut signature — small forward-swept surfaces up front) ──
    object "LeftCanard" using "GunmetalTrim" {
      geometry: "cube"
      position: [-0.9, 0.05, 1.6]
      rotation: [0, 18, 0]
      scale: [1.3, 0.05, 0.5]
      color: "#3a3f4a"
    }
    object "RightCanard" using "GunmetalTrim" {
      geometry: "cube"
      position: [0.9, 0.05, 1.6]
      rotation: [0, -18, 0]
      scale: [1.3, 0.05, 0.5]
      color: "#3a3f4a"
    }

    // ── Main wings: FORWARD-SWEPT (the load-bearing decision) ──────────────
    // Roots attach aft on the fuselage; the wing yaws so the outboard TIP
    // leads forward of the root. Left/right rotate opposite signs so both
    // tips sweep toward the nose.
    object "LeftWing" using "HullPanel" {
      geometry: "cube"
      position: [-2.4, -0.05, -0.9]
      rotation: [0, 22, 0]
      scale: [4.0, 0.08, 1.4]
      color: "#404550"

      object "LeftWingtip" using "HullDark" {
        geometry: "cube"
        position: [-2.05, 0.02, 0.35]
        scale: [0.45, 0.06, 0.7]
        color: "#2f333d"
      }
      object "LeftNavLight" using "NavRed" {
        geometry: "sphere"
        position: [-2.1, 0.06, 0.55]
        scale: [0.08, 0.08, 0.08]
        color: "#ff0000"
      }
    }
    object "RightWing" using "HullPanel" {
      geometry: "cube"
      position: [2.4, -0.05, -0.9]
      rotation: [0, -22, 0]
      scale: [4.0, 0.08, 1.4]
      color: "#404550"

      object "RightWingtip" using "HullDark" {
        geometry: "cube"
        position: [2.05, 0.02, 0.35]
        scale: [0.45, 0.06, 0.7]
        color: "#2f333d"
      }
      object "RightNavLight" using "NavGreen" {
        geometry: "sphere"
        position: [2.1, 0.06, 0.55]
        scale: [0.08, 0.08, 0.08]
        color: "#00ff00"
      }

      // ── ASYMMETRY: starboard-only targeting pod + squadron chevron ───────
      // The port wing carries none of this — it gives the ship a handed side
      // and a definite front, instead of a mirror with no focal point.
      object "TargetingPod" using "GunmetalTrim" {
        geometry: "cylinder"
        position: [1.6, -0.18, 0.7]
        rotation: [90, 0, 0]
        scale: [0.16, 0.9, 0.16]
        color: "#23262d"

        object "PodSensor" {
          geometry: "sphere"
          position: [0, 0.55, 0]
          scale: [0.9, 0.9, 0.9]
          color: "#ffaa33"
          material: { emissive: "#ffaa33", emissiveIntensity: 2.2 }
        }
      }
      object "SquadronChevron" using "SquadronMark" {
        geometry: "cube"
        position: [1.1, 0.06, -0.1]
        rotation: [0, -22, 0]
        scale: [0.5, 0.02, 0.28]
        color: "#ff8a2a"
      }
    }

    // ── Engines: tri-nozzle (two outboard + one dorsal spine nozzle) ──────
    object "LeftEngine" using "GunmetalTrim" {
      geometry: "cylinder"
      position: [-0.6, -0.1, -2.8]
      rotation: [90, 0, 0]
      scale: [0.3, 1.2, 0.3]
      color: "#2a2e35"

      object "LeftNozzle" {
        geometry: "cylinder"
        position: [0, -0.6, 0]
        scale: [1.1, 0.15, 1.1]
        color: "#222222"
        material: { metalness: 0.95 }
      }
      object "LeftThrust" using "ThrustBlue" {
        geometry: "cone"
        position: [0, -0.9, 0]
        scale: [0.8, 1.2, 0.8]
        color: "#00aaff"
      }
      object "LeftThrustCore" using "ThrustCore" {
        geometry: "sphere"
        position: [0, -0.7, 0]
        scale: [0.3, 0.3, 0.3]
        color: "#ffffff"

        point_light "LeftThrustGlow" {
          color: "#66ccff"
          intensity: 1.8
          position: [0, 0, 0]
          distance: 6
          decay: 2
        }
      }
    }
    object "RightEngine" using "GunmetalTrim" {
      geometry: "cylinder"
      position: [0.6, -0.1, -2.8]
      rotation: [90, 0, 0]
      scale: [0.3, 1.2, 0.3]
      color: "#2a2e35"

      object "RightNozzle" {
        geometry: "cylinder"
        position: [0, -0.6, 0]
        scale: [1.1, 0.15, 1.1]
        color: "#222222"
        material: { metalness: 0.95 }
      }
      object "RightThrust" using "ThrustBlue" {
        geometry: "cone"
        position: [0, -0.9, 0]
        scale: [0.8, 1.2, 0.8]
        color: "#00aaff"
      }
      object "RightThrustCore" using "ThrustCore" {
        geometry: "sphere"
        position: [0, -0.7, 0]
        scale: [0.3, 0.3, 0.3]
        color: "#ffffff"

        point_light "RightThrustGlow" {
          color: "#66ccff"
          intensity: 1.8
          position: [0, 0, 0]
          distance: 6
          decay: 2
        }
      }
    }

    // ── Single canted dorsal spine (NOT a symmetric twin-tail) ────────────
    // One fin, offset-canted to port, continuing the handed read of the hull.
    object "DorsalSpine" using "HullDark" {
      geometry: "cube"
      position: [-0.12, 0.75, -2.4]
      rotation: [0, 0, 12]
      scale: [0.07, 1.3, 0.9]
      color: "#31353f"

      object "SpineNozzle" using "GunmetalTrim" {
        geometry: "cylinder"
        position: [0, -0.55, -0.5]
        rotation: [90, 0, 0]
        scale: [1.6, 0.4, 1.6]
        color: "#222222"
      }
      object "SpineTailLight" {
        geometry: "sphere"
        position: [0, 0.55, -0.35]
        scale: [0.06, 0.06, 0.06]
        color: "#ffffff"
        material: { emissive: "#ffffff", emissiveIntensity: 2.0 }
      }
    }

    // ── Nose cannons (kept, but tucked into the chine, not a mirrored pair
    // floating off the wings) ─────────────────────────────────────────────
    object "LeftCannon" using "GunmetalTrim" {
      geometry: "cylinder"
      position: [-0.42, -0.2, 2.6]
      rotation: [90, 0, 0]
      scale: [0.05, 1.1, 0.05]
      color: "#222222"
    }
    object "RightCannon" using "GunmetalTrim" {
      geometry: "cylinder"
      position: [0.42, -0.2, 2.6]
      rotation: [90, 0, 0]
      scale: [0.05, 1.1, 0.05]
      color: "#222222"
    }
  }

  // ── Lighting ──────────────────────────────────────────────────────────────
  directional_light "StarLight" {
    color: "#eeeeff"
    intensity: 1.0
    position: [5, 3, 10]
  }
  ambient_light "SpaceGlow" {
    color: "#101020"
    intensity: 0.2
  }
}
