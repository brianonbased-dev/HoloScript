composition "MedievalCastle" {
  // ── HoloScript Native Asset ──────────────────────────────────────────────
  // A medieval castle with towers, walls, gate, and flag poles.
  // Demonstrates: architectural composition, repeated patterns, detail layering.

  environment {
    skybox: "hdr_studio"
    ambient_light: 0.3
    shadows: true
    tone_mapping: "aces"
  }

  post_processing {
    bloom { intensity: 0.15, threshold: 0.9 }
    tone_mapping { mode: "aces" }
    ambient_occlusion { intensity: 0.35, radius: 0.5 }
  }

  // ── Shared Materials ──────────────────────────────────────────────────────
  // Weathered-stone system: foundation is the darkest, most eroded course;
  // walls/towers/keep share a lichen-toned ashlar but vary roughness slightly
  // per part so the castle doesn't read as one flat-painted mesh (smell list §4).
  template "FoundationStone" {
    material: { roughness: 0.95, metalness: 0.0 }
  }
  template "WallAshlar" {
    material: { roughness: 0.88, metalness: 0.0 }
  }
  template "TowerAshlar" {
    material: { roughness: 0.83, metalness: 0.0 }
  }
  template "RoofSlate" {
    material: { roughness: 0.65, metalness: 0.0 }
  }
  template "TimberDark" {
    material: { roughness: 0.8, metalness: 0.0 }
  }
  template "IronWork" {
    material: { roughness: 0.4, metalness: 0.75 }
  }
  template "WindowGlow" {
    material: { emissive: "#FFDD44", emissiveIntensity: 1.5, roughness: 0.3 }
  }

  object "Castle" @physics @collidable {
    position: [0, 0, 0]

    // ── Foundation ────────────────────────────────────────────────────────
    object "Foundation" using "FoundationStone" {
      geometry: "cube"
      position: [0, 0.25, 0]
      scale: [12, 0.5, 10]
      color: "#4a4a3a"
    }

    // ── Main Walls ────────────────────────────────────────────────────────
    object "WallFront" using "WallAshlar" {
      geometry: "cube"
      position: [0, 2, 5]
      scale: [12, 3.5, 0.5]
      color: "#8C7B6B"
    }
    object "WallBack" using "WallAshlar" {
      geometry: "cube"
      position: [0, 2, -5]
      scale: [12, 3.5, 0.5]
      color: "#8C7B6B"
    }
    object "WallLeft" using "WallAshlar" {
      geometry: "cube"
      position: [-6, 2, 0]
      scale: [0.5, 3.5, 10]
      color: "#8C7B6B"
    }
    object "WallRight" using "WallAshlar" {
      geometry: "cube"
      position: [6, 2, 0]
      scale: [0.5, 3.5, 10]
      color: "#8C7B6B"
    }

    // ── Corner Towers ─────────────────────────────────────────────────────
    object "TowerFL" using "TowerAshlar" {
      geometry: "cylinder"
      position: [-6, 2.5, 5]
      scale: [1.2, 5.0, 1.2]
      color: "#7A6B5C"

      object "RoofFL" using "RoofSlate" {
        geometry: "cone"
        position: [0, 3.2, 0]
        scale: [1.5, 2.0, 1.5]
        color: "#6B2D2D"
      }
      object "FlagPoleFL" using "IronWork" {
        geometry: "cylinder"
        position: [0, 4.8, 0]
        scale: [0.04, 1.5, 0.04]
        color: "#cccccc"
      }
      object "FlagFL" {
        geometry: "cube"
        position: [0.3, 5.3, 0]
        scale: [0.6, 0.35, 0.02]
        color: "#cc1111"
      }
    }
    object "TowerFR" using "TowerAshlar" {
      geometry: "cylinder"
      position: [6, 2.5, 5]
      scale: [1.2, 5.0, 1.2]
      color: "#7A6B5C"

      object "RoofFR" using "RoofSlate" {
        geometry: "cone"
        position: [0, 3.2, 0]
        scale: [1.5, 2.0, 1.5]
        color: "#6B2D2D"
      }
    }
    object "TowerBL" using "TowerAshlar" {
      geometry: "cylinder"
      position: [-6, 2.5, -5]
      scale: [1.2, 5.0, 1.2]
      color: "#7A6B5C"

      object "RoofBL" using "RoofSlate" {
        geometry: "cone"
        position: [0, 3.2, 0]
        scale: [1.5, 2.0, 1.5]
        color: "#6B2D2D"
      }
    }
    object "TowerBR" using "TowerAshlar" {
      geometry: "cylinder"
      position: [6, 2.5, -5]
      scale: [1.2, 5.0, 1.2]
      color: "#7A6B5C"

      object "RoofBR" using "RoofSlate" {
        geometry: "cone"
        position: [0, 3.2, 0]
        scale: [1.5, 2.0, 1.5]
        color: "#6B2D2D"
      }
    }

    // ── Gate House ────────────────────────────────────────────────────────
    object "GateFrame" using "WallAshlar" {
      geometry: "cube"
      position: [0, 1.8, 5.3]
      scale: [2.5, 3.6, 0.8]
      color: "#6B5C4D"

      object "GateArch" using "TimberDark" {
        geometry: "cylinder"
        position: [0, 0.4, 0.1]
        rotation: [90, 0, 0]
        scale: [0.8, 0.5, 0.8]
        color: "#3D2B1F"
      }
      object "Portcullis" using "IronWork" {
        geometry: "cube"
        position: [0, -0.2, 0.2]
        scale: [1.4, 2.2, 0.08]
        color: "#4a4a4a"
      }
    }

    // ── Keep (Central Tower) ──────────────────────────────────────────────
    object "Keep" using "TowerAshlar" {
      geometry: "cube"
      position: [0, 3.5, -1.5]
      scale: [4, 6.5, 3.5]
      color: "#7A6B5C"

      object "KeepRoof" using "RoofSlate" {
        geometry: "cone"
        position: [0, 3.8, 0]
        scale: [3.0, 2.5, 2.5]
        color: "#5C2020"
      }
      object "KeepWindow1" using "WindowGlow" {
        geometry: "cube"
        position: [0, 1.5, 1.8]
        scale: [0.5, 0.8, 0.1]
        color: "#FFDD44"

        point_light "KeepWindow1Glow" {
          color: "#FFDD44"
          intensity: 1.2
          position: [0, 0, 0.3]
          distance: 4
          decay: 2
        }
      }
      object "KeepWindow2" using "WindowGlow" {
        geometry: "cube"
        position: [1.0, 1.5, 1.8]
        scale: [0.5, 0.8, 0.1]
        color: "#FFDD44"
      }
      object "KeepWindow3" using "WindowGlow" {
        geometry: "cube"
        position: [-1.0, 1.5, 1.8]
        scale: [0.5, 0.8, 0.1]
        color: "#FFDD44"
      }
    }

    // ── Battlements (Wall Top Teeth) ──────────────────────────────────────
    object "Merlon1" using "TowerAshlar" {
      geometry: "cube"
      position: [-5, 4.0, 5]
      scale: [0.6, 0.5, 0.6]
      color: "#7A6B5C"
    }
    object "Merlon2" using "TowerAshlar" {
      geometry: "cube"
      position: [-3, 4.0, 5]
      scale: [0.6, 0.5, 0.6]
      color: "#7A6B5C"
    }
    object "Merlon3" using "TowerAshlar" {
      geometry: "cube"
      position: [-1, 4.0, 5]
      scale: [0.6, 0.5, 0.6]
      color: "#7A6B5C"
    }
    object "Merlon4" using "TowerAshlar" {
      geometry: "cube"
      position: [1, 4.0, 5]
      scale: [0.6, 0.5, 0.6]
      color: "#7A6B5C"
    }
    object "Merlon5" using "TowerAshlar" {
      geometry: "cube"
      position: [3, 4.0, 5]
      scale: [0.6, 0.5, 0.6]
      color: "#7A6B5C"
    }
    object "Merlon6" using "TowerAshlar" {
      geometry: "cube"
      position: [5, 4.0, 5]
      scale: [0.6, 0.5, 0.6]
      color: "#7A6B5C"
    }
  }

  // ── Lighting ──────────────────────────────────────────────────────────────
  directional_light "Sun" {
    color: "#fff5e0"
    intensity: 1.3
    position: [8, 12, 6]
    shadows: true
  }
  ambient_light "Sky" {
    color: "#8899bb"
    intensity: 0.35
  }
}
