/**
 * The Drowned Conservatory (A-009 stress-test 2026-05-31)
 *
 * NEVER-EXERCISED TRAITS UNDER TEST:
 *
 *   @ocean_caustics — The lagoon has risen through the ground-floor windows,
 *                     flooding the lower third of the greenhouse. Caustics are
 *                     generated by the water surface above — refractive light
 *                     lattices crawl across the iron columns, the submerged
 *                     floor tiles, and the coral-draped archways at a pace that
 *                     follows the gentle swell. Exercises: projector_plane,
 *                     intensity, color_tint, animation_speed, depth_falloff,
 *                     distortion_strength.
 *
 *   @pollen_emitter — Above the waterline, the original plants have run wild
 *                     through a century of undisturbed growth. Three species
 *                     are mid-bloom: a bank of white jasmine whose tendrils
 *                     have claimed the east wall, a stand of tree ferns sporing
 *                     at head height, and a wild lily that has pushed through
 *                     the cracked tile floor. Their pollen drifts in slow
 *                     spirals through the shafts of prismatic light, catching
 *                     the dispersion fans and briefly becoming visible as
 *                     gold-green motes. Exercises: density, particle_size,
 *                     drift_speed, drift_variance, color, affected_by_light,
 *                     buoyancy, lifetime.
 *
 *   @firefly_emitter — Night has arrived outside. Through the broken glass
 *                      panels, coastal fireflies (Photinus pyralis) have drifted
 *                      in and colonized the upper air pocket of the conservatory.
 *                      They cruise in lazy ellipses, their abdomens firing at
 *                      0.5 Hz with a warm yellow-green 565 nm flash. When one
 *                      drifts too close to a pollen cloud, its flash illuminates
 *                      a brief golden haze. Exercises: flash_color, flash_hz,
 *                      flash_duration_ms, flight_radius, flight_height_range,
 *                      count, wander_speed.
 *
 *   @dispersion      — The glass roof panels — many intact, many cracked into
 *                      mosaic facets held by lead caming — act as prisms at
 *                      low solar angles (and now under the rising moon). Each
 *                      crack's edge separates light into its spectrum. Where a
 *                      shaft crosses a pollen cloud, a tiny rainbow fan
 *                      materialises and fades. Exercises: ior_wavelength_curve,
 *                      source_light, spread_angle, intensity, affect_particles.
 *
 *   @coral           — The columns and lower arches, below the waterline, are
 *                      colonised by branching Acropora coral (warm, shallow-
 *                      water species that has migrated in with climate shift).
 *                      The material drives subsurface scatter of the caustic
 *                      light through the semi-translucent polyp tissue —
 *                      producing the characteristic pink-orange inner glow of
 *                      live coral in dappled light. Exercises: species,
 *                      branch_density, health, polyp_glow, subsurface_scatter.
 *
 * WELL-EXERCISED ANCHOR TRAITS:
 *   @glowing         — moonlight reflected off water surface fills the dome
 *   @collidable      — conservatory structure, floor, water surface volume
 *   @animated        — water swell, plant frond motion, firefly wander paths
 *   @particle        — splash motes at waterline, spore bursts from ferns
 *   @spatial_audio   — coastal lagoon water lap, insect chorus outside
 *
 * SCENE STORY:
 *   A Victorian palm house — cast iron and glass, modelled on Kew's
 *   Temperate House — stands on a tidal lagoon that has been rising for
 *   forty years. The original owners left in 1986; the plants did not.
 *   Today the water table sits 0.9 metres above the original floor. The
 *   eastern and western bays are fully submerged below window-sill level.
 *   The central nave retains an air pocket five metres tall.
 *
 *   It is 21:30. Moonlight enters through the fractured ceiling at a
 *   low angle, dispersed by each glass crack into spectral fans. The
 *   water surface below channels that light into caustic lattices that
 *   skitter across the coral-claimed columns. Above the waterline,
 *   jasmine and wild lilies hold the last of their spring bloom. Their
 *   pollen drifts up through the rainbow shafts and briefly glows golden.
 *   Fireflies — a dozen of them, refugees from the coastal meadow —
 *   trace lazy ellipses near the ridge beam, their cold-green flashes
 *   more regular than any of the other lights in this place.
 *
 *   The sound is water. A slow, interior lap against iron. And outside,
 *   just audible: summer insects. Nothing else.
 *
 * COMPILE TARGET: webgpu
 *   Caustic projection requires a screen-space or shadow-map pass.
 *   Dispersion requires multi-wavelength spectral ray or post-process split.
 *   Transparent water mesh + alpha-sorted coral requires depth pre-pass.
 */

composition "DrownedConservatory" {
  version: "7.0"
  description: "A flooded Victorian greenhouse at night — @ocean_caustics, @pollen_emitter, @firefly_emitter, @dispersion, @coral stress-test."
  tags: ["a009", "stress-test", "nature", "ocean", "caustics", "pollen", "firefly", "dispersion", "coral", "2026-05-31"]

  // ──────────────────────────────────────────────────────────────────────────
  // ENVIRONMENT
  // Moonlit lagoon interior. Near-total darkness except the water reflection,
  // the caustics, the dispersion shafts, and the firefly flashes.
  // ──────────────────────────────────────────────────────────────────────────
  environment {
    skybox: "coastal_lagoon_night"
    ambient_light: 0.03
    ambient_color: "#060c14"
    gravity: [0, -9.81, 0]
    fog: {
      enabled: true
      color: "#030810"
      density: 0.022
      mode: "exponential"
    }
    water_surface_y: 0.9
    seawater_density: 1025
    time_of_day: "21:30"
    moon_phase: "waxing_gibbous"
    moon_elevation_deg: 34
  }

  // ──────────────────────────────────────────────────────────────────────────
  // LIGHTING — Moon only (no artificial sources)
  // ──────────────────────────────────────────────────────────────────────────
  object "MoonDirectional" {
    type: "directional_light"
    position: [-40, 60, -80]
    target: [0, 0, 0]
    color: "#ccdcff"
    intensity: 0.28
    cast_shadows: true
    shadow_map_size: 2048
    shadow_bias: -0.0002
  }

  object "MoonFill" {
    type: "point_light"
    position: [0, 4.2, 0]
    color: "#a0b8e0"
    intensity: 0.08
    distance: 14
    decay: 2
  }

  // ──────────────────────────────────────────────────────────────────────────
  // WATER SURFACE — the flooding lagoon at 0.9 m above original floor
  // @glowing provides the reflective moonlight sheen visible from above
  // ──────────────────────────────────────────────────────────────────────────
  object "WaterSurface" {
    geometry: "plane"
    position: [0, 0.9, 0]
    scale: [22, 1, 28]
    render_order: 1
    material: {
      baseColor: "#0a1520"
      metallic: 0.0
      roughness: 0.08
      transmission: 0.72
      ior: 1.33
      transparent: true
    }
    @glowing {
      color: "#8099cc"
      radius: 8.0
      intensity: 0.14
      falloff: "quadratic"
    }
    @animated {
      type: "ripple"
      speed: 0.18
      amplitude: 0.025
      wavelength: 2.8
      origin: [0, 0, 0]
      direction: [0.3, 0, 1]
    }
    @collidable {
      shape: "plane"
      layer: "water_surface"
      friction: 0.1
    }
    castShadow: false
    receiveShadow: false
  }

  // ──────────────────────────────────────────────────────────────────────────
  // OCEAN CAUSTICS — the core never-exercised trait #1
  //
  // The water surface above generates refractive caustic projections onto all
  // submerged geometry below. The projector_plane is the water surface at y=0.9.
  // depth_falloff causes the lattice to dissipate with distance from the surface
  // so the deepest submerged tiles receive only faint patterned light.
  // distortion_strength couples to the @animated ripple so the caustic lattice
  // moves with the swell — not pre-baked, live.
  // ──────────────────────────────────────────────────────────────────────────
  scene_trait @ocean_caustics {
    projector_plane_y: 0.9
    intensity: 0.55
    color_tint: "#b8d4ff"
    animation_speed: 0.22
    depth_falloff: 0.35
    depth_falloff_start_y: 0.88
    distortion_strength: 0.018
    pattern: "refractive"
    texture_resolution: 512
    light_source: "MoonDirectional"
    receive_layer: ["submerged", "coral_surface"]
    temporal_blend: 0.12
  }

  // ──────────────────────────────────────────────────────────────────────────
  // DISPERSION — never-exercised trait #4
  //
  // The glass roof's cracked panes act as prisms at oblique moon angles.
  // Each intact pane passes white moonlight; each fractured edge creates a
  // short spectral fan whose spread_angle is narrow (12°) but visible in
  // the dark. affect_particles: true means pollen that drifts through a
  // dispersion shaft briefly catches the rainbow tint on its mesh normals.
  // ──────────────────────────────────────────────────────────────────────────
  scene_trait @dispersion {
    source_light: "MoonDirectional"
    ior_wavelength_curve: {
      red: 1.514
      green: 1.522
      blue: 1.530
      violet: 1.538
    }
    spread_angle_deg: 12
    intensity: 0.48
    max_fan_length: 4.2
    affect_particles: true
    fan_fade_distance: 3.0
    requires_crack_geometry: true
    crack_geometry_layer: "glass_pane"
  }

  // ──────────────────────────────────────────────────────────────────────────
  // STRUCTURE — Cast iron conservatory frame
  // ──────────────────────────────────────────────────────────────────────────
  object "ConservatoryFloor" {
    geometry: "plane"
    position: [0, 0, 0]
    scale: [22, 1, 28]
    material: {
      baseColor: "#1a1510"
      roughness: 0.88
      normalMap: "textures/victorian_tile_cracked_normal.png"
      normalScale: 1.8
    }
    @collidable {
      shape: "plane"
      layer: "submerged"
      friction: 0.85
    }
    castShadow: false
    receiveShadow: true
  }

  template "IronColumn" {
    geometry: "cylinder"
    scale: [0.22, 5.8, 0.22]
    material: {
      baseColor: "#1c1c1e"
      metallic: 0.9
      roughness: 0.6
      normalMap: "textures/cast_iron_normal.png"
    }
    @collidable { shape: "cylinder", layer: "structure" }
    castShadow: true
    receiveShadow: true
  }

  // East colonnade
  object "Col_E1" using "IronColumn" { position: [4.5, 2.9, -8.0] }
  object "Col_E2" using "IronColumn" { position: [4.5, 2.9,  0.0] }
  object "Col_E3" using "IronColumn" { position: [4.5, 2.9,  8.0] }

  // West colonnade
  object "Col_W1" using "IronColumn" { position: [-4.5, 2.9, -8.0] }
  object "Col_W2" using "IronColumn" { position: [-4.5, 2.9,  0.0] }
  object "Col_W3" using "IronColumn" { position: [-4.5, 2.9,  8.0] }

  // ──────────────────────────────────────────────────────────────────────────
  // CORAL — never-exercised trait #5
  //
  // Acropora millepora (staghorn coral) has colonised the submerged column
  // bases and the lower arch surfaces over decades of slow saltwater ingress.
  // The @coral trait drives the subsurface scatter through polyp tissue so
  // that caustic light entering from above produces the characteristic
  // pink-orange inner glow. health: 0.82 (healthy but not pristine — some
  // bleaching on the tips nearest the most recent flood line).
  // ──────────────────────────────────────────────────────────────────────────
  template "CoralGrowth" {
    geometry: "mesh_procedural"
    @coral {
      species: "acropora_millepora"
      branch_density: 0.72
      health: 0.82
      polyp_glow: true
      polyp_glow_color: "#ff8040"
      polyp_glow_intensity: 0.35
      subsurface_scatter: true
      subsurface_scatter_radius: 0.018
      subsurface_color: "#ff6030"
      bleaching_fraction: 0.12
      bleach_tip_color: "#f8e8d8"
      colonisation_age_years: 18
    }
    @glowing {
      color: "#ff7040"
      radius: 0.6
      intensity: 0.22
      falloff: "exponential"
    }
    @collidable { shape: "mesh", layer: "coral_surface" }
    castShadow: true
    receiveShadow: true
  }

  object "Coral_Col_E1_Base" using "CoralGrowth" { position: [4.5, 0.45, -8.0], scale: [0.55, 0.55, 0.55] }
  object "Coral_Col_E2_Base" using "CoralGrowth" { position: [4.5, 0.45,  0.0], scale: [0.62, 0.62, 0.62] }
  object "Coral_Col_W1_Base" using "CoralGrowth" { position: [-4.5, 0.45, -8.0], scale: [0.48, 0.48, 0.48] }
  object "Coral_Col_W3_Base" using "CoralGrowth" { position: [-4.5, 0.45, 8.0], scale: [0.70, 0.70, 0.70] }

  object "CoralArchSouth" using "CoralGrowth" {
    position: [0, 0.6, -10]
    scale: [3.2, 0.7, 0.5]
    rotation: [0, 0, 0]
  }

  // ──────────────────────────────────────────────────────────────────────────
  // GLASS ROOF — cracked Victorian glazing, dispersion source geometry
  // The pane layer ("glass_pane") is what @dispersion references for
  // crack-edge identification.
  // ──────────────────────────────────────────────────────────────────────────
  object "GlassRoofNave" {
    geometry: "arched_vault"
    position: [0, 5.8, 0]
    scale: [9.0, 2.4, 28.0]
    face: "interior"
    layer: "glass_pane"
    material: {
      baseColor: "#dde8f8"
      metallic: 0.0
      roughness: 0.08
      transmission: 0.88
      ior: 1.52
      transparent: true
      opacity: 0.82
      crack_pattern: "textures/victorian_glass_cracks_alpha.png"
      crack_density: 0.35
    }
    @collidable { shape: "mesh", layer: "glass_pane" }
    castShadow: false
    receiveShadow: false
    render_order: 2
  }

  // ──────────────────────────────────────────────────────────────────────────
  // PLANTS — Jasmine wall, tree ferns, wild lily
  // The fern uses @particle for spore bursts; the lily and jasmine are
  // static mesh with animated frond motion.
  // ──────────────────────────────────────────────────────────────────────────
  object "JasmineWall_East" {
    type: "mesh"
    model: "models/jasmine_wall_tangle.glb"
    position: [4.2, 2.2, 0]
    scale: [0.8, 3.0, 8.0]
    @animated {
      type: "wave"
      axis: "y"
      speed: 0.14
      amplitude: 0.025
      frequency: 0.8
    }
  }

  object "TreeFern_Centre" {
    type: "mesh"
    model: "models/tree_fern_cyathea.glb"
    position: [-1.2, 0.9, 3.5]
    scale: [1.0, 1.0, 1.0]
    @animated {
      type: "sway"
      speed: 0.09
      amplitude_deg: 3.5
      axis: [0.3, 0, 1]
    }
    @particle {
      count: 220
      shape: "disc"
      emit_from: "crown"
      velocity: { min: 0.01, max: 0.04 }
      velocity_direction: "hemisphere_up"
      lifetime: { min: 4.0, max: 14.0 }
      size: { start: 0.006, end: 0.003 }
      color: { start: "#c8a040aa", end: "#c8a04000" }
      blend: "additive"
      emit_rate: 3
      gravity_scale: 0.04
    }
  }

  object "WildLily_NW" {
    type: "mesh"
    model: "models/lily_wild_bloom.glb"
    position: [-3.1, 0.9, 6.8]
    scale: [0.6, 0.6, 0.6]
    @animated {
      type: "sway"
      speed: 0.07
      amplitude_deg: 2.0
      axis: [1, 0, 0.5]
    }
  }

  // ──────────────────────────────────────────────────────────────────────────
  // POLLEN EMITTER — never-exercised trait #2
  //
  // Three pollen emitters placed at the centre of each plant's bloom zone.
  // The jasmine emits fine white-gold pollen in slow upward spirals. The
  // fern emits green-brown spores. The lily emits gold-orange pollen.
  // affected_by_light: true pairs with @dispersion's affect_particles: true —
  // when a pollen particle passes through a dispersion shaft the renderer
  // samples the spectral fan and tints the particle's normal accordingly.
  //
  // The buoyancy parameter keeps particles suspended longer in the still
  // air than gravity alone would allow — modelling the slight convective
  // warmth from the water surface below.
  // ──────────────────────────────────────────────────────────────────────────
  object "JasminePollen" {
    type: "empty"
    position: [3.8, 2.6, 0]
    @pollen_emitter {
      density: 0.48
      particle_size: { min: 0.004, max: 0.009 }
      drift_speed: 0.018
      drift_variance: 0.006
      color: "#f8e880"
      color_variance: 0.12
      buoyancy: 0.15
      lifetime: { min: 8.0, max: 22.0 }
      emit_radius: 3.5
      emit_height_range: [1.8, 4.5]
      affected_by_light: true
      gravity_scale: 0.025
    }
  }

  object "FernSpores" {
    type: "empty"
    position: [-1.2, 2.4, 3.5]
    @pollen_emitter {
      density: 0.32
      particle_size: { min: 0.003, max: 0.007 }
      drift_speed: 0.022
      drift_variance: 0.009
      color: "#88a040"
      color_variance: 0.18
      buoyancy: 0.08
      lifetime: { min: 6.0, max: 18.0 }
      emit_radius: 1.8
      emit_height_range: [0.5, 2.8]
      affected_by_light: true
      gravity_scale: 0.05
    }
  }

  object "LilyPollen" {
    type: "empty"
    position: [-3.1, 1.6, 6.8]
    @pollen_emitter {
      density: 0.28
      particle_size: { min: 0.005, max: 0.011 }
      drift_speed: 0.014
      drift_variance: 0.005
      color: "#ffc040"
      color_variance: 0.15
      buoyancy: 0.12
      lifetime: { min: 10.0, max: 26.0 }
      emit_radius: 1.2
      emit_height_range: [0.3, 1.8]
      affected_by_light: true
      gravity_scale: 0.02
    }
  }

  // ──────────────────────────────────────────────────────────────────────────
  // FIREFLY EMITTER — never-exercised trait #3
  //
  // Photinus pyralis, the common eastern firefly. Flash colour: 565 nm
  // (yellow-green). Flash rate: 0.5 Hz (one flash every two seconds, per
  // species documentation). Flight: lazy ellipses 0.5–2.2 m above the
  // water surface, concentrated under the ridge beam where heat from the
  // exposed warm water below creates slight thermal uplift.
  //
  // count: 12 — a real firefly density for an enclosed space this size.
  // wander_speed: 0.08 m/s — firefly cruise speed, measured.
  // ──────────────────────────────────────────────────────────────────────────
  object "FireflyColony" {
    type: "empty"
    position: [0, 2.4, 0]
    @firefly_emitter {
      count: 12
      flash_color: "#c8ff40"
      flash_hz: 0.5
      flash_duration_ms: 180
      flash_intensity: 1.8
      flash_radius: 0.35
      flight_radius: 6.5
      flight_height_range: [0.5, 2.2]
      wander_speed: 0.08
      wander_smoothness: 0.85
      individual_variance: 0.22
      phase_offset_variance: 1.0
      glow_between_flashes: true
      glow_intensity: 0.04
      glow_color: "#80cc20"
      affected_by_wind: false
    }
  }

  // ──────────────────────────────────────────────────────────────────────────
  // WATERLINE MOTES — splash particle layer at the air-water interface
  // ──────────────────────────────────────────────────────────────────────────
  object "WaterlineMotes" {
    type: "empty"
    position: [0, 0.9, 0]
    @particle {
      count: 320
      shape: "sphere"
      emit_from: "plane"
      plane_scale: 14.0
      velocity: { min: 0.004, max: 0.02 }
      velocity_direction: "hemisphere_up"
      lifetime: { min: 1.5, max: 4.0 }
      size: { start: 0.008, end: 0.0 }
      color: { start: "#80a8e088", end: "#80a8e000" }
      blend: "additive"
      emit_rate: 4
      gravity_scale: 0.0
    }
  }

  // ──────────────────────────────────────────────────────────────────────────
  // SPATIAL AUDIO
  // ──────────────────────────────────────────────────────────────────────────
  object "WaterLap" {
    type: "empty"
    position: [0, 0.9, 0]
    @spatial_audio {
      src: "audio/enclosed_water_lap_iron.ogg"
      loop: true
      volume: 0.42
      pitch: 1.0
      rolloff: "exponential"
      min_distance: 0.5
      max_distance: 20
      cone_inner: 360
      cone_outer: 360
    }
  }

  object "InsectChorus" {
    type: "empty"
    position: [0, 3.0, 18]
    @spatial_audio {
      src: "audio/coastal_summer_insects_chorus.ogg"
      loop: true
      volume: 0.28
      pitch: 1.0
      rolloff: "linear"
      min_distance: 4
      max_distance: 35
      cone_inner: 90
      cone_outer: 200
      cone_outer_gain: 0.15
    }
  }

  // ──────────────────────────────────────────────────────────────────────────
  // POST-PROCESSING — lean; the scene carries itself visually
  // ──────────────────────────────────────────────────────────────────────────
  post_processing {
    bloom: { intensity: 1.1, threshold: 0.45, radius: 0.7 }
    tone_mapping: "aces"
    exposure: 0.88
    depth_of_field: {
      enabled: true
      focus_distance: 3.5
      aperture: 1.4
      bokeh_shape: "hexagonal"
    }
    vignette: { intensity: 0.28, radius: 0.68 }
    film_grain: { intensity: 0.018, size: 1.0, colored: false }
  }
}
