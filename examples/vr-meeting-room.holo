// VR Meeting Room — HoloScript native asset
// BRIEF (the referent, not the label): a real boardroom oriented to a HEAD.
//   The one decision everything else obeys: THE ROOM HAS A FRONT. The screen
//   wall at -z is the head of the room, and the whole layout points at it.
//   The table runs LENGTHWISE toward the screen (long axis along z), not a
//   centered square. A single HEAD chair sits at the near (+z) end, turned to
//   face the screen; attendee chairs run down the two long sides, each yawed
//   inward-and-forward so they actually FACE the presentation end instead of
//   staring across the table at each other. Seating is unequal on purpose:
//   more chairs down one side than the other. Chairs are seat + backrest
//   (a back you can tell which way it faces), not a single symmetric cube.
//   Handed side (kills the mirror-symmetry smell): a coffee-service CREDENZA
//   stands against the -x wall only, so the room has a dominant side as well
//   as a clear front. Materials are the graduated @advanced_pbr set from the
//   prior pass, unchanged — this pass reshapes FORM/LAYOUT to the brief.

composition "VR Meeting Room" {
  environment {
    skybox: "none"
    background_color: "#1a1512"
    ambient_light: 0.35
    shadows: true
  }

  // Warm overhead point lights, biased toward the screen (front) end
  object "CeilingLight1" {
    type: "point_light"
    position: [0, 3.5, -1.8]
    color: "#ffe4c4"
    intensity: 0.8
    distance: 8
  }

  object "CeilingLight2" {
    type: "point_light"
    position: [0, 3.5, 1.5]
    color: "#ffe4c4"
    intensity: 0.6
    distance: 8
  }

  // ===================
  // ROOM MATERIALS — wood floor, upholstered chairs, dark table finish
  // ===================

  material "ConferenceWoodFloor" @advanced_pbr {
    base_color: "#8B6914"
    roughness: 0.75
    metallic: 0.03
    albedo_map: "textures/oak_floor_albedo.png"
    normal_map: "textures/oak_floor_normal.png"
    ao_map: "textures/oak_floor_ao.png"
  }

  material "ChairUpholstery" @advanced_pbr {
    base_color: "#34495e"
    roughness: 0.6
    metallic: 0.15
    albedo_map: "textures/chair_fabric_albedo.png"
    normal_map: "textures/chair_fabric_normal.png"
  }

  material "TableDarkVeneer" @advanced_pbr {
    base_color: "#2c3e50"
    roughness: 0.7
    metallic: 0.04
    albedo_map: "textures/dark_veneer_albedo.png"
    normal_map: "textures/dark_veneer_normal.png"
  }

  // Credenza carcass — a matte cabinet wood, warmer than the table veneer so
  // the service console reads as a separate piece against the side wall.
  material "CredenzaWood" @advanced_pbr {
    base_color: "#5a3d1e"
    roughness: 0.55
    metallic: 0.05
    albedo_map: "textures/walnut_cabinet_albedo.png"
    normal_map: "textures/walnut_cabinet_normal.png"
  }

  // Wood floor
  object "Floor" {
    @collidable

    position: [0, 0, 0]
    scale: [8, 0.08, 6]
    geometry: "cube"
    material: "ConferenceWoodFloor"
  }

  // ===================
  // TEMPLATES
  // ===================

  // A chair with a BACK: a seat pad plus a backrest child, so you can read
  // which way it faces. Placed instances rotate as a unit to face the screen.
  template "Chair" {
    @collidable
    @sittable

    geometry: "cube"
    material: "ChairUpholstery"
    scale: [0.42, 0.1, 0.42]

    // Backrest sits at the BACK edge of the seat (+z in the chair's own frame),
    // so a chair rotated to yaw=180 puts its back to the viewer and its face
    // to the screen.
    object "Backrest" {
      geometry: "cube"
      position: [0, 2.6, 2.0]
      scale: [1.0, 5.0, 0.18]
      material: "ChairUpholstery"
    }
  }

  template "LightOrb" {
    @glowing

    geometry: "sphere"
    color: "#f0f0f0"
    emissive: "#ffffff"
    emissiveIntensity: 1

    point_light {
      color: "#ffe4c4"
      intensity: 1.5
      range: 6
      cast_shadows: false
    }
  }

  // ===================
  // OBJECTS
  // ===================

  // Conference table — run LENGTHWISE toward the screen (long axis along z).
  // The far (-z) end points at the head of the room; the near (+z) end is
  // where the meeting is chaired.
  object "Table" {
    @collidable

    position: [0, 0.75, -0.3]
    scale: [1.4, 0.1, 3.4]
    geometry: "cube"
    material: "TableDarkVeneer"
  }

  // ── HEAD CHAIR: near (+z) end, turned to face the screen at -z ─────────────
  // The one seat the layout is built around — it chairs the room and looks
  // straight down the table at the presentation wall.
  object "HeadChair" using "Chair" {
    position: [0, 0.5, 1.9]
    rotation: [0, 180, 0]
    scale: [0.48, 0.55, 0.48]
  }

  // ── ATTENDEE CHAIRS: down the two LONG sides, yawed to face the screen ─────
  // Left side (-x) carries THREE; right side (+x) carries TWO. Unequal on
  // purpose. Each is yawed inward-and-forward so its occupant faces the
  // screen end, not the person across the table.
  object "ChairL1" using "Chair" {
    position: [-1.0, 0.5, 1.0]
    rotation: [0, 235, 0]
    scale: [0.42, 0.5, 0.42]
  }

  object "ChairL2" using "Chair" {
    position: [-1.0, 0.5, -0.4]
    rotation: [0, 235, 0]
    scale: [0.42, 0.5, 0.42]
  }

  object "ChairL3" using "Chair" {
    position: [-1.0, 0.5, -1.8]
    rotation: [0, 235, 0]
    scale: [0.42, 0.5, 0.42]
  }

  object "ChairR1" using "Chair" {
    position: [1.0, 0.5, 0.3]
    rotation: [0, 125, 0]
    scale: [0.42, 0.5, 0.42]
  }

  object "ChairR2" using "Chair" {
    position: [1.0, 0.5, -1.1]
    rotation: [0, 125, 0]
    scale: [0.42, 0.5, 0.42]
  }

  // ── HANDED SIDE: coffee-service credenza against the -x wall only ──────────
  // A low cabinet with a carafe and two cups on top. It stands on ONE side of
  // the room, giving the space a dominant side to go with its clear front.
  object "Credenza" {
    @collidable

    position: [-3.4, 0.45, -0.6]
    scale: [0.6, 0.9, 2.2]
    geometry: "cube"
    material: "CredenzaWood"

    object "Carafe" {
      geometry: "cylinder"
      position: [0, 1.15, -0.35]
      scale: [0.5, 0.6, 0.5]
      color: "#20242b"
      material: { metalness: 0.85, roughness: 0.2 }
    }
    object "CupA" {
      geometry: "cylinder"
      position: [0, 1.1, 0.15]
      scale: [0.28, 0.28, 0.28]
      color: "#e8e2d6"
    }
    object "CupB" {
      geometry: "cylinder"
      position: [0, 1.1, 0.45]
      scale: [0.28, 0.28, 0.28]
      color: "#e8e2d6"
    }
  }

  // ── FOCAL END: presentation screen, the head/anchor of the room ───────────
  // Wider and set flush to the -z wall so it reads as the wall the room faces.
  object "Screen" {
    @glowing
    @pointable

    position: [0, 2, -3]
    scale: [4.4, 2.5, 0.1]
    geometry: "cube"
    color: "#ffffff"
    emissive: "#ffffff"
    emissiveIntensity: 0.8

    on_point() {
      // Toggle presentation mode
      trigger "screen_activated"
    }
  }

  // Ambient lighting orbs — flanking the screen wall to frame the front
  object "Light1" using "LightOrb" {
    position: [-2, 3, -2.6]
    scale: [0.2, 0.2, 0.2]
  }

  object "Light2" using "LightOrb" {
    position: [2, 3, -2.6]
    scale: [0.2, 0.2, 0.2]
  }

  post_processing {
    bloom: { intensity: 0.25, threshold: 0.65, radius: 0.3 }
    tone_mapping: "aces"
  }
}
