composition "HoloHub Spatial Gallery" {
    @author("HoloScript_Core")
    @version("1.0.0")
    @networked
    @tags(["hub", "marketplace", "spatial"])

    environment {
        skyColor: "#0a0a20"
        horizonColor: "#1a1a40"
        groundColor: "#050510"
        grid: true
    }

    post_processing {
        bloom { intensity: 0.4, threshold: 0.7 }
        tone_mapping { mode: "aces" }
        ambient_occlusion { intensity: 0.3, radius: 0.5 }
    }

    // ----------------------------------------------------------
    // MATERIALS
    // ----------------------------------------------------------
    // Named @advanced_pbr materials for the room shell and pedestals.

    material "HubFloorPolished" @advanced_pbr {
        base_color: "#0a0a20"
        roughness: 0.2
        metallic: 0.1
        albedo_map: "textures/hub_floor_albedo.png"
        normal_map: "textures/hub_floor_normal.png"
        ao_map: "textures/hub_floor_ao.png"
    }

    material "HubPedestalMetal" @advanced_pbr {
        base_color: "#3a3a55"
        roughness: 0.35
        metallic: 0.7
        albedo_map: "textures/hub_pedestal_albedo.png"
        normal_map: "textures/hub_pedestal_normal.png"
    }

    // Main Gallery Structure
    object "Gallery_Floor" {
        geometry: "plane"
        scale: [100, 1, 100]
        material: "HubFloorPolished"
    }

    // Welcome Hologram
    object "Welcome_Sign" {
        @hologram
        position: [0, 2, -5]
        geometry: "text"
        properties: {
            text: "Welcome to HoloHub Spatial"
            fontSize: 48
            color: "#00ffff"
        }
    }

    // Display Pedestals for Featured Scenes
    // These will be populated dynamically or via logic blocks in production
    
    object "Scene_Pedestal_01" {
        @hologram
        @portal(sceneId: "smart-city-nexus")
        position: [-5, 0, -10]
        geometry: "models/hub_pedestal.glb"
        
        onInteraction: {
            emit "holohub:spawn_preview" { sceneId: "smart-city-nexus" }
        }
    }

    object "Scene_Pedestal_02" {
        @hologram
        @portal(sceneId: "neon-combat-arena")
        position: [5, 0, -10]
        geometry: "models/hub_pedestal.glb"
        
        onInteraction: {
            emit "holohub:spawn_preview" { sceneId: "neon-combat-arena" }
        }
    }

    // Central Spawner Pad
    object "Spawner_Pad" {
        @physics(type: "static")
        position: [0, 0.1, -15]
        geometry: "cylinder"
        scale: [4, 0.2, 4]
        material: "HubPedestalMetal"
        emissive: "#00ffff"
        emissiveIntensity: 0.6

        @tooltip("Drop Hub Previews here to instantiate them")
    }

    logic {
        on_preview_spawned(data) {
            emit "ui_notification" "Holographic preview of " + data.sceneId + " manifest."
        }
    }
}
