// Twin Earth — First Playable Proof (HoloLand)
// Location-based AR game layer with privacy governance and graceful degradation.
// Canary: task_1778616474061_3yjb

@world {
  backgroundColor: "#87CEEB"
  ambient: 0.6
  fog: { type: "linear", color: "#e0f7fa", near: 80, far: 300 }
  shadows: true
}

// ═══════════════════════════════════════════════════════════════════
// EarthLayer — Digital twin strata
// ═══════════════════════════════════════════════════════════════════

object "terrain_shell" @earth_layer @earth_terrain @game_geo_anchor @game_geo_persistent {
  position: [0, -0.5, 0]
  scale: [200, 1, 200]
  color: "#5d8a3e"
  geometry: "plane"
  material: "grass"
  lat: 40.7128
  lon: -74.0060
  alt: 10
}

object "city_hall" @earth_layer @earth_building @game_place @place_social {
  position: [12, 15, -8]
  scale: [8, 30, 8]
  color: "#8b4513"
  geometry: "cube"
  material: "brick"
  place_capacity: 500
  place_schedule: "09:00-17:00"
}

object "broadway_road" @earth_layer @earth_road {
  position: [0, 0.1, 20]
  scale: [120, 0.2, 6]
  color: "#333333"
  geometry: "cube"
  material: "asphalt"
}

object "central_pond" @earth_layer @earth_water {
  position: [-25, 0.2, 10]
  scale: [15, 0.5, 10]
  color: "#1e90ff"
  geometry: "cylinder"
  material: "water"
}

// Reference evidence for the arborescent canopy asset:
// - Crown silhouette and uneven vertical massing:
//   https://commons.wikimedia.org/wiki/File:Liquidambar_styraciflua_Slender_Silhouette_1zz.jpg
// - Oak bark plate/ridge texture:
//   https://commons.wikimedia.org/wiki/File:Sawtooth_Oak_Quercus_acutissima_Trunk_Bark_2008px.jpg
object "central_canopy_asset" @earth_layer @earth_vegetation {
  position: [-15, 3.8, -15]
  scale: [1, 1, 1]
  color: "#2f7d32"
  geometry: "procedural_vegetation_mesh"
  material: {
    baseColor: "#2f7d32"
    barkColor: "#5f412c"
    leafClusterColor: "#3f8f3d"
    roughness: 0.82
    windBreakup: 0.18
  }
  canopy_profile: {
    silhouette: "asymmetric_oval_crown"
    crown_lobes: 7
    bole_height: 3.2
    bole_taper: 0.36
    bark_ridge_depth: 0.12
    root_flare_radius: 1.0
    leaf_cluster_noise: 0.42
  }
}

object "central_canopy_bole_core" @earth_layer @earth_vegetation {
  position: [-15, 1.6, -15]
  scale: [0.42, 3.2, 0.42]
  color: "#5f412c"
  geometry: "cylinder"
  material: { baseColor: "#5f412c", roughness: 0.92, ridgeContrast: 0.28 }
}

object "central_canopy_bole_ridge_west" @earth_layer @earth_vegetation {
  position: [-15.34, 1.7, -14.92]
  scale: [0.07, 3.0, 0.08]
  color: "#3b291f"
  geometry: "cube"
  rotation: [0, 0.16, 0.05]
  material: { baseColor: "#3b291f", roughness: 0.96 }
}

object "central_canopy_bole_ridge_east" @earth_layer @earth_vegetation {
  position: [-14.66, 1.65, -15.08]
  scale: [0.06, 2.7, 0.08]
  color: "#7a563c"
  geometry: "cube"
  rotation: [0, -0.12, -0.04]
  material: { baseColor: "#7a563c", roughness: 0.94 }
}

object "central_canopy_bough_left" @earth_layer @earth_vegetation {
  position: [-15.55, 3.12, -15.05]
  scale: [0.1, 1.28, 0.1]
  color: "#5a3a28"
  geometry: "cylinder"
  rotation: [0.0, 0.0, 0.48]
