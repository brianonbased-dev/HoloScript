// Contemporary Masters — a processional route, not a floor plan.
// The visitor enters south under the EntranceArch, is drawn down the
// entry axis (z) to the HERO piece — Sculpture2, the $45k "Ascending
// Form" bronze — set on-axis and lit hardest. The PartitionWall is the
// SPINE that bends the path left around itself, past a sequence of
// subordinate sculptures, and out through the gift shop at the NE
// corner. Seating and lighting are handed toward the hero: nothing is
// mirror-symmetric. One decision governs — a directed path culminating
// in a single centerpiece.
// Platforms: Unity, Unreal, BabylonJS, WebXR

composition "Virtual Museum Exhibition" {

  metadata {
    name: 'Virtual Art Gallery'
    description: 'An immersive virtual museum with curated exhibitions, interactive artworks, audio guides, and educational content. Supports multi-user gallery visits up to 50 concurrent visitors.'
    version: '4.2.0'
    author: 'HoloScript Cultural Arts Division'
    category: 'cultural'
    tags: ['art', 'museum', 'gallery', 'education', 'cultural', 'multiplayer']
    platforms: ['unity', 'unreal', 'babylonjs', 'webxr']
    minPlayers: 1
    maxPlayers: 50
  }

  // ── Environment ──────────────────────────────────────────────────────────

  environment {
    skybox: "studio"
    ambient_light: 0.4
  }

  light "GalleryMain" {
    type: "directional"
    color: "#fff8f0"
    intensity: 0.7
    rotation: [-50, 20, 0]
    cast_shadows: true
  }

  post_processing {
    bloom: { enabled: true, intensity: 0.15, threshold: 0.85 }
    tone_mapping: { enabled: true, type: "aces" }
  }

  // ── Materials ────────────────────────────────────────────────────────────
  // Named @advanced_pbr materials for the gallery shell, frames,
  // pedestals, and sculptures. Canvas base_color stays per-artwork
  // (set on each painting object) since each piece is a distinct
  // hue; this material only supplies the shared woven-canvas response.

  material "WhiteOakParquet" @advanced_pbr {
    base_color: "#c9a56a"
    roughness: 0.45
    metallic: 0.0
    albedo_map: "textures/white_oak_parquet_albedo.png"
    normal_map: "textures/white_oak_parquet_normal.png"
    ao_map: "textures/white_oak_parquet_ao.png"
  }

  material "GalleryPlaster" @advanced_pbr {
    base_color: "#ffffff"
    roughness: 0.9
    metallic: 0.0
    albedo_map: "textures/plaster_albedo.png"
    normal_map: "textures/plaster_normal.png"
  }

  material "SmoothPlaster" @advanced_pbr {
    base_color: "#ffffff"
    roughness: 0.78
    metallic: 0.0
    albedo_map: "textures/smooth_plaster_albedo.png"
    normal_map: "textures/smooth_plaster_normal.png"
  }

  material "GalleryCanvas" @advanced_pbr {
    base_color: "#e8e3d8"
    roughness: 0.95
    metallic: 0.0
    albedo_map: "textures/canvas_albedo.png"
    normal_map: "textures/canvas_weave_normal.png"
  }

  material "GiltFrame" @advanced_pbr {
    base_color: "#8b7355"
    roughness: 0.28
    metallic: 0.9
    normal_map: "textures/gilt_frame_normal.png"
  }

  material "EbonyFrame" @advanced_pbr {
    base_color: "#2c2c2c"
    roughness: 0.35
    metallic: 0.0
    albedo_map: "textures/ebony_albedo.png"
    normal_map: "textures/ebony_normal.png"
  }

  material "RusticFrame" @advanced_pbr {
    base_color: "#5c4033"
    roughness: 0.75
    metallic: 0.0
    albedo_map: "textures/rustic_wood_albedo.png"
    normal_map: "textures/rustic_wood_normal.png"
  }

  material "PedestalMarble" @advanced_pbr {
    base_color: "#d3d3d3"
    roughness: 0.15
    metallic: 0.0
    albedo_map: "textures/marble_albedo.png"
    normal_map: "textures/marble_normal.png"
    ao_map: "textures/marble_ao.png"
  }

  material "PedestalMarbleBlack" @advanced_pbr {
    base_color: "#2a2a2a"
    roughness: 0.12
    metallic: 0.0
    albedo_map: "textures/black_marble_albedo.png"
    normal_map: "textures/black_marble_normal.png"
  }

  material "PedestalPlinthBlack" @advanced_pbr {
    base_color: "#1a1a1a"
    roughness: 0.5
    metallic: 0.0
  }

  material "PolishedBronze" @advanced_pbr {
    base_color: "#4169e1"
    roughness: 0.2
    metallic: 1.0
    normal_map: "textures/polished_bronze_normal.png"
  }

  material "Copper" @advanced_pbr {
    base_color: "#b87333"
    roughness: 0.25
    metallic: 1.0
    normal_map: "textures/copper_normal.png"
  }

  material "BlownGlass" @advanced_pbr {
    base_color: "#a0d8ef"
    roughness: 0.03
    metallic: 0.0
    opacity: 0.3
    ior: 1.5
  }

  material "TeakWood" @advanced_pbr {
    base_color: "#8b4513"
    roughness: 0.5
    metallic: 0.0
    albedo_map: "textures/teak_albedo.png"
    normal_map: "textures/teak_normal.png"
  }

  material "Limestone" @advanced_pbr {
    base_color: "#c8b88a"
    roughness: 0.7
    metallic: 0.0
    albedo_map: "textures/limestone_albedo.png"
    normal_map: "textures/limestone_normal.png"
    ao_map: "textures/limestone_ao.png"
  }

  material "PolishedMarble" @advanced_pbr {
    base_color: "#b0bec5"
    roughness: 0.1
    metallic: 0.0
    albedo_map: "textures/polished_marble_albedo.png"
    normal_map: "textures/polished_marble_normal.png"
  }

  material "CastBronze" @advanced_pbr {
    base_color: "#78909c"
    roughness: 0.3
    metallic: 1.0
    normal_map: "textures/cast_bronze_normal.png"
  }

  material "PolishedAluminum" @advanced_pbr {
    base_color: "#cfd8dc"
    roughness: 0.08
    metallic: 1.0
  }

  material "PlinthMarble" @advanced_pbr {
    base_color: "#ffffff"
    roughness: 0.18
    metallic: 0.0
    albedo_map: "textures/marble_albedo.png"
    normal_map: "textures/marble_normal.png"
  }

  material "Mahogany" @advanced_pbr {
    base_color: "#4e342e"
    roughness: 0.35
    metallic: 0.0
    albedo_map: "textures/mahogany_albedo.png"
    normal_map: "textures/mahogany_normal.png"
  }

  // ── Architecture ──────────────────────────────────────────────────────────

  object "GalleryFloor" {
    @collidable
    geometry: "plane"
    position: [0, 0, 0]
    scale: [30, 1, 30]
    color: "#f5f5dc"
    material: "WhiteOakParquet"
    receiveShadows: true
  }

  object "GalleryCeiling" {
    geometry: "plane"
    position: [0, 6, 0]
    rotation: [180, 0, 0]
    scale: [30, 1, 30]
    color: "#ffffff"
    material: "GalleryPlaster"
  }

  object "NorthWall" {
    @collidable
    geometry: "cube"
    position: [0, 3, -15]
    scale: [30, 6, 0.2]
    color: "#ffffff"
    material: "SmoothPlaster"
  }

  object "SouthWall" {
    @collidable
    geometry: "cube"
    position: [0, 3, 15]
    scale: [30, 6, 0.2]
    color: "#ffffff"
    material: "SmoothPlaster"
  }

  object "EastWall" {
    @collidable
    geometry: "cube"
    position: [15, 3, 0]
    rotation: [0, 90, 0]
    scale: [30, 6, 0.2]
    color: "#ffffff"
    material: "SmoothPlaster"
  }

  object "WestWall" {
    @collidable
    geometry: "cube"
    position: [-15, 3, 0]
    rotation: [0, 90, 0]
    scale: [30, 6, 0.2]
    color: "#ffffff"
    material: "SmoothPlaster"
  }

  object "PartitionWall" {
    @collidable
    geometry: "cube"
    // SPINE: offset east of the entry axis and rotated so its south end
    // meets the visitor head-on, forcing the route to bend left (west)
    // around it toward the hero rather than running straight through.
    position: [4, 3, 2]
    rotation: [0, 22, 0]
    scale: [0.2, 6, 14]
    color: "#f8f8f0"
    material: "SmoothPlaster"
  }

  // ── Main Gallery Artworks ─────────────────────────────────────────────────

  object "AbstractPainting" {
    @clickable
    @pointable
    @glowing
    geometry: "plane"
    // Dominant canvas on the north wall: larger and slightly left of the
    // hero axis, the anchor the two smaller works read out from.
    position: [-1.5, 2.4, -14.8]
    scale: [3, 2.3, 1]
    color: "#ff6347"
    material: "GalleryCanvas"
    behavior "ArtworkInfo" {
      title: 'Chromatic Resonance No. 7'
      artist: 'Isabella Fontaine'
      year: 2023
      medium: 'Acrylic on canvas'
      price: 12500
      currency: 'USD'
      audioGuide: 'audio/abstract-guide.mp3'
    }
  }

  object "AbstractPaintingFrame" {
    geometry: "cube"
    position: [-1.5, 2.4, -14.85]
    scale: [3.1, 2.4, 0.05]
    color: "#8b7355"
    material: "GiltFrame"
  }

  object "AbstractSpotlight" {
    @glowing
    geometry: "cylinder"
    position: [-1.5, 5.5, -14]
    rotation: [-20, 0, 0]
    scale: [0.1, 0.5, 0.1]
    color: "#fffacd"
    emissionIntensity: 4.0
    castShadows: true
  }

  object "LandscapePainting" {
    @clickable
    @pointable
    @glowing
    geometry: "plane"
    // Smaller left flank, hung low beside the dominant canvas.
    position: [-6.5, 1.9, -14.8]
    scale: [1.6, 1.2, 1]
    color: "#87ceeb"
    material: "GalleryCanvas"
    behavior "ArtworkInfo" {
      title: 'Autumn Valley at Dusk'
      artist: 'Marcus Chen'
      year: 2021
      medium: 'Oil on canvas'
      price: 8750
      currency: 'USD'
    }
  }

  object "LandscapeFrame" {
    geometry: "cube"
    position: [-6.5, 1.9, -14.85]
    scale: [1.7, 1.3, 0.05]
    color: "#2c2c2c"
    material: "EbonyFrame"
  }

  object "LandscapeSpotlight" {
    @glowing
    geometry: "cylinder"
    position: [-6.5, 5.5, -14]
    rotation: [-20, 0, 0]
    scale: [0.1, 0.5, 0.1]
    color: "#fffacd"
    emissionIntensity: 2.5
  }

  object "PortraitPainting" {
    @clickable
    @pointable
    @glowing
    geometry: "plane"
    // Smallest, furthest right — the tail of the reading order, so the
    // eye is released back toward the hero on the entry axis.
    position: [2.2, 1.9, -14.8]
    scale: [1.4, 1.7, 1]
    color: "#daa520"
    material: "GalleryCanvas"
    behavior "ArtworkInfo" {
      title: 'The Philosopher\'s Gaze'
      artist: 'Elena Morozova'
      year: 2022
      medium: 'Oil on linen'
      price: 6800
      currency: 'USD'
    }
  }

  object "PortraitFrame" {
    geometry: "cube"
    position: [2.2, 1.9, -14.85]
    scale: [1.5, 1.8, 0.05]
    color: "#8b7355"
    material: "GiltFrame"
  }

  object "PortraitSpotlight" {
    @glowing
    geometry: "cylinder"
    position: [2.2, 5.5, -14]
    rotation: [-20, 0, 0]
    scale: [0.1, 0.5, 0.1]
    color: "#fffacd"
    emissionIntensity: 2.5
  }

  // ── West Wall Gallery ─────────────────────────────────────────────────────

  object "AbstractionPainting2" {
    @clickable
    @glowing
    geometry: "plane"
    position: [-14.8, 2.5, -8]
    rotation: [0, 90, 0]
    scale: [2.5, 1.8, 1]
    color: "#6a0dad"
    material: "GalleryCanvas"
    behavior "ArtworkInfo" {
      title: 'Violet Dissolution'
      artist: 'Henri Leblanc'
      year: 2024
      medium: 'Mixed media on board'
      price: 5500
    }
  }

  object "AbstractionFrame2" {
    geometry: "cube"
    position: [-14.85, 2.5, -8]
    rotation: [0, 90, 0]
    scale: [2.6, 1.9, 0.05]
    color: "#5c4033"
    material: "RusticFrame"
  }

  object "ContemporaryPainting" {
    @clickable
    @glowing
    geometry: "plane"
    position: [-14.8, 2.5, 2]
    rotation: [0, 90, 0]
    scale: [2, 1.5, 1]
    color: "#ff4500"
    material: "GalleryCanvas"
    behavior "ArtworkInfo" {
      title: 'Urban Fragments IV'
      artist: 'Rosa Fuentes'
      year: 2023
      medium: 'Spray paint on canvas'
      price: 3200
    }
  }

  object "MinimalistPainting" {
    @clickable
    @glowing
    geometry: "plane"
    position: [-14.8, 2.5, 12]
    rotation: [0, 90, 0]
    scale: [2, 2, 1]
    color: "#f5f5f5"
    material: "GalleryCanvas"
    behavior "ArtworkInfo" {
      title: 'White on White Study'
      artist: 'Erik Strand'
      year: 2022
      medium: 'Tempera on gessoed canvas'
      price: 7800
    }
  }

  // ── Sculpture Hall ────────────────────────────────────────────────────────

  object "Pedestal" {
    @collidable
    geometry: "cylinder"
    position: [0, 0.5, -5]
    scale: [0.5, 1, 0.5]
    color: "#d3d3d3"
    material: "PedestalMarble"
  }

  object "ModernSculpture" {
    @glowing
    @clickable
    geometry: "sphere"
    position: [0, 1.5, -5]
    scale: 0.6
    color: "#4169e1"
    material: "PolishedBronze"
    behavior "ArtworkInfo" {
      title: 'Infinite Loop'
      artist: 'James Nakamura'
      year: 2024
      medium: 'Cast bronze with gold patina'
      price: 22000
      currency: 'USD'
    }
    behavior "Interactive360" {
      allowSpin: true
      spinSpeed: 0.5
    }
  }

  object "Pedestal2" {
    @collidable
    geometry: "cylinder"
    position: [8, 0.5, -5]
    scale: [0.4, 1, 0.4]
    color: "#d3d3d3"
    material: "PedestalMarbleBlack"
  }

  object "CopperSculpture" {
    @clickable
    geometry: "cube"
    position: [8, 1.5, -5]
    rotation: [0, 45, 0]
    scale: [0.5, 0.5, 0.5]
    color: "#b87333"
    material: "Copper"
    behavior "ArtworkInfo" {
      title: 'Tessellation Study IV'
      artist: 'Amara Diallo'
      year: 2023
      price: 9500
    }
  }

  object "Pedestal3" {
    @collidable
    geometry: "cylinder"
    position: [-8, 0.5, -5]
    scale: [0.4, 1, 0.4]
    color: "#d3d3d3"
    material: "PedestalPlinthBlack"
  }

  object "GlassSculpture" {
    @clickable
    @glowing
    geometry: "sphere"
    position: [-8, 1.5, -5]
    scale: [0.4, 0.7, 0.4]
    color: "#a0d8ef"
    material: "BlownGlass"
    transparency: 0.3
    behavior "ArtworkInfo" {
      title: 'Ocean Memory'
      artist: 'Sofia Andersson'
      year: 2022
      price: 4200
    }
  }

  // ── Seating & Wayfinding ──────────────────────────────────────────────────

  // Seating clusters as a small viewing gallery south of the hero, all
  // three benches facing the bronze — no longer one-each-side-and-center.
  object "BenchLeft" {
    @collidable
    geometry: "cube"
    position: [-2.5, 0.3, -3]
    rotation: [0, 18, 0]
    scale: [2, 0.6, 0.5]
    color: "#8b4513"
    material: "TeakWood"
  }

  object "BenchRight" {
    @collidable
    geometry: "cube"
    position: [2.5, 0.3, -3]
    rotation: [0, -18, 0]
    scale: [2, 0.6, 0.5]
    color: "#8b4513"
    material: "TeakWood"
  }

  object "BenchCenter" {
    @collidable
    geometry: "cube"
    position: [0, 0.3, -1.5]
    scale: [2.4, 0.6, 0.5]
    color: "#8b4513"
    material: "TeakWood"
  }

  object "InfoPlaque1" {
    @clickable
    @glowing
    geometry: "plane"
    position: [-1.5, 1, -14.5]
    scale: [0.5, 0.3, 1]
    color: "#000000"
  }

  object "InfoPlaque2" {
    @clickable
    @glowing
    geometry: "plane"
    position: [-6.5, 0.9, -14.5]
    scale: [0.5, 0.3, 1]
    color: "#000000"
  }

  object "InfoPlaque3" {
    @clickable
    @glowing
    geometry: "plane"
    position: [2.2, 0.9, -14.5]
    scale: [0.5, 0.3, 1]
    color: "#000000"
  }

  // Wayfinding hangs over the entry, angled to point down the path
  // toward the hero the moment the visitor passes under the arch.
  object "WayfindingSign" {
    @glowing
    geometry: "plane"
    position: [-1.5, 4, 9]
    rotation: [0, 8, 0]
    scale: [1.8, 0.6, 1]
    color: "#222222"
  }

  object "EntranceArch" {
    @collidable
    geometry: "cube"
    position: [0, 4, 13]
    scale: [5, 2, 0.3]
    color: "#c8b88a"
    material: "Limestone"
  }

  // ── Ambient Lighting ──────────────────────────────────────────────────────

  // Lighting is handed toward the hero: two bright sources crown the
  // bronze, the rest fall as dimmer markers along the entry path — the
  // four-corner box is gone.
  object "AmbientLight1" {
    @glowing
    geometry: "sphere"
    position: [-0.8, 5.5, -9.5]
    scale: 0.28
    color: "#fff8f0"
    emissionIntensity: 5.0
    castShadows: true
  }

  object "AmbientLight2" {
    @glowing
    geometry: "sphere"
    position: [0.8, 5.5, -10.5]
    scale: 0.28
    color: "#fff8f0"
    emissionIntensity: 5.0
    castShadows: true
  }

  object "AmbientLight3" {
    @glowing
    geometry: "sphere"
    position: [-3, 5.5, 5]
    scale: 0.18
    color: "#fff8f0"
    emissionIntensity: 2.0
  }

  object "AmbientLight4" {
    @glowing
    geometry: "sphere"
    position: [-4.5, 5.5, -7]
    scale: 0.18
    color: "#fff8f0"
    emissionIntensity: 2.2
  }

  object "SkyLight" {
    @glowing
    geometry: "plane"
    position: [0, 5.9, 0]
    rotation: [180, 0, 0]
    scale: [10, 1, 10]
    color: "#e8f4ff"
    emissionIntensity: 2.0
  }

  // ── Museum Systems ────────────────────────────────────────────────────────

  system "VisitorSystem" {
    maxConcurrentVisitors: 50
    queueEnabled: true
    guidedTourMode: true
    freeRoamMode: true
    event "onVisitorEnter" {
      assignAudioGuide: true
      logEntry: true
      showWelcome: true
    }
    event "onArtworkInteract" {
      playAudioGuide: true
      logInteraction: true
      showDetailPanel: true
    }
    event "onVisitorExit" {
      rateExperience: true
      suggestRelated: true
    }
  }

  system "ExhibitionManager" {
    currentExhibition: 'Contemporary Masters 2025'
    exhibitionStartDate: '2025-01-15'
    exhibitionEndDate: '2025-06-30'
    totalArtworks: 24
    rotateExhibition: true
    rotationIntervalDays: 30
  }

  system "AudioGuideSystem" {
    defaultLanguage: 'en'
    supportedLanguages: ['en', 'es', 'fr', 'de', 'zh', 'ja']
    autoTriggerDistance: 2.0
    volume: 0.8
  }

  // ── Sculpture Garden ──────────────────────────────────────────────────────

  object "Sculpture1" {
    @clickable
    @collidable
    geometry: "sphere"
    // Second waypoint: the $28k marble sits west of the entry axis after
    // the route bends around the partition — a pause before the hero.
    position: [-4.5, 0.8, -7]
    scale: [0.6, 1.2, 0.6]
    color: "#b0bec5"
    material: "PolishedMarble"
    behavior "ArtworkInfo" {
      title: 'Convergence I'
      artist: 'Elena Vasquez'
      year: 2021
      medium: 'Carrara Marble'
      price: 28000.00
    }
  }

  object "Sculpture2" {
    @clickable
    @collidable
    geometry: "cube"
    // HERO. The $45k "Ascending Form" bronze stands dead on the entry
    // axis at the culmination of the route — the deepest, tallest object
    // the visitor walks toward from the door. Everything defers to it.
    position: [0, 1.4, -10]
    scale: [0.7, 2.8, 0.7]
    rotation: [0, 45, 0]
    color: "#78909c"
    material: "CastBronze"
    behavior "ArtworkInfo" {
      title: 'Ascending Form'
      artist: 'Marcus Chen'
      year: 2019
      medium: 'Bronze'
      price: 45000.00
    }
  }

  object "Sculpture3" {
    @clickable
    @collidable
    geometry: "cylinder"
    // First waypoint: met just inside the door, set west of the axis so
    // it opens the leftward bend of the route toward the hero.
    position: [-3, 1, 5]
    scale: [0.4, 2, 0.4]
    color: "#cfd8dc"
    material: "PolishedAluminum"
    behavior "ArtworkInfo" {
      title: 'Infinite Loop'
      artist: 'Sophie Laurent'
      year: 2023
      medium: 'Polished Aluminum'
      price: 22000.00
    }
  }

  object "SculpturePedestal1" {
    @collidable
    geometry: "cube"
    position: [-4.5, 0.3, -7]
    scale: [0.8, 0.6, 0.8]
    color: "#ffffff"
    material: "PlinthMarble"
  }

  // HERO plinth: taller and wider than the others so the bronze reads as
  // the culmination the moment the visitor clears the door.
  object "SculpturePedestal2" {
    @collidable
    geometry: "cube"
    position: [0, 0.4, -10]
    scale: [1.1, 0.8, 1.1]
    color: "#ffffff"
  }

  object "SculpturePedestal3" {
    @collidable
    geometry: "cube"
    position: [-3, 0.3, 5]
    scale: [0.8, 0.6, 0.8]
    color: "#ffffff"
  }

  // Hero spotlights: two hard sources rake the bronze from front and
  // side so it out-lights every other piece in the room.
  object "HeroSpotlight" {
    @glowing
    geometry: "cylinder"
    position: [0, 5.6, -8]
    rotation: [-28, 0, 0]
    scale: [0.12, 0.6, 0.12]
    color: "#fffacd"
    emissionIntensity: 6.0
    castShadows: true
  }

  object "HeroSpotlightRake" {
    @glowing
    geometry: "cylinder"
    position: [-2.5, 5.6, -10]
    rotation: [-25, 0, 22]
    scale: [0.1, 0.5, 0.1]
    color: "#fffacd"
    emissionIntensity: 5.0
  }

  // ── Gift Shop ─────────────────────────────────────────────────────────────

  object "GiftShopCounter" {
    @collidable
    geometry: "cube"
    position: [8, 0.5, 8]
    scale: [2, 1, 0.6]
    color: "#4e342e"
    material: "Mahogany"
  }

  object "ArtBookDisplay" {
    @clickable
    @collidable
    geometry: "cube"
    position: [9, 0.8, 8]
    scale: [0.5, 0.8, 0.5]
    color: "#fafafa"
    behavior "GiftShopItem" {
      name: 'Exhibition Catalog'
      price: 39.99
    }
  }

  object "PostcardStand" {
    @clickable
    @collidable
    geometry: "cylinder"
    position: [7.5, 0.8, 8]
    scale: [0.3, 0.8, 0.3]
    color: "#efebe9"
    behavior "GiftShopItem" {
      name: 'Art Postcards (Set of 10)'
      price: 12.99
    }
  }

  // ── Visitor Systems ───────────────────────────────────────────────────────

  system "VisitorAnalytics" {
    trackDwellTime: true
    trackArtworkInteractions: true
    trackAudioGuideUsage: true
    trackVisitorFlow: true
    heatmapEnabled: true

    event "onArtworkViewed" {
      logArtworkId: true
      logDwellTimeSeconds: true
      logAudioPlayed: true
    }
  }

  system "ExhibitionCuration" {
    exhibitionName: 'Visions of Tomorrow'
    curators: ['Dr. Amara Osei', 'Prof. James Whitfield']
    openDate: '2025-06-01'
    closeDate: '2025-12-31'
    totalArtworks: 42
    totalVisitors: 0
    ticketPrice: 18.00
    membersFree: true
  }

  system "AccessibilitySupport" {
    wheelchairAccessible: true
    audioDescriptionsEnabled: true
    subtitlesEnabled: true
    largeTextMode: false
    signLanguageVideos: true
    tactileMapAvailable: true
    guideDogFriendly: true
  }
}

