// Language Reference: Modules & Imports (.hsplus format)
// Comprehensive reference for code organization and reusability
// For AI agent grounding and developer learning
//
// HoloScript+ modules use @import / @export DIRECTIVES (not bare ESM
// statements). Only nodes preceded by an @export directive are visible
// to importing files. Imports are resolved by the ImportResolver with
// circular-dependency detection built in.

// === IMPORTING MODULES (@import directive) ===

// Import a module — exported nodes become available under a default
// alias derived from the file name ("game" for ./utils/game.hsplus)
@import "./utils/game.hsplus"

// Import with an explicit alias
@import "./utils/game.hsplus" as GameUtils

// Import specific exports by name
@import { CalculateScoreBoard, TimerPanel } from "./utils/helpers.hsplus"

// Import everything under a namespace alias
@import * as UiKit from "./components/ui.hsplus"

// Import from the community registry (@username/module form)
@import "@holoscript/ui-essentials"

// === EXPORTING FROM MODULES (@export directive) ===

// An @export directive on the line BEFORE a node makes that node
// available to importers. Optionally annotate the kind and name:
//   @export                      — export the node that follows
//   @export template "Weapon"    — kind- and name-qualified export

// Export a template
@export template "Weapon"
template "Weapon" {
  geometry: "box"

  state {
    damage: 10
    durability: 100
    equipped: false
  }

  actions {
    use() {
      console.log("Using weapon");
      this.state.durability -= 1;

      if (this.state.durability <= 0) {
        this.break();
      }
    }

    break() {
      console.log("Weapon broke!");
      this.destroy();
    }
  }
}

// Export a composition
@export composition "WeaponShop"
composition "WeaponShop" {
  object "Counter" {
    geometry: "box"
    position: { x: 0, y: 1, z: -3 }
  }
}

// Bare @export — exports whatever node follows
@export
template "HealthPotion" {
  geometry: "sphere"
  color: "#e63946"

  state {
    heal_amount: 25
  }
}

// === MODULE ORGANIZATION PATTERNS ===

// === Pattern 1: Component Library ===
// File: components/ui.hsplus — a module of reusable UI templates

@export template "Button"
template "Button" {
  type: "ui"
  uiType: "button"

  state {
    isHovered: false
    isPressed: false
  }

  on_pointer_enter() {
    this.state.isHovered = true;
  }

  on_pointer_exit() {
    this.state.isHovered = false;
  }

  on_pointer_down() {
    this.state.isPressed = true;
  }

  on_pointer_up() {
    this.state.isPressed = false;
  }
}

@export template "ProgressBar"
template "ProgressBar" {
  type: "ui"
  uiType: "progressBar"

  state {
    value: 0
    max: 100
  }

  computed {
    percent: () => {
      return (this.state.value / this.state.max) * 100;
    }
  }
}

// === Pattern 2: Configuration Module ===
// File: config/game.hsplus — shared settings live on an exported
// object's state, imported wherever they are needed

@export object "GameConfig"
object "GameConfig" {
  state {
    player: {
      startHealth: 100,
      startMana: 50,
      moveSpeed: 5.0,
      jumpForce: 10.0
    }
    world: {
      gravity: -9.81,
      timeScale: 1.0,
      weatherEnabled: true
    }
    ui: {
      showHealthBar: true,
      showMinimap: true,
      hudScale: 1.0
    }
    debug: {
      showFPS: false,
      showColliders: false,
      godMode: false
    }
  }
}

// === Pattern 3: Game Systems Module ===
// File: systems/inventory.hsplus — behavior lives in actions blocks on
// an exported object (not bare classes/functions)

@export object "InventorySystem"
object "InventorySystem" {
  state {
    items: []
    maxSlots: 20
  }

  actions {
    addItem(item) {
      if (state.items.length >= state.maxSlots) {
        console.log("Inventory full!");
        return false;
      }
      state.items.push(item);
      return true;
    }

    removeItem(itemId) {
      const index = state.items.findIndex(item => item.id === itemId);
      if (index !== -1) {
        return state.items.splice(index, 1)[0];
      }
      return null;
    }

    getItem(itemId) {
      return state.items.find(item => item.id === itemId);
    }

    clear() {
      state.items = [];
    }
  }
}

// === USING IMPORTED TEMPLATES IN A COMPOSITION ===

composition "GameExample" {
  // Templates imported above (e.g. from ./components/ui.hsplus) are
  // referenced with `using "TemplateName"` exactly like local templates.

  state {
    playerHealth: 100  // Could read GameConfig.state.player.startHealth
  }

  actions {
    takeDamage(damage, armor) {
      const reduction = armor / (armor + 100);
      state.playerHealth -= damage * (1 - reduction);
    }
  }

  // Use imported template
  object "HealthBar" using "ProgressBar" {
    position: { x: 10, y: 10 }

    bind: {
      value: "state.playerHealth",
      max: 100
    }
  }

  object "StartButton" using "Button" {
    text: "Start Game"
    position: { x: 10, y: 60 }

    onClick: () => {
      console.log("Game started!");
    }
  }
}

// === CIRCULAR DEPENDENCY HANDLING ===
// The ImportResolver tracks a "currently resolving" set (DFS cycle
// detection). If module A imports B and B imports A, resolution stops
// at the repeated edge and reports a non-fatal resolution error instead
// of looping forever. Prefer extracting the shared pieces into a third
// module both can import:
//
//   shared.hsplus   — @export template "SharedHud"
//   player.hsplus   — @import { SharedHud } from "./shared.hsplus"
//   enemy.hsplus    — @import { SharedHud } from "./shared.hsplus"

// === KEY MODULE CONCEPTS ===
// 1. @import "./path.hsplus"            — import a module (default alias)
// 2. @import "./path.hsplus" as Alias   — import with explicit alias
// 3. @import { A, B } from "./path"     — named imports
// 4. @import * as NS from "./path"      — namespace import
// 5. @import "@user/module"             — community registry import
// 6. @export (+ optional kind "Name")   — export the node that follows
// 7. Only @export-ed nodes are visible to importers
// 8. Cycles are detected and reported, never infinite-looped

// === BEST PRACTICES ===
// - One composition per file (like React components)
// - Group related templates into component-library modules
// - Keep shared settings on an exported config object
// - Put behavior in actions blocks on exported objects/templates
// - Always pair @export with the node it precedes (next line)
// - Avoid circular dependencies — extract a shared module instead
// - Keep modules focused and cohesive
