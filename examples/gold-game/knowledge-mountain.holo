// THE KNOWLEDGE MOUNTAIN — generated from the REAL GOLD vault
// 186 entries · 83 lineage cables · generated 2026-05-24
// Coordinates are COMPUTED, not authored: semantics->(x,z) via spectral
// embedding over TF-IDF; tier->elevation; lineage_in->crystal scale.
// Companion to examples/gold-game/gold-vault-game.holo — same templates.
// Regenerate: python tools/knowledge-mountain/gen_holo.py
// ═══════════════════════════════════════════════════════════════════

composition "Knowledge Mountain — GOLD vault" {
  metadata {
    name: 'The Knowledge Mountain — the real GOLD vault as climbable geometry'
    category: 'gaming'
    concept: 'vault entries placed at computed mountain coordinates (semantics + tier + lineage)'
    backend: 'D:/GOLD (computed via tools/knowledge-mountain/build_mountain.py)'
    platforms: ['r3f', 'babylonjs']
  }

  environment {
    skybox: "vault_archive"
    ambient_light: 0.4
    fog_density: 0.008
    fog_color: "#0a0c14"
  }

  template "KnowledgeEntry" {
    @grabbable
    @interactive
    geometry: "octahedron"
    scale: [0.3, 0.3, 0.3]
    state {
      tier: "bronze"
      graduated: false
      lineage_links: 0
    }
  }

