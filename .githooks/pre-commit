        echo "$CHOKE_OUT"
        echo "     Fix: use ResilientOrchestratorFetch (packages/connector-core) or @holoscript/config ENDPOINTS,"
        echo "          or (intentional grandfather) run: node scripts/holo-ci/check-orchestrator-fetch-canonical.mjs --update"
        FAILED=1
    else
        echo -e "  ${GREEN}✓${NC} No new raw orchestrator-URL literals (typed client is the growing path)"
    fi
else
    echo -e "  ${GREEN}✓${NC} No staged files"
fi

# Gate 5e: Quest MR emit golden-diff — the in-core QuestCompiler (surface: immersive_mr) must
