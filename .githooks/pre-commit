        echo "$MCPGATE_OUT"
        echo "     Fix: wrap the handler's dispatch in gateToolCall (packages/mcp-server/src/tool-call-gate.ts)"
        FAILED=1
    else
        echo -e "  ${GREEN}✓${NC} All CallToolRequestSchema handlers route through gateToolCall"
    fi
else
    echo -e "  ${GREEN}✓${NC} No staged mcp-server source"
fi

# Gate 5e3: Orchestrator-fetch chokepoint ratchet (CHOKEPOINT-CAPTURE, dependency-sovereignty-ladder
# 2026-07-16). New files hardcoding the raw Railway orchestrator URL literal (outside
# packages/connector-core and @holoscript/config) are blocked (CHOKEPOINT-GREW); route through the
# typed ResilientOrchestratorFetch client (Jetson-first cascade) instead. Grandfathered debt lives in
