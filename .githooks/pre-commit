# Gate 5e-quest-bv: Quest BUILD-VERIFY — proves the freshly-emitted QuestCompiler output (scanner +
# worlds) BUILDS via real `gradlew assembleDebug` over the committed Meta Spatial SDK skeleton. Unlike
# AndroidXR, compile_to_quest is device-proven and PASSES (green 2026-06-21). Default mode SKIPs on a
# JDK-less box (never blocks a commit); a box/CI with a JDK runs the real build. Only runs when the
# scanner app, the Quest emit chain, the build-verify runner, or the gate is staged. (W.810: build-verify
# is the trust gate; golden-diff alone is blind to whether the output compiles.)
echo "  ├─ Quest build-verify..."
STAGED_QUEST_BV=$(git diff --cached --name-only -- \
    'apps/quest-universal-qr-scanner/**' \
    'packages/core/src/compiler/QuestCompiler.ts' \
    'packages/core/src/compiler/quest-mr-emit.ts' \
    'packages/core/src/compiler/quest-world-emit.ts' \
    'scripts/holo-ci/build-verify/**' \
    'scripts/holo-ci/check-quest-build-verify.mts' 2>/dev/null || true)
if [ -n "$STAGED_QUEST_BV" ]; then
    QUEST_BV_OUT=$(run_with_timeout 600 npx tsx scripts/holo-ci/check-quest-build-verify.mts 2>&1)
    QUEST_BV_STATUS=$?
    if [ "$QUEST_BV_STATUS" -ne 0 ]; then
        echo -e "  ${RED}❌ Quest build-verify failed${NC}"
        echo "$QUEST_BV_OUT"
        echo "     The emitted Quest app did not build. Fix the QuestCompiler emit so the output is buildable."
        FAILED=1
    else
        echo -e "  ${GREEN}✓${NC} Quest build-verify passed (built or skipped — no toolchain)"
    fi
fi

# Gate 5f: Trait parity — every R3F-emitted trait must be handled or noop-classified.
# This is the INTERLOCK for the legacy R3FCompiler-to-SceneIR transition.
# Only runs when R3FCompiler.ts or the trait runtime files are staged — avoids blocking
# unrelated commits. The check is fast (~100ms, pure read — no install/network).
echo "  ├─ Trait parity gate..."
STAGED_PARITY=$(git diff --cached --name-only -- \
    'packages/core/src/compiler/R3FCompiler.ts' \
    'packages/runtime/src/traits/*.ts' \
    'scripts/holo-ci/TRAIT_NOOP_MANIFEST.json' 2>/dev/null || true)
if [ -n "$STAGED_PARITY" ]; then
