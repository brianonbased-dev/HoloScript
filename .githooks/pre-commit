        echo -e "  ${RED}❌ Net-new hand-authored render .tsx (production surface must be HS-native)${NC}"
        echo "$RENDER_OUT"
        echo "     Fix: author it in .hs and compile it (header), make it a compiler example,"
        echo "          or (intentional legacy) run: node scripts/holo-ci/check-render-surface-native.mjs --update"
        FAILED=1
    else
        echo -e "  ${GREEN}✓${NC} Render surface HS-native (no net-new hand-authored render)"
    fi
else
    echo -e "  ${GREEN}✓${NC} No staged render .tsx"
fi

# Gate 5e2: MCP gate coverage (WRAP-WITH-RECEIPTS, dependency-sovereignty-ladder 2026-07-16).
# Every setRequestHandler(CallToolRequestSchema) fold point under packages/mcp-server/src must
# route through gateToolCall (packages/mcp-server/src/tool-call-gate.ts) — per-call NDJSON
# receipts + the typed FounderGate/x402 check seam. Fast static scan; only runs when mcp-server
# source is staged so unrelated commits skip it. HoloCI's mcp-gate-coverage gate is the
