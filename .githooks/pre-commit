    PARITY_STATUS=$?
    if [ "$PARITY_STATUS" -ne 0 ]; then
        echo -e "  ${RED}❌ Trait parity gap detected${NC}"
        echo "$PARITY_OUT"
        echo "     Fix: add a TraitHandler in packages/runtime/src/traits/ OR"
        echo "          add an entry to scripts/holo-ci/TRAIT_NOOP_MANIFEST.json with a reason."
        echo "     Detail: node scripts/holo-ci/check-trait-parity.mjs --verbose"
        FAILED=1
    else
        echo -e "  ${GREEN}✓${NC} Trait parity OK"
    fi
else
    echo -e "  ${GREEN}✓${NC} Trait parity (no relevant staged files)"
fi

# Gate 5g: Hardcoded ecosystem-count gate (Zero Hardcoded Stats / docs/NUMBERS.md SSOT).
# Scans STAGED markdown for a bare count before a volatile noun (traits / compilers / MCP tools /
# compile-export targets / knowledge entries) — the rot pattern that makes every doc a lie within
# weeks ("1,800+ VR traits" was wrong in 12 files; tool count went 34→82→88→122→158). Gates NEW
# violations only (staged scope, multi-agent-safe); the existing backlog is not retro-failed. Escape
# a legit number with a NUMBERS.md reference, a verify/find/grep command, ~approx, or "as of <date>".
echo "  ├─ Hardcoded-stats gate (NUMBERS.md SSOT)..."
STAGED_MD=$(git diff --cached --name-only --diff-filter=ACM -- '*.md' 2>/dev/null || true)
if [ -n "$STAGED_MD" ]; then
    STATS_OUT=$(run_with_timeout 20 node scripts/holo-ci/check-hardcoded-stats.mjs $STAGED_MD 2>&1)
    STATS_STATUS=$?
    if [ "$STATS_STATUS" -ne 0 ]; then
        echo -e "  ${RED}❌ Hardcoded ecosystem count in a staged doc${NC}"
        echo "$STATS_OUT"
        echo "     Fix: reference docs/NUMBERS.md or the verification command instead of the literal count."
        FAILED=1
    else
        echo -e "  ${GREEN}✓${NC} No hardcoded ecosystem counts"
    fi
else
    echo -e "  ${GREEN}✓${NC} No staged markdown"
fi

# Gate 5g2: Language-strata gate (stratum taxonomy, docs/spec/language-architecture.md §6.2).
# The meaning stratum (HoloMeaning, @holoscript/meaning) is defined ONCE and imported — a second
# definition of a canonical resolver name, the resolution-record union, or the gap-reason enum
# outside the canonical homes is a mirror and is blocked. The uAAL/HSI-IR overload this prevents
# was the root cause of the 2026-07 language-design loop (two IRs for one meaning stratum).
echo "  ├─ Language-strata gate (one meaning, defined once)..."
# Runs UNCONDITIONALLY: staged-file trigger-matching proved fragile on the stage-2 landing commit
# itself — its git-mv renames (index status R) slipped the ACM diff-filter and skipped the gate
# (2026-07-17). A move IS how a mirror escapes; always check.
# Budget raised 30s -> 60s (2026-08-05, task_1783725666154_l157 follow-up): the "<2s" full-tree
# walk this comment used to describe now measures ~30-32s on repeated direct runs (repo growth),
# so the old 30s budget was clipping a passing check mid-flight and false-failing every commit that
# touched this gate — confirmed by three direct `node ... --strict` runs, all exit 0 (no real
# mirror), all landing in the 30.1s-32.1s band, both from a candidate worktree and the main checkout.
# Budget raised 60s -> 120s (2026-09-02): the walk now measures ~65s on this Windows laptop, so 60s
# clipped a passing `--strict` run and printed the generic "Meaning-stratum mirror" banner with
# empty output. Pass `--root` so the walk is bound to this worktree even if cwd drifts.
STRATA_ROOT=$(git rev-parse --show-toplevel)
STRATA_OUT=$(run_with_timeout 120 node scripts/holo-ci/check-language-strata.mjs --strict --root "$STRATA_ROOT" 2>&1)
STRATA_STATUS=$?
if [ "$STRATA_STATUS" -ne 0 ]; then
    echo "$STRATA_OUT"
    if [ "$STRATA_STATUS" -eq 124 ]; then
        echo -e "  ${RED}❌ Language-strata gate timed out (budget 120s; walk is ~65s on this laptop)${NC}"
        echo "     Re-run: node scripts/holo-ci/check-language-strata.mjs --strict --root \"$STRATA_ROOT\""
    else
        echo -e "  ${RED}❌ Meaning-stratum mirror (second definition outside @holoscript/meaning)${NC}"
        echo "     Fix: import the contract from @holoscript/meaning (docs/spec/language-architecture.md §6.2); never re-declare it."
    fi
    FAILED=1
else
    echo -e "  ${GREEN}✓${NC} One meaning stratum, defined once"
fi

# Gate 5g7: Workspace build-graph gate (ARCHITECTURE.md dependency rules 1 and 7).
# Rules 1 ("No cycles") and 7 ("core must never depend on engine") existed with NO enforcing
# gate, which is how commit 7f2ba28b3 (2026-07-07) silently reverted b53e815f9. The cost,
# measured 2026-08-05: the workspace could not be built from a clean checkout at all — an
# 11-package SCC left pnpm unable to order framework before engine, and engine's
# `tsc -p tsconfig.dts.json` died on 14 TS2307 reading a dist/ that could not exist yet.
# Checks THREE defect classes, because acyclicity alone is not sufficient:
#   1. cycles over workspace: edges (Tarjan, all four dependency fields — devDependencies
#      participate in pnpm's ordering, and that is exactly how core closed this one);
#   2. build-order inversions that are NOT cycles (a semver back-edge creates no pnpm edge,
#      so core->plugin + plugin--semver-->core + a --dts build inverts the order silently);
#   3. unordered build-time deps (a sibling needed for type emit but declared only by semver
#      gives pnpm no ordering constraint — this is what deleting a cycle edge leaves behind).
# Runs UNCONDITIONALLY: a static manifest walk over 144 packages, milliseconds. Staged-file
# triggering would miss a rename, and a moved manifest is a way the invariant escapes.
echo "  ├─ Workspace build-graph gate (no cycles, no inverted or unordered build deps)..."
WSGRAPH_OUT=$(run_with_timeout 30 node scripts/holo-ci/check-workspace-acyclic.mjs 2>&1)
WSGRAPH_STATUS=$?
if [ "$WSGRAPH_STATUS" -ne 0 ]; then
    echo -e "  ${RED}❌ Workspace dependency graph cannot produce a correct build order${NC}"
    echo "$WSGRAPH_OUT"
    echo "     Fix the manifest edge, not the build order. See decisions/2026-08-05_workspace-build-cycle.md."
    FAILED=1
else
    echo -e "  ${GREEN}✓${NC} Build graph orderable (0 cycles, 0 inversions, 0 unordered)"
fi

# Gate 5g6: Docker-drift gate (per-service Docker recipe vs import graph, W.787 class).
# The gate existed since 2026-07-10 (check:docker-drift) but was wired into NO enforcement
# seam — so the @holoscript/meaning extraction (2026-07-17) broke THREE production images
# (mcp-server 264c42076, tunnel d317c543b, studio bd748044a — 5 consecutive deploy
# failures) with a gap class the gate detects statically in ~2s. Runs UNCONDITIONALLY
# (same rationale as the strata gate above: the breaking change is usually a SOURCE
# import with zero Dockerfile edits, so staged-file scoping would miss exactly the
# class this exists to catch). Ratcheted: fails only when a gap set GROWS vs
# scripts/holo-ci/docker-drift-baseline.json; burn the baseline down, never up.
echo "  ├─ Docker-drift gate (import graph vs per-service Docker recipes)..."
DOCKER_DRIFT_OUT=$(run_with_timeout 60 node scripts/holo-ci/check-docker-drift.mjs 2>&1)
DOCKER_DRIFT_STATUS=$?
if [ "$DOCKER_DRIFT_STATUS" -ne 0 ]; then
    echo -e "  ${RED}❌ Docker recipe drift (a NEW one-sided import/build-order gap would break a container build)${NC}"
    echo "$DOCKER_DRIFT_OUT"
    echo "     Fix: add the dep's build step (with dts) BEFORE its importer in the named Dockerfile — see the studio/meaning fix bd748044a for the pattern. Reseed only for a deliberate exception: pnpm check:docker-drift:update."
    FAILED=1
else
    echo -e "  ${GREEN}✓${NC} Docker recipes hold vs import graph (ratchet baseline)"
fi

# Gate 5g3: Verifier-of-record gate (language-architecture.md §6.3). A corpus/reward file that
# emits abstention LABELS must route them through the shipped gradeByResolver, never a fork —
# the function that labels training data must be the function that runs at inference. Strict on
# this repo's packages/ (green today; protects the reward terms from a verdict-fork regression).
# The corpus builders live in ai-ecosystem; audit them there with --roots (report-only).
echo "  ├─ Verifier-of-record gate (labels from the shipped resolver)..."
VOR_OUT=$(run_with_timeout 30 node scripts/holo-ci/check-verifier-of-record.mjs --strict 2>&1)
VOR_STATUS=$?
if [ "$VOR_STATUS" -ne 0 ]; then
    echo -e "  ${RED}❌ Forked resolution verdict (labels not routed through gradeByResolver)${NC}"
    echo "$VOR_OUT"
    echo "     Fix: import gradeByResolver from @holoscript/meaning (or the @holoscript/uaal shim); never re-derive."
    FAILED=1
else
    echo -e "  ${GREEN}✓${NC} Verifier of record: labels route through the shipped resolver"
fi

# Gate 5g4: Family-admission gate (language-architecture.md §4.2/§6.5). Every admitted meaning
# family must abstain with a FAMILY-SCOPED gap code, not a collapsed base bucket. Went strict
# 2026-07-17 once the 3 grandfathered families (occlusion/norm_status/dischargeable) gained codes;
# a new family (or a regressed one) with only a coarse bucket now fails. Fast static walk.
echo "  ├─ Family-admission gate (family-scoped gap codes)..."
FAM_OUT=$(run_with_timeout 30 node scripts/holo-ci/check-family-admission.mjs --strict 2>&1)
FAM_STATUS=$?
if [ "$FAM_STATUS" -ne 0 ]; then
    echo -e "  ${RED}❌ A meaning family abstains with only a coarse base bucket (no family-scoped gap code)${NC}"
    echo "$FAM_OUT"
    echo "     Fix: emit structuredGap('<family>.<code>', …) on the family's abstention path (§4.2)."
    FAILED=1
else
    echo -e "  ${GREEN}✓${NC} Every admitted family emits a family-scoped gap code"
fi

# Gate 5g5: Executable spec corpus (I2, spec-as-corpus). Every case in
# packages/compiler-wasm/spec-corpus/ is a NORMATIVE claim (source + verdict the grammar authority
# must reach); this replays all of them against the real pkg-node artifact. A drifted verdict means
# the language no longer means what the spec says — either the grammar change is wrong, or the spec
# changed and the corpus case must be updated IN THE SAME COMMIT so the meaning change is
# reviewable. ~1s for the whole corpus; binds to the WASM authority, never the TS parsers.
echo "  ├─ Executable spec corpus (spec-as-corpus, I2)..."
SPEC_OUT=$(run_with_timeout 30 node scripts/holo-ci/check-spec-corpus.mjs --strict 2>&1)
SPEC_STATUS=$?
if [ "$SPEC_STATUS" -ne 0 ]; then
    echo -e "  ${RED}❌ The executable spec drifted — a normative corpus verdict no longer holds${NC}"
    echo "$SPEC_OUT"
    echo "     Fix: correct the grammar change, or update the corpus case + re-pin (--update-manifest) in this commit."
    FAILED=1
else
    echo -e "  ${GREEN}✓${NC} Executable spec holds (every normative corpus verdict verified)"
fi

# Gate 5h: No third-party QR-code service gate (F.106/F.117: generate QR codes LOCALLY).
# Scans STAGED packages/*/src files for a hosted QR-service hostname (api.qrserver.com et al).
# Regression history: api.qrserver.com leaked every published .holo share/scan URL via
# encodeURIComponent(sceneUrl) in SocialTraits.ts + renderer.ts (fixed 2026-07-01). This gate
# prevents a third regression. Excludes docs/archive/ (dead reference HTML, not live code).
echo "  ├─ No-third-party-QR gate (F.106/F.117)..."
STAGED_SRC=$(git diff --cached --name-only --diff-filter=ACM -- 'packages/*/src/**/*.ts' 'packages/*/src/**/*.tsx' 'packages/*/src/**/*.js' 'packages/*/src/**/*.mjs' 2>/dev/null || true)
if [ -n "$STAGED_SRC" ]; then
    QR_OUT=$(run_with_timeout 20 node scripts/holo-ci/check-no-third-party-qr.mjs $STAGED_SRC 2>&1)
    QR_STATUS=$?
    if [ "$QR_STATUS" -ne 0 ]; then
        echo -e "  ${RED}❌ Third-party QR-service literal in staged source${NC}"
        echo "$QR_OUT"
        echo "     Fix: generate QR codes locally via the 'qrcode' npm package (data: URI), never a hosted API."
        FAILED=1
    else
        echo -e "  ${GREEN}✓${NC} No third-party QR-service literals"
    fi
else
    echo -e "  ${GREEN}✓${NC} No staged source files"
fi

# Gate 6: Complexity — skipped (not configured)
echo -e "  ├─ Complexity analysis... ${YELLOW}⚠ skipped${NC}"

# Gate 7: Security audit — DISABLED for pre-commit
echo -e "  ├─ Security audit... ${YELLOW}⚠ skipped (CI handles this)${NC}"

# Gate 8: Brain (.hsplus) scope enforcement — RELOCATED to the commit-msg hook
# (.githooks/commit-msg) on 2026-06-03 (board task_1780471084146_a54w).
# It must run at commit-msg, not here: pre-commit fires BEFORE git writes the
# commit message, so reading it at this stage only ever saw the PREVIOUS commit's
# message (.git/COMMIT_EDITMSG / git log -1) — which false-blocked correctly-scoped
# commits and could false-pass wrong-scoped ones. The commit-msg hook receives the
# real message path as "$1". This is a non-blocking heads-up only.
if git diff --cached --name-only -- 'compositions/*.hsplus' 2>/dev/null | grep -q .; then
    echo -e "  ├─ Brain (.hsplus) staged — scope enforced at commit-msg stage"
fi

# Final result
if [ $FAILED -eq 1 ]; then
    echo ""
    echo -e "${RED}❌ Quality gates failed. Commit blocked.${NC}"
    echo "   Fix the issues above and try again."
    exit 1
else
    echo ""
    echo -e "${GREEN}✅ All quality gates passed!${NC}"
    exit 0
fi
