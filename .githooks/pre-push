#!/bin/bash
# AI Ecosystem: Pre-Push Gate — frozen-lockfile drift (task_1780438044239_4ftu)
#
# WHY: push to main auto-deploys EVERY Railway service, each via
# `pnpm install --frozen-lockfile` against the shared root pnpm-lock.yaml. A
# stale package.json <-> pnpm-lock.yaml drift makes that install fail, which
# bricks the deploy of every service at once — this has happened twice in 3 days
# (7f6f1ff0f on 2026-06-02; b019827c0 / 5cd115c2d two days prior). This gate
# blocks such a push BEFORE it reaches main, but only when the push actually
# touches a package.json or the lockfile (otherwise it is a no-op, zero cost).
#
# It reuses scripts/holo-ci/frozen-lockfile-check.mjs — the exact same logic the
# HoloCI frozen-lockfile gate runs (F.107: HoloCI, not GitHub Actions) — which
# does a fast `--lockfile-only` pnpm probe plus a static every-dep-present check.
#
# Emergency bypass (NOT for main): git push --no-verify

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; NC='\033[0m'
ZERO='0000000000000000000000000000000000000000'

# --- Gate: studio Dockerfile static check (always-run, ~1s) ----------------
# WHY: a package compiled with `tsc --emitDeclarationOnly` in the studio
# Dockerfile that does NOT exclude test files bricks the Railway studio build
# the moment a test imports a removed export (the agent-protocol class, 2568f997e).
# This is the HoloCI `dockerfile-static-check` gate (gates.mjs) run LOCALLY — a
# fast static check (no Docker daemon, no install) so a dead fleet CI path can't
# let an instant, high-blast-radius deploy-bricker slip to main un-gated.
# Emergency bypass (NOT for main): git push --no-verify
if [ -f scripts/validate-dockerfile-build.mjs ]; then
  if ! node scripts/validate-dockerfile-build.mjs; then
    echo -e "${RED}[pre-push] BLOCKED: studio Dockerfile static check failed — would brick the Railway studio deploy.${NC}"
    echo -e "${YELLOW}  Fix the flagged package's tsconfig.json (exclude test files), then re-push.${NC}"
    echo -e "${YELLOW}  Emergency bypass (NOT for main): git push --no-verify${NC}"
    exit 1
  fi
fi

# --- Gate: doctrine-slot falsifier (local breadcrumb must prove hooks fired) ---
if [ -f scripts/check-doctrine-slots.mjs ]; then
  if ! node scripts/check-doctrine-slots.mjs; then
    echo -e "${RED}[pre-push] BLOCKED: the doctrine-slot gate refused -- its reason is printed above.${NC}"
    echo -e "${YELLOW}  Fix what it names (a registered hook that never fired, or a marked lane's missing breadcrumb), then re-push.${NC}"
    echo -e "${YELLOW}  Emergency bypass (NOT for main): git push --no-verify${NC}"
    exit 1
  fi
fi

# Collect the files the push changes. The pre-push protocol feeds lines
# "<local_ref> <local_sha> <remote_ref> <remote_sha>" on stdin.
#
# THE QUESTION IS WHAT THIS BRANCH CHANGES RELATIVE TO THE TRUNK IT LANDS ON,
# so the range starts at the merge base with that trunk: `trunk...local`, three
# dots. Two measurements made this the rule:
#
#   2026-08-16 (task_1786942099138_9ad3): the base was `origin/main`, the
#   GitHub federation mirror, which runs behind HoloRepo canon. The range swept
#   in 6 already-landed commits carrying 4 packages/core files, the pushed
#   commit carried none, and the ~15-minute core-baseline receipt was demanded.
#   Fixed then by reading the TARGET remote's main.
#
#   2026-09-28: the base was right and the range was still wrong. `git diff A..B`
#   is a tree comparison, not "the commits in B": with main 17 commits past the
#   branch point, `main..branch` listed the 5 packages/core files main had
#   changed since, while the branch changed 22 studio files and no core file
#   (three dots: 0 core files, exactly the 22). An existing branch that merges
#   main hit the same wall through `remote_sha..local_sha`, which lists every
#   file the merge brought in.
#
# git hands pre-push the remote name as $1 and its URL as $2, so the trunk of
# the real target is one ls-remote away. Order: the target's main, then
# origin/main, then (for an existing branch) the old per-push range, then fail
# closed. An ls-remote answer can name a commit that is not here. `git diff`
# against it fails (exit 128, measured on git 2.51), and the `|| force_check=1`
# below would then judge every push in full, a needless core run; so it is
# verified first, and a missing commit falls back to origin/main.
trunk=$(git ls-remote "${2:-$1}" refs/heads/main 2>/dev/null | cut -f1)
if [ -n "$trunk" ] && ! git cat-file -e "${trunk}^{commit}" 2>/dev/null; then
  trunk=''
fi
if [ -z "$trunk" ]; then
  trunk=$(git rev-parse --verify --quiet origin/main 2>/dev/null || true)
fi
changed=''
force_check=0
while read -r local_ref local_sha remote_ref remote_sha; do
  # Branch deletion — nothing to validate.
  [ "$local_sha" = "$ZERO" ] && continue
  if [ -n "$trunk" ]; then
    # A trunk range shows what a push adds, never what it removes: a rewind of
    # main lists nothing. So a push that is not a fast-forward is judged in full.
    if [ "$remote_sha" != "$ZERO" ] && ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
      force_check=1
      continue
    fi
    # Criss-cross merges leave two merge bases; `git diff` then warns, uses one,
    # exits 0, and can list nothing while landing the branch changes a file.
    if [ "$(git merge-base --all "$trunk" "$local_sha" 2>/dev/null | wc -l)" -gt 1 ]; then
      force_check=1
      continue
    fi
    range="$trunk...$local_sha"
  elif [ "$remote_sha" != "$ZERO" ]; then
    # A tree comparison: unlike a trunk range, it shows what a rewind removes.
    range="$remote_sha..$local_sha"
  else
    force_check=1
    continue
  fi
  # No merge base (unrelated history) makes the diff fail: judge everything.
  files=$(git diff --name-only "$range" 2>/dev/null) || force_check=1
  changed="$changed
$files"
done

# --- Gate: core test baseline receipt (scoped to packages/core) -------------
# WHY: packages/core/test-baseline.json classifies core suite failures into
# flaky / known-stable / NEW so a real regression is distinguishable from the
# suite's known noise. Its classifier (packages/core/scripts/check-core-test-baseline.mjs)
# was committed 2026-05-31 and registered NOWHERE for 66 days; the first time it
# was ever run — 2026-08-05 — it immediately surfaced 5 unrecorded failures.
#
# The suite costs ~15 min, which cannot run at push time without simply training
# `--no-verify`. So the proof is produced out of band and only CHECKED here, in
# milliseconds, against the content hash of packages/core at HEAD.
# See decisions/2026-08-05_holoscript-native-testing.md.
# Emergency bypass (NOT for main): git push --no-verify
if [ "$force_check" = "1" ] || printf '%s\n' "$changed" | grep -qE '^packages/core/'; then
  if [ -f scripts/holo-ci/check-core-baseline-receipt.mjs ]; then
    if ! node scripts/holo-ci/check-core-baseline-receipt.mjs; then
      exit 1
    fi
  fi
fi

# ── Studio generators: the drift check, actually run ────────────────────────
#
# Four generators emit committed files. Until 2026-09-21 each emitted RAW output
# while the repo-wide format pass rewrote the committed copies, so every run
# produced a phantom diff -- and a check that is always red is a check nobody
# reads, which is how real drift hid. They format their own output now and
# `check:studio-generators` compares committed output against a fresh run.
#
# That check existed and NOTHING INVOKED IT. `.github/workflows` holds only
# `_archived/`, and the only mention of viewreg:check outside its own definition
# was the comment admitting no caller existed. An honest check nobody runs is
# still a check that cannot fail; this is the caller.
#
# Measured 2026-09-22: 6 seconds on a clean tree, exit 0. Fed a real drift (one
# view id renamed in the generated output) it exits 1 and names the file.
if [ "$force_check" = "1" ] || printf '%s\n' "$changed" | grep -qE '^packages/studio/'; then
  echo -e "${YELLOW}[pre-push] studio change — checking generator drift (~6s)...${NC}"
  # Output is SHOWN, not swallowed. Sending it to /dev/null threw away the only
  # thing that tells the developer WHICH file drifted, leaving them to re-run the
  # check by hand to learn what the hook already knew.
  if ! corepack pnpm --filter @holoscript/studio run generators:check; then
    echo -e "${RED}[pre-push] BLOCKED: a committed generated file no longer matches its generator.${NC}"
    # Three SEPARATE commands. `pnpm run a b c` runs script `a` with "b" and "c"
    # as argv -- it does not run three scripts. The one-line form printed here
    # before ran holo:build only, so anyone blocked by vector or viewreg drift
    # followed the instructions, saw exit 0, pushed, and was blocked again with
    # the identical message.
    echo -e "${YELLOW}  Fix: pnpm --filter @holoscript/studio run holo:build${NC}"
    echo -e "${YELLOW}       pnpm --filter @holoscript/studio run vector:build${NC}"
    echo -e "${YELLOW}       pnpm --filter @holoscript/studio run viewreg:build${NC}"
    echo -e "${YELLOW}  then commit the regenerated files.${NC}"
    echo -e "${YELLOW}  Never edit a @generated file directly — change the .holo source.${NC}"
    echo -e "${YELLOW}  Emergency bypass (NOT for main): git push --no-verify${NC}"
    exit 1
  fi

  # THE CHECK READS THE WORKING TREE, AND THE PUSH SENDS THE COMMIT.
  #
  # Every --check mode compares the generator against the files ON DISK. But
  # `prebuild` and `predev` regenerate the tree, so a developer who commits stale
  # generated output and then runs `pnpm build` has a clean working tree and a
  # stale commit -- and the check above passes by construction while the push
  # carries the drift.
  #
  # The check just proved disk == generator output. So all that is left is
  # disk == HEAD for the generated artifacts, which git can answer directly.
  gen_paths="packages/studio/.holo-manifest.json packages/studio/src/lib/studio/viewRegistry.generated.ts packages/studio/src/lib/studio/viewRegistry.components.tsx packages/studio/src/components/panels/native"
  if ! git diff --quiet HEAD -- $gen_paths 2>/dev/null; then
    echo -e "${RED}[pre-push] BLOCKED: generated studio files differ between your commit and your working tree.${NC}"
    echo -e "${YELLOW}  The generators agree with your FILES, but you have not committed them, so the${NC}"
    echo -e "${YELLOW}  push would carry the older output. Commit the regenerated files:${NC}"
    git diff --name-only HEAD -- $gen_paths 2>/dev/null | sed 's/^/    /'
    echo -e "${YELLOW}  Emergency bypass (NOT for main): git push --no-verify${NC}"
    exit 1
  fi
  echo -e "${GREEN}[pre-push] studio generators match their sources, and the commit matches the tree.${NC}"
fi

# Gate only when a manifest or the lockfile is part of the push.
if [ "$force_check" = "0" ] && ! printf '%s\n' "$changed" | grep -qE '(^|/)package\.json$|(^|/)pnpm-lock\.yaml$'; then
  exit 0
fi

echo -e "${YELLOW}[pre-push] package.json/lockfile change in this push — checking frozen-lockfile drift...${NC}"
if node scripts/holo-ci/frozen-lockfile-check.mjs; then
  echo -e "${GREEN}[pre-push] lockfile IN SYNC — push allowed.${NC}"
  exit 0
fi

echo -e "${RED}[pre-push] BLOCKED: package.json <-> pnpm-lock.yaml drift.${NC}"
echo -e "${RED}  Pushing this would fail \`pnpm install --frozen-lockfile\` and BRICK every Railway service deploy.${NC}"
echo -e "${YELLOW}  Fix: run \`pnpm install\` to refresh the lockfile, commit pnpm-lock.yaml, then re-push.${NC}"
echo -e "${YELLOW}  Emergency bypass (NOT for main): git push --no-verify${NC}"
exit 1
