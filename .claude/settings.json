{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node C:/Users/Josep/.ai-ecosystem/hooks/run-hook.mjs sessionstart/room-connect.mjs"
          },
          {
            "type": "command",
            "command": "node C:/Users/Josep/.ai-ecosystem/hooks/run-hook.mjs sessionstart/memory-ceiling-check.mjs",
            "timeout": 10,
            "async": true,
            "statusMessage": "Checking HoloScript MEMORY.md ceiling (auto-graduate if over 20KB)...",
            "env": {
              "CLAUDE_PROJECT_MEMORY_DIR": "C:/Users/Josep/.claude/projects/c--Users-Josep-Documents-GitHub-HoloScript/memory"
            }
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Shell|WebFetch|WebSearch|Edit|Write|NotebookEdit|TaskCreate|TaskUpdate|AskUserQuestion|CronCreate|mcp__scheduled-tasks__create_scheduled_task",
        "hooks": [
          {
            "type": "command",
            "command": "node C:/Users/Josep/.ai-ecosystem/hooks/run-hook.mjs pretooluse/skill-redirect.mjs",
            "timeout": 3,
            "async": false,
            "statusMessage": "Checking skill availability..."
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node C:/Users/Josep/.ai-ecosystem/hooks/run-hook.mjs pretooluse/caveat-reverify.mjs",
            "timeout": 3,
            "async": false,
            "statusMessage": "Checking caveat freshness..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node C:/Users/Josep/.ai-ecosystem/hooks/run-hook.mjs userpromptsubmit/mode-injector-fast.mjs",
            "timeout": 5,
            "async": false,
            "statusMessage": "Re-injecting team-mode directive per prompt (cache-only fast path)..."
