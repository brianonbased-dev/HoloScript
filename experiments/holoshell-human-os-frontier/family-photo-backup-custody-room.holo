/**
 * HoloShell Family Photo Backup Custody Room
 *
 * Visible room concept for:
 * "Back up family photos safely, detect duplicates, redact private metadata,
 * prove the backup is intact before any deletion is allowed, and block
 * original deletion until a separate fresh approval is given."
 *
 * Gates: SourceAlbumGate, DuplicateMemoryTable, PrivacyAndEncryptionGate,
 *        ProviderBoundaryGate, RestoreProofGate, DeleteBlockerToken
 */

composition "HoloShell Family Photo Backup Custody Room" {
  environment {
    backgroundColor: "#0d1a26"
    ambient_light: 0.52
    shadows: true
  }

  template "CustodyStation" {
    @billboard
    @anchor
    geometry: "plane"
    scale: [1.34, 0.5, 0.08]
    material: {
      color: "#152636"
      emissive: "#1e3a52"
      emissiveIntensity: 0.24
      transparent: true
      opacity: 0.94
    }
  }

  template "EvidenceToken" {
    @grabbable
    @collidable
    geometry: "sphere"
    scale: [0.16, 0.16, 0.16]
    material: { color: "#76d8a6" }
  }

  template "BlockerToken" {
    @grabbable
    geometry: "octahedron"
    scale: [0.18, 0.18, 0.18]
    material: { color: "#f7768e" }
    glow: { color: "#ff4466", intensity: 0.6 }
  }

  // ── Gate 1: Source Album ──────────────────────────────────────────────────
  // Reads the album label, fingerprints every file, and records media kind,
  // size, and hash. Originals are read-only throughout the entire flow.

  object "SourceAlbumGate" using "CustodyStation" {
    position: [-3.8, 2.1, -2.6]
    label: "Source album: fingerprint, media kind, hash, read-only lock"
    properties: {
      humanJob: "select which album or folder to back up without learning paths, formats, or cloud logins"
      consumes: "album label, album fingerprint, per-file hash (SHA-256), media kind, size, unreadable flag"
      failureState: "unreadable file, source hash changed after snapshot"
      sourceRule: "originals are read-only until a separate fresh approval unlocks deletion"
    }
  }

  // ── Gate 2: Duplicate Memory ──────────────────────────────────────────────
  // Groups identical or near-identical files, assigns duplicate group IDs,
  // and reports counts. The human sees how many unique photos the album
  // actually contains before deciding what to keep.

  object "DuplicateMemoryTable" using "CustodyStation" {
    position: [-1.6, 2.1, -2.6]
    label: "Duplicate memory: group identicals, report unique count"
    properties: {
      consumes: "file hashes, sizes, media kinds — grouped into duplicate groups"
      failureState: "hash collision, zero-file album"
      humanJob: "see how many unique photos the album actually has"
    }
  }

  // ── Gate 3: Privacy & Encryption ──────────────────────────────────────────
  // Strips GPS coordinates, face labels, and camera serial numbers from public
  // metadata. The private receipt retains absolute paths; the public receipt
  // never exposes them. Encryption policy is chosen here (client-side encrypt
  // is the default for cloud targets).

  object "PrivacyAndEncryptionGate" using "CustodyStation" {
    position: [0.6, 2.1, -2.6]
    label: "Privacy and encryption: strip GPS, faces, serials; choose policy"
    properties: {
      consumes: "metadata policy choice, GPS/face/serial redaction flags"
      failureState: "raw pixels in public receipt, GPS not redacted, face labels not redacted"
      humanJob: "choose who sees what metadata — the room enforces the strictest safe default"
      enforcedDefaults: {
        rawPixelsInPublicReceipt: false
        gpsRedacted: true
        faceLabelsRedacted: true
        metadataPolicy: "client_side_encrypt"
      }
    }
  }

  // ── Gate 4: Provider Boundary ─────────────────────────────────────────────
  // The target plan: external drive, encrypted archive, cloud provider, or
  // NAS. Quota is checked, delete semantics are made visible, and provider
  // account is resolved. No deletion of originals happens here — this gate
  // only governs where the copy goes.

  object "ProviderBoundaryGate" using "CustodyStation" {
    position: [2.8, 2.1, -2.6]
    label: "Provider boundary: target kind, quota, delete semantics visible"
    properties: {
      consumes: "target kind, quota check result, delete semantics, provider account"
      failureState: "quota exceeded, provider account not resolved, delete semantics hidden"
      humanJob: "choose where the backup copy lives — the room never hides what deletion means"
    }
  }

  // ── Gate 5: Restore Proof ─────────────────────────────────────────────────
  // A verification receipt proves the backup copy is intact, readable, and
  // matches the originals. Only after this gate passes can deletion even be
  // considered. The verification includes a sample restore: a random subset
  // of files is read back and their hashes compared.

  object "RestoreProofGate" using "CustodyStation" {
    position: [0, 1.35, -1.0]
    label: "Restore proof: verify backup integrity before any deletion"
    properties: {
      consumes: "verification receipt: copy manifest hash, sample restore results"
      failureState: "hash mismatch, count mismatch, privacy mode mismatch, copy not executed"
      humanJob: "see proof that every photo in the backup is intact and readable"
      enforcedConstraint: "originalsDeletionAllowed is always false in this receipt"
    }
  }

  // ── Gate 6: Delete Blocker ────────────────────────────────────────────────
  // A separate, break-glass approval that must be given AFTER restore proof
  // passes. The custody receipt marks deleteBlocked: true. Only this token
  // can unlock deletion, and it requires a fresh human "I understand" action.
  // Even then, deletion is only of the originals — the backup copy is permanent.

  object "DeleteBlockerToken" using "BlockerToken" {
    position: [2.2, 0.85, 0.3]
    label: "Delete blocker: originals cannot be deleted until you separately approve"
    properties: {
      receiptKind: "photo_backup_delete_blocker"
      requiresFreshApproval: true
      approvalText: "I understand that the originals will be permanently deleted from this device"
      enforcedBy: "PhotoBackupCustodyReceipt.summary.deleteBlocked == true"
      unlockCondition: "RestoreProofGate status == verified AND separate human approval"
      rollback: "originals remain on device if approval is not given or if restore proof is not verified"
    }
  }

  // ── Evidence Tokens ───────────────────────────────────────────────────────

  object "AlbumSnapshotToken" using "EvidenceToken" {
    position: [-2.6, 0.78, 0.3]
    label: "album snapshot: label, fingerprint, file count"
    properties: {
      receiptKind: "photo_backup_album_snapshot"
      requiredArtifacts: ["albumLabel", "albumFingerprint", "fileCount"]
    }
  }

  object "DuplicateGroupToken" using "EvidenceToken" {
    position: [-0.8, 0.78, 0.3]
    material: { color: "#7aa2f7" }
    label: "duplicate groups identified"
    properties: {
      receiptKind: "photo_backup_duplicate_memory"
      requiredArtifacts: ["duplicateGroupCount", "uniqueFileCount"]
    }
  }

  object "PrivacyEnvelopeToken" using "EvidenceToken" {
    position: [1.0, 0.78, 0.3]
    material: { color: "#bb9af7" }
    label: "privacy envelope applied: GPS stripped, faces stripped, serials stripped"
    properties: {
      receiptKind: "photo_backup_privacy_envelope"
      requiredArtifacts: ["gpsRedacted", "faceLabelsRedacted", "metadataPolicy"]
    }
  }

  object "CopyManifestToken" using "EvidenceToken" {
    position: [2.8, 0.78, 0.3]
    material: { color: "#9ece6a" }
    label: "copy manifest: target written, quota checked, hash recorded"
    properties: {
      receiptKind: "photo_backup_copy_manifest"
      requiredArtifacts: ["targetKind", "copyManifestHash", "quotaChecked"]
    }
  }

  // ── Timeline rail ──────────────────────────────────────────────────────────

  object "BackupTimelineWall" {
    @anchor
    geometry: "cube"
    position: [0, 0.24, 0.2]
    scale: [7.6, 0.08, 0.14]
    color: "#565f89"
    label: "timeline: select album -> detect duplicates -> strip privacy -> choose target -> verify backup -> [optional: approve deletion]"
  }

  // ── Rollback drawer ───────────────────────────────────────────────────────

  object "RollbackDrawer" using "CustodyStation" {
    position: [0, 0.95, 1.6]
    label: "Rollback: delete generated backup artifacts, never touch originals unless approved"
    properties: {
      rollback: "remove generated receipts, backup copy artifacts, and .tmp directories — originals untouched"
      replay: "rerun from album fingerprint, duplicate detection, privacy envelope, and copy manifest"
    }
  }
}