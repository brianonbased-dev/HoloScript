// Brittney — flagship EMBODIED AGENT (archetype 3).
//
// The same entity-generic body as a human/avatar, but DRIVEN by authoritative world-state
// (keyed by entity_id) and — per D.102 "portable agent mind" — anchored to a seat WALLET
// identity with memory loaded from private:<wallet>. D.094: never hardcode Brittney into the
// machinery; she is the flagship DEFAULT, and any BYOK agent plugs into the identical body.
// Renders natively via the bridge: parseHolo → buildCharacterHostFromComposition → renderCharacter
// (@holoscript/engine character-render). NOT R3F.

composition "Brittney - Embodied Agent" {
  metadata {
    title: "Brittney"
    version: "1.0.0"
    archetype: "embodied_agent"
    tags: ["agent", "embodied", "humanoid", "brittney"]
    description: "Agent-agnostic embodiment: world-state-driven body; identity = seat wallet; memory = private wallet store (D.102)."
  }

  object "Brittney" {
    @skeleton(rig: "humanoid_65", ik_enabled: true)
    @body(height: 1.68, build_scale: 1.0, skin_tone: "#e8c4a0")
    @subsurface_scattering(color: [0.8, 0.25, 0.13], radius: 1.2, thickness: 0.3)
    @hair(style: "medium_wavy", color: "#2c1810")
    @face(blend_shapes: 52, eye_tracking: true)
    @expressive(presets: { happy: { mouthSmile: 0.8 }, thinking: { browInnerUp: 0.4 } }, auto_blink: true)
    @locomotion(mode: "walk", speed: 1.4)
    @character_voice { spatial_audio: true, lip_sync: true }
    @avatar_embodiment(first_person: false, mirror_visible: true)

    // D.102 mind-carry seam: the SAME wallet-keyed agent that ran on the Jetson node
    // now inhabits this body at spawn, loading private:<wallet> memory across the
    // substrate hop — proven by the CrossSubstrateIdentityReceipt the seam emits. With
    // this the flagship body no longer renders soulless (check:embodied-mind).
    @portable_mind_seam(
      bearer: env("HOLOSCRIPT_AGENT_X402_BEARER"),
      mesh_api_base: env("HOLOMESH_API_BASE"),
      team_id: env("HOLOMESH_TEAM_ID"),
      agent_id: "brittney"
    )

    geometry: "avatar"
    position: [0, 0, 0]

    // Embodied-agent state: the body is a projection of authoritative world-state (entity_id).
    // The @portable_mind_seam above binds identity + private:<wallet> memory at spawn;
    // the identity wallet is derived from the seat bearer, never declared literally (G.GOLD.016).
    state {
      activity: "idle"
      entity_id: "brittney"
      memory_scope: "private:<wallet>"
    }

    on_init() { play("idle_breathe") }
  }
}
